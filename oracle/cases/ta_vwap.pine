//@version=5
indicator("ta_vwap")
// ta.vwap 오라클 검증(ROADMAP P2 "ta.* 44종"). Pine 문법상 volume 인자가 없어 내장 bar series
// volume을 암묵 사용(vwma/mfi와 동일). Without an anchor the VWAP restarts on the first bar of each
// session (tests/oracle/ta_vwap.test.ts; the pine2py golden's never-reset sum is not ground truth).
// 콜사이트 2개(close/high)로 상태 슬롯 독립도 함께 검증.
var float __obs_vwap_c = na
var float __obs_vwap_h = na
__obs_vwap_c := ta.vwap(close)
__obs_vwap_h := ta.vwap(high)
