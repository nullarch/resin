//@version=5
indicator("ta_linreg")
// ta.linreg 오라클 검증(ROADMAP P2 "ta.* 44종" — linreg). length=4로 sample10.json 10바 안에서
// 워밍업 구간(NaN, 바 0~2)과 정상 구간(바 3~9)을 모두 커버. offset=0 and offset=2 are observed
// together to check the offset term of linreg = intercept + slope * (length - 1 - offset)
// (ref_v6_ta_math.txt): offset bars BACK from the newest bar (tests/oracle/ta_linreg.test.ts).
var float __obs_linreg0 = na
var float __obs_linreg2 = na
__obs_linreg0 := ta.linreg(close, 4, 0)
__obs_linreg2 := ta.linreg(close, 4, 2)
