//@version=5
indicator("ta_change_mom")
// ta.change/ta.mom 오라클 검증(ROADMAP P2 "ta.* 44종" — change/mom). pine2py wavealgo/ta/change.py
// 소스 대조로 mom()이 change()의 완전한 별칭임을 확인했으므로 둘 다 같은 length=3으로 관측해
// 바이트 단위로 동일함을 함께 검증한다. sample10.json 10바 안에서 워밍업(바 0~2, data_len<=3
// -> NaN)과 정상 구간(바 3~9)을 모두 커버.
var float __obs_change = na
var float __obs_mom = na
__obs_change := ta.change(close, 3)
__obs_mom := ta.mom(close, 3)
