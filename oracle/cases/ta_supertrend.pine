//@version=5
indicator("ta_supertrend")
// ta.supertrend(factor=2.0, atrPeriod=3) observed over sample10.json. The pine2py golden is not
// ground truth for this case: tests/oracle/ta_supertrend.test.ts checks the PyneCore oracle's values
// (direction 1 = downtrend, -1 = uptrend; tier 1 resin-harness suites/strategy/tv/supertrend).
[value, direction] = ta.supertrend(2.0, 3)
var float __obs_value = na
var float __obs_direction = na
__obs_value := value
__obs_direction := direction
