//@version=5
indicator("Accumulation/Distribution")
// TV 빌트인 "Accumulation/Distribution" 인디케이터 E2E 재현(ROADMAP P2 "TV 빌트인 인디케이터 15종
// E2E" 네 번째 슬라이스, 3종 중 2: OBV/ACCDIST/COG). ta.accdist 자체의 계산은 이미
// oracle/cases/ta_obv_accdist.pine(순수 __obs 미러, close/high/low/volume 암묵 사용)으로 개별
// 검증됐다 -- 이 케이스는 그 위에 indicator()/plot()을 얹어 완성된 빌트인 스크립트 구조 전체를
// 검증한다. ta.accdist()도 obv와 동일하게 Pine 문법상 인자가 없어 input.* 결선이 필요 없다.
adValue = ta.accdist()

plot(adValue, "AD")

var float __obs_accdist = na
__obs_accdist := adValue
