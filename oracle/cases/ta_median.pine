//@version=5
indicator("ta_median")
// ta.median 오라클 검증(ROADMAP P2 "ta.* 44종" — median). length=3으로 sample10.json 10바 안에서
// 워밍업(바 0~1, data_len<length라 NaN)과 정상 구간(바 2~9)을 모두 커버. pine2py wavealgo/ta/median.py:
// 매 바 최근 length개(현재 포함)를 정렬해 중앙값(홀수 길이라 가운데 값 그대로). sample10엔 na가
// 없어 NaN-프라임 순환 버퍼의 "항상 push해 오염" 경로(highest/change와 동일 raw-passthrough)는
// runtime.test.ts hand-verified로 별도 검증(pine2py median() 직접 실행 대비 300건 fuzz 사전 확인).
var float __obs_median = na
__obs_median := ta.median(close, 3)
