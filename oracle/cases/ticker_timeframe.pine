__obs_std := ticker.standard("BINANCE:BTCUSDT")
var string __obs_mod = na
__obs_mod := ticker.modify("BINANCE:BTCUSDT")
var string __obs_ha = na
__obs_ha := ticker.heikinashi("BINANCE:BTCUSDT")
var string __obs_renko = na
__obs_renko := ticker.renko("BINANCE:BTCUSDT")
var string __obs_kagi = na
__obs_kagi := ticker.kagi("BINANCE:BTCUSDT")
var string __obs_lb = na
