//@version=5
indicator("ticker_timeframe")
// ticker.*(8종)/timeframe.change(C235) — bar-independent (pure literal args, no OHLCV dependency,
// str_basic.pine/math_const.pine 패턴과 동일). pine2py wavealgo/__init__.py 전부가 순수 문자열
// pass-through/접합 + timeframe_change 상수 반환이라 바마다 값이 바뀌지 않는다.
var string __obs_new0 = na
__obs_new0 := ticker.new("BINANCE", "BTCUSDT")
var string __obs_new1 = na
__obs_new1 := ticker.new()
