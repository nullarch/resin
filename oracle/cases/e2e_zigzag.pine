//@version=5
indicator("ZigZag")
// 패턴: 실전 지표 재현(ROADMAP P3, TV 커뮤니티 ZigZag 인디케이터 재현). Supertrend/WaveTrend/
// Squeeze Momentum/Ichimoku(C186~C189)는 전부 "그 바 하나만 보고 계산되는 순수 함수형 조합"이라
// 오라클이 항상 안전했던 것과 달리, 이 스크립트는 처음으로 **상태 누적형**이다 -- 이미 개별
// 검증된 ta.pivothigh/ta.pivotlow(oracle/cases/ta_pivot.pine, tests/oracle/ta_pivot.test.ts)의
// 확정 신호를 var(zzPrice/zzBar/zzDir/pivotCount)로 누적해 "마지막 확정 피벗 대비 deviation% 이상
// 반대 방향으로 움직여야 새 피벗을 확정한다"는 ZigZag 고유 상태 전이 로직을 얹는다.
// depth=1(left=right=1)은 ta_pivot.pine이 이미 검증한 최소 비자명 창과 동일 -- sample10.json의
// high/low 채널이 close 채널과 동일한 지그재그 형태(교대 고점/저점)라 정확히 같은 위치(바3/바7=
// 고점 확정, 바4/바8=저점 확정)에서 두 쌍의 교대 피벗이 나온다. deviation=0.5%는 이 4개 확정
// 피벗 전부가 항상 통과하는 낮은 문턱으로 골라(교대 흐름 자체를 우선 검증) "문턱 미달로 스킵"
// 분기는 이번 케이스 범위 밖(향후 별도 오라클로 커버, ROADMAP에 등재).
// zzDir==0(아직 피벗 없음) 판정은 var int를 na가 아닌 리터럴 0으로 초기화해 정수 비교만으로
// 게이트하고(VERIFIED_SEMANTICS.md OPEN "비교/na 시맨틱"을 초기 상태에서 아예 우회), 삼항의
// 두 분기 모두 순수 산술(stateful 호출 없음)이라 TV의 "삼항 양쪽 항상 평가" 시맨틱(C66)과
// JS 네이티브 lazy 삼항 사이의 차이가 최종값에 영향을 주지 않는다.
depth = 1
deviation = 0.5

var float zzPrice = 0.0
var int zzBar = 0
var int zzDir = 0
var int pivotCount = 0

ph = ta.pivothigh(high, depth, depth)
pl = ta.pivotlow(low, depth, depth)

if ph != na
    pctMove = zzDir == 0 ? 100.0 : math.abs(ph - zzPrice) / zzPrice * 100.0
    if zzDir <= 0 or pctMove >= deviation
        zzPrice := ph
        zzBar := bar_index - depth
        zzDir := 1
        pivotCount := pivotCount + 1

if pl != na
    pctMove = zzDir == 0 ? 100.0 : math.abs(zzPrice - pl) / zzPrice * 100.0
    if zzDir >= 0 or pctMove >= deviation
        zzPrice := pl
        zzBar := bar_index - depth
        zzDir := -1
        pivotCount := pivotCount + 1

plot(zzPrice, "ZigZag")

var float __obs_zzPrice = na
var float __obs_zzBar = na
var float __obs_zzDir = na
var float __obs_pivotCount = na
__obs_zzPrice := zzPrice
__obs_zzBar := zzBar
__obs_zzDir := zzDir
__obs_pivotCount := pivotCount
