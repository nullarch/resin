//@version=5
indicator("Supertrend")
// TradingView built-in "Supertrend" indicator end to end. The pine2py golden is not ground truth for
// this case: tests/oracle/e2e_supertrend.test.ts checks the PyneCore oracle's values (direction 1 =
// downtrend, -1 = uptrend; tier 1 resin-harness suites/strategy/tv/supertrend).
factorInput = input.float(2.0, "Factor")
atrPeriodInput = input.int(3, "ATR Period")

[value, direction] = ta.supertrend(factorInput, atrPeriodInput)

plot(value, "SuperTrend")
plot(direction, "Direction")

var float __obs_value = na
var float __obs_direction = na
__obs_value := value
__obs_direction := direction
