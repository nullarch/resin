//@version=5
indicator("cond_loop_ta")
// [hard→분할] 조건부 stateful call — loop 본문(for/while) 슬라이스 검증 (ROADMAP line 809, C161).
// per-call 상태 전진 모델에서 루프 안 ta 콜은 "반복마다 같은 콜사이트 상태가 1회씩 전진"이다.
// pine2py는 for/while을 Python 루프로 직결 트랜스파일(codegen.py _gen_for/_gen_while)하고
// state_key가 codegen 시점 정적 콜사이트 카운터(_taN)라 정확히 동형 — 즉 이 골든 자체가
// "루프 안 per-call 전진" 시맨틱의 수치 오라클이다. 채널은 전부 ta.ema(진짜 call-fed — sma/rma는
// 첫 호출 히스토리 백필로 오라클 무효, DIVERGENCES.md #11 / cond_switch_ta.pine C65 발견 참조).
//
// __obs_a: 고정 2회/바 for 루프 — ema(close,3) 상태가 바마다 정확히 2스텝 전진.
//   같은 바에서 같은 close를 두 번 먹으므로 bar1 마지막 호출(통산 4회째)에서
//   시드 (101+101+102)/3=101.3333 뒤 한 스텝 더: 0.5*102+0.5*101.3333=101.6667 (스모킹 건 —
//   바당 1회 전진이었다면 bar1은 아직 워밍업 NaN이어야 함).
var float __obs_a = na
for i = 0 to 1
    __obs_a := ta.ema(close, 3)
// __obs_b: while 루프(카운터 2회/바) — for와 동일한 per-call 전진이 while 본문에서도 성립.
var float __obs_b = na
j = 0
while j < 2
    __obs_b := ta.ema(close, 5)
    j := j + 1
// __obs_c: continue로 중간 반복을 건너뛰는 for 루프(i=0,2에서만 호출 — 2회/바) —
// 루프 본문 안 if(cond-body)/continue와 per-call 전진의 조합.
var float __obs_c = na
for i = 0 to 2
    if i == 1
        continue
    __obs_c := ta.ema(close, 4)
// __obs_d: 바마다 반복 횟수가 달라지는 for 루프(limit이 1,0,1,0,... 교대 → 호출 2,1,2,1,...회) —
// 바마다 상태가 다른 속도로 전진하는 핵심 시나리오. ema(close,2)는 bar0(2회 호출)에서 이미
// 시드 (101+101)/2=101 완성.
var float flag = 0.0
flag := 1.0 - flag
limit = flag > 0.5 ? 1 : 0
var float __obs_d = na
for i = 0 to limit
    __obs_d := ta.ema(close, 2)
