//@version=5
indicator("cond_loop_ta")
// Stateful calls in loop bodies (for/while). A loop call site keeps ONE state, and every
// execution on one bar re-derives from the state the bar started with (PyneCore __loop_state__,
// tier 1 ta_373_sma_loop_shared_window). The golden next to this case is pine2py's, which advanced
// the state once per iteration (C161) — not ground truth; tests/oracle/cond_loop_ta.test.ts asserts
// the tier-2 oracle's values instead. Every channel is a ta.ema.
//
// __obs_a: a for loop running twice per bar — ema(close,3) still steps once per bar.
var float __obs_a = na
for i = 0 to 1
    __obs_a := ta.ema(close, 3)
// __obs_b: a while loop (counter, twice per bar) — the same law in a while body.
var float __obs_b = na
j = 0
while j < 2
    __obs_b := ta.ema(close, 5)
    j := j + 1
// __obs_c: a for loop that skips i == 1 with continue (called at i = 0 and 2) — an if/continue
// inside the loop body.
var float __obs_c = na
for i = 0 to 2
    if i == 1
        continue
    __obs_c := ta.ema(close, 4)
// __obs_d: a for loop whose iteration count alternates per bar (limit 1,0,1,0,... → 2,1,2,1,...
// calls) — the state still steps once per bar.
var float flag = 0.0
flag := 1.0 - flag
limit = flag > 0.5 ? 1 : 0
var float __obs_d = na
for i = 0 to limit
    __obs_d := ta.ema(close, 2)
