//@version=5
indicator("ta_dmi")
// ta.dmi 오라클 검증(ROADMAP P2 "ta.* 44종"). diLength=3, adxSmoothing=2 — 기본값(14,14)은
// sample10.json(10바) 안에서 rma 워밍업이 끝나지 않아 전 구간 na다. diLength=3이면 ta.tr/+DM/-DM의
// rma가 바1..3에서 시드돼 바3부터 plusDi/minusDi 유효, adxSmoothing=2라 dx 2개(바3,바4)가 모이는
// 바4부터 adx까지 전 채널 유효 — 10바 안에서 워밍업/DI-only/DI+ADX 세 구간을 전부 커버
// (tests/oracle/ta_dmi.test.ts, PyneCore values).
[plusDi, minusDi, adx] = ta.dmi(3, 2)
var float __obs_plus_di = na
var float __obs_minus_di = na
var float __obs_adx = na
__obs_plus_di := plusDi
__obs_minus_di := minusDi
__obs_adx := adx
