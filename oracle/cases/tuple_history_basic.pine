//@version=5
indicator("tuple_history_basic")
[macdLine, sigLine, histLine] = ta.macd(close, 3, 5, 2)
f(x) =>
    [x * 2.0, x + 1.0]
[dblc, incc] = f(close)
[dblo, inco] = f(open)
var float __obs_m1 = na
__obs_m1 := macdLine[1]
var float __obs_s2 = na
__obs_s2 := sigLine[2]
var float __obs_h1 = na
__obs_h1 := histLine[1]
var float __obs_dc1 = na
__obs_dc1 := dblc[1]
var float __obs_ic2 = na
__obs_ic2 := incc[2]
var float __obs_dyn = na
__obs_dyn := dblo[bar_index % 3]
var float __obs_io1 = na
__obs_io1 := inco[1]
