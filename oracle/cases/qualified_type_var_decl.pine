//@version=5
indicator("qualified_type_var_decl")
// C219: `var/varip series/simple/const TYPE x = ...` 및 var 없는 `series/simple/const TYPE x = ...`
// 타입 한정자 접두 변수 선언 파서 지원 신규 (C195 parser 감사 잔여 스코프 2/3 -- for-in(1/3)은
// C215/216, import/library(3/3)는 사람 판단 대기로 범위 밖, LIMITATIONS.md 참조). pine2py
// parser.py _parse_var_decl(L220-225)/_parse_qualified_var_decl(L274-292) literal port -- 단
// qualifier(series/simple/const)는 pine2js 어디서도 소비되지 않는 장식 정보라 파서가 소비만 하고
// 버린다(typeHint는 base type만 저장, "series float" 합성 문자열이 아님 -- inferNumType 등 정확
// 문자열 매치 소비자와의 충돌 회피). 이 오라클은 "타입 한정자가 붙어도 기존 무한정자 선언과 정확히
// 같은 값을 낸다"를 bar-by-bar로 검증한다.
var series float accSeries = 0.0
accSeries := accSeries + close
var float __obs_acc_series = na
__obs_acc_series := accSeries

varip simple int counter = 0
counter := counter + 1
var float __obs_counter = na
__obs_counter := counter

var const bool flag = true
var float __obs_flag = na
__obs_flag := flag ? 1.0 : 0.0

// var 없는 로컬(bare qualifier, 매 바 재평가)
series float localX = close * 2.0
var float __obs_local = na
__obs_local := localX

// if 블록 안에서도 var 없는 qualifier 로컬이 지원되는지 확인
var float __obs_if_local = na
if bar_index > 2
    simple int ifLocal = 7
    __obs_if_local := ifLocal
