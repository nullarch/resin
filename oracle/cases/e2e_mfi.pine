//@version=5
indicator("Money Flow Index")
// TV 빌트인 "Money Flow Index" 인디케이터 E2E 재현(ROADMAP P2 "TV 빌트인 인디케이터 15종
// E2E" 세 번째 슬라이스, 3종 중 1: MFI/WPR/VWAP). ta.mfi 자체의 계산은 이미
// oracle/cases/ta_mfi.pine(순수 __obs 미러, close 직접 사용, length=3)으로 개별 검증됐다 -- 이
// 케이스는 그 위에 indicator()/input.int/input.source/plot()을 얹어 완성된 빌트인 스크립트 구조
// 전체를 검증한다. length=3은 ta_mfi.pine과 동일 파라미터를 재사용(sample10.json 10바 안에서
// 워밍업/유효 구간을 이미 커버해둔 조합 그대로 재사용). volume은 Pine 인자가 아니라 내장 bar
// series로 암묵 사용된다(analyzer.ts TA_REGISTRY.mfi 주석 참조, ta_mfi.pine과 동일).
lengthInput = input.int(3, "Length")
src = input.source(close, "Source")

mfiValue = ta.mfi(src, lengthInput)

plot(mfiValue, "MFI")

var float __obs_mfi = na
__obs_mfi := mfiValue
