//@version=5
indicator("ta_range_percentile_varlen")
// ta.range/ta.percentile_nearest_rank/ta.percentile_linear_interpolation series(가변) length
// 오라클 검증(배치25 (4) 계속, next_hint(C552) 잔여 싱글턴 3종 묶음, C553 — runtime/ta.ts
// rangeVarLen/percentileNearestRankVarLen/percentileLinearInterpolationVarLen). 셋 다
// pine2py(range_func.py/percentrank.py)가 상태 없이 매 호출 현재 length로
// source.get(0..length-1)을 재구축하는 무상태 재스캔이라(get_ta_state 미사용, python 직접 실행
// 확인 2026-08-01) highest/lowest(C547)·median(C550)과 동일하게 **length 값이 실제로 변하는
// 축을 골든으로 직접 대조할 수 있다**.
// lenA = 5 - (bar_index % 5): sample10.json 10바에서 5,4,3,2,1,... 순환 — 바 0/1은 워밍업 NaN,
// 바 2~9는 정상 구간(세 함수 공통 워밍업 게이트).
lenA = 5 - (bar_index % 5)
var float __obs_range1 = na
__obs_range1 := ta.range(close, lenA)
// lenB: -1/0/2 3-way 순환 — range만 length<=0(0과 음수 둘 다)에서 pine2py가 크래시 없이 -inf를
// 반환하는 실측 동작(hi=-inf/lo=+inf가 그대로 남아 hi-lo=-inf, python 직접 확인)의 literal port를
// 골든으로 직접 검증(highest의 -inf #178과 동일 축) — percentile류는 length<1 전부 IndexError
// 크래시라 이 축에 못 넣고 na 자체 결정(DIVERGENCES 신규 항목, tests/unit/runtime.test.ts로 커버).
lenB = bar_index % 3 == 0 ? -1 : (bar_index % 3 == 1 ? 0 : 2)
var float __obs_range2 = na
__obs_range2 := ta.range(high, lenB)
// percentile_nearest_rank: 2-인자 폼(percentage 생략, 기본 50 — varlen 경로의 codegen 패딩 분기를
// 골든으로 검증)과 3-인자 폼(percentage=30 명시)을 나란히.
var float __obs_pnr1 = na
__obs_pnr1 := ta.percentile_nearest_rank(close, lenA)
var float __obs_pnr2 = na
__obs_pnr2 := ta.percentile_nearest_rank(close, lenA, 30)
// percentile_linear_interpolation: 위와 동일한 2/3-인자 폼 쌍.
var float __obs_pli1 = na
__obs_pli1 := ta.percentile_linear_interpolation(close, lenA)
var float __obs_pli2 = na
__obs_pli2 := ta.percentile_linear_interpolation(close, lenA, 30)
