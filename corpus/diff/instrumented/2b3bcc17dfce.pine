
//@version=5
indicator("BB Width MA")
[mid, upper, lower] = ta.bb(close, 5, 2.0)
width = mid > 0 ? (upper - lower) / mid : 0.0
widthMA = ta.sma(width, 3)
squeezing = width < widthMA
var float __obs_plot0 = na
__obs_plot0 := width
plot(width, "Width")
var float __obs_plot1 = na
__obs_plot1 := squeezing ? 1 : 0
plot(squeezing ? 1 : 0, "Squeeze")
