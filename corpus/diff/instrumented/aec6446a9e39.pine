//@version=5
indicator("RewardShape")
baseReward = close > open ? 1.0 : -1.0
volatility = high - low
avgVol = nz(ta.sma(volatility, 3), volatility)
penalty = volatility > avgVol ? -0.3 : 0.0
shapedReward = baseReward + penalty
var float cumShaped = 0.0
cumShaped := cumShaped + shapedReward
var float __obs_plot0 = na
__obs_plot0 := cumShaped
plot(cumShaped, "CumSR")
