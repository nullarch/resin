
//@version=5
indicator("Power")
rsi = nz(ta.rsi(close, 3), 50.0)
normalized = rsi / 100.0
squared = math.pow(normalized, 2.0)
sqrtVal = math.sqrt(normalized)
var float __obs_plot0 = na
__obs_plot0 := squared
plot(squared, "Sq")
var float __obs_plot1 = na
__obs_plot1 := sqrtVal
plot(sqrtVal, "Sqrt")
