
//@version=5
indicator("Reg Full")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)

trendScore = (close > sma3 ? 1 : -1) + (sma3 > sma5 ? 1 : -1)
momScore = rsi > 55 ? 1 : rsi < 45 ? -1 : 0
volRatio = avgATR > 0 ? atr / avgATR : 1.0

var int regimeChanges = 0
var int prevRegime = 0
regime = trendScore + momScore
if regime != prevRegime
    regimeChanges := regimeChanges + 1
prevRegime := regime

var float __obs_plot0 = na
__obs_plot0 := regime
plot(regime, "R")
var float __obs_plot1 = na
__obs_plot1 := regimeChanges
plot(regimeChanges, "RC")
