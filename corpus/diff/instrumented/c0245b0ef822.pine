
//@version=5
indicator("ConvWeight")
targetRatio = 0.6
currentRatio = 0.5
steps = 0
while math.abs(currentRatio - targetRatio) > 0.001 and steps < 50
    currentRatio := currentRatio + (targetRatio - currentRatio) * 0.3
    steps := steps + 1
var float __obs_plot0 = na
__obs_plot0 := currentRatio
plot(currentRatio, "CR")
