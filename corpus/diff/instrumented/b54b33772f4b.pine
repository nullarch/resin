//@version=5
indicator("Dashboard")
float rsiVal = nz(ta.rsi(close, 3), 50.0)
float atrVal = nz(ta.atr(3), 1.0)
float smaVal = ta.sma(close, 5)
float rsiScore = rsiVal > 60.0 ? 1.0 : rsiVal < 40.0 ? -1.0 : 0.0
float trendScore = close > nz(smaVal, close) ? 1.0 : -1.0
float volScore = atrVal > 3.0 ? 1.0 : 0.0
float composite = (rsiScore + trendScore + volScore) / 3.0
var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "Composite")
