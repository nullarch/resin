
//@version=5
indicator("Band Lbl")
[mid, upper, lower] = ta.bb(close, 5, 2.0)
zone = close > upper ? "ABOVE" : close < lower ? "BELOW" : close > mid ? "UPPER" : "LOWER"
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
vol = avgATR > 0 and atr / avgATR > 1.3 ? "HV" : "LV"
label = zone + "_" + vol
var float __obs_plot0 = na
__obs_plot0 := label == "ABOVE_HV" ? 1 : 0
plot(label == "ABOVE_HV" ? 1 : 0, "AHV")
