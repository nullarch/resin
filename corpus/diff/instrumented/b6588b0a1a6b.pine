//@version=5
indicator("DG-20 Riemannian Distance")
var float rDist = 0.0
if not na(close[1])
    dx = 1.0
    dy = close - close[1]
    devVal = nz(ta.stdev(close, 5), 1.0)
    g22 = devVal * devVal
    ds = math.sqrt(dx * dx + g22 * dy * dy)
    rDist := rDist + ds
var float __obs_plot0 = na
__obs_plot0 := rDist
plot(rDist)
