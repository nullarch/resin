//@version=5
indicator("ArrSortForWhile")
arr = array.new_float(0)
for i = 0 to 4
    array.push(arr, close - float(i))
array.sort(arr)
idx = 0
total = 0.0
sz = array.size(arr)
while idx < sz
    total := total + array.get(arr, idx)
    idx := idx + 1
avg = sz > 0 ? total / float(sz) : 0.0
var float __obs_plot0 = na
__obs_plot0 := math.log(math.max(avg, 1.0))
plot(math.log(math.max(avg, 1.0)), "L")
