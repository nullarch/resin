
//@version=5
indicator("RecFactor")
var float equity = 100.0
var float peak = 100.0
var float maxDD = 0.0
pnl = close > open ? 1.5 : -1.0
equity := equity + pnl
peak := equity > peak ? equity : peak
dd = peak - equity
maxDD := dd > maxDD ? dd : maxDD
totalReturn = equity - 100.0
rf = maxDD > 0.01 ? totalReturn / maxDD : 0.0
var float __obs_plot0 = na
__obs_plot0 := rf
plot(rf, "RF")
