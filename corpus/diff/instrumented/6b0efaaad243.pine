
//@version=5
indicator("Price Eff")
netMove = math.abs(close - close[5])
totalMove = 0.0
for i = 0 to 4
    diff = math.abs(close[i] - close[i+1])
    if not na(diff)
        totalMove := totalMove + diff
efficiency = totalMove > 0 ? nz(netMove, 0.0) / totalMove : 0.0
var float __obs_plot0 = na
__obs_plot0 := efficiency
plot(efficiency, "Eff")
