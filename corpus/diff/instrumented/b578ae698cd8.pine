
//@version=5
indicator("UDT Fcst")
type Forecast
    float predicted = 0.0
    float actual = 0.0
    float error = 0.0

var Forecast f = Forecast.new()
f.actual := close
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
f.predicted := ema3 + (ema3 - sma5)
f.error := f.actual - f.predicted
var float __obs_plot0 = na
__obs_plot0 := f.error
plot(f.error, "Err")
