
//@version=5
indicator("Multi Ind")
var store = map.new<string, float>()
map.put(store, "sma3", ta.sma(close, 3))
map.put(store, "ema5", ta.ema(close, 5))
map.put(store, "rsi", ta.rsi(close, 3))
map.put(store, "atr", ta.atr(3))
sma = map.get(store, "sma3", 0.0)
rsi = map.get(store, "rsi", 50.0)
bullish = close > sma and rsi > 50
var float __obs_plot0 = na
__obs_plot0 := bullish ? 1 : 0
plot(bullish ? 1 : 0, "Bull")
