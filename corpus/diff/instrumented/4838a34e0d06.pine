
//@version=5
indicator("Ind Comp")
var ic = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
map.put(ic, "momentum", nz(close - close[1], 0.0))
map.put(ic, "trend", close - sma3)
map.put(ic, "osc", rsi - 50)
composite = 0.0
for [k, v] in ic
    composite := composite + v
var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "C")
