
//@version=5
indicator("Ensemble")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)

vote1 = rsi > 50 ? 1 : 0
vote2 = close > sma3 ? 1 : 0
vote3 = close > ema5 ? 1 : 0
totalVotes = vote1 + vote2 + vote3
signal = totalVotes >= 2 ? 1 : -1
var float __obs_plot0 = na
__obs_plot0 := signal
plot(signal, "S")
