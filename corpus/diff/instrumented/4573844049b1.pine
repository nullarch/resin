//@version=5
indicator("Key Store")
var keyStore = map.new<string, float>()
rsiVal = nz(ta.rsi(close, 3), 50.0)
regime = rsiVal > 70.0 ? "overbought" : rsiVal < 30.0 ? "oversold" : "neutral"
derivedKey = close * 31.0 + volume * 0.07
derivedKey := derivedKey - math.floor(derivedKey / 997.0) * 997.0
map.put(keyStore, regime, derivedKey)
storeSize = map.size(keyStore)
var float __obs_plot0 = na
__obs_plot0 := storeSize
plot(storeSize)
