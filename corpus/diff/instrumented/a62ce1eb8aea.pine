
//@version=5
indicator("UDT Defaults")
type Settings
    float rsiThreshold = 60.0
    float atrMultiplier = 2.0
    int lookback = 5
    bool useFilter = true

var Settings cfg = Settings.new()
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
signal = rsi > cfg.rsiThreshold and cfg.useFilter
stopDist = atr * cfg.atrMultiplier
var float __obs_plot0 = na
__obs_plot0 := signal ? 1 : 0
plot(signal ? 1 : 0, "Sig")
var float __obs_plot1 = na
__obs_plot1 := stopDist
plot(stopDist, "Stop")
