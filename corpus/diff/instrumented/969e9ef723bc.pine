
//@version=5
indicator("Multi Alert")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
alertcondition(rsi > 70, "OB", "RSI overbought")
alertcondition(rsi < 30, "OS", "RSI oversold")
alertcondition(ta.crossover(close, sma3), "Cross Up", "Price crossed above MA")
var float __obs_plot0 = na
__obs_plot0 := rsi
plot(rsi, "RSI")
