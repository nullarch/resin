//@version=5
indicator("VolTermStruct")
shortVol = nz(ta.stdev(close, 3), 1.0)
longVol = nz(ta.stdev(close, 7), 1.0)
termSlope = longVol > 0.001 ? shortVol / longVol : 1.0
contango = termSlope < 1.0 ? 1.0 : 0.0
var float __obs_plot0 = na
__obs_plot0 := termSlope
plot(termSlope, "Slope")
var float __obs_plot1 = na
__obs_plot1 := contango
plot(contango, "Cont")
