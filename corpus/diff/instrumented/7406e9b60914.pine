
//@version=5
indicator("Str Empty")
s = ""
isEmpty = str.length(s) == 0
s := close > open ? "bull" : "bear"
notEmpty = str.length(s) > 0
var float __obs_plot0 = na
__obs_plot0 := isEmpty ? 1 : 0
plot(isEmpty ? 1 : 0, "Was")
var float __obs_plot1 = na
__obs_plot1 := notEmpty ? 1 : 0
plot(notEmpty ? 1 : 0, "Now")
