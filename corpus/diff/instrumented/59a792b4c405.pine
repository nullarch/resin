
//@version=5
indicator("State Machine")
var int state = 0
var int transitions = 0
sma3 = ta.sma(close, 3)
prevState = state
if close > sma3 and state != 1
    state := 1
    transitions := transitions + 1
else if close < sma3 and state != -1
    state := -1
    transitions := transitions + 1
var float __obs_plot0 = na
__obs_plot0 := state
plot(state, "State")
var float __obs_plot1 = na
__obs_plot1 := transitions
plot(transitions, "Transitions")
