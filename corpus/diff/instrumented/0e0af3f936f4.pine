
//@version=5
indicator("EventQueue")
var float[] eventQ = array.new_float(0)
maxQSize = 5

if close > open
    array.push(eventQ, close)
if array.size(eventQ) > maxQSize
    array.shift(eventQ)

qLen = array.size(eventQ)
avgEvent = qLen > 0 ? array.avg(eventQ) : 0.0
var float __obs_plot0 = na
__obs_plot0 := avgEvent
plot(avgEvent, "AE")
