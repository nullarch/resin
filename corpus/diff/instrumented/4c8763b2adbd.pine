//@version=5
indicator("Var Complex")
var float maxDrawdown = 0.0
var float peak = 0.0
var float totalReturn = 0.0
var int winCount = 0
var int lossCount = 0
ret = close / close[1] - 1
if not na(ret)
    totalReturn := totalReturn + ret
    if ret > 0
        winCount := winCount + 1
    else
        lossCount := lossCount + 1
    peak := math.max(peak, totalReturn)
    dd = peak - totalReturn
    maxDrawdown := math.max(maxDrawdown, dd)
winRate = (winCount + lossCount) > 0 ? winCount / (winCount + lossCount) * 100 : 0
var float __obs_plot0 = na
__obs_plot0 := winRate
plot(winRate)
var float __obs_plot1 = na
__obs_plot1 := maxDrawdown * 100
plot(maxDrawdown * 100)
