//@version=5
indicator("Spectral Bandwidth")
float vwp = close * volume
float sumVWP = ta.sma(vwp, 5)
float sumVol = ta.sma(volume, 5)
float centroid = nz(sumVol, 1.0) > 0 ? nz(sumVWP, 0.0) / nz(sumVol, 1.0) : close
float dev = math.abs(close - centroid)
float bandwidth = ta.sma(dev, 3)
var float __obs_plot0 = na
__obs_plot0 := nz(bandwidth, 0.0)
plot(nz(bandwidth, 0.0), "Bandwidth")
