
//@version=5
indicator("Score Dist")
var float[] scores = array.new_float(0)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
score = (close > sma3 ? 1.0 : 0.0) + (rsi > 55 ? 1.0 : 0.0) + (volume > ta.sma(volume, 5) ? 1.0 : 0.0)
array.push(scores, score)
if array.size(scores) > 10
    array.shift(scores)
avgScore = array.size(scores) > 0 ? array.avg(scores) : 0.0
improving = score > avgScore
var float __obs_plot0 = na
__obs_plot0 := improving ? 1 : 0
plot(improving ? 1 : 0, "Imp")
