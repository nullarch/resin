
//@version=5
indicator("Dashboard")
var dash = map.new<string, float>()
map.put(dash, "price", close)
map.put(dash, "sma", ta.sma(close, 3))
map.put(dash, "rsi", ta.rsi(close, 3))
map.put(dash, "atr", ta.atr(3))
aboveSMA = close > map.get(dash, "sma", 0.0)
var float __obs_plot0 = na
__obs_plot0 := aboveSMA ? 1 : 0
plot(aboveSMA ? 1 : 0, "AboveSMA")
