//@version=5
indicator("BABounce")
var int bounces = 0
var int totalPairs = 0
prevClose = nz(close[1], close)
prevClose2 = nz(close[2], close)
dir1 = close - prevClose
dir2 = prevClose - prevClose2
totalPairs := totalPairs + 1
if dir1 * dir2 < 0
    bounces := bounces + 1
bouncePct = totalPairs > 0 ? float(bounces) / float(totalPairs) : 0.0
var float __obs_plot0 = na
__obs_plot0 := bouncePct
plot(bouncePct, "Bounce")
