
//@version=5
indicator("Index Search")
arr = array.from(1.0, 2.0, 3.0, 2.0, 1.0)
firstTwo = array.indexof(arr, 2.0)
lastTwo = array.lastindexof(arr, 2.0)
var float __obs_plot0 = na
__obs_plot0 := firstTwo
plot(firstTwo, "First")
var float __obs_plot1 = na
__obs_plot1 := lastTwo
plot(lastTwo, "Last")
