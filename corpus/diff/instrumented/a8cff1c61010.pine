//@version=5
indicator("Enum Compare")
enum Signal
    Buy = 1
    Sell = 2
    Hold = 0

Signal sig = Signal.Buy
var float result = 0.0
if sig == Signal.Buy
    result := 100.0
else if sig == Signal.Sell
    result := -100.0
else
    result := 0.0
var float __obs_plot0 = na
__obs_plot0 := result
plot(result)
