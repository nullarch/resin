
//@version=5
indicator("Donchian")
length = 5
upper = ta.highest(high, length)
lower = ta.lowest(low, length)
mid = (upper + lower) / 2
var float __obs_plot0 = na
__obs_plot0 := upper
plot(upper, "Upper")
var float __obs_plot1 = na
__obs_plot1 := lower
plot(lower, "Lower")
var float __obs_plot2 = na
__obs_plot2 := mid
plot(mid, "Mid")
