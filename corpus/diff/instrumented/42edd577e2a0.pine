
//@version=5
indicator("Rebal")
var float targetW = 0.5
var float currentW = 0.5
var int rebalCount = 0
drift = close > 100 ? close / 200.0 : 0.5
currentW := drift
needRebal = math.abs(currentW - targetW) > 0.1
if needRebal
    currentW := targetW
    rebalCount := rebalCount + 1
var float __obs_plot0 = na
__obs_plot0 := float(rebalCount)
plot(float(rebalCount), "RC")
