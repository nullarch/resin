//@version=5
indicator("Multi Input")
length = input.int(5, "Length")
mult = input.float(2.0, "Multiplier")
showSignal = input.bool(true, "Show")
srcType = input.string("close", "Source")
sma_ = ta.sma(close, length)
upper = sma_ + mult * ta.stdev(close, length)
var float __obs_plot0 = na
__obs_plot0 := showSignal ? upper : sma_
plot(showSignal ? upper : sma_)
