//@version=5
indicator("DegreeCent")
nodes = array.new_float(0)
array.push(nodes, close)
array.push(nodes, open)
array.push(nodes, high)
array.push(nodes, low)
threshold = 5.0
deg = array.new_float(4, 0.0)
for i = 0 to 3
    cnt = 0.0
    for j = 0 to 3
        if i != j
            diff = math.abs(array.get(nodes, i) - array.get(nodes, j))
            if diff < threshold
                cnt := cnt + 1.0
    array.set(deg, i, cnt / 3.0)
maxCent = array.max(deg)
avgCent = array.avg(deg)
var float __obs_plot0 = na
__obs_plot0 := maxCent
plot(maxCent, "MaxCent")
var float __obs_plot1 = na
__obs_plot1 := avgCent
plot(avgCent, "AvgCent")
