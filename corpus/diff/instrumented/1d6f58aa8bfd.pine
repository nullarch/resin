
//@version=5
indicator("EMA Ribbon")
ema3 = ta.ema(close, 3)
ema5 = ta.ema(close, 5)
spread = ema3 - ema5
expanding = math.abs(spread) > math.abs(spread[1])
var float __obs_plot0 = na
__obs_plot0 := spread
plot(spread, "Spread")
var float __obs_plot1 = na
__obs_plot1 := expanding ? 1 : 0
plot(expanding ? 1 : 0, "Exp")
