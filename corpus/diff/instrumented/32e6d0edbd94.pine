
//@version=5
indicator("CCI RSI Combo")
cciVal = ta.cci(close, 5)
rsiVal = ta.rsi(close, 3)
bullConfirm = cciVal > 0 and rsiVal > 50
bearConfirm = cciVal < 0 and rsiVal < 50
var int confirms = 0
if bullConfirm or bearConfirm
    confirms := confirms + 1
var float __obs_plot0 = na
__obs_plot0 := confirms
plot(confirms, "Confirms")
