
//@version=5
indicator("LB Returns")
var float[] rets = array.new_float(0)
array.clear(rets)
for i = 1 to 5
    prev = close[i]
    if not na(prev) and prev > 0
        ret = (close - prev) / prev * 100
        array.push(rets, ret)
bestRet = array.size(rets) > 0 ? array.max(rets) : 0.0
var float __obs_plot0 = na
__obs_plot0 := bestRet
plot(bestRet, "BestRet")
