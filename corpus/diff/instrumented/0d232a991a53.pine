
//@version=5
indicator("Mean Conv")
sma5 = ta.sma(close, 5)
estimate = close
alpha = 0.3
iters = 0
while math.abs(estimate - sma5) > 0.001 and iters < 50
    estimate := estimate + alpha * (sma5 - estimate)
    iters := iters + 1
var float __obs_plot0 = na
__obs_plot0 := estimate
plot(estimate, "Est")
