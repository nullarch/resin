//@version=5
indicator("DG-15 Evolute")
var float centerY = 0.0
if not na(close[2])
    dp1 = close - close[1]
    dp0 = close[1] - close[2]
    d2p = dp1 - dp0
    denom = math.pow(1.0 + dp1 * dp1, 1.5)
    kappa = denom > 0.001 ? d2p / denom : 0.0
    radius = math.abs(kappa) > 0.0001 ? 1.0 / kappa : 0.0
    normalY = 1.0 / math.max(math.sqrt(1.0 + dp1 * dp1), 0.001)
    centerY := close + radius * normalY
var float __obs_plot0 = na
__obs_plot0 := centerY
plot(centerY)
