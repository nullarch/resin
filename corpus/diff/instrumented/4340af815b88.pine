//@version=5
indicator("Dashboard", overlay=true)
var t = table.new(position.top_right, 3, 3, bgcolor=color.black)
sma5 = ta.sma(close, 5)
rsi5 = ta.rsi(close, 5)
if barstate.islast
    table.cell(t, 0, 0, "Metric", text_color=color.white)
    table.cell(t, 0, 1, "Value", text_color=color.white)
    table.cell(t, 1, 0, "SMA(5)")
    table.cell(t, 1, 1, str.tostring(sma5))
    table.cell(t, 2, 0, "RSI(5)")
    table.cell(t, 2, 1, str.tostring(rsi5))
var float __obs_plot0 = na
__obs_plot0 := close
plot(close)
