
//@version=5
indicator("MACD Zero")
[macd, sig, hist] = ta.macd(close, 3, 5, 3)
zeroCrossUp = macd > 0 and macd[1] <= 0
zeroCrossDown = macd < 0 and macd[1] >= 0
var float __obs_plot0 = na
__obs_plot0 := macd
plot(macd, "MACD")
var float __obs_plot1 = na
__obs_plot1 := zeroCrossUp ? 1 : zeroCrossDown ? -1 : 0
plot(zeroCrossUp ? 1 : zeroCrossDown ? -1 : 0, "ZeroCross")
