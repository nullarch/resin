
//@version=5
indicator("Max DD")
peak = close
maxDD = 0.0
for i = 0 to 4
    c = close[i]
    if not na(c)
        if c > peak
            peak := c
        dd = (peak - c) / peak * 100
        if dd > maxDD
            maxDD := dd
var float __obs_plot0 = na
__obs_plot0 := maxDD
plot(maxDD, "MaxDD")
