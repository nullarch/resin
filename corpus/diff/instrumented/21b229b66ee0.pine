
//@version=5
indicator("SR Full")
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
pivot = (high + low + close) / 3
r1 = 2 * pivot - lo5
s1 = 2 * pivot - hi5

range_ = hi5 - lo5
pos = range_ > 0 ? (close - lo5) / range_ : 0.5

var int resTests = 0
var int supTests = 0
atr = nz(ta.atr(3), 1.0)
if math.abs(close - hi5) < atr
    resTests := resTests + 1
if math.abs(close - lo5) < atr
    supTests := supTests + 1

var float __obs_plot0 = na
__obs_plot0 := pos
plot(pos, "Pos")
var float __obs_plot1 = na
__obs_plot1 := resTests + supTests
plot(resTests + supTests, "Tests")
