
//@version=5
indicator("Mov Med")
var float[] win = array.new_float(0)
array.push(win, close)
if array.size(win) > 5
    array.shift(win)
sorted = array.copy(win)
array.sort(sorted)
med = array.median(sorted)
deviation = close - med
var float __obs_plot0 = na
__obs_plot0 := med
plot(med, "Med")
var float __obs_plot1 = na
__obs_plot1 := deviation
plot(deviation, "Dev")
