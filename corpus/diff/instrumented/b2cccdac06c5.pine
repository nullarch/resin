
//@version=5
indicator("Round Level")
level = math.floor(close)
step = 5.0
rounded = math.floor(close / step) * step
nextUp = rounded + step
nextDown = rounded
distUp = nextUp - close
distDown = close - nextDown
nearest = distUp < distDown ? nextUp : nextDown
var float __obs_plot0 = na
__obs_plot0 := nearest
plot(nearest, "Nearest")
