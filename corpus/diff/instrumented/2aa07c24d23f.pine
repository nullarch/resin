
//@version=5
indicator("NA Safe Arith")
a = close[8]
b = close[1]
safeA = nz(a, close)
safeB = nz(b, close)
sum = safeA + safeB
diff = safeA - safeB
product = safeA * safeB / close
var float __obs_plot0 = na
__obs_plot0 := sum
plot(sum, "Sum")
var float __obs_plot1 = na
__obs_plot1 := diff
plot(diff, "Diff")
