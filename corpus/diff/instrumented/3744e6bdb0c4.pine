
//@version=5
indicator("Max GL")
var float maxGain = 0.0
var float maxLoss = 0.0
chg = close - close[1]
if not na(chg)
    if chg > maxGain
        maxGain := chg
    if chg < maxLoss
        maxLoss := chg
var float __obs_plot0 = na
__obs_plot0 := maxGain
plot(maxGain, "MaxGain")
var float __obs_plot1 = na
__obs_plot1 := maxLoss
plot(maxLoss, "MaxLoss")
