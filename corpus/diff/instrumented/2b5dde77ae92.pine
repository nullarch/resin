//@version=5
indicator("HarmRatio04")
highVal = nz(ta.highest(high, 5), high)
lowVal = nz(ta.lowest(low, 5), low)
range_ = highVal - lowVal
fib382 = lowVal + range_ * 0.382
fib618 = lowVal + range_ * 0.618
fib786 = lowVal + range_ * 0.786
harmRatio = range_ > 0 ? (close - lowVal) / range_ : 0.5
var float __obs_plot0 = na
__obs_plot0 := harmRatio
plot(harmRatio, "hr")
