
//@version=5
indicator("Risk Enum")
enum RLevel
    Critical = 4
    High = 3
    Moderate = 2
    Low = 1
    Minimal = 0

atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
volR = avgATR > 0 ? atr / avgATR : 1.0
rsiExt = math.abs(rsi - 50) / 50
combined = volR + rsiExt
level = combined > 3 ? RLevel.Critical : combined > 2.5 ? RLevel.High : combined > 1.5 ? RLevel.Moderate : combined > 0.8 ? RLevel.Low : RLevel.Minimal
var float __obs_plot0 = na
__obs_plot0 := int(level)
plot(int(level), "Lvl")
