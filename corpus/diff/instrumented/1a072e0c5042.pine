
//@version=5
indicator("Roll Sharpe")
sumRet = 0.0
sumRetSq = 0.0
cnt = 0
for i = 0 to 4
    c = close[i]
    p = close[i + 1]
    if not na(c) and not na(p) and p > 0
        ret = (c - p) / p
        sumRet := sumRet + ret
        sumRetSq := sumRetSq + ret * ret
        cnt := cnt + 1
meanRet = cnt > 0 ? sumRet / cnt : 0.0
variance = cnt > 1 ? sumRetSq / cnt - meanRet * meanRet : 0.001
sd = math.sqrt(math.max(variance, 0.0001))
sharpe = sd > 0 ? meanRet / sd : 0.0
var float __obs_plot0 = na
__obs_plot0 := sharpe
plot(sharpe, "Sharpe")
