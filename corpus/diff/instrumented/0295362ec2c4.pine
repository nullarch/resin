
//@version=5
indicator("Stat Conv")
sma5 = ta.sma(close, 5)
target = sma5 > 0 ? close / sma5 : 1.0
estimate = 1.0
steps = 0
while math.abs(estimate - target) > 0.001 and steps < 20
    estimate := estimate + (target - estimate) * 0.4
    steps := steps + 1
var float __obs_plot0 = na
__obs_plot0 := estimate
plot(estimate, "Est")
