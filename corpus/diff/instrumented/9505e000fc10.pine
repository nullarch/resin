
//@version=5
indicator("Algo Full")
var float[] window = array.new_float(0)
var data = map.new<string, float>()
array.push(window, close)
if array.size(window) > 8
    array.shift(window)

sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)

map.put(data, "trend", sma3 > sma5 ? 1.0 : -1.0)
map.put(data, "momentum", (rsi - 50) / 50)
map.put(data, "volatility", atr)

composite = 0.0
for [k, v] in data
    composite := composite + v

windowAvg = array.size(window) > 0 ? array.avg(window) : close
windowMax = array.size(window) > 0 ? array.max(window) : close
windowMin = array.size(window) > 0 ? array.min(window) : close

var int algoDecisions = 0
if composite > 1
    algoDecisions := algoDecisions + 1

var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "C")
var float __obs_plot1 = na
__obs_plot1 := algoDecisions
plot(algoDecisions, "AD")
