
//@version=5
indicator("Range Cont")
var float[] ranges = array.new_float(0)
barRange = high - low
array.push(ranges, barRange)
if array.size(ranges) > 8
    array.shift(ranges)
contracting = true
sz = array.size(ranges)
if sz > 2
    for i = 1 to math.max(sz - 1, 1)
        if i < sz and array.get(ranges, i) > array.get(ranges, i - 1) * 1.1
            contracting := false
var float __obs_plot0 = na
__obs_plot0 := contracting ? 1 : 0
plot(contracting ? 1 : 0, "C")
