
//@version=5
indicator("Stdev Bands")
basis = ta.sma(close, 5)
sd = ta.stdev(close, 5)
upper1 = basis + sd
upper2 = basis + sd * 2
lower1 = basis - sd
lower2 = basis - sd * 2
inBand = close >= lower1 and close <= upper1
var float __obs_plot0 = na
__obs_plot0 := inBand ? 1 : 0
plot(inBand ? 1 : 0, "InBand")
