
//@version=5
indicator("Covar")
var float[] prices = array.new_float(0)
var float[] volumes = array.new_float(0)
array.push(prices, close)
array.push(volumes, volume)
if array.size(prices) > 6
    array.shift(prices)
    array.shift(volumes)
cov = array.covariance(prices, volumes)
var float __obs_plot0 = na
__obs_plot0 := cov
plot(cov, "Cov")
