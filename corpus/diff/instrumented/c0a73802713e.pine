
//@version=5
indicator("StrFull")
type Report
    string header = ""
    string body = ""
    int updates = 0

var Report rpt = Report.new()
var string[] msgHistory = array.new_string(0)
var labels = map.new<string, string>()

rsi = nz(ta.rsi(close, 3), 50.0)
sma5 = ta.sma(close, 5)

dir = close > open ? "BULL" : "BEAR"
strength = rsi > 60 ? "STRONG" : rsi > 40 ? "MILD" : "WEAK"

rpt.header := "=== BAR " + str.tostring(bar_index) + " ==="
bodyParts = "RSI:" + str.tostring(rsi, "#.#")
bodyParts := bodyParts + " | Dir:" + dir
bodyParts := bodyParts + " | " + strength
rpt.body := bodyParts
rpt.updates := rpt.updates + 1

fullMsg = rpt.header + "
" + rpt.body
array.push(msgHistory, fullMsg)
if array.size(msgHistory) > 5
    array.shift(msgHistory)

map.put(labels, "direction", dir)
map.put(labels, "strength", strength)
map.put(labels, "rsi_level", rsi > 50 ? "HIGH" : "LOW")

totalChars = 0.0
for i = 0 to array.size(msgHistory) - 1
    s = array.get(msgHistory, i)
    totalChars := totalChars + float(str.length(s))

mapInfo = ""
for [k, v] in labels
    mapInfo := mapInfo + v

output = float(str.length(rpt.header)) + float(str.length(rpt.body)) + totalChars + float(str.length(mapInfo))
var float __obs_plot0 = na
__obs_plot0 := output
plot(output, "OUT")
