
//@version=5
indicator("Osc State")
var int obCount = 0
var int osCount = 0
var int crossCount = 0
rsi = nz(ta.rsi(close, 3), 50.0)
if rsi > 70
    obCount := obCount + 1
if rsi < 30
    osCount := osCount + 1
prevAbove = not na(close[1]) and nz(ta.rsi(close, 3), 50.0) > 50
currBelow = rsi < 50
if prevAbove and currBelow
    crossCount := crossCount + 1
var float __obs_plot0 = na
__obs_plot0 := crossCount
plot(crossCount, "Cx")
