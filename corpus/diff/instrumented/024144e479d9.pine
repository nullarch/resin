//@version=5
indicator("Ito Lemma")
float logPrice = close > 0 ? math.log(close) : 0.0
float prevLog = not na(close[1]) and close[1] > 0 ?
    math.log(close[1]) : logPrice
float dLogP = logPrice - prevLog
float prevC = not na(close[1]) ? close[1] : close
float simpleRet = prevC > 0 ? (close - prevC) / prevC : 0.0
float itoGap = math.abs(dLogP - simpleRet)
var float __obs_plot0 = na
__obs_plot0 := itoGap
plot(itoGap, "ItoGap")
