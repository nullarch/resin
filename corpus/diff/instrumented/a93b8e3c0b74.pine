
//@version=5
indicator("Iterative Smooth")
value = close
target = ta.sma(close, 5)
alpha = 0.3
iterations = 0
while math.abs(value - target) > 0.1 and iterations < 50
    value := value * (1 - alpha) + target * alpha
    iterations := iterations + 1
var float __obs_plot0 = na
__obs_plot0 := value
plot(value, "Smoothed")
