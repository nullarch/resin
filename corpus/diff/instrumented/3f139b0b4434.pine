
//@version=5
indicator("Price Lvl")
type PriceLevel
    float resistance = 0.0
    float support = 0.0
    float midpoint = 0.0

var PriceLevel lvl = PriceLevel.new()
lvl.resistance := ta.highest(high, 5)
lvl.support := ta.lowest(low, 5)
lvl.midpoint := (lvl.resistance + lvl.support) / 2.0
aboveMid = close > lvl.midpoint
var float __obs_plot0 = na
__obs_plot0 := aboveMid ? 1 : 0
plot(aboveMid ? 1 : 0, "Above")
