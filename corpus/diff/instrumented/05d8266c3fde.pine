
//@version=5
indicator("Reg Scan")
sma3 = ta.sma(close, 3)
bullBars = 0
bearBars = 0
for i = 0 to 4
    if not na(close[i])
        if close[i] > sma3
            bullBars := bullBars + 1
        else
            bearBars := bearBars + 1
dominance = bullBars - bearBars
var float __obs_plot0 = na
__obs_plot0 := dominance
plot(dominance, "D")
