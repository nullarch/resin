
//@version=5
indicator("LR Quality")
lr = ta.linreg(close, 5, 0)
dev = ta.stdev(close, 5)
trendQuality = dev > 0 ? math.abs(lr - close) / dev : 0.0
goodFit = trendQuality < 1.0
var float __obs_plot0 = na
__obs_plot0 := trendQuality
plot(trendQuality, "Quality")
var float __obs_plot1 = na
__obs_plot1 := goodFit ? 1 : 0
plot(goodFit ? 1 : 0, "GoodFit")
