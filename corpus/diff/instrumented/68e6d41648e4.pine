
//@version=5
indicator("Eq Hist")
var float[] eqHist = array.new_float(0)
var float equity = 10000.0
ret = close - close[1]
equity := equity + nz(ret, 0.0) * 10
array.push(eqHist, equity)
if array.size(eqHist) > 8
    array.shift(eqHist)
maxEq = array.max(eqHist)
minEq = array.min(eqHist)
ddFromPeak = maxEq > 0 ? (maxEq - equity) / maxEq * 100 : 0.0
var float __obs_plot0 = na
__obs_plot0 := ddFromPeak
plot(ddFromPeak, "DD")
