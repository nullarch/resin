
//@version=5
indicator("Risk Map FI")
var rm = map.new<string, float>()
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
ratio = avgATR > 0 ? atr / avgATR : 1.0
rsi = nz(ta.rsi(close, 3), 50.0)
map.put(rm, "vol_risk", ratio > 1.3 ? 1.0 : 0.0)
map.put(rm, "mom_risk", rsi > 70 or rsi < 30 ? 1.0 : 0.0)
map.put(rm, "trend_risk", close < ta.sma(close, 5) ? 1.0 : 0.0)
totalRisk = 0.0
for [k, v] in rm
    totalRisk := totalRisk + v
var float __obs_plot0 = na
__obs_plot0 := totalRisk
plot(totalRisk, "TR")
