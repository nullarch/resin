
//@version=5
indicator("Bar Desc")
body = math.abs(close - open)
rng = high - low
eff = rng > 0 ? body / rng : 0.0
dir = close > open ? "BULL" : "BEAR"
size = eff > 0.7 ? "BIG" : eff > 0.3 ? "MED" : "SML"
desc = dir + "_" + size
isBigBull = desc == "BULL_BIG"
var float __obs_plot0 = na
__obs_plot0 := isBigBull ? 1 : 0
plot(isBigBull ? 1 : 0, "BB")
