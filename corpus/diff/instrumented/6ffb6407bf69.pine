
//@version=5
indicator("Sig Quality")
rsi = nz(ta.rsi(close, 3), 50.0)
[m, s, h] = ta.macd(close, 3, 5, 3)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
trendOK = close > sma3
momOK = rsi > 50 and h > 0
volOK = atr < ta.sma(atr, 5) * 2
quality = (trendOK ? 1 : 0) + (momOK ? 1 : 0) + (volOK ? 1 : 0)
var float __obs_plot0 = na
__obs_plot0 := quality
plot(quality, "Qual")
