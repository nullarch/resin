
//@version=5
indicator("Trade Lbl")
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
direction = close > sma3 ? "LONG" : "SHORT"
quality = rsi > 60 and close > sma3 ? "A" : rsi > 50 ? "B" : "C"
label = direction + "_" + quality
isLongA = label == "LONG_A"
var float __obs_plot0 = na
__obs_plot0 := isLongA ? 1 : 0
plot(isLongA ? 1 : 0, "LA")
