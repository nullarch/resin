
//@version=5
indicator("UDT TA")
type Analysis
    float trend = 0.0
    float momentum = 0.0
    float volatility = 0.0

var Analysis an = Analysis.new()
an.trend := close > ta.sma(close, 3) ? 1.0 : -1.0
an.momentum := (nz(ta.rsi(close, 3), 50.0) - 50) / 50
an.volatility := nz(ta.atr(3), 1.0)
score = an.trend + an.momentum
var float __obs_plot0 = na
__obs_plot0 := score
plot(score, "S")
