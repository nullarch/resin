
//@version=5
indicator("Period Sigs")
var float[] sigs = array.new_float(0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
sig = (sma3 > sma5 ? 1.0 : -1.0) + (rsi > 50 ? 0.5 : -0.5)
array.push(sigs, sig)
if array.size(sigs) > 8
    array.shift(sigs)
avgSig = array.size(sigs) > 0 ? array.avg(sigs) : 0.0
var float __obs_plot0 = na
__obs_plot0 := avgSig
plot(avgSig, "AS")
