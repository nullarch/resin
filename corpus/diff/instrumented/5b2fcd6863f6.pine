
//@version=5
indicator("Regime Params")
var rp = map.new<string, float>()
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
isVolatile = atr > avgATR * 1.3
map.put(rp, "stop", isVolatile ? 3.0 : 2.0)
map.put(rp, "target", isVolatile ? 4.0 : 3.0)
map.put(rp, "size", isVolatile ? 0.5 : 1.0)
sizeMult = map.get(rp, "size", 1.0)
var float __obs_plot0 = na
__obs_plot0 := sizeMult
plot(sizeMult, "Size")
