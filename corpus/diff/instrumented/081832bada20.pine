//@version=5
indicator("Donchian", overlay=true)
length = 10
upper = ta.highest(high, length)
lower = ta.lowest(low, length)
mid = (upper + lower) / 2
expanding = (upper - lower) > (upper[1] - lower[1])
var float __obs_plot0 = na
__obs_plot0 := upper
plot(upper)
var float __obs_plot1 = na
__obs_plot1 := mid
plot(mid)
var float __obs_plot2 = na
__obs_plot2 := lower
plot(lower)
var float __obs_plot3 = na
__obs_plot3 := expanding ? 1.0 : 0.0
plot(expanding ? 1.0 : 0.0)
