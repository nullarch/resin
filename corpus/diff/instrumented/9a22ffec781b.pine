//@version=5
indicator("Full Indicator")
var float lastUpper = 0
var float lastLower = 0
smaVal = ta.sma(close, 3)
stdVal = ta.stdev(close, 3)
if not na(smaVal) and not na(stdVal)
    lastUpper := smaVal + 2 * stdVal
    lastLower := smaVal - 2 * stdVal
    var float __obs_plot0 = na
    __obs_plot0 := smaVal
    plot(smaVal, title="SMA")
    var float __obs_plot1 = na
    __obs_plot1 := lastUpper
    plot(lastUpper, title="Upper")
    var float __obs_plot2 = na
    __obs_plot2 := lastLower
    plot(lastLower, title="Lower")
