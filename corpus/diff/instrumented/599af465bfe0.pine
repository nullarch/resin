
//@version=5
indicator("Comp Regime")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
trendScore = sma3 > sma5 ? 1 : -1
momScore = rsi > 55 ? 1 : rsi < 45 ? -1 : 0
volScore = avgATR > 0 and atr > avgATR * 1.3 ? 1 : 0
composite = trendScore + momScore + volScore
var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "CR")
