
//@version=5
indicator("Str Map")
var labels = map.new<string, string>()
rsi = nz(ta.rsi(close, 3), 50.0)
trend = close > ta.sma(close, 3) ? "UP" : "DN"
mom = rsi > 60 ? "BULL" : rsi < 40 ? "BEAR" : "NEU"
map.put(labels, "trend", trend)
map.put(labels, "momentum", mom)
trendLabel = map.get(labels, "trend", "FLAT")
momLabel = map.get(labels, "momentum", "NEU")
combined = trendLabel + "_" + momLabel
isIdeal = combined == "UP_BULL"
var float __obs_plot0 = na
__obs_plot0 := isIdeal ? 1 : 0
plot(isIdeal ? 1 : 0, "Ideal")
