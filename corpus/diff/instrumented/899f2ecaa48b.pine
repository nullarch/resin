
//@version=5
indicator("Str Split")
tags = "BUY,TREND,MOMENTUM"
hasBuy = str.contains(tags, "BUY")
hasTrend = str.contains(tags, "TREND")
tagCount = (hasBuy ? 1 : 0) + (hasTrend ? 1 : 0)
totalLen = str.length(tags)
var float __obs_plot0 = na
__obs_plot0 := tagCount
plot(tagCount, "Tags")
var float __obs_plot1 = na
__obs_plot1 := totalLen
plot(totalLen, "Len")
