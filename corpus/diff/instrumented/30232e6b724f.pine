//@version=5
indicator("Multi plot")
sma5 = ta.sma(close, 5)
ema5 = ta.ema(close, 5)
rsi5 = ta.rsi(close, 5)
clr = close > nz(sma5) ? color.green : color.red
var float __obs_plot0 = na
__obs_plot0 := sma5
plot(sma5, "SMA", color=clr)
var float __obs_plot1 = na
__obs_plot1 := ema5
plot(ema5, "EMA")
hline(70, "OB")
hline(30, "OS")
plotshape(ta.crossover(sma5, ema5), style=shape.triangleup)
