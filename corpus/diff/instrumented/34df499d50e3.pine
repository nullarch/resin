
//@version=5
indicator("Quant System")
// TA Suite
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsiVal = ta.rsi(close, 3)
atrVal = ta.atr(3)
[macdLine, sigLine, hist] = ta.macd(close, 3, 5, 3)

// Scoring system
trendScore = close > sma3 ? 1 : -1
momScore = rsiVal > 50 ? 1 : -1
volScore = atrVal > ta.sma(atrVal, 3) ? 1 : 0
macdScore = hist > 0 ? 1 : -1
totalScore = trendScore + momScore + volScore + macdScore

// State tracking
var int bullBars = 0
var int bearBars = 0
var float maxScore = -999.0
var float minScore = 999.0
if totalScore > 0
    bullBars := bullBars + 1
else
    bearBars := bearBars + 1
if totalScore > maxScore
    maxScore := float(totalScore)
if totalScore < minScore
    minScore := float(totalScore)

// Array accumulation
var float[] scoreHistory = array.new_float(0)
array.push(scoreHistory, float(totalScore))

// Map summary
var m = map.new<string, float>()
map.put(m, "total", float(totalScore))
map.put(m, "bulls", float(bullBars))
map.put(m, "bears", float(bearBars))

var float __obs_plot0 = na
__obs_plot0 := totalScore
plot(totalScore, "Score")
var float __obs_plot1 = na
__obs_plot1 := bullBars
plot(bullBars, "Bull")
var float __obs_plot2 = na
__obs_plot2 := bearBars
plot(bearBars, "Bear")
