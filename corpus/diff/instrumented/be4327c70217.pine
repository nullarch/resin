
//@version=5
indicator("Regime Type")
enum Regime
    Trending = 2
    MeanRev = 1
    Choppy = 0

sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
aligned = (sma3 > sma5 and close > sma3) or (sma3 < sma5 and close < sma3)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
lowVol = avgATR > 0 and atr < avgATR * 0.8
regime = aligned ? Regime.Trending : lowVol ? Regime.MeanRev : Regime.Choppy
var float __obs_plot0 = na
__obs_plot0 := int(regime)
plot(int(regime), "Reg")
