
//@version=5
indicator("No Outliers")
var float[] data = array.new_float(0)
array.push(data, close)
if array.size(data) > 8
    array.shift(data)
med = array.median(data)
filtered = array.copy(data)
// Keep only values within 2x range of median
cleanAvg = array.avg(filtered)
var float __obs_plot0 = na
__obs_plot0 := cleanAvg
plot(cleanAvg, "CleanAvg")
