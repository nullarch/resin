
//@version=5
indicator("Flow Wt")
totalRange = high - low
buyPress = totalRange > 0 ? (close - low) / totalRange : 0.5
weight = buyPress > 0.7 ? 2.0 : buyPress > 0.5 ? 1.0 : buyPress > 0.3 ? 0.5 : 0.25
rsi = nz(ta.rsi(close, 3), 50.0)
signal = (rsi - 50) / 50 * weight
var float __obs_plot0 = na
__obs_plot0 := signal
plot(signal, "Sig")
