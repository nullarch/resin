
//@version=5
indicator("Roll Stats")
var float[] window = array.new_float(0)
array.push(window, close)
if array.size(window) > 8
    array.shift(window)
mean = array.avg(window)
sd = array.stdev(window)
min_ = array.min(window)
max_ = array.max(window)
range_ = max_ - min_
cv = mean > 0 ? sd / mean : 0.0
var float __obs_plot0 = na
__obs_plot0 := cv
plot(cv, "CV")
var float __obs_plot1 = na
__obs_plot1 := range_
plot(range_, "Rng")
