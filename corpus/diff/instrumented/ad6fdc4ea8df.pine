
//@version=5
indicator("Eq Curve")
type EqCurve
    float value = 10000.0
    float peak = 10000.0
    float maxDD = 0.0

var EqCurve eq = EqCurve.new()
chg = ta.change(close, 1)
eq.value := eq.value + nz(chg, 0.0) * 10
if eq.value > eq.peak
    eq.peak := eq.value
dd = eq.peak > 0 ? (eq.peak - eq.value) / eq.peak * 100 : 0.0
if dd > eq.maxDD
    eq.maxDD := dd
var float __obs_plot0 = na
__obs_plot0 := eq.value
plot(eq.value, "Equity")
var float __obs_plot1 = na
__obs_plot1 := eq.maxDD
plot(eq.maxDD, "MaxDD")
