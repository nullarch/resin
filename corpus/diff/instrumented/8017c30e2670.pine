
//@version=5
indicator("Symmetry")
mid = (high + low) / 2
upperDist = high - mid
lowerDist = mid - low
symmetry = (upperDist + lowerDist) > 0 ? math.min(upperDist, lowerDist) / math.max(upperDist, lowerDist) : 1.0
closeBias = mid > 0 ? (close - mid) / (high - low > 0 ? high - low : 1) : 0.0
var float __obs_plot0 = na
__obs_plot0 := symmetry
plot(symmetry, "Sym")
var float __obs_plot1 = na
__obs_plot1 := closeBias
plot(closeBias, "Bias")
