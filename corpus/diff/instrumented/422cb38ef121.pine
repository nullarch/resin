
//@version=5
indicator("Strat Map FI")
var sm = map.new<string, float>()
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
map.put(sm, "trend_sig", close > sma3 ? 1.0 : -1.0)
map.put(sm, "mom_sig", rsi > 55 ? 1.0 : rsi < 45 ? -1.0 : 0.0)
map.put(sm, "vol_sig", volume > ta.sma(volume, 5) ? 1.0 : 0.0)
bullSignals = 0
for [k, v] in sm
    if v > 0
        bullSignals := bullSignals + 1
var float __obs_plot0 = na
__obs_plot0 := bullSignals
plot(bullSignals, "BS")
