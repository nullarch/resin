
//@version=5
indicator("Combined")
type Metrics
    float composite = 0.0
    int count = 0

var Metrics m = Metrics.new()
var data = map.new<string, float>()
var float[] history = array.new_float(0)
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
map.put(data, "rsi", (rsi - 50) / 50)
map.put(data, "trend", close > sma3 ? 1.0 : -1.0)
map.put(data, "vol", volume > ta.sma(volume, 5) ? 1.0 : 0.0)
total = 0.0
for [k, v] in data
    total := total + v
array.push(history, total)
if array.size(history) > 5
    array.shift(history)
m.composite := array.size(history) > 0 ? array.avg(history) : 0.0
m.count := m.count + 1
var float __obs_plot0 = na
__obs_plot0 := m.composite
plot(m.composite, "C")
