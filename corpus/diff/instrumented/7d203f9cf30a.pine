
//@version=5
indicator("RSI MA Div")
rsi = ta.rsi(close, 3)
rsiMA = ta.sma(rsi, 3)
priceMA = ta.sma(close, 3)
rsiAboveMA = rsi > rsiMA
priceAboveMA = close > priceMA
divergence = (rsiAboveMA and not priceAboveMA) or (not rsiAboveMA and priceAboveMA)
var float __obs_plot0 = na
__obs_plot0 := divergence ? 1 : 0
plot(divergence ? 1 : 0, "Div")
