
//@version=5
indicator("Str Ops")
base = "Price: $100.50"
cleaned = str.replace_all(base, "$", "")
len = str.length(cleaned)
starts = str.startswith(base, "Price")
var float __obs_plot0 = na
__obs_plot0 := len
plot(len, "Len")
var float __obs_plot1 = na
__obs_plot1 := starts ? 1 : 0
plot(starts ? 1 : 0, "Starts")
