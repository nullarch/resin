
//@version=5
indicator("Reg Label")
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
trend = close > sma3 ? "UP" : "DN"
mom = rsi > 60 ? "Strong" : rsi < 40 ? "Weak" : "Neutral"
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
vol = avgATR > 0 and atr > avgATR * 1.3 ? "HiVol" : "LoVol"
label = trend + "_" + mom + "_" + vol
isBest = label == "UP_Strong_LoVol"
var float __obs_plot0 = na
__obs_plot0 := isBest ? 1 : 0
plot(isBest ? 1 : 0, "Best")
