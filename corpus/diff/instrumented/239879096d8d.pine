
//@version=5
indicator("All Pos")
changes = array.from(close - open, high - low, close - low)
allPos = array.every(changes)
anyPos = array.some(changes)
var float __obs_plot0 = na
__obs_plot0 := allPos ? 1 : 0
plot(allPos ? 1 : 0, "AllPos")
var float __obs_plot1 = na
__obs_plot1 := anyPos ? 1 : 0
plot(anyPos ? 1 : 0, "AnyPos")
