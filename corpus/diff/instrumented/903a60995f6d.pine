
//@version=5
indicator("Vol Full")
volSMA = ta.sma(volume, 5)
volRatio = volSMA > 0 ? volume / volSMA : 1.0

// OBV
var float obv = 0.0
if close > close[1]
    obv := obv + volume
else if close < close[1]
    obv := obv - volume

// Volume profile
var float[] volHist = array.new_float(0)
array.push(volHist, volume)
if array.size(volHist) > 8
    array.shift(volHist)
avgVol = array.avg(volHist)

// Volume map
var vm = map.new<string, float>()
map.put(vm, "ratio", volRatio)
map.put(vm, "obv", obv)
map.put(vm, "avg", avgVol)

// Composite
volScore = volRatio > 1.5 ? 1.0 : volRatio < 0.5 ? -1.0 : 0.0
priceScore = close > open ? 1.0 : -1.0
composite = volScore * priceScore

var int bars = 0
bars := bars + 1

var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "Comp")
var float __obs_plot1 = na
__obs_plot1 := volRatio
plot(volRatio, "VR")
