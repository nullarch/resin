
//@version=5
indicator("Trail Stop")
type TrailStop
    float stopLevel = 0.0
    float highWaterMark = 0.0
    bool active = false

var TrailStop ts = TrailStop.new()
atr = ta.atr(3)
if close > ta.sma(close, 3) and not ts.active
    ts.active := true
    ts.highWaterMark := close
    ts.stopLevel := close - atr * 2
if ts.active
    if close > ts.highWaterMark
        ts.highWaterMark := close
        ts.stopLevel := close - atr * 2
    if close < ts.stopLevel
        ts.active := false
var float __obs_plot0 = na
__obs_plot0 := ts.stopLevel
plot(ts.stopLevel, "Stop")
var float __obs_plot1 = na
__obs_plot1 := ts.active ? 1 : 0
plot(ts.active ? 1 : 0, "Active")
