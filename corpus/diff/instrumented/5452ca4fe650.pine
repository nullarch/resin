
//@version=5
indicator("Lo Close")
lo5 = ta.lowest(close, 5)
distFromLow = close - lo5
distPct = lo5 > 0 ? distFromLow / lo5 * 100 : 0.0
nearLow = distPct < 1.0
var float __obs_plot0 = na
__obs_plot0 := distPct
plot(distPct, "DistPct")
var float __obs_plot1 = na
__obs_plot1 := nearLow ? 1 : 0
plot(nearLow ? 1 : 0, "NearLow")
