
//@version=5
indicator("Nested All")
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
result = 0.0
if close > sma3
    for i = 0 to 2
        c = close[i]
        if not na(c) and c > sma3
            est = c
            j = 0
            while est > sma3 and j < 5
                est := est * 0.99
                j := j + 1
            result := result + float(j)
var float __obs_plot0 = na
__obs_plot0 := result
plot(result, "Res")
