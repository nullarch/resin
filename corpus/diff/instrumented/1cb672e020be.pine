
//@version=5
indicator("Range Hist")
var float[] ranges = array.new_float(0)
rng = high - low
array.push(ranges, rng)
if array.size(ranges) > 8
    array.shift(ranges)
avgRange = array.avg(ranges)
isWide = rng > avgRange * 1.5
isNarrow = rng < avgRange * 0.5
var float __obs_plot0 = na
__obs_plot0 := isWide ? 1 : isNarrow ? -1 : 0
plot(isWide ? 1 : isNarrow ? -1 : 0, "Width")
