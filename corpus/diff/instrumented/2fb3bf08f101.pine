//@version=5
indicator("NS-10 Bernoulli")
var float kinetic = 0.0
if not na(close[1])
    vel = close - close[1]
    kinetic := 0.5 * vel * vel
potential = close / 100.0
pressureE = volume / 10000.0
totalEnergy = kinetic + potential + pressureE
var float __obs_plot0 = na
__obs_plot0 := totalEnergy
plot(totalEnergy)
