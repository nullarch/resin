//@version=5
indicator("Comprehensive 55")

// NaN propagation
float nan_val = na
float nan_add = nan_val + 1.0
var bool nan_check = false
nan_check := na(nan_add)

// var state persistence
var float counter = 0.0
counter := counter + 1.0

// Series history
prev_close = close[1]
var float hist_diff = 0.0
hist_diff := close - nz(prev_close, close)

// TA chaining
ema3 = ta.ema(close, 3)
sma_ema = ta.sma(ema3, 3)

// nz coalescing
float x = na
float safe = nz(x, 99.0)

// Color literal
c = #FF0000

// Division safety
float div_result = 10.0 / 0.0
var bool div_nan = false
div_nan := na(div_result)

var float result = 0.0
result := counter + safe + nz(sma_ema, 0.0)
var float __obs_plot0 = na
__obs_plot0 := close
plot(close, color=c)
