
//@version=5
indicator("Pin Bar")
bodySize = math.abs(close - open_)
fullRange = high - low
upperWick = high - math.max(close, open_)
lowerWick = math.min(close, open_) - low
isHammer = fullRange > 0 and lowerWick > bodySize * 2 and upperWick < bodySize * 0.5
isStar = fullRange > 0 and upperWick > bodySize * 2 and lowerWick < bodySize * 0.5
var float __obs_plot0 = na
__obs_plot0 := isHammer ? 1 : isStar ? -1 : 0
plot(isHammer ? 1 : isStar ? -1 : 0, "Pin")
