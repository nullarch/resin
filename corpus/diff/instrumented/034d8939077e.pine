
//@version=5
indicator("MTF Confirm")
fastMA = ta.sma(close, 3)
slowMA = ta.sma(close, 5)
rsi = ta.rsi(close, 3)
confirmed = false
if close > fastMA
    if fastMA > slowMA
        if rsi > 45
            confirmed := true
var float __obs_plot0 = na
__obs_plot0 := confirmed ? 1 : 0
plot(confirmed ? 1 : 0, "Confirmed")
