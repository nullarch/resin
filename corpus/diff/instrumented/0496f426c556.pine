
//@version=5
indicator("Single Elem")
var float[] single = array.new_float(0)
array.clear(single)
array.push(single, close)
avg = array.avg(single)
maxV = array.max(single)
minV = array.min(single)
allSame = avg == maxV and maxV == minV
var float __obs_plot0 = na
__obs_plot0 := allSame ? 1 : 0
plot(allSame ? 1 : 0, "S")
