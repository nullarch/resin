//@version=5
indicator("ArrHist15")
var float est = 100.0
est := est + 0.3 * (close - est)
history = array.new_float(0)
for i = 0 to 4
    array.push(history, est + float(i) * 0.01)
histMean = array.sum(history) / math.max(float(array.size(history)), 1.0)
var float __obs_plot0 = na
__obs_plot0 := histMean
plot(histMean, "hm")
