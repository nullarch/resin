//@version=5
indicator("SeqBF")
var float bayesFactor = 1.0
retVal = close - nz(close[1], close)
sigma = math.max(high - low, 0.01)
lhoodTrend = math.exp(math.max(-(retVal - 0.5) * (retVal - 0.5) / (2.0 * sigma * sigma), -20.0))
lhoodFlat = math.exp(math.max(-retVal * retVal / (2.0 * sigma * sigma), -20.0))
ratio = lhoodFlat > 0.0001 ? lhoodTrend / lhoodFlat : 1.0
bayesFactor := bayesFactor * ratio
bfClamp = math.max(0.001, math.min(1000.0, bayesFactor))
var float __obs_plot0 = na
__obs_plot0 := bfClamp
plot(bfClamp, "BF")
