//@version=5
indicator("State Machine")
var int state = 0
var float trigger_price = 0.0
if state == 0
    if close > 105
        state := 1
        trigger_price := close
else if state == 1
    if close < trigger_price - 2
        state := 2
else
    state := 0
var int final_state = 0
final_state := state
var float __obs_plot0 = na
__obs_plot0 := close
plot(close)
