indicator("Str Arr")
var string[] labels = array.new_string(0)
lbl = close > open ? "green" : "red"
array.push(labels, lbl)
if array.size(labels) > 5
    array.shift(labels)
lastLabel = array.last(labels)
isGreen = lastLabel == "green"
var float __obs_plot0 = na
__obs_plot0 := isGreen ? 1 : 0
plot(isGreen ? 1 : 0, "Green")
