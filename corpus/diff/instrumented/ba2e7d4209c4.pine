
//@version=5
indicator("Run MinMax")
var float[] window = array.new_float(0)
array.push(window, close)
if array.size(window) > 6
    array.shift(window)
mn = array.min(window)
mx = array.max(window)
midpoint = (mn + mx) / 2.0
var float __obs_plot0 = na
__obs_plot0 := midpoint
plot(midpoint, "Mid")
var float __obs_plot1 = na
__obs_plot1 := mx - mn
plot(mx - mn, "Range")
