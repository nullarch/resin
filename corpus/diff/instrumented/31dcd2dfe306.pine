
//@version=5
indicator("Counter Reset")
var int counter = 0
var int resets = 0
counter := counter + 1
sma3 = ta.sma(close, 3)
if ta.crossover(close, sma3)
    resets := resets + 1
    counter := 0
var float __obs_plot0 = na
__obs_plot0 := counter
plot(counter, "Counter")
var float __obs_plot1 = na
__obs_plot1 := resets
plot(resets, "Resets")
