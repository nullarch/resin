//@version=5
indicator("ClusterCoeff")
n = array.new_float(0)
array.push(n, close)
array.push(n, open)
array.push(n, high)
array.push(n, low)
thresh = 6.0
neighbors = array.new_int(0)
for j = 1 to 3
    if math.abs(array.get(n, 0) - array.get(n, j)) < thresh
        array.push(neighbors, j)
k = array.size(neighbors)
triCount = 0.0
if k >= 2
    for i = 0 to k - 2
        for j = i + 1 to k - 1
            ni = array.get(neighbors, i)
            nj = array.get(neighbors, j)
            if math.abs(array.get(n, ni) - array.get(n, nj)) < thresh
                triCount := triCount + 1.0
maxTri = k >= 2 ? float(k) * (float(k) - 1.0) / 2.0 : 1.0
cc = maxTri > 0.0 ? triCount / maxTri : 0.0
var float __obs_plot0 = na
__obs_plot0 := cc
plot(cc, "CC")
