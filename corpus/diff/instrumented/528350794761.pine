
//@version=5
indicator("All Math")
ret = close[1] > 0 ? close / close[1] - 1 : 0.0
logRet = ret > -1 ? math.log(1 + ret) : 0.0
absRet = math.abs(ret)
sqrtAbs = math.sqrt(absRet)
powRet = math.pow(absRet, 2)
maxV = math.max(ret, 0.0)
minV = math.min(ret, 0.0)
rounded = math.round(ret * 10000) / 10000
clamped = math.max(math.min(ret, 0.1), -0.1)
sign = ret > 0 ? 1 : ret < 0 ? -1 : 0
var float __obs_plot0 = na
__obs_plot0 := clamped * 100
plot(clamped * 100, "C")
