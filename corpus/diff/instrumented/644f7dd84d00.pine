
//@version=5
indicator("Price Dist")
totalDist = 0.0
count = 0
sma5 = ta.sma(close, 5)
for i = 0 to 4
    c = close[i]
    if not na(c)
        totalDist := totalDist + math.abs(c - sma5)
        count := count + 1
avgDist = count > 0 ? totalDist / count : 0.0
var float __obs_plot0 = na
__obs_plot0 := avgDist
plot(avgDist, "Dist")
