
//@version=5
indicator("Mov Median")
var float[] window = array.new_float(0)
array.push(window, close)
if array.size(window) > 5
    array.shift(window)
med = array.median(window)
devFromMed = close - med
var float __obs_plot0 = na
__obs_plot0 := med
plot(med, "Median")
var float __obs_plot1 = na
__obs_plot1 := devFromMed
plot(devFromMed, "Dev")
