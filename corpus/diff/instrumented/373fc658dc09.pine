
//@version=5
indicator("Flow Thresh")
totalRange = high - low
buyPress = totalRange > 0 ? (close - low) / totalRange : 0.5
threshold = 0.9
steps = 0
while threshold > buyPress and steps < 15
    threshold := threshold - 0.1
    steps := steps + 1
var float __obs_plot0 = na
__obs_plot0 := steps
plot(steps, "St")
