//@version=5
indicator("Vortex Shedding")
var float vortex = 0.0
var float phase = 0.0
strouhal = 0.21
velocity = math.abs(close - open)
diameter = high - low
frequency = diameter > 0 ? strouhal * velocity / diameter : 0.0
phase := phase + frequency * 0.5
vortex := math.sin(phase) * velocity
var float __obs_plot0 = na
__obs_plot0 := vortex
plot(vortex)
