//@version=5
indicator("RSI Div")
rsi_ = ta.rsi(close, 5)
rsiPrev = rsi_[1]
pricePrev = close[1]
// Bullish divergence: price lower low, RSI higher low
var int divSignal = 0
if not na(rsi_) and not na(rsiPrev)
    if close < nz(pricePrev) and rsi_ > nz(rsiPrev)
        divSignal := 1
    else if close > nz(pricePrev) and rsi_ < nz(rsiPrev)
        divSignal := -1
    else
        divSignal := 0
var float __obs_plot0 = na
__obs_plot0 := divSignal
plot(divSignal)
