
//@version=5
indicator("Lin Reg")
sumX = 0.0
sumY = 0.0
sumXY = 0.0
sumX2 = 0.0
n = 5
for i = 0 to 4
    c = close[i]
    if not na(c)
        x = float(4 - i)
        sumX := sumX + x
        sumY := sumY + c
        sumXY := sumXY + x * c
        sumX2 := sumX2 + x * x
denom = n * sumX2 - sumX * sumX
slope = denom != 0 ? (n * sumXY - sumX * sumY) / denom : 0.0
var float __obs_plot0 = na
__obs_plot0 := slope
plot(slope, "Slope")
