
//@version=5
indicator("SMA Fan")
s3 = ta.sma(close, 3)
s5 = ta.sma(close, 5)
s8 = ta.sma(close, 8)
fanWidth = s3 - s8
expanding = math.abs(fanWidth) > math.abs(fanWidth[1])
var float __obs_plot0 = na
__obs_plot0 := fanWidth
plot(fanWidth, "Width")
var float __obs_plot1 = na
__obs_plot1 := expanding ? 1 : 0
plot(expanding ? 1 : 0, "Exp")
