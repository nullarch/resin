
//@version=5
indicator("Dyn Map")
var dm = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
if rsi > 55
    map.put(dm, "signal", 1.0)
else if rsi < 45
    map.put(dm, "signal", -1.0)
else
    map.put(dm, "signal", 0.0)
total = 0.0
for [k, v] in dm
    total := total + v
var float __obs_plot0 = na
__obs_plot0 := total
plot(total, "Tot")
