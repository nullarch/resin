
//@version=5
indicator("Enum Int")
enum Signal
    StrongBuy = 2
    Buy = 1
    Neutral = 0
    Sell = -1
    StrongSell = -2

rsiVal = ta.rsi(close, 3)
sig = rsiVal > 70 ? Signal.StrongBuy : rsiVal > 55 ? Signal.Buy : rsiVal < 30 ? Signal.StrongSell : rsiVal < 45 ? Signal.Sell : Signal.Neutral
score = int(sig)
var float __obs_plot0 = na
__obs_plot0 := score
plot(score, "Score")
