
//@version=5
indicator("Adapt Params")
var params = map.new<string, float>()
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
ratio = avgATR > 0 ? atr / avgATR : 1.0
map.put(params, "stop_mult", ratio > 1.5 ? 3.0 : 2.0)
map.put(params, "target_mult", ratio > 1.5 ? 4.5 : 3.0)
map.put(params, "position_pct", ratio > 1.5 ? 0.5 : 1.0)
stopM = map.get(params, "stop_mult", 2.0)
var float __obs_plot0 = na
__obs_plot0 := stopM
plot(stopM, "StopMult")
