
//@version=5
indicator("C250 Ultimate")
type MasterSystem
    float composite = 0.0
    int decisions = 0
    float peak = -999.0

var MasterSystem ms = MasterSystem.new()
var analytics = map.new<string, float>()
var float[] history = array.new_float(0)

sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema3 = ta.ema(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
stoch = ta.stoch(close, high, low, 5)
[macdL, sigL, histL] = ta.macd(close, 3, 5, 3)
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)

map.put(analytics, "trend", sma5 > 0 ? (sma3 - sma5) / sma5 * 100 : 0.0)
map.put(analytics, "momentum", (rsi - 50) / 50 * 30)
map.put(analytics, "stoch", (stoch - 50) / 50 * 20)
map.put(analytics, "macd", histL > 0 ? 10.0 : -10.0)
map.put(analytics, "position", hi5 > lo5 ? (close - lo5) / (hi5 - lo5) * 20 - 10 : 0.0)

composite = 0.0
for [k, v] in analytics
    composite := composite + v
composite := composite / 5

volAdj = avgATR > 0 and atr / avgATR > 1.5 ? 0.5 : 1.0
finalScore = composite * volAdj

array.push(history, finalScore)
if array.size(history) > 10
    array.shift(history)

ms.composite := finalScore
ms.peak := math.max(ms.peak, finalScore)
if finalScore > 3
    ms.decisions := ms.decisions + 1

avgHist = array.size(history) > 0 ? array.avg(history) : 0.0
improving = finalScore > avgHist

trendLabel = ms.composite > 0 ? "BULL" : "BEAR"
confidence = math.abs(ms.composite) > 5 ? "HIGH" : "LOW"
fullLabel = trendLabel + "_" + confidence

var float __obs_plot0 = na
__obs_plot0 := ms.composite
plot(ms.composite, "Score")
var float __obs_plot1 = na
__obs_plot1 := ms.decisions
plot(ms.decisions, "Dec")
var float __obs_plot2 = na
__obs_plot2 := improving ? 1 : 0
plot(improving ? 1 : 0, "Imp")
