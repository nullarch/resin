//@version=5
indicator("Median Survival")
float hazRate = 0.08
var float surv = 1.0
surv := surv * (1.0 - hazRate)
var int medianBar = 0
var bool crossedHalf = false
if surv < 0.5 and not crossedHalf
    medianBar := bar_index
    crossedHalf := true
var float __obs_plot0 = na
__obs_plot0 := medianBar
plot(medianBar, "MedianBar")
