//@version=5
indicator("Donchian")
length = 5
upper = ta.highest(high, length)
lower = ta.lowest(low, length)
basis = (upper + lower) / 2
var float __obs_plot0 = na
__obs_plot0 := basis
plot(basis)
var float __obs_plot1 = na
__obs_plot1 := upper
plot(upper)
var float __obs_plot2 = na
__obs_plot2 := lower
plot(lower)
