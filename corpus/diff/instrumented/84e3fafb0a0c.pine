
//@version=5
indicator("Port UDT")
type Portfolio
    float value = 10000.0
    float peak = 10000.0
    float maxDD = 0.0

var Portfolio pf = Portfolio.new()
ret = close[1] > 0 ? (close - close[1]) / close[1] : 0.0
pf.value := pf.value * (1 + nz(ret, 0.0))
pf.peak := math.max(pf.peak, pf.value)
dd = pf.peak > 0 ? (pf.peak - pf.value) / pf.peak * 100 : 0.0
pf.maxDD := math.max(pf.maxDD, dd)
var float __obs_plot0 = na
__obs_plot0 := pf.maxDD
plot(pf.maxDD, "MDD")
