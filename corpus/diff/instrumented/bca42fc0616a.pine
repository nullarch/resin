
//@version=5
indicator("Sortino")
var float[] rets = array.new_float(0)
ret = close - close[1]
if not na(ret)
    array.push(rets, ret)
if array.size(rets) > 8
    array.shift(rets)
avg = array.avg(rets)
negSum = 0.0
negCount = 0
for v in rets
    if v < 0
        negSum := negSum + v * v
        negCount := negCount + 1
downDev = negCount > 0 ? math.sqrt(negSum / negCount) : 0.0
sortino = downDev > 0 ? avg / downDev : 0.0
var float __obs_plot0 = na
__obs_plot0 := sortino
plot(sortino, "Sort")
