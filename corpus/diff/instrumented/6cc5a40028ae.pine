
//@version=5
indicator("Converge Det")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
gap = math.abs(sma3 - sma5)
prevGap = math.abs(sma3[1] - sma5[1])
converging = gap < nz(prevGap, gap)
convergenceRate = nz(prevGap, 0.0) > 0 ? gap / prevGap : 1.0
var float __obs_plot0 = na
__obs_plot0 := gap
plot(gap, "Gap")
var float __obs_plot1 = na
__obs_plot1 := converging ? 1 : 0
plot(converging ? 1 : 0, "Conv")
