
//@version=5
indicator("BB %B")
[mid, upper, lower] = ta.bb(close, 5, 2.0)
bandwidth = upper - lower
pctB = bandwidth != 0 ? (close - lower) / bandwidth : 0.5
extreme = pctB > 1.0 or pctB < 0.0
var float __obs_plot0 = na
__obs_plot0 := pctB
plot(pctB, "PctB")
var float __obs_plot1 = na
__obs_plot1 := extreme ? 1 : 0
plot(extreme ? 1 : 0, "Extreme")
