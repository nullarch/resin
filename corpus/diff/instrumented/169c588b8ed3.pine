
//@version=5
indicator("RSI Div Scan")
rsi = ta.rsi(close, 3)
priceUp = close > close[2]
rsiDown = rsi < rsi[2]
bearDiv = priceUp and rsiDown
priceDown = close < close[2]
rsiUp = rsi > rsi[2]
bullDiv = priceDown and rsiUp
var float __obs_plot0 = na
__obs_plot0 := bearDiv ? -1 : bullDiv ? 1 : 0
plot(bearDiv ? -1 : bullDiv ? 1 : 0, "Div")
