
//@version=5
indicator("Math Chain")
ret = close[1] > 0 ? (close - close[1]) / close[1] : 0.0
logRet = ret > -1 ? math.log(1 + ret) : -10.0
absLog = math.abs(logRet)
sqrtAbs = math.sqrt(absLog)
scaled = math.round(sqrtAbs * 1000) / 1000
clamped = math.max(math.min(scaled, 1.0), 0.0)
var float __obs_plot0 = na
__obs_plot0 := clamped
plot(clamped, "C")
