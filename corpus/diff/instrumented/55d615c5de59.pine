//@version=5
indicator("ConvergeFull")
var int gen = 0
var float prevAvgFit = 0.0
gen := gen + 1
pop = array.new_float(0)
for i = 0 to 5
    gene = close + float(i) * math.sin(float(gen) + float(i))
    array.push(pop, gene)
fitArr = array.new_float(0)
for [idx, g] in pop
    dist = math.abs(g - 107.0)
    fit = 1.0 / math.max(dist, 0.01)
    array.push(fitArr, fit)
avgFit = array.avg(fitArr)
bestFit = array.max(fitArr)
improvement = math.abs(avgFit - prevAvgFit)
converged = improvement < 0.001 ? 1.0 : 0.0
prevAvgFit := avgFit
var float __obs_plot0 = na
__obs_plot0 := bestFit
plot(bestFit, "BestFit")
var float __obs_plot1 = na
__obs_plot1 := converged
plot(converged, "Conv")
