
//@version=5
indicator("Level Scan")
maxHigh = high
minLow = low
for i = 1 to 5
    if not na(high[i])
        maxHigh := math.max(maxHigh, high[i])
    if not na(low[i])
        minLow := math.min(minLow, low[i])
rangeVal = maxHigh - minLow
var float __obs_plot0 = na
__obs_plot0 := rangeVal
plot(rangeVal, "R")
