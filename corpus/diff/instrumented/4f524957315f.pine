
//@version=5
indicator("RSI BB")
rsi = ta.rsi(close, 3)
rsiBasis = ta.sma(rsi, 5)
rsiDev = ta.stdev(rsi, 5)
rsiUpper = rsiBasis + 2 * rsiDev
rsiLower = rsiBasis - 2 * rsiDev
extreme = rsi > rsiUpper or rsi < rsiLower
var float __obs_plot0 = na
__obs_plot0 := rsi
plot(rsi, "RSI")
var float __obs_plot1 = na
__obs_plot1 := extreme ? 1 : 0
plot(extreme ? 1 : 0, "Extreme")
