//@version=5
indicator("PredCorr02")
var float state = 100.0
var float velocity = 0.0
predicted = state + velocity
innovation = close - predicted
kGain = 0.3
state := predicted + kGain * innovation
velocity := velocity + 0.1 * innovation
var float __obs_plot0 = na
__obs_plot0 := state
plot(state, "st")
