
//@version=5
indicator("RP Wt")
atr = nz(ta.atr(3), 1.0)
vol1 = atr
vol2 = nz(ta.stdev(close, 5), 1.0)
totalInvVol = (vol1 > 0 ? 1.0 / vol1 : 0.0) + (vol2 > 0 ? 1.0 / vol2 : 0.0)
w1 = totalInvVol > 0 ? (vol1 > 0 ? 1.0 / vol1 : 0.0) / totalInvVol : 0.5
w2 = 1.0 - w1
var float __obs_plot0 = na
__obs_plot0 := w1
plot(w1, "W1")
