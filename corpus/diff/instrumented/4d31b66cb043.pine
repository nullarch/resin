
//@version=5
indicator("Hist Bins")
sma5 = ta.sma(close, 5)
diff = close - sma5
bin = 0
for i = -3 to 3
    lowerBound = float(i) * 0.5
    upperBound = float(i + 1) * 0.5
    if diff >= lowerBound and diff < upperBound
        bin := i
var float __obs_plot0 = na
__obs_plot0 := bin
plot(bin, "Bin")
