//@version=5
indicator("For Step Boundary")
float r1 = 0.0
// step = range, should execute twice (0 and 5)
for i = 0 to 5 by 5
    r1 := r1 + i
// 0 + 5 = 5
var float last_r1 = 0.0
last_r1 := r1

float r2 = 0.0
// single step covers range
for i = 0 to 1 by 10
    r2 := r2 + i
// just 0
var float last_r2 = 0.0
last_r2 := r2
var float __obs_plot0 = na
__obs_plot0 := close
plot(close)
