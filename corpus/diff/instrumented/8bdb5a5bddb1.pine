//@version=5
indicator("Persist ATR")
float atrVal = nz(ta.atr(3), 1.0)
float smaVal = ta.sma(close, 3)
float normDev = atrVal > 0 ? math.abs(close - smaVal) / atrVal : 0.0
var float maxPersist = 0.0
if normDev > maxPersist
    maxPersist := normDev
var float __obs_plot0 = na
__obs_plot0 := maxPersist
plot(maxPersist, "MaxPersist")
