
//@version=5
indicator("MA Spread")
var float[] spreads = array.new_float(0)
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
spread = ema3 - sma5
array.push(spreads, spread)
if array.size(spreads) > 6
    array.shift(spreads)
avgSpread = array.avg(spreads)
expanding = spread > avgSpread
var float __obs_plot0 = na
__obs_plot0 := spread
plot(spread, "Sp")
var float __obs_plot1 = na
__obs_plot1 := expanding ? 1 : 0
plot(expanding ? 1 : 0, "Exp")
