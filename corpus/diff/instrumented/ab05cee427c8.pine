
//@version=5
indicator("MinMax Pos")
var float[] window = array.new_float(0)
array.push(window, close)
if array.size(window) > 6
    array.shift(window)
maxVal = array.max(window)
minVal = array.min(window)
maxIdx = array.indexof(window, maxVal)
minIdx = array.indexof(window, minVal)
maxRecent = maxIdx > minIdx
var float __obs_plot0 = na
__obs_plot0 := maxRecent ? 1 : 0
plot(maxRecent ? 1 : 0, "MaxR")
