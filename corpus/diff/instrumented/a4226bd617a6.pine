
//@version=5
indicator("Risk Check")
riskScore = 0.0
atr = ta.atr(3)
rsi = nz(ta.rsi(close, 3), 50.0)
checks = 0
maxChecks = 5
while checks < maxChecks
    if checks == 0 and atr > ta.sma(atr, 5)
        riskScore := riskScore + 1.0
    if checks == 1 and rsi > 70
        riskScore := riskScore + 1.0
    if checks == 2 and rsi < 30
        riskScore := riskScore + 1.0
    if checks == 3 and close > ta.highest(high, 5) * 0.99
        riskScore := riskScore + 0.5
    if checks == 4 and close < ta.lowest(low, 5) * 1.01
        riskScore := riskScore + 0.5
    checks := checks + 1
var float __obs_plot0 = na
__obs_plot0 := riskScore
plot(riskScore, "Risk")
