//@version=5
indicator("Bioavailability")
totalDose = high - low
absorbedDose = close - low
bioavail = totalDose > 0 ? absorbedDose / totalDose : 0.0
smaBA = ta.sma(close, 3)
normalized = not na(smaBA) and smaBA > 0 ? bioavail * 100.0 : 50.0
var float __obs_plot0 = na
__obs_plot0 := normalized
plot(normalized)
