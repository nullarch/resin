//@version=5
indicator("FE10")
var int signals = 0
cciVal = nz(ta.cci(close, 5), 0.0)
roundedCci = math.round(cciVal)
zeroLine = 0.0
if cciVal > 100
    signals := signals + 1
else
    if cciVal < -100
        signals := signals - 1
var float __obs_plot0 = na
__obs_plot0 := roundedCci
plot(roundedCci, title="cci")
