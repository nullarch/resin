
//@version=5
indicator("Power")
sqr = math.pow(close - open, 2)
cube = math.pow(math.abs(close - open), 3)
sqrtVal = math.sqrt(sqr)
cbrtProxy = math.pow(math.abs(cube), 1.0/3.0)
var float __obs_plot0 = na
__obs_plot0 := sqrtVal
plot(sqrtVal, "Sqrt")
var float __obs_plot1 = na
__obs_plot1 := cbrtProxy
plot(cbrtProxy, "Cbrt")
