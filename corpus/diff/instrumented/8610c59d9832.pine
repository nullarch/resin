
//@version=5
indicator("MinMax Norm")
hi8 = ta.highest(close, 8)
lo8 = ta.lowest(close, 8)
rng = hi8 - lo8
normalized = rng > 0 ? (close - lo8) / rng : 0.5
scaled = normalized * 2.0 - 1.0
var float __obs_plot0 = na
__obs_plot0 := normalized
plot(normalized, "Norm")
var float __obs_plot1 = na
__obs_plot1 := scaled
plot(scaled, "Scaled")
