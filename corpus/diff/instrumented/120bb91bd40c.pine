
//@version=5
indicator("Bracket")
atr = ta.atr(3)
entry = close
stopDist = atr * 2
targetDist = atr * 3
stop = entry - stopDist
target = entry + targetDist
rr = stopDist > 0 ? targetDist / stopDist : 0.0
var float __obs_plot0 = na
__obs_plot0 := rr
plot(rr, "RR")
var float __obs_plot1 = na
__obs_plot1 := stop
plot(stop, "Stop")
