
//@version=5
indicator("Multi Plot")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
spread = sma3 - sma5
var float __obs_plot0 = na
__obs_plot0 := spread
plot(spread, "Spread")
var float __obs_plot1 = na
__obs_plot1 := rsi
plot(rsi, "RSI")
var float __obs_plot2 = na
__obs_plot2 := atr
plot(atr, "ATR")
