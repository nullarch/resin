
//@version=5
indicator("Index Filter")
arr = array.from(10.0, 20.0, 30.0, 40.0, 50.0)
evenSum = 0.0
oddSum = 0.0
for [i, val] in arr
    if i % 2 == 0
        evenSum := evenSum + val
    else
        oddSum := oddSum + val
var float __obs_plot0 = na
__obs_plot0 := evenSum
plot(evenSum, "Even")
var float __obs_plot1 = na
__obs_plot1 := oddSum
plot(oddSum, "Odd")
