//@version=5
indicator("Cycle 123 Comprehensive", overlay=true)
type Analysis
    float momentum = 0.0
    float volatility = 0.0
    string trend = "neutral"
    int strength = 0
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema5 = ta.ema(close, 5)
rsi5 = ta.rsi(close, 5)
atr3 = ta.atr(3)
[bbU, bbM, bbL] = ta.bb(close, 5, 2.0)
var arr = array.new_float(0)
var m = map.new<string, float>()
var int totalBars = 0
var float maxMom = 0.0
a = Analysis.new()
if not na(sma3) and not na(sma5)
    a.momentum := nz(sma3) - nz(sma5)
    a.trend := a.momentum > 0 ? "bullish" : "bearish"
    a.strength := 0
    if close > nz(sma3)
        a.strength := a.strength + 1
    if close > nz(ema5)
        a.strength := a.strength + 1
    if not na(rsi5) and nz(rsi5) > 50
        a.strength := a.strength + 1
if not na(atr3)
    a.volatility := nz(atr3)
if math.abs(a.momentum) > maxMom
    maxMom := math.abs(a.momentum)
array.push(arr, close)
if array.size(arr) > 5
    array.shift(arr)
map.put(m, "mom", a.momentum)
map.put(m, "vol", a.volatility)
var float __obs_plot0 = na
__obs_plot0 := sma3
plot(sma3, "Fast")
var float __obs_plot1 = na
__obs_plot1 := sma5
plot(sma5, "Slow")
totalBars := totalBars + 1
