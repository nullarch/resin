//@version=5
indicator("C300-09")
var float smoothed = 0.0
volRatio = volume > 0 ? volume / 1000.0 : 1.0
alpha = 2.0 / (3.0 + 1.0)
adjusted = alpha * volRatio
adjusted := math.min(adjusted, 0.9)
adjusted := math.max(adjusted, 0.1)
smoothed := smoothed * (1.0 - adjusted) + close * adjusted
var float __obs_plot0 = na
__obs_plot0 := smoothed
plot(smoothed)
