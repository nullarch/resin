
//@version=5
indicator("Osc Report")
rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
rsiLabel = rsi > 70 ? "OB" : rsi < 30 ? "OS" : "OK"
stochLabel = k > 80 ? "OB" : k < 20 ? "OS" : "OK"
report = "RSI:" + rsiLabel + " STK:" + stochLabel
allOK = rsiLabel == "OK" and stochLabel == "OK"
var float __obs_plot0 = na
__obs_plot0 := allOK ? 1 : 0
plot(allOK ? 1 : 0, "OK")
