
//@version=5
indicator("Decay")
halfLife = 5.0
decayRate = math.log(2.0) / halfLife
decay1 = math.exp(-decayRate * 1)
decay3 = math.exp(-decayRate * 3)
decay5 = math.exp(-decayRate * 5)
var float __obs_plot0 = na
__obs_plot0 := decay1
plot(decay1, "D1")
var float __obs_plot1 = na
__obs_plot1 := decay5
plot(decay5, "D5")
