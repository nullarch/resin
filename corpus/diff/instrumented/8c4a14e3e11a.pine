
//@version=5
indicator("Map+Array")
var scores = map.new<string, float>()
var float[] history = array.new_float(0)
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
map.put(scores, "trend", close > sma3 ? 1.0 : -1.0)
map.put(scores, "mom", (rsi - 50) / 50)
total = 0.0
for [k, v] in scores
    total := total + v
array.push(history, total)
if array.size(history) > 8
    array.shift(history)
avg = array.size(history) > 0 ? array.avg(history) : 0.0
var float __obs_plot0 = na
__obs_plot0 := avg
plot(avg, "A")
