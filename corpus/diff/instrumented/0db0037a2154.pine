
//@version=5
indicator("Band Brk")
var float[] breaks = array.new_float(0)
sma5 = ta.sma(close, 5)
atr = nz(ta.atr(3), 1.0)
upper = sma5 + atr * 1.5
lower = sma5 - atr * 1.5
if close > upper
    array.push(breaks, 1.0)
if close < lower
    array.push(breaks, -1.0)
if array.size(breaks) > 10
    array.shift(breaks)
bullBreaks = 0
for i = 0 to math.max(array.size(breaks) - 1, 0)
    if i < array.size(breaks) and array.get(breaks, i) > 0
        bullBreaks := bullBreaks + 1
var float __obs_plot0 = na
__obs_plot0 := bullBreaks
plot(bullBreaks, "BB")
