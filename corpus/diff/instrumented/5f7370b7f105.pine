
//@version=5
indicator("Trade Result")
type TradeResult
    float entryPrice = 0.0
    float exitPrice = 0.0
    float pnl = 0.0
    bool isWin = false

var TradeResult lastTrade = TradeResult.new()
sma3 = ta.sma(close, 3)
if ta.crossover(close, sma3)
    lastTrade.entryPrice := close
if ta.crossunder(close, sma3) and lastTrade.entryPrice > 0
    lastTrade.exitPrice := close
    lastTrade.pnl := close - lastTrade.entryPrice
    lastTrade.isWin := lastTrade.pnl > 0
var float __obs_plot0 = na
__obs_plot0 := lastTrade.pnl
plot(lastTrade.pnl, "PnL")
