
//@version=5
indicator("IfChain")
spread = high - low
category = 0
if spread > 10
    category := 5
else if spread > 7
    category := 4
else if spread > 5
    category := 3
else if spread > 3
    category := 2
else
    category := 1
var float __obs_plot0 = na
__obs_plot0 := float(category)
plot(float(category), "Cat")
