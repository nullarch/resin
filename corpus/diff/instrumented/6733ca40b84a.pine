
//@version=5
indicator("Osc Zone")
enum Zone
    ExtremeOB = 4
    OB = 3
    Neutral = 2
    OS = 1
    ExtremeOS = 0

rsi = nz(ta.rsi(close, 3), 50.0)
zone = rsi > 80 ? Zone.ExtremeOB : rsi > 65 ? Zone.OB : rsi < 20 ? Zone.ExtremeOS : rsi < 35 ? Zone.OS : Zone.Neutral
var float __obs_plot0 = na
__obs_plot0 := int(zone)
plot(int(zone), "Zone")
