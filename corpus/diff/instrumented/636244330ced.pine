
//@version=5
indicator("Event Lbl")
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
event = ta.crossover(close, sma3) ? "CROSS_UP" : ta.crossunder(close, sma3) ? "CROSS_DN" : rsi > 70 ? "OB" : rsi < 30 ? "OS" : "NONE"
isBullEvent = event == "CROSS_UP" or event == "OS"
var float __obs_plot0 = na
__obs_plot0 := isBullEvent ? 1 : 0
plot(isBullEvent ? 1 : 0, "BE")
