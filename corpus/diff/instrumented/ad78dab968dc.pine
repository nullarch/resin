
//@version=5
indicator("Vol UDT")
type VolTracker
    float cumVol = 0.0
    float maxVol = 0.0
    int spikeBars = 0

var VolTracker vt = VolTracker.new()
vt.cumVol := vt.cumVol + volume
vt.maxVol := math.max(vt.maxVol, volume)
avgVol = ta.sma(volume, 5)
if volume > avgVol * 2
    vt.spikeBars := vt.spikeBars + 1
var float __obs_plot0 = na
__obs_plot0 := vt.spikeBars
plot(vt.spikeBars, "Spk")
