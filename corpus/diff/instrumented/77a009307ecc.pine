
//@version=5
indicator("Adapt Weight")
rsi = ta.rsi(close, 3)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
volHigh = atr > avgATR
rsiVal = nz(rsi, 50.0)
weight = volHigh ? (rsiVal > 60 ? 0.8 : rsiVal < 40 ? 0.2 : 0.5) : (rsiVal > 60 ? 0.6 : rsiVal < 40 ? 0.4 : 0.5)
var float __obs_plot0 = na
__obs_plot0 := weight
plot(weight, "Weight")
