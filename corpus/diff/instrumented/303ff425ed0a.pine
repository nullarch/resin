
//@version=5
indicator("Sig Str Track")
var sst = map.new<string, float>()
sig = close > ta.sma(close, 3) ? 1.0 : -1.0
prevSig = map.get(sst, "signal", 0.0)
prevStr = map.get(sst, "strength", 0.0)
newStr = sig == prevSig ? math.min(prevStr + 0.2, 1.0) : 0.2
map.put(sst, "signal", sig)
map.put(sst, "strength", newStr)
var float __obs_plot0 = na
__obs_plot0 := newStr
plot(newStr, "Strength")
