
//@version=5
indicator("EMA Ribbon")
e3 = ta.ema(close, 3)
e5 = ta.ema(close, 5)
e8 = ta.ema(close, 8)
bullOrder = e3 > e5 and e5 > e8
bearOrder = e3 < e5 and e5 < e8
ribbonWidth = e3 - e8
var float __obs_plot0 = na
__obs_plot0 := ribbonWidth
plot(ribbonWidth, "Width")
var float __obs_plot1 = na
__obs_plot1 := bullOrder ? 1 : bearOrder ? -1 : 0
plot(bullOrder ? 1 : bearOrder ? -1 : 0, "Order")
