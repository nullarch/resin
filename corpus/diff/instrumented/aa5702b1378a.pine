
//@version=5
indicator("Adapt MA")
var float adaptMA = 0.0
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
volRatio = avgATR > 0 ? atr / avgATR : 1.0
alpha = math.min(volRatio * 0.3, 0.9)
adaptMA := alpha * close + (1 - alpha) * adaptMA
var float __obs_plot0 = na
__obs_plot0 := close - adaptMA
plot(close - adaptMA, "Diff")
