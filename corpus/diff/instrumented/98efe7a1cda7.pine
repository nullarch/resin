
//@version=5
indicator("StrFilter")
rsi = nz(ta.rsi(close, 3), 50.0)
label = rsi > 70 ? "OB" : rsi < 30 ? "OS" : "N"
labelLen = str.length(label)
combined = str.tostring(math.round(rsi, 2)) + " " + label
totalLen = str.length(combined)
var float __obs_plot0 = na
__obs_plot0 := float(totalLen)
plot(float(totalLen), "TL")
