
//@version=5
indicator("Risk Sum")
var risks = map.new<string, float>()
atr = ta.atr(3)
rsi = nz(ta.rsi(close, 3), 50.0)
map.put(risks, "market", atr > 0 ? atr / close * 100 : 0.0)
map.put(risks, "momentum", math.abs(rsi - 50) / 50)
map.put(risks, "gap", math.abs(open - close[1]) / close * 100)
totalRisk = 0.0
for [k, v] in risks
    totalRisk := totalRisk + v
var float __obs_plot0 = na
__obs_plot0 := totalRisk
plot(totalRisk, "Total")
