
//@version=5
indicator("Period State")
var int alignedBars = 0
var int divergedBars = 0
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi3 = nz(ta.rsi(close, 3), 50.0)
rsi5 = nz(ta.rsi(close, 5), 50.0)
aligned = (sma3 > sma5 and rsi3 > rsi5) or (sma3 < sma5 and rsi3 < rsi5)
if aligned
    alignedBars := alignedBars + 1
else
    divergedBars := divergedBars + 1
var float __obs_plot0 = na
__obs_plot0 := alignedBars - divergedBars
plot(alignedBars - divergedBars, "Net")
