
//@version=5
indicator("Roll ZScore")
var float[] vals = array.new_float(0)
array.push(vals, close)
if array.size(vals) > 5
    array.shift(vals)
avg = array.avg(vals)
sd = array.stdev(vals)
zscore = sd > 0 ? (close - avg) / sd : 0.0
var float __obs_plot0 = na
__obs_plot0 := zscore
plot(zscore, "Z")
