
//@version=5
indicator("Adapt Smooth")
val = close
smoothed = val
alpha = 0.5
iterations = 0
while iterations < 5
    smoothed := smoothed * (1.0 - alpha) + val * alpha
    alpha := alpha * 0.8
    iterations := iterations + 1
var float __obs_plot0 = na
__obs_plot0 := smoothed
plot(smoothed, "Smoothed")
