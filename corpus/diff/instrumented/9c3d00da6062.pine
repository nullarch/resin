
//@version=5
indicator("VarRatio")
ret1 = close - close[1]
ret2 = close - close[2]
var float sumR1sq = 0.0
var float sumR2sq = 0.0
var int cnt = 0
if not na(ret1) and not na(ret2)
    sumR1sq := sumR1sq + ret1 * ret1
    sumR2sq := sumR2sq + ret2 * ret2
    cnt := cnt + 1
vr = cnt > 1 ? sumR2sq / (2.0 * sumR1sq + 0.0001) : 1.0
var float __obs_plot0 = na
__obs_plot0 := vr
plot(vr, "VR")
