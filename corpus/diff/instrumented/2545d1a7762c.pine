//@version=5
indicator("HarmDet19")
basePrice = nz(ta.sma(close, 5), 100.0)
ratio = basePrice > 0.001 ? close / basePrice : 1.0
frac = ratio - math.floor(ratio)
tolerance = 0.15
upperBound = 1.0 - tolerance
lowSide = frac < tolerance ? 1.0 : 0.0
highSide = frac > upperBound ? 1.0 : 0.0
harmScore = lowSide + highSide > 0 ? 1.0 : 0.0
ratioLabel = harmScore > 0.5 ? "harmonic" : "off"
var float __obs_plot0 = na
__obs_plot0 := harmScore
plot(harmScore, "hs")
