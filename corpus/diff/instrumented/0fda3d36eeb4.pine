//@version=5
indicator("Neural Plasticity Map")
var regionStrength = map.new<string, float>()
bullish = close > open
if bullish
    prev = map.contains(regionStrength, "motor") ? map.get(regionStrength, "motor") : 0.0
    map.put(regionStrength, "motor", prev + 1.0)
else
    prev = map.contains(regionStrength, "sensory") ? map.get(regionStrength, "sensory") : 0.0
    map.put(regionStrength, "sensory", prev + 1.0)
total = map.size(regionStrength)
var float __obs_plot0 = na
__obs_plot0 := total
plot(total)
