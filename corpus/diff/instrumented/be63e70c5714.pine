
//@version=5
indicator("Mom Full")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
[macdLine, signalLine, hist] = ta.macd(close, 3, 5, 3)

rsiScore = (rsi - 50) / 50
trendScore = sma5 > 0 ? (sma3 - sma5) / sma5 * 100 : 0.0
macdScore = hist > 0 ? 1.0 : -1.0

composite = rsiScore * 0.4 + trendScore * 0.3 + macdScore * 0.3

var int strongBars = 0
if composite > 0.5
    strongBars := strongBars + 1

var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "C")
var float __obs_plot1 = na
__obs_plot1 := strongBars
plot(strongBars, "SB")
