
//@version=5
indicator("Multi Strat Full")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
atr = ta.atr(3)
[m, s, h] = ta.macd(close, 3, 5, 3)
k = ta.stoch(close, high, low, 5)

// Strategy signals
var strats = map.new<string, float>()
map.put(strats, "trend", close > sma3 and sma3 > ema5 ? 1.0 : -1.0)
map.put(strats, "momentum", (rsi - 50) / 50)
map.put(strats, "macd", h > 0 ? 1.0 : -1.0)
map.put(strats, "stoch", (k - 50) / 50)

// Aggregate
totalScore = 0.0
count = 0
for [name, score] in strats
    totalScore := totalScore + score
    count := count + 1
avgScore = count > 0 ? totalScore / count : 0.0

// Track
var float[] aggHistory = array.new_float(0)
array.push(aggHistory, avgScore)
if array.size(aggHistory) > 8
    array.shift(aggHistory)

var int bars = 0
bars := bars + 1

var float __obs_plot0 = na
__obs_plot0 := avgScore
plot(avgScore, "Avg")
var float __obs_plot1 = na
__obs_plot1 := array.avg(aggHistory)
plot(array.avg(aggHistory), "Smooth")
