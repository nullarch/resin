
//@version=5
indicator("Deep Tern")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
score = close > sma3 ? (rsi > 60 ? (avgATR > 0 and atr < avgATR ? 3.0 : 2.0) : 1.0) : (rsi < 40 ? (avgATR > 0 and atr < avgATR ? -3.0 : -2.0) : -1.0)
var float __obs_plot0 = na
__obs_plot0 := score
plot(score, "Score")
