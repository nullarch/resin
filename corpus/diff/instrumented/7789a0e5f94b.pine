
//@version=5
indicator("MACD Cross")
[macdLine, signalLine, hist] = ta.macd(close, 3, 5, 3)
bullCross = ta.crossover(macdLine, signalLine)
bearCross = ta.crossunder(macdLine, signalLine)
var int crosses = 0
if bullCross or bearCross
    crosses := crosses + 1
var float __obs_plot0 = na
__obs_plot0 := hist
plot(hist, "Histogram")
