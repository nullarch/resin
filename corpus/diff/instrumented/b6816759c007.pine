
//@version=5
indicator("Regime Sig")
var rs = map.new<string, float>()
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
volRatio = avgATR > 0 ? atr / avgATR : 1.0
regime = volRatio > 1.5 ? "volatile" : close > sma3 ? "trending" : "ranging"
signal = regime == "volatile" ? 0.0 : regime == "trending" ? (close > sma3 ? 1.0 : -1.0) : (rsi < 35 ? 1.0 : rsi > 65 ? -1.0 : 0.0)
map.put(rs, "regime_signal", signal)
var float __obs_plot0 = na
__obs_plot0 := signal
plot(signal, "Sig")
