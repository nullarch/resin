//@version=5
indicator("Concordance")
var int concordant = 0
var int discordant = 0
prevC = nz(close[1], close)
prevV = nz(volume[1], volume)
diffC = close - prevC
diffV = volume - prevV
if diffC * diffV > 0
    concordant := concordant + 1
else if diffC * diffV < 0
    discordant := discordant + 1
totalPairs = concordant + discordant
tau = totalPairs > 0 ? float(concordant - discordant) / float(totalPairs) : 0.0
var float __obs_plot0 = na
__obs_plot0 := tau
plot(tau, "Tau")
