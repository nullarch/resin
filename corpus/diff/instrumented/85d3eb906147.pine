
//@version=5
indicator("Bar Class")
bullBars = 0
bearBars = 0
dojiBars = 0
for i = 0 to 4
    c = close[i]
    o = open[i]
    h = high[i]
    l = low[i]
    if not na(c) and not na(o) and not na(h) and not na(l)
        body = math.abs(c - o)
        rng = h - l
        if rng > 0 and body / rng < 0.1
            dojiBars := dojiBars + 1
        else if c > o
            bullBars := bullBars + 1
        else
            bearBars := bearBars + 1
var float __obs_plot0 = na
__obs_plot0 := bullBars
plot(bullBars, "Bull")
var float __obs_plot1 = na
__obs_plot1 := dojiBars
plot(dojiBars, "Doji")
