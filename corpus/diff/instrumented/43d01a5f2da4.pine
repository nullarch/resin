
//@version=5
indicator("Sig Track")
var int lastSignal = 0
var int signalAge = 0
var int totalSignals = 0
rsi = nz(ta.rsi(close, 3), 50.0)
newSig = rsi > 60 ? 1 : rsi < 40 ? -1 : 0
if newSig != 0 and newSig != lastSignal
    lastSignal := newSig
    signalAge := 0
    totalSignals := totalSignals + 1
signalAge := signalAge + 1
var float __obs_plot0 = na
__obs_plot0 := signalAge
plot(signalAge, "Age")
var float __obs_plot1 = na
__obs_plot1 := totalSignals
plot(totalSignals, "Total")
