
//@version=5
indicator("Vol Label")
volSMA = ta.sma(volume, 5)
ratio = volSMA > 0 ? volume / volSMA : 1.0
volLabel = ratio > 2.0 ? "SPIKE" : ratio > 1.0 ? "ABOVE" : "BELOW"
priceLabel = close > open ? "UP" : "DN"
combined = volLabel + "_" + priceLabel
isBullSpike = combined == "SPIKE_UP"
var float __obs_plot0 = na
__obs_plot0 := isBullSpike ? 1 : 0
plot(isBullSpike ? 1 : 0, "BS")
