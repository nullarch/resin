
//@version=5
indicator("Vol Model")
type VolModel
    float current = 0.0
    float average = 0.0
    float ratio = 1.0

var VolModel vm = VolModel.new()
vm.current := ta.atr(3)
vm.average := ta.sma(vm.current, 5)
vm.ratio := vm.average > 0 ? vm.current / vm.average : 1.0
isHighVol = vm.ratio > 1.5
var float __obs_plot0 = na
__obs_plot0 := vm.ratio
plot(vm.ratio, "VR")
