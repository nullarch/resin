
//@version=5
indicator("Div Data")
var dd = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
map.put(dd, "price_chg", nz(close - close[1], 0.0))
map.put(dd, "rsi", rsi)
map.put(dd, "vol_chg", nz(volume - volume[1], 0.0))
priceChg = map.get(dd, "price_chg", 0.0)
rsiVal = map.get(dd, "rsi", 50.0)
divergent = (priceChg > 0 and rsiVal < 50) or (priceChg < 0 and rsiVal > 50)
var float __obs_plot0 = na
__obs_plot0 := divergent ? 1 : 0
plot(divergent ? 1 : 0, "D")
