//@version=5
indicator("DoseResponse")
rsiDose = nz(ta.rsi(close, 5), 50.0) / 100.0
response = close - nz(close[1], close)
lowDose = rsiDose < 0.33 ? response : 0.0
midDose = rsiDose >= 0.33 and rsiDose < 0.66 ? response : 0.0
highDose = rsiDose >= 0.66 ? response : 0.0
var float __obs_plot0 = na
__obs_plot0 := lowDose
plot(lowDose, "LowD")
var float __obs_plot1 = na
__obs_plot1 := midDose
plot(midDose, "MidD")
var float __obs_plot2 = na
__obs_plot2 := highDose
plot(highDose, "HighD")
