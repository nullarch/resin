
//@version=5
indicator("Scale Out")
atr = ta.atr(3)
level = close
step = atr * 0.5
levels = 0
totalProfit = 0.0
while levels < 4
    level := level + step
    totalProfit := totalProfit + step * (4 - levels)
    levels := levels + 1
var float __obs_plot0 = na
__obs_plot0 := totalProfit
plot(totalProfit, "TotalProfit")
