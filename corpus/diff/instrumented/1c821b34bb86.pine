//@version=5
indicator("Drag Coefficient")
velocity = math.abs(close - open)
frontalArea = high - low
density = 1.225
dragForce = volume * 0.001
cd = velocity > 0 and frontalArea > 0 ? (2.0 * dragForce) / (density * velocity * velocity * frontalArea) : 0.0
cd := math.min(cd, 10.0)
var float __obs_plot0 = na
__obs_plot0 := cd
plot(cd)
