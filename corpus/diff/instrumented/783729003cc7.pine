//@version=5
indicator("Divergence")
var int divCount = 0
float rsiVal = nz(ta.rsi(close, 3), 50.0)
float prevC = not na(close[1]) ? close[1] : close
float rsiSma = ta.sma(rsiVal, 3)
float prevRsi = not na(rsiSma[1]) ? rsiSma[1] : nz(rsiSma, 50.0)
bool priceUp = close > prevC
bool rsiDown = nz(rsiSma, 50.0) < prevRsi
if priceUp and rsiDown
    divCount := divCount + 1
var float __obs_plot0 = na
__obs_plot0 := divCount
plot(divCount, "DivCount")
