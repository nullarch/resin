
//@version=5
indicator("MA Map")
var md = map.new<string, float>()
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
map.put(md, "fast", sma3)
map.put(md, "slow", sma5)
map.put(md, "spread", sma3 - sma5)
spread = map.get(md, "spread", 0.0)
var float __obs_plot0 = na
__obs_plot0 := spread
plot(spread, "Sprd")
