
//@version=5
indicator("Enum Flag")
enum Level
    Low = 1
    Medium = 2
    High = 3

atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
ratio = avgATR > 0 ? atr / avgATR : 1.0
volLevel = ratio > 1.5 ? Level.High : ratio > 0.8 ? Level.Medium : Level.Low
isHigh = volLevel == Level.High
var float __obs_plot0 = na
__obs_plot0 := float(volLevel)
plot(float(volLevel), "Lvl")
