
//@version=5
indicator("Math Full")
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
sma5 = ta.sma(close, 5)
sd = ta.stdev(close, 5)

logRet = close > 0 and close[1] > 0 ? math.log(close / close[1]) : 0.0
zScore = sd > 0 ? (close - sma5) / sd : 0.0
sigmoid = 1.0 / (1.0 + math.exp(-(rsi - 50) / 10))
eucDist = math.sqrt(math.pow(close - sma5, 2))
normATR = close > 0 ? atr / close * 100 : 0.0

composite = sigmoid * 0.3 + (1 - math.abs(zScore) / 3) * 0.3 + (1 - normATR / 10) * 0.4
clamped = math.max(0.0, math.min(1.0, composite))

var int bars = 0
bars := bars + 1

var float __obs_plot0 = na
__obs_plot0 := clamped
plot(clamped, "Score")
var float __obs_plot1 = na
__obs_plot1 := zScore
plot(zScore, "Z")
