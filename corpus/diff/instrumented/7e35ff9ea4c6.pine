//@version=5
indicator("test")
fastEMA = ta.ema(close, 3)
slowEMA = ta.ema(close, 5)
macd = fastEMA - slowEMA
signal = ta.ema(macd, 3)
macdRising = macd > macd[1]
signalRising = signal > signal[1]
var float __obs_plot0 = na
__obs_plot0 := macdRising and signalRising ? 1 : 0
plot(macdRising and signalRising ? 1 : 0)
