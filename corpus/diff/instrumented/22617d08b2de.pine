
//@version=5
indicator("HurstProxy")
length = 5
rangeHL = ta.highest(high, length) - ta.lowest(low, length)
dev = ta.stdev(close, length)
rs = dev > 0 ? rangeHL / dev : 1.0
hurst = math.log(rs) / math.log(length)
hurstArr = array.new_float(0)
array.push(hurstArr, hurst)
latest = array.get(hurstArr, 0)
var float __obs_plot0 = na
__obs_plot0 := latest
plot(latest, "H")
