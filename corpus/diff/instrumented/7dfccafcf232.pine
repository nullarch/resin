
//@version=5
indicator("Pivots")
ph = ta.pivothigh(high, 2, 2)
pl = ta.pivotlow(low, 2, 2)
hasPivotHigh = not na(ph)
hasPivotLow = not na(pl)
var float __obs_plot0 = na
__obs_plot0 := hasPivotHigh ? 1 : 0
plot(hasPivotHigh ? 1 : 0, "PH")
var float __obs_plot1 = na
__obs_plot1 := hasPivotLow ? 1 : 0
plot(hasPivotLow ? 1 : 0, "PL")
