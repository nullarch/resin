
//@version=5
indicator("Sess State")
var int sessCount = 0
var float sessOpen = 0.0
var float sessVol = 0.0
var int barInSess = 0
barInSess := barInSess + 1
if barInSess == 1
    sessOpen := close
sessVol := sessVol + volume
if barInSess >= 5
    sessCount := sessCount + 1
    barInSess := 0
    sessVol := 0.0
var float __obs_plot0 = na
__obs_plot0 := sessCount
plot(sessCount, "SC")
