
//@version=5
indicator("Osc Dash")
var od = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
map.put(od, "rsi", rsi)
map.put(od, "stoch", k)
map.put(od, "rsi_zone", rsi > 70 ? 1.0 : rsi < 30 ? -1.0 : 0.0)
map.put(od, "stoch_zone", k > 80 ? 1.0 : k < 20 ? -1.0 : 0.0)
rsiZone = map.get(od, "rsi_zone", 0.0)
stochZone = map.get(od, "stoch_zone", 0.0)
agreement = rsiZone == stochZone and rsiZone != 0
var float __obs_plot0 = na
__obs_plot0 := agreement ? 1 : 0
plot(agreement ? 1 : 0, "Agree")
