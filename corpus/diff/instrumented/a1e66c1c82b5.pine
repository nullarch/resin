
//@version=5
indicator("Vol Regime Track")
var int currentRegime = 0
var int regimeChanges = 0
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
newRegime = atr > avgATR * 1.5 ? 2 : atr > avgATR ? 1 : 0
if newRegime != currentRegime
    regimeChanges := regimeChanges + 1
    currentRegime := newRegime
var float __obs_plot0 = na
__obs_plot0 := currentRegime
plot(currentRegime, "Regime")
var float __obs_plot1 = na
__obs_plot1 := regimeChanges
plot(regimeChanges, "Changes")
