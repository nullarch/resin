
//@version=5
indicator("Adaptive Engine")
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)

// Adaptive regime
avgATR = ta.sma(atr, 5)
volRegime = atr > avgATR * 1.5 ? 2 : atr > avgATR ? 1 : 0

// Adaptive weights
trendWt = volRegime == 2 ? 0.5 : 0.3
momWt = volRegime == 0 ? 0.5 : 0.3
volWt = 1.0 - trendWt - momWt

// Signals
tSig = close > sma3 ? 1.0 : -1.0
mSig = rsi > 50 ? 1.0 : -1.0
vSig = atr > avgATR ? 1.0 : -1.0
composite = tSig * trendWt + mSig * momWt + vSig * volWt

var float[] history = array.new_float(0)
array.push(history, composite)
if array.size(history) > 8
    array.shift(history)
avgComp = array.avg(history)

var state = map.new<string, float>()
map.put(state, "composite", composite)
map.put(state, "regime", float(volRegime))

var int bars = 0
bars := bars + 1

var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "Comp")
var float __obs_plot1 = na
__obs_plot1 := avgComp
plot(avgComp, "Avg")
