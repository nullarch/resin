
//@version=5
indicator("Pat Hist")
var float[] patScores = array.new_float(0)
bodySize = math.abs(close - open_)
fullRange = high - low
score = fullRange > 0 ? bodySize / fullRange : 0.0
array.push(patScores, close > open_ ? score : -score)
if array.size(patScores) > 8
    array.shift(patScores)
avgScore = array.size(patScores) > 0 ? array.avg(patScores) : 0.0
var float __obs_plot0 = na
__obs_plot0 := avgScore
plot(avgScore, "AS")
