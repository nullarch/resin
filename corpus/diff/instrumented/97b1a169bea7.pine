
//@version=5
indicator("Mom Scan")
upBars = 0
downBars = 0
for i = 0 to 4
    if not na(close[i]) and not na(close[i+1])
        if close[i] > close[i+1]
            upBars := upBars + 1
        else
            downBars := downBars + 1
momScore = upBars - downBars
var float __obs_plot0 = na
__obs_plot0 := momScore
plot(momScore, "MS")
