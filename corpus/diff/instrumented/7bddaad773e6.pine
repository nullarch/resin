
//@version=5
indicator("WeightSum")
var float[] vals = array.new_float(0)
var float[] wts = array.new_float(0)

array.clear(vals)
array.clear(wts)

array.push(vals, close - open)
array.push(wts, 0.5)
array.push(vals, high - low)
array.push(wts, 0.3)
array.push(vals, volume > 1000 ? 1.0 : -1.0)
array.push(wts, 0.2)

weightedSum = 0.0
for i = 0 to array.size(vals) - 1
    weightedSum := weightedSum + array.get(vals, i) * array.get(wts, i)
var float __obs_plot0 = na
__obs_plot0 := weightedSum
plot(weightedSum, "WS")
