
//@version=5
indicator("HL Ratio")
hi5 = ta.highest(close, 5)
lo5 = ta.lowest(close, 5)
ratio = lo5 > 0 ? hi5 / lo5 : 1.0
expanding = ratio > ratio[1]
var float __obs_plot0 = na
__obs_plot0 := ratio
plot(ratio, "Ratio")
var float __obs_plot1 = na
__obs_plot1 := expanding ? 1 : 0
plot(expanding ? 1 : 0, "Expanding")
