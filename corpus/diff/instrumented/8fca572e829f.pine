//@version=5
indicator("FE17")
var int level = 0
emaVal = ta.ema(close, 3)
atrVal = nz(ta.atr(3), 1.0)
band = emaVal + atrVal * 2
dist = math.abs(close - band)
cnt = 0
n = 0
while n < 4
    cnt := cnt + (dist > n ? 1 : 0)
    n := n + 1
label = str.tostring(cnt)
level := cnt
var float __obs_plot0 = na
__obs_plot0 := level
plot(level, title="lvl")
