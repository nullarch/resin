
//@version=5
indicator("Eq Target")
ret = nz(close - close[1], 0.0)
equity = 10000.0
target = 10100.0
periods = 0
avgRet = nz(ta.sma(ret, 5), 0.0)
while equity < target and periods < 100
    equity := equity + avgRet * 10
    periods := periods + 1
var float __obs_plot0 = na
__obs_plot0 := periods
plot(periods, "Per")
