
//@version=5
indicator("DepthLevels")
levels = array.new_float(0)
midPrice = (high + low) / 2.0
for i = 1 to 5
    bidLevel = midPrice - float(i) * 0.5
    array.push(levels, bidLevel)
for i = 1 to 5
    askLevel = midPrice + float(i) * 0.5
    array.push(levels, askLevel)
totalDepth = array.sum(levels)
var float __obs_plot0 = na
__obs_plot0 := totalDepth
plot(totalDepth, "TD")
