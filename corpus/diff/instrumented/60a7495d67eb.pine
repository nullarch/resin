
//@version=5
indicator("EventWin")
var float[] window = array.new_float(0)
maxWin = 4

if close > open
    array.push(window, close)
if array.size(window) > maxWin
    array.shift(window)

winMax = array.size(window) > 0 ? array.max(window) : 0.0
winMin = array.size(window) > 0 ? array.min(window) : 0.0
spread = winMax - winMin
var float __obs_plot0 = na
__obs_plot0 := spread
plot(spread, "SP")
