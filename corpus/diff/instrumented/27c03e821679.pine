
//@version=5
indicator("StochRSI")
rsi = nz(ta.rsi(close, 3), 50.0)
hiRSI = ta.highest(rsi, 5)
loRSI = ta.lowest(rsi, 5)
stochRSI = hiRSI != loRSI ? (rsi - loRSI) / (hiRSI - loRSI) * 100 : 50.0
kLine = ta.sma(stochRSI, 3)
var float __obs_plot0 = na
__obs_plot0 := stochRSI
plot(stochRSI, "SR")
var float __obs_plot1 = na
__obs_plot1 := kLine
plot(kLine, "K")
