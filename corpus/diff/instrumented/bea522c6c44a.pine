//@version=5
indicator("HasbrouckIS")
prevClose = nz(close[1], close)
ret = close - prevClose
mid = (high + low) / 2.0
prevMid = (nz(high[1], high) + nz(low[1], low)) / 2.0
midRet = mid - prevMid
retSq = ret * ret
midRetSq = midRet * midRet
infoShare = retSq > 0.001 ? midRetSq / retSq : 0.5
infoShare := math.max(0.0, math.min(1.0, infoShare))
var float __obs_plot0 = na
__obs_plot0 := infoShare
plot(infoShare, "IS")
