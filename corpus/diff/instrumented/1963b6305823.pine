
//@version=5
indicator("Stat Dash")
var sd = map.new<string, float>()
sma5 = ta.sma(close, 5)
stddev = ta.stdev(close, 5)
map.put(sd, "mean", sma5)
map.put(sd, "stddev", stddev)
map.put(sd, "cv", sma5 > 0 ? stddev / sma5 : 0.0)
map.put(sd, "z", stddev > 0 ? (close - sma5) / stddev : 0.0)
cv = map.get(sd, "cv", 0.0)
var float __obs_plot0 = na
__obs_plot0 := cv
plot(cv, "CV")
