//@version=5
indicator("Venturi Effect")
widePipe = high - low
narrowPipe = math.abs(close - open)
wideArea = math.max(widePipe, 0.1)
narrowArea = math.max(narrowPipe, 0.1)
ratio = wideArea / narrowArea
velocityIncrease = ratio > 1.0 ? math.sqrt(ratio) : 1.0
var float __obs_plot0 = na
__obs_plot0 := velocityIncrease
plot(velocityIncrease)
