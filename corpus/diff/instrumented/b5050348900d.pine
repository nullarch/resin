//@version=5
indicator("Language Membership")
signal = nz(ta.ema(close, 3), close)
threshold = nz(ta.sma(close, 5), close)
var int accepted = 0
var int rejected = 0
if signal > threshold
    accepted := accepted + 1
else
    rejected := rejected + 1
ratio = (accepted + rejected) > 0 ? accepted / (accepted + rejected) : 0.0
var float __obs_plot0 = na
__obs_plot0 := ratio
plot(ratio, "AcceptRate")
