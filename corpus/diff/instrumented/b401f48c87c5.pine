
//@version=5
indicator("Eff")
netMove = math.abs(close - close[3])
totalMove = 0.0
for i = 0 to 2
    if not na(close[i]) and not na(close[i+1])
        totalMove := totalMove + math.abs(close[i] - close[i+1])
efficiency = totalMove > 0 ? netMove / totalMove : 0.0
var float __obs_plot0 = na
__obs_plot0 := efficiency
plot(efficiency, "Eff")
