
//@version=5
indicator("Reg Data")
var rd = map.new<string, float>()
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
map.put(rd, "trend", close > sma3 ? 1.0 : -1.0)
map.put(rd, "momentum", (rsi - 50) / 50)
map.put(rd, "volatility", atr)
trendVal = map.get(rd, "trend", 0.0)
momVal = map.get(rd, "momentum", 0.0)
combined = trendVal + momVal
var float __obs_plot0 = na
__obs_plot0 := combined
plot(combined, "C")
