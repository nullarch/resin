//@version=5
indicator("Vol Signals")
avgVol = ta.sma(volume, 5)
highVol = not na(avgVol) and volume > avgVol * 1.5
rsi_ = ta.rsi(close, 5)
signal = highVol and not na(rsi_) and rsi_ < 30 ? 2 : highVol and not na(rsi_) and rsi_ > 70 ? -2 : 0
var float __obs_plot0 = na
__obs_plot0 := signal
plot(signal)
