//@version=5
indicator("LeadLagXCorr")
var float sumA = 0.0
var float sumB = 0.0
var float sumAB = 0.0
var float sumA2 = 0.0
var float sumB2 = 0.0
var int cnt = 0
cnt := cnt + 1
a = nz(volume[1], volume)
b = close - nz(close[1], close)
sumA := sumA + a
sumB := sumB + b
sumAB := sumAB + a * b
sumA2 := sumA2 + a * a
sumB2 := sumB2 + b * b
n = float(cnt)
denom = math.sqrt(math.max(0.0001, (sumA2 - sumA * sumA / n) * (sumB2 - sumB * sumB / n)))
xcorr = denom > 0.01 ? (sumAB - sumA * sumB / n) / denom : 0.0
var float __obs_plot0 = na
__obs_plot0 := xcorr
plot(xcorr, "XCorr")
