//@version=5
indicator("Metapopulation Connectivity")
var float patch1 = 80.0
var float patch2 = 40.0
migrationRate = 0.05
transfer = migrationRate * (patch1 - patch2)
patch1 := patch1 - transfer + patch1 * 0.02
patch2 := patch2 + transfer + patch2 * 0.02
var float __obs_plot0 = na
__obs_plot0 := patch1 + patch2
plot(patch1 + patch2, "TotalPop")
