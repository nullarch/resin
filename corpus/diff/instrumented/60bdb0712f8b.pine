//@version=5
indicator("Cycle 126 Comprehensive", overlay=true)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema5 = ta.ema(close, 5)
rsi5 = ta.rsi(close, 5)
atr3 = ta.atr(3)
cumVol = ta.cum(volume)
chg = ta.change(close)
h5 = ta.highest(high, 5)
l5 = ta.lowest(low, 5)
[macdLine, sigLine, hist] = ta.macd(close, 3, 5, 3)
var prices = array.new_float(0)
var m = map.new<string, float>()
var int barCount = 0
var float maxRSI = 0.0
array.push(prices, close)
if array.size(prices) > 5
    array.shift(prices)
windowAvg = array.avg(prices)
map.put(m, "sma", nz(sma3))
map.put(m, "rsi", nz(rsi5))
map.put(m, "atr", nz(atr3))
if not na(rsi5) and nz(rsi5) > maxRSI
    maxRSI := nz(rsi5)
bullish = not na(sma3) and not na(sma5) and not na(rsi5) and
    close > nz(sma3) and
    nz(sma3) > nz(sma5) and
    nz(rsi5) > 40
clr = bullish ? color.green : color.red
var float __obs_plot0 = na
__obs_plot0 := sma3
plot(sma3, "Fast", color=clr)
var float __obs_plot1 = na
__obs_plot1 := sma5
plot(sma5, "Slow")
hline(70)
hline(30)
barCount := barCount + 1
