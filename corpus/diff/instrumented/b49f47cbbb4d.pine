
//@version=5
indicator("Bool Comp")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
avgVol = ta.sma(volume, 5)
cond1 = close > sma3 and sma3 > sma5
cond2 = rsi > 50 and rsi < 70
cond3 = volume > avgVol
fullBull = cond1 and cond2 and cond3
anyBull = cond1 or cond2
notBear = not (close < sma3 and rsi < 40)
var float __obs_plot0 = na
__obs_plot0 := fullBull ? 3 : anyBull and notBear ? 2 : anyBull ? 1 : 0
plot(fullBull ? 3 : anyBull and notBear ? 2 : anyBull ? 1 : 0, "S")
