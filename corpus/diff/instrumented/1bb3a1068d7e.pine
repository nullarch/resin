
//@version=5
indicator("Trend Mom")
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
[m, s, h] = ta.macd(close, 3, 5, 3)
atr = ta.atr(3)

// Trend score
trendAligned = close > ema3 and ema3 > sma5
trendScore = trendAligned ? 1.0 : close < ema3 and ema3 < sma5 ? -1.0 : 0.0

// Momentum score
momScore = (rsi - 50) / 50

// MACD confirmation
macdConf = h > 0 ? 1.0 : -1.0

// Composite
composite = trendScore * 0.4 + momScore * 0.3 + macdConf * 0.3

var float[] scores = array.new_float(0)
array.push(scores, composite)
if array.size(scores) > 8
    array.shift(scores)

var int bars = 0
bars := bars + 1

var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "Comp")
var float __obs_plot1 = na
__obs_plot1 := array.avg(scores)
plot(array.avg(scores), "AvgC")
