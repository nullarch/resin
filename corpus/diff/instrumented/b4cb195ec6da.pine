
//@version=5
indicator("TickRule")
var float lastClassified = 0.0
diff = close - close[1]
tickDir = na(diff) ? 0.0 : diff > 0 ? 1.0 : diff < 0 ? -1.0 : lastClassified
lastClassified := tickDir
buyVol = tickDir > 0 ? volume : tickDir == 0 ? volume * 0.5 : 0.0
sellVol = tickDir < 0 ? volume : tickDir == 0 ? volume * 0.5 : 0.0
netFlow = buyVol - sellVol
var float __obs_plot0 = na
__obs_plot0 := netFlow
plot(netFlow, "NF")
