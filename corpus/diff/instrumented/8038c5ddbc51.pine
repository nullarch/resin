
//@version=5
indicator("Map Counter")
var counters = map.new<string, float>()
prevBull = map.get(counters, "bull", 0.0)
prevBear = map.get(counters, "bear", 0.0)
if close > open
    map.put(counters, "bull", prevBull + 1)
else
    map.put(counters, "bear", prevBear + 1)
bullCnt = map.get(counters, "bull", 0.0)
bearCnt = map.get(counters, "bear", 0.0)
total = bullCnt + bearCnt
ratio = total > 0 ? bullCnt / total : 0.5
var float __obs_plot0 = na
__obs_plot0 := ratio
plot(ratio, "Ratio")
