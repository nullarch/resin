
//@version=5
indicator("Roll Corr")
var float[] xs = array.new_float(0)
var float[] ys = array.new_float(0)
rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
array.push(xs, rsi)
array.push(ys, k)
if array.size(xs) > 6
    array.shift(xs)
    array.shift(ys)
cov = array.covariance(xs, ys)
sdX = array.stdev(xs)
sdY = array.stdev(ys)
corr = sdX > 0 and sdY > 0 ? cov / (sdX * sdY) : 0.0
var float __obs_plot0 = na
__obs_plot0 := corr
plot(corr, "Corr")
