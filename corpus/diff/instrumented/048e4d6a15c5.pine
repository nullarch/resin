
//@version=5
indicator("SR")
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
mid = (hi5 + lo5) / 2
nearResist = hi5 > 0 ? (hi5 - close) / hi5 * 100 < 1 : false
nearSupport = lo5 > 0 ? (close - lo5) / lo5 * 100 < 1 : false
var float __obs_plot0 = na
__obs_plot0 := nearResist ? 1 : nearSupport ? -1 : 0
plot(nearResist ? 1 : nearSupport ? -1 : 0, "SR")
