//@version=5
indicator("ESSReplicator")
var float freqHawk = 0.5
payHH = -2.0
payHD = 3.0
payDH = 0.0
payDD = 1.5
fitHawk = freqHawk * payHH + (1.0 - freqHawk) * payHD
fitDove = freqHawk * payDH + (1.0 - freqHawk) * payDD
avgFit = freqHawk * fitHawk + (1.0 - freqHawk) * fitDove
growth = avgFit != 0 ? freqHawk * (fitHawk - avgFit) / math.max(math.abs(avgFit), 0.01) : 0.0
freqHawk := math.max(0.01, math.min(0.99, freqHawk + growth * 0.1))
var float __obs_plot0 = na
__obs_plot0 := freqHawk
plot(freqHawk, "Hawk")
