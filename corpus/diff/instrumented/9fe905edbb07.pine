
//@version=5
indicator("Risk Prof")
type RiskProfile
    float maxDD = 0.0
    float peak = 0.0
    int riskEvents = 0

var RiskProfile rp = RiskProfile.new()
rp.peak := math.max(rp.peak, close)
dd = rp.peak > 0 ? (rp.peak - close) / rp.peak * 100 : 0.0
rp.maxDD := math.max(rp.maxDD, dd)
if dd > 1.0
    rp.riskEvents := rp.riskEvents + 1
var float __obs_plot0 = na
__obs_plot0 := rp.maxDD
plot(rp.maxDD, "MDD")
