
//@version=5
indicator("Ichi Proxy")
tenkan = (ta.highest(high, 3) + ta.lowest(low, 3)) / 2
kijun = (ta.highest(high, 5) + ta.lowest(low, 5)) / 2
aboveCloud = close > math.max(tenkan, kijun)
belowCloud = close < math.min(tenkan, kijun)
var float __obs_plot0 = na
__obs_plot0 := tenkan
plot(tenkan, "Tenkan")
var float __obs_plot1 = na
__obs_plot1 := kijun
plot(kijun, "Kijun")
