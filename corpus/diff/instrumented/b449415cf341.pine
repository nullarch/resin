//@version=5
indicator("Dual Convergence")
var float phi = 0.0
var float psi = 0.0
float cost = math.abs(close - open)
float phiNew = math.max(phi, cost - psi)
float psiNew = math.max(psi, cost - phi)
float delta = math.abs(phiNew - phi) + math.abs(psiNew - psi)
phi := phiNew
psi := psiNew
var float __obs_plot0 = na
__obs_plot0 := delta
plot(delta, "DualDelta")
