//@version=5
indicator("Comprehensive Lexer Refactor")

/* multi-line
   block comment */

float base = 1.5e1 + .5 // inline comment

float calc = (base +
    10.0) *
    2.0

bool cond = calc > 50 and
    calc < 100

var float result = 0.0
if cond
    if calc > 60
        result := calc
    else
        result := 0.0
var float __obs_plot0 = na
__obs_plot0 := result
plot(result, color=#00FF00)
