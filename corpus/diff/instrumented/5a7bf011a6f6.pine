//@version=5
indicator("Swarm Consensus")
ma3 = ta.sma(close, 3)
ma5 = ta.sma(close, 5)
ma7 = ta.sma(close, 7)
vote1 = close > ma3 ? 1.0 : -1.0
vote2 = close > ma5 ? 1.0 : -1.0
vote3 = close > ma7 ? 1.0 : -1.0
consensus = (vote1 + vote2 + vote3) / 3.0
var float __obs_plot0 = na
__obs_plot0 := consensus
plot(consensus)
