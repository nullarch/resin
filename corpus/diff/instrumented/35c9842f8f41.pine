
//@version=5
indicator("Run Corr")
var float[] xs = array.new_float(0)
var float[] ys = array.new_float(0)
array.push(xs, close)
array.push(ys, volume)
if array.size(xs) > 5
    array.shift(xs)
    array.shift(ys)
cov = array.covariance(xs, ys)
var float __obs_plot0 = na
__obs_plot0 := nz(cov, 0.0)
plot(nz(cov, 0.0), "Cov")
