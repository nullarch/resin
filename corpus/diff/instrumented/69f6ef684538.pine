
//@version=5
indicator("MR ZScore")
sma5 = ta.sma(close, 5)
sd = ta.stdev(close, 5)
z = sd > 0 ? (close - sma5) / sd : 0.0
mrSignal = z < -1.5 ? 1.0 : z > 1.5 ? -1.0 : 0.0
var float __obs_plot0 = na
__obs_plot0 := z
plot(z, "Z")
var float __obs_plot1 = na
__obs_plot1 := mrSignal
plot(mrSignal, "MR")
