
//@version=5
indicator("Mom Win")
var float[] changes = array.new_float(0)
chg = close - open
array.push(changes, chg)
if array.size(changes) > 5
    array.shift(changes)
posChanges = 0
for v in changes
    if v > 0
        posChanges := posChanges + 1
winRate = array.size(changes) > 0 ? posChanges / array.size(changes) : 0.0
var float __obs_plot0 = na
__obs_plot0 := winRate
plot(winRate, "WR")
