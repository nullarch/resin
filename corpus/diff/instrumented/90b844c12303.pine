
//@version=5
indicator("Trend Conv")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
spread = math.abs(sma3 - sma5)
threshold = 10.0
steps = 0
while threshold > spread and steps < 15
    threshold := threshold * 0.6
    steps := steps + 1
var float __obs_plot0 = na
__obs_plot0 := steps
plot(steps, "St")
