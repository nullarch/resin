
//@version=5
indicator("Algo Framework")
// Indicators
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)

// Signal generation
trendFilter = close > ema5
momFilter = rsi > 40 and rsi < 75
entrySignal = ta.crossover(close, sma3) and trendFilter and momFilter

// Position management
var int position = 0
var float entryPrice = 0.0
if entrySignal and position == 0
    position := 1
    entryPrice := close
if position == 1 and (close < entryPrice - atr * 2 or rsi > 75)
    position := 0

// Risk tracking
var float maxDD = 0.0
var float peak = 0.0
if close > peak
    peak := close
dd = peak > 0 ? (peak - close) / peak : 0.0
if dd > maxDD
    maxDD := dd

var int bars = 0
bars := bars + 1

// History
var float[] posHist = array.new_float(0)
array.push(posHist, float(position))
if array.size(posHist) > 8
    array.shift(posHist)
avgPos = array.avg(posHist)

var m = map.new<string, float>()
map.put(m, "position", float(position))
map.put(m, "dd", maxDD * 100)

var float __obs_plot0 = na
__obs_plot0 := position
plot(position, "Pos")
var float __obs_plot1 = na
__obs_plot1 := maxDD * 100
plot(maxDD * 100, "DD%")
