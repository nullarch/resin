
//@version=5
indicator("Sort Insert")
var float[] sorted = array.new_float(0)
if array.size(sorted) > 5
    array.shift(sorted)
array.push(sorted, close)
array.sort(sorted)
medianVal = array.size(sorted) > 0 ? array.get(sorted, math.floor(array.size(sorted) / 2)) : close
var float __obs_plot0 = na
__obs_plot0 := medianVal
plot(medianVal, "Med")
