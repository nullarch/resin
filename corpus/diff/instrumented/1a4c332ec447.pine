
//@version=5
indicator("Fib Levels")
hi = ta.highest(high, 5)
lo = ta.lowest(low, 5)
diff = hi - lo
fib382 = hi - diff * 0.382
fib500 = hi - diff * 0.500
fib618 = hi - diff * 0.618
inFibZone = close >= fib618 and close <= fib382
var float __obs_plot0 = na
__obs_plot0 := inFibZone ? 1 : 0
plot(inFibZone ? 1 : 0, "InFib")
