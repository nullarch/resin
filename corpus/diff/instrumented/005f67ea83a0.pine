
//@version=5
indicator("Vol Regime")
atrVal = ta.atr(3)
smaATR = ta.sma(atrVal, 3)
highVol = atrVal > smaATR
var int regimeCount = 0
if highVol
    regimeCount := regimeCount + 1
var float __obs_plot0 = na
__obs_plot0 := atrVal
plot(atrVal, "ATR")
var float __obs_plot1 = na
__obs_plot1 := regimeCount
plot(regimeCount, "HighVol Count")
