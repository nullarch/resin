
//@version=5
indicator("Mom Regime")
type MomRegime
    float score = 0.0
    int regime = 0
    int duration = 0

var MomRegime mr = MomRegime.new()
rsi = nz(ta.rsi(close, 3), 50.0)
[m, s, h] = ta.macd(close, 3, 5, 3)
mr.score := (rsi - 50) / 50 * 0.5 + (h > 0 ? 0.5 : -0.5)
newRegime = mr.score > 0.3 ? 1 : mr.score < -0.3 ? -1 : 0
if newRegime != mr.regime
    mr.regime := newRegime
    mr.duration := 1
else
    mr.duration := mr.duration + 1
var float __obs_plot0 = na
__obs_plot0 := mr.score
plot(mr.score, "Score")
var float __obs_plot1 = na
__obs_plot1 := mr.duration
plot(mr.duration, "Dur")
