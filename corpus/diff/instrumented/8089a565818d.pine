//@version=5
indicator("Spectral Flatness")
float e1 = nz(ta.ema(close, 2), close)
float e2 = nz(ta.ema(close, 3), close)
float e3 = nz(ta.ema(close, 5), close)
float b1 = (close - e1) * (close - e1) + 0.001
float b2 = (close - e2) * (close - e2) + 0.001
float b3 = (close - e3) * (close - e3) + 0.001
float arithMean = (b1 + b2 + b3) / 3.0
float logGeo = (math.log(b1) + math.log(b2) + math.log(b3)) / 3.0
float geoMean = math.exp(logGeo)
float flatness = arithMean > 0 ? geoMean / arithMean : 0.0
var float __obs_plot0 = na
__obs_plot0 := flatness
plot(flatness, "Flatness")
