//@version=5
indicator("CondEnt06")
var float jointUp = 0.0
var float jointDown = 0.0
var float totalN = 0.0
totalN := totalN + 1.0
isUp = close > open
volHigh = volume > 1000
if isUp and volHigh
    jointUp := jointUp + 1.0
if not isUp and not volHigh
    jointDown := jointDown + 1.0
pJU = totalN > 0 ? jointUp / totalN : 0.0
pJD = totalN > 0 ? jointDown / totalN : 0.0
condEnt = pJU > 0.001 ? -pJU * math.log(pJU) : 0.0
condEnt := condEnt + (pJD > 0.001 ? -pJD * math.log(pJD) : 0.0)
var float __obs_plot0 = na
__obs_plot0 := condEnt
plot(condEnt, "ce")
