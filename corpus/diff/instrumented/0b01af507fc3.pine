
//@version=5
indicator("Harmonic Mean")
recipSum = 0.0
count = 0
for i = 0 to 4
    val = close[i]
    if not na(val) and val > 0
        recipSum := recipSum + 1.0 / val
        count := count + 1
hMean = count > 0 and recipSum > 0 ? count / recipSum : 0.0
var float __obs_plot0 = na
__obs_plot0 := hMean
plot(hMean, "HM")
