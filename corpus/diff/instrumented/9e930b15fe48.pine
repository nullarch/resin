
//@version=5
indicator("Log Exp")
logClose = close > 0 ? math.log(close) : 0.0
logReturn = close > 0 and close[1] > 0 ? math.log(close / close[1]) : 0.0
expSmooth = math.exp(math.min(logReturn * 10, 5.0))
var float __obs_plot0 = na
__obs_plot0 := logReturn
plot(logReturn, "LR")
var float __obs_plot1 = na
__obs_plot1 := expSmooth
plot(expSmooth, "Exp")
