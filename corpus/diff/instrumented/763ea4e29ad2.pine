
//@version=5
indicator("Risk Mon")
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
volRisk = avgATR > 0 ? atr / avgATR : 1.0
momRisk = math.abs(rsi - 50) / 50
totalRisk = volRisk * 0.6 + momRisk * 0.4
riskLevel = totalRisk > 2.0 ? "HIGH" : totalRisk > 1.0 ? "MED" : "LOW"
isHigh = riskLevel == "HIGH"
var float __obs_plot0 = na
__obs_plot0 := totalRisk
plot(totalRisk, "Risk")
var float __obs_plot1 = na
__obs_plot1 := isHigh ? 1 : 0
plot(isHigh ? 1 : 0, "Hi")
