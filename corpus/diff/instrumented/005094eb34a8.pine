
//@version=5
indicator("Math Full")
ret = close[1] > 0 ? math.log(close / close[1]) : 0.0
sqRet = math.pow(ret, 2)
absRet = math.abs(ret)
sqrtAbsRet = math.sqrt(absRet)
rounded = math.round(ret * 10000) / 10000
maxVal = math.max(ret, 0.0)
minVal = math.min(ret, 0.0)
clamped = math.max(math.min(ret, 0.05), -0.05)
var float __obs_plot0 = na
__obs_plot0 := clamped * 100
plot(clamped * 100, "C")
