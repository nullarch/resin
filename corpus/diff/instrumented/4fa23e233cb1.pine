
//@version=5
indicator("Max Consec")
var int currentStreak = 0
var int maxStreak = 0
var float prevClose = 0.0
if prevClose > 0
    if close > prevClose
        currentStreak := currentStreak > 0 ? currentStreak + 1 : 1
    else
        currentStreak := currentStreak < 0 ? currentStreak - 1 : -1
if math.abs(currentStreak) > maxStreak
    maxStreak := math.abs(currentStreak)
prevClose := close
var float __obs_plot0 = na
__obs_plot0 := currentStreak
plot(currentStreak, "Streak")
var float __obs_plot1 = na
__obs_plot1 := maxStreak
plot(maxStreak, "Max")
