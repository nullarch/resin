//@version=5
indicator("Comprehensive", overlay=true)
length = 5
src = close
smaVal = ta.sma(src, length)
emaVal = ta.ema(src, length)
rsiVal = ta.rsi(src, length)
atrVal = ta.atr(high, low, close, length)
[macdLine, signalLine, hist] = ta.macd(src, 3, 5, 3)
trend = emaVal > smaVal ? 1 : -1
strength = rsiVal / 100
atrPct = atrVal / close * 100
bullish = trend == 1 and strength > 0.5
var float __obs_plot0 = na
__obs_plot0 := smaVal
plot(smaVal)
var float __obs_plot1 = na
__obs_plot1 := emaVal
plot(emaVal)
