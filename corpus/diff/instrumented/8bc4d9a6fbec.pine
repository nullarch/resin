//@version=5
indicator("ATR Channels", overlay=true)
length = 14
mult = 2.0
basis = ta.sma(close, length)
atr = ta.atr(length)
upper = basis + mult * atr
lower = basis - mult * atr
expanding = atr > atr[1]
var float __obs_plot0 = na
__obs_plot0 := basis
plot(basis)
var float __obs_plot1 = na
__obs_plot1 := upper
plot(upper)
var float __obs_plot2 = na
__obs_plot2 := lower
plot(lower)
var float __obs_plot3 = na
__obs_plot3 := expanding ? 1.0 : 0.0
plot(expanding ? 1.0 : 0.0)
