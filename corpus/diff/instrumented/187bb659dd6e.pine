
//@version=5
indicator("Mom Level")
enum MomLevel
    Strong = 3
    Moderate = 2
    Weak = 1
    None_ = 0

rsi = nz(ta.rsi(close, 3), 50.0)
diff = math.abs(rsi - 50)
level = diff > 30 ? MomLevel.Strong : diff > 15 ? MomLevel.Moderate : diff > 5 ? MomLevel.Weak : MomLevel.None_
var float __obs_plot0 = na
__obs_plot0 := int(level)
plot(int(level), "Lvl")
