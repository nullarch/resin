
//@version=5
indicator("Sig Lbl")
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
direction = close > sma3 ? "LONG" : "SHORT"
confidence = rsi > 60 or rsi < 40 ? "HIGH" : "LOW"
label = direction + "_" + confidence
isLongHigh = label == "LONG_HIGH"
var float __obs_plot0 = na
__obs_plot0 := isLongHigh ? 1 : 0
plot(isLongHigh ? 1 : 0, "LH")
