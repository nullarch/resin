
//@version=5
indicator("LB Ext")
highestRSI = 0.0
lowestRSI = 100.0
rsi = nz(ta.rsi(close, 3), 50.0)
for i = 0 to 4
    r = rsi[i]
    if not na(r)
        highestRSI := math.max(highestRSI, r)
        lowestRSI := math.min(lowestRSI, r)
rsiRange = highestRSI - lowestRSI
var float __obs_plot0 = na
__obs_plot0 := rsiRange
plot(rsiRange, "Rng")
