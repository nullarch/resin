
//@version=5
indicator("Stat Report")
mean = ta.sma(close, 5)
sd = ta.stdev(close, 5)
zscore = sd > 0 ? (close - mean) / sd : 0.0
zLabel = zscore > 1 ? "HIGH" : zscore < -1 ? "LOW" : "MID"
volLabel = sd > mean * 0.02 ? "VOLATILE" : "STABLE"
report = zLabel + "_" + volLabel
isHighVol = str.contains(report, "VOLATILE")
var float __obs_plot0 = na
__obs_plot0 := isHighVol ? 1 : 0
plot(isHighVol ? 1 : 0, "HV")
