
//@version=5
indicator("Tick Hist")
var float[] ticks = array.new_float(0)
tick = close - close[1]
if not na(tick)
    array.push(ticks, tick)
if array.size(ticks) > 8
    array.shift(ticks)
posCount = 0
for i = 0 to math.max(array.size(ticks) - 1, 0)
    if i < array.size(ticks) and array.get(ticks, i) > 0
        posCount := posCount + 1
tickBias = array.size(ticks) > 0 ? float(posCount) / array.size(ticks) : 0.5
var float __obs_plot0 = na
__obs_plot0 := tickBias
plot(tickBias, "Bias")
