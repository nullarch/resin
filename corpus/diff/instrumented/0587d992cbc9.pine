
//@version=5
indicator("Band Widths")
var float[] widths = array.new_float(0)
[mid, upper, lower] = ta.bb(close, 5, 2.0)
width = upper - lower
array.push(widths, width)
if array.size(widths) > 10
    array.shift(widths)
avgWidth = array.size(widths) > 0 ? array.avg(widths) : width
isSqueeze = width < avgWidth * 0.8
var float __obs_plot0 = na
__obs_plot0 := isSqueeze ? 1 : 0
plot(isSqueeze ? 1 : 0, "Sq")
