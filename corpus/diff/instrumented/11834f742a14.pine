
//@version=5
indicator("ATR Norm")
atr = ta.atr(3)
normATR = close > 0 ? atr / close * 100 : 0.0
avgNormATR = ta.sma(normATR, 5)
isVolatile = normATR > avgNormATR * 1.5
var float __obs_plot0 = na
__obs_plot0 := normATR
plot(normATR, "NATR")
var float __obs_plot1 = na
__obs_plot1 := isVolatile ? 1 : 0
plot(isVolatile ? 1 : 0, "Vol")
