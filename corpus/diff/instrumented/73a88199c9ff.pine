//@version=5
indicator("Isostatic Rebound")
var float depression = 0.0
var float rebound = 0.0
load = volume > 1200 ? (volume - 1000) / 100.0 : 0.0
relaxTime = 5.0
depression := depression + load
reboundRate = depression / relaxTime
rebound := rebound + reboundRate
depression := math.max(depression - reboundRate, 0.0)
var float __obs_plot0 = na
__obs_plot0 := rebound
plot(rebound)
