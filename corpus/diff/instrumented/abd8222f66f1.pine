
//@version=5
indicator("Mom Lbl")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
rsiLabel = rsi > 60 ? "RSI+" : rsi < 40 ? "RSI-" : "RSI="
trendLabel = close > sma3 ? "T+" : "T-"
combined = rsiLabel + "|" + trendLabel
isBullish = str.contains(combined, "+") and not str.contains(combined, "-")
var float __obs_plot0 = na
__obs_plot0 := isBullish ? 1 : 0
plot(isBullish ? 1 : 0, "Bull")
