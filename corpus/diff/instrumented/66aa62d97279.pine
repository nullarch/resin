
//@version=5
indicator("Pin Bar")
body = math.abs(close - open)
totalRange = high - low
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
bullPin = totalRange > 0 and lowerWick > totalRange * 0.6 and body < totalRange * 0.3
bearPin = totalRange > 0 and upperWick > totalRange * 0.6 and body < totalRange * 0.3
var float __obs_plot0 = na
__obs_plot0 := bullPin ? 1 : bearPin ? -1 : 0
plot(bullPin ? 1 : bearPin ? -1 : 0, "Pin")
