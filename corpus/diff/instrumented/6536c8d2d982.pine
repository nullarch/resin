
//@version=5
indicator("Skip Cont")
total = 0.0
count = 0
for i = 0 to 7
    c = close[i]
    if na(c)
        continue
    if c < open[i]
        continue
    total := total + c
    count := count + 1
avg = count > 0 ? total / count : close
var float __obs_plot0 = na
__obs_plot0 := avg
plot(avg, "Avg")
