
//@version=5
indicator("VPIN")
var float cumBuyVol = 0.0
var float cumSellVol = 0.0
var float cumTotalVol = 0.0
buyV = close >= open ? volume : 0.0
sellV = close < open ? volume : 0.0
cumBuyVol := cumBuyVol + buyV
cumSellVol := cumSellVol + sellV
cumTotalVol := cumTotalVol + volume
vpin = cumTotalVol > 0 ? math.abs(cumBuyVol - cumSellVol) / cumTotalVol : 0.0
var float __obs_plot0 = na
__obs_plot0 := vpin
plot(vpin, "VPIN")
