
//@version=5
indicator("VAM Combo")
var float[] history = array.new_float(0)
var state = map.new<string, float>()
var int totalBars = 0
totalBars := totalBars + 1
rsi = nz(ta.rsi(close, 3), 50.0)
array.push(history, rsi)
if array.size(history) > 8
    array.shift(history)
map.put(state, "avg_rsi", array.avg(history))
map.put(state, "bar_count", float(totalBars))
avgRSI = map.get(state, "avg_rsi", 50.0)
var float __obs_plot0 = na
__obs_plot0 := avgRSI
plot(avgRSI, "AvgRSI")
