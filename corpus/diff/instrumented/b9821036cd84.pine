
//@version=5
indicator("Change Analysis")
chg1 = ta.change(close, 1)
chg3 = ta.change(close, 3)
chg5 = ta.change(close, 5)
accelerating = nz(chg1) > 0 and nz(chg3) > 0 and nz(chg5) > 0
decelerating = nz(chg1) < nz(chg3)
var float __obs_plot0 = na
__obs_plot0 := nz(chg1)
plot(nz(chg1), "Chg1")
var float __obs_plot1 = na
__obs_plot1 := accelerating ? 1 : 0
plot(accelerating ? 1 : 0, "Accel")
