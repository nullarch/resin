//@version=5
indicator("UDT Drawing")
type Container
    float price = 0.0
    float spread = 0.0
var Container c = Container.new()
c.price := close
c.spread := high - low
label_text = str.format("P:{0} S:{1}", str.tostring(c.price), str.tostring(c.spread))
var float __obs_plot0 = na
__obs_plot0 := c.price
plot(c.price)
var float __obs_plot1 = na
__obs_plot1 := c.spread
plot(c.spread)
