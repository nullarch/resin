//@version=5
indicator("Cond Color Hist")
fast = ta.ema(close, 12)
slow = ta.ema(close, 26)
hist = fast - slow
c = hist > 0 ?
    (hist > nz(hist[1], 0) ? color.lime : color.green) :
    (hist < nz(hist[1], 0) ? color.red : color.maroon)
var float __obs_plot0 = na
__obs_plot0 := hist
plot(hist, color=c)
