//@version=5
indicator("GameDash")
var float cumRegretA = 0.0
var float cumRegretB = 0.0
a11 = close - open
a12 = -(high - close)
a21 = close - low
a22 = -(high - low)
minR1 = math.min(a11, a12)
minR2 = math.min(a21, a22)
maximin = math.max(minR1, minR2)
denom = a11 - a12 - a21 + a22
mixedP = math.abs(denom) > 0.01 ? (a22 - a21) / denom : 0.5
mixedP := math.max(0.0, math.min(1.0, mixedP))
payA = close - open
payB = high - close
chosen = cumRegretA >= cumRegretB ? payA : payB
cumRegretA := math.max(0.0, cumRegretA + (payA - chosen))
cumRegretB := math.max(0.0, cumRegretB + (payB - chosen))
totalReg = cumRegretA + cumRegretB
regretProb = totalReg > 0.01 ? cumRegretA / totalReg : 0.5
var float __obs_plot0 = na
__obs_plot0 := maximin
plot(maximin, "Maximin")
var float __obs_plot1 = na
__obs_plot1 := mixedP
plot(mixedP, "MixP")
var float __obs_plot2 = na
__obs_plot2 := regretProb
plot(regretProb, "RegProb")
