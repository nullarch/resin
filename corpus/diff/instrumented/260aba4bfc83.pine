//@version=5
indicator("DetailSign")
var int streak = 0
prev = nz(close[1], close)
detail = close - prev
if detail > 0
    streak := streak > 0 ? streak + 1 : 1
else if detail < 0
    streak := streak < 0 ? streak - 1 : -1
else
    streak := 0
var float __obs_plot0 = na
__obs_plot0 := float(streak)
plot(float(streak), "Streak")
