//@version=5
indicator("WhileVarIfMath")
var float runMax = 0.0
var float runMin = 999.0
spread = high - low
runMax := math.max(runMax, spread)
runMin := math.min(runMin, spread)
idx = 0
total = 0.0
while idx < 3
    total := total + 1.0
    idx := idx + 1
var float __obs_plot0 = na
__obs_plot0 := runMax - runMin + total
plot(runMax - runMin + total, "R")
