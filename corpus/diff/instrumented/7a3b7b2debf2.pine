
//@version=5
indicator("Rising Falling")
isRising = ta.rising(close, 3)
isFalling = ta.falling(close, 3)
var int riseCount = 0
var int fallCount = 0
if isRising
    riseCount := riseCount + 1
if isFalling
    fallCount := fallCount + 1
var float __obs_plot0 = na
__obs_plot0 := riseCount
plot(riseCount, "Rises")
var float __obs_plot1 = na
__obs_plot1 := fallCount
plot(fallCount, "Falls")
