//@version=5
indicator("WP Distance")
float birth1 = low
float death1 = high
float birth2 = open
float death2 = close
float pers1 = death1 - birth1
float pers2 = math.abs(death2 - birth2)
float wpDist = math.abs(pers1 - pers2)
var float cumWP = 0.0
cumWP := cumWP + wpDist
var float __obs_plot0 = na
__obs_plot0 := cumWP
plot(cumWP, "WPDist")
