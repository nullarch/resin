//@version=5
indicator("Tectonic Stress")
var float stress = 0.0
var float ruptureThreshold = 30.0
strain = math.abs(close - open) * 0.5
stress := stress + strain
if stress > ruptureThreshold
    stress := stress * 0.3
    ruptureThreshold := ruptureThreshold * 1.1
var float __obs_plot0 = na
__obs_plot0 := stress
plot(stress)
