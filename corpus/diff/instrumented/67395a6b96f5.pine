
//@version=5
indicator("Mom Dash")
var md = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
[m, s, h] = ta.macd(close, 3, 5, 3)
k = ta.stoch(close, high, low, 5)
map.put(md, "rsi", rsi)
map.put(md, "macd_h", h)
map.put(md, "stoch", k)
bullCount = 0
bullCount := bullCount + (rsi > 50 ? 1 : 0)
bullCount := bullCount + (h > 0 ? 1 : 0)
bullCount := bullCount + (k > 50 ? 1 : 0)
var float __obs_plot0 = na
__obs_plot0 := bullCount
plot(bullCount, "Bull")
