//@version=5
indicator("FitWeights")
fitArr = array.new_float(0)
array.push(fitArr, math.max(close - open, 0.01))
array.push(fitArr, math.max(high - close, 0.01))
array.push(fitArr, math.max(close - low, 0.01))
totalFit = array.sum(fitArr)
weights = array.new_float(0)
for [idx, f] in fitArr
    w = totalFit > 0 ? f / totalFit : 1.0 / 3.0
    array.push(weights, w)
var float __obs_plot0 = na
__obs_plot0 := array.max(weights)
plot(array.max(weights), "MaxW")
