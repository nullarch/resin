
//@version=5
indicator("MA Converge")
sma5 = ta.sma(close, 5)
ema5 = ta.ema(close, 5)
diff = math.abs(sma5 - ema5)
avgDiff = ta.sma(diff, 3)
converging = diff < avgDiff
var float __obs_plot0 = na
__obs_plot0 := diff
plot(diff, "Diff")
var float __obs_plot1 = na
__obs_plot1 := converging ? 1 : 0
plot(converging ? 1 : 0, "Conv")
