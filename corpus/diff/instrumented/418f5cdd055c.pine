
//@version=5
indicator("LB Score")
sma3 = ta.sma(close, 3)
score = 0.0
for i = 0 to 4
    c = close[i]
    m = sma3[i]
    if not na(c) and not na(m)
        weight = 1.0 - float(i) * 0.15
        score := score + (c > m ? weight : -weight)
var float __obs_plot0 = na
__obs_plot0 := score
plot(score, "Score")
