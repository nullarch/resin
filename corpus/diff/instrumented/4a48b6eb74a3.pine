
//@version=5
indicator("Sort Median")
arr = array.from(5.0, 1.0, 3.0, 2.0, 4.0)
array.sort(arr)
med = array.median(arr)
first = array.first(arr)
last_ = array.last(arr)
var float __obs_plot0 = na
__obs_plot0 := med
plot(med, "Median")
var float __obs_plot1 = na
__obs_plot1 := first
plot(first, "First")
var float __obs_plot2 = na
__obs_plot2 := last_
plot(last_, "Last")
