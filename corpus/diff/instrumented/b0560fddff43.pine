
//@version=5
indicator("Enum UDT")
enum Signal
    StrongBuy = 2
    Buy = 1
    Neutral = 0
    Sell = -1
    StrongSell = -2

type Analysis
    Signal signal = Signal.Neutral
    float confidence = 0.0
    int score = 0

var Analysis a = Analysis.new()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
bullPoints = (rsi > 55 ? 1 : 0) + (close > sma3 ? 1 : 0)
a.score := bullPoints
a.signal := bullPoints == 2 ? Signal.StrongBuy : bullPoints == 1 ? Signal.Buy : Signal.Neutral
a.confidence := float(bullPoints) / 2.0
var float __obs_plot0 = na
__obs_plot0 := int(a.signal)
plot(int(a.signal), "Sig")
