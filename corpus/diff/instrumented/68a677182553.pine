//@version=5
indicator("DG-05 Frenet Normal")
var float normalX = 0.0
var float normalY = 0.0
if not na(close[1])
    tx = 1.0
    ty = close - close[1]
    mag = math.sqrt(tx * tx + ty * ty)
    mag := math.max(mag, 0.001)
    normalX := -ty / mag
    normalY := tx / mag
var float __obs_plot0 = na
__obs_plot0 := normalX
plot(normalX)
var float __obs_plot1 = na
__obs_plot1 := normalY
plot(normalY)
