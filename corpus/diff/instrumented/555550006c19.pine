
//@version=5
indicator("Signal Agg")
var signals = map.new<string, float>()
map.put(signals, "trend", close > ta.sma(close, 3) ? 1.0 : -1.0)
map.put(signals, "mom", ta.rsi(close, 3) > 50 ? 1.0 : -1.0)
map.put(signals, "vol", ta.atr(3) > ta.sma(ta.atr(3), 5) ? 1.0 : -1.0)
composite = (map.get(signals, "trend", 0.0) + map.get(signals, "mom", 0.0) + map.get(signals, "vol", 0.0)) / 3.0
var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "Composite")
