
//@version=5
indicator("Regime Trans")
var int prevRegime = 0
var int transitions = 0
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
regime = close > sma3 and rsi > 55 ? 1 : close < sma3 and rsi < 45 ? -1 : 0
if regime != prevRegime and regime != 0
    transitions := transitions + 1
prevRegime := regime
var float __obs_plot0 = na
__obs_plot0 := transitions
plot(transitions, "Trans")
