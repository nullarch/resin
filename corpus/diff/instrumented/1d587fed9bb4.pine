
//@version=5
indicator("Best Strat")
var scores = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
map.put(scores, "mom", (rsi - 50) / 50)
map.put(scores, "trend", close > sma3 ? 0.5 : -0.5)
map.put(scores, "revert", rsi < 30 ? 1.0 : rsi > 70 ? -1.0 : 0.0)
bestVal = -999.0
for [k, v] in scores
    if v > bestVal
        bestVal := v
var float __obs_plot0 = na
__obs_plot0 := bestVal
plot(bestVal, "Best")
