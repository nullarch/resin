
//@version=5
indicator("Pat Full")
bodySize = math.abs(close - open_)
fullRange = high - low
ratio = fullRange > 0 ? bodySize / fullRange : 0.0
isBull = close > open_

var int bullReversal = 0
var int bearReversal = 0
prevBear = not na(close[1]) and close[1] < open_[1]
prevBull = not na(close[1]) and close[1] > open_[1]
if isBull and prevBear
    bullReversal := bullReversal + 1
if not isBull and prevBull
    bearReversal := bearReversal + 1

strength = ratio > 0.7 ? 3 : ratio > 0.3 ? 2 : 1
dirScore = isBull ? strength : -strength

var float __obs_plot0 = na
__obs_plot0 := dirScore
plot(dirScore, "DS")
var float __obs_plot1 = na
__obs_plot1 := bullReversal - bearReversal
plot(bullReversal - bearReversal, "Rev")
