//@version=5
indicator("Multi Plot")
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi_ = ta.rsi(close, 5)
var float __obs_plot0 = na
__obs_plot0 := sma3
plot(sma3, "SMA", color=color.blue)
var float __obs_plot1 = na
__obs_plot1 := ema5
plot(ema5, "EMA", color=color.red)
hline(70, "Overbought")
hline(30, "Oversold")
bgcolor(rsi_ > 70 ? color.new(color.red, 90) : na)
