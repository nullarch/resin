
//@version=5
indicator("Ind Buf")
var float[] buf = array.new_float(0)
array.push(buf, close)
if array.size(buf) > 5
    array.shift(buf)
mean = array.size(buf) > 0 ? array.avg(buf) : close
deviation = close - mean
normDev = mean > 0 ? deviation / mean * 100 : 0.0
var float __obs_plot0 = na
__obs_plot0 := normDev
plot(normDev, "ND")
