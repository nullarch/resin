
//@version=5
indicator("Multi Alert")
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
avgVol = ta.sma(volume, 5)
cond1 = ta.crossover(close, sma3)
cond2 = rsi > 70
cond3 = avgVol > 0 and volume > avgVol * 2
alertcondition(cond1, "MA Cross")
alertcondition(cond2, "RSI OB")
alertcondition(cond3, "Vol Spike")
activeAlerts = (cond1 ? 1 : 0) + (cond2 ? 1 : 0) + (cond3 ? 1 : 0)
var float __obs_plot0 = na
__obs_plot0 := activeAlerts
plot(activeAlerts, "AA")
