
//@version=5
indicator("Squeeze")
[bbMid, bbUp, bbLow] = ta.bb(close, 5, 2.0)
[kcMid, kcUp, kcLow] = ta.kc(close, 5, 1.5)
squeeze = bbUp < kcUp and bbLow > kcLow
momentum = close - ta.sma(close, 5)
var float __obs_plot0 = na
__obs_plot0 := squeeze ? 1 : 0
plot(squeeze ? 1 : 0, "Squeeze")
var float __obs_plot1 = na
__obs_plot1 := momentum
plot(momentum, "Mom")
