
//@version=5
indicator("For-In Cond")
var data = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
map.put(data, "rsi", rsi)
map.put(data, "trend", close > sma3 ? 1.0 : -1.0)
map.put(data, "volume", volume)
map.put(data, "atr", nz(ta.atr(3), 1.0))
bullish = 0
bearish = 0
for [k, v] in data
    if k == "rsi" and v > 55
        bullish := bullish + 1
    if k == "trend" and v > 0
        bullish := bullish + 1
    if k == "rsi" and v < 45
        bearish := bearish + 1
var float __obs_plot0 = na
__obs_plot0 := bullish - bearish
plot(bullish - bearish, "Net")
