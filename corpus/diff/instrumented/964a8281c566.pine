//@version=5
indicator("WaveTrend")
n1 = 5
n2 = 3
ap = hlc3
esa = ta.ema(ap, n1)
d = ta.ema(math.abs(ap - esa), n1)
ci = (ap - esa) / (0.015 * d)
wt1 = ta.ema(ci, n2)
wt2 = ta.sma(wt1, 3)
var float __obs_plot0 = na
__obs_plot0 := wt1
plot(wt1)
var float __obs_plot1 = na
__obs_plot1 := wt2
plot(wt2)
