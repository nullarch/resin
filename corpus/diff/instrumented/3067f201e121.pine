//@version=5
indicator("DFT05")
var int barN = 0
barN := barN + 1
freq = 3.0
realPart = 0.0
imagPart = 0.0
for k = 0 to 4
    angle = 2.0 * math.pi * freq * float(k) / 5.0
    sample = close + float(k) * 0.1
    realPart := realPart + sample * math.cos(angle)
    imagPart := imagPart - sample * math.sin(angle)
magnitude = math.sqrt(realPart * realPart + imagPart * imagPart)
var float __obs_plot0 = na
__obs_plot0 := magnitude
plot(magnitude, "mag")
