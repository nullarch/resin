
//@version=5
indicator("Body Dist")
var float[] bodies = array.new_float(0)
bodySize = math.abs(close - open_)
array.push(bodies, bodySize)
if array.size(bodies) > 10
    array.shift(bodies)
avgBody = array.size(bodies) > 0 ? array.avg(bodies) : 0.0
maxBody = array.size(bodies) > 0 ? array.max(bodies) : 0.0
isLargeBody = bodySize > avgBody * 1.5
var float __obs_plot0 = na
__obs_plot0 := isLargeBody ? 1 : 0
plot(isLargeBody ? 1 : 0, "LB")
