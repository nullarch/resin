
//@version=5
indicator("Bar Stats")
type BarStats
    float avgBody = 0.0
    float avgRange = 0.0
    int count = 0

var BarStats stats = BarStats.new()
body = math.abs(close - open)
rng = high - low
stats.count := stats.count + 1
n = float(stats.count)
stats.avgBody := stats.avgBody + (body - stats.avgBody) / n
stats.avgRange := stats.avgRange + (rng - stats.avgRange) / n
var float __obs_plot0 = na
__obs_plot0 := stats.avgBody
plot(stats.avgBody, "AvgBody")
var float __obs_plot1 = na
__obs_plot1 := stats.avgRange
plot(stats.avgRange, "AvgRange")
