//@version=5
indicator("DualState06")
var float pos = 100.0
var float vel = 0.0
kp = 0.4
kv = 0.1
predPos = pos + vel
residual = close - predPos
pos := predPos + kp * residual
vel := vel + kv * residual
spread = math.abs(close - pos)
var float __obs_plot0 = na
__obs_plot0 := pos
plot(pos, "pos")
var float __obs_plot1 = na
__obs_plot1 := spread
plot(spread, "spr")
