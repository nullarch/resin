
//@version=5
indicator("Freq Counter")
var m = map.new<string, int>()
direction = close > open ? "up" : "down"
prev = map.get(m, direction, 0)
map.put(m, direction, prev + 1)
ups = map.get(m, "up", 0)
downs = map.get(m, "down", 0)
var float __obs_plot0 = na
__obs_plot0 := ups
plot(ups, "Up Count")
var float __obs_plot1 = na
__obs_plot1 := downs
plot(downs, "Down Count")
