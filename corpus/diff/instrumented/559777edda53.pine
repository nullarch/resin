//@version=5
indicator("MeasNoise11")
var float est = 100.0
var float noiseEst = 1.0
gain = 0.3
resid = close - est
est := est + gain * resid
noiseEst := 0.95 * noiseEst + 0.05 * resid * resid
snr = noiseEst > 0.001 ? (est * est) / noiseEst : 0.0
var float __obs_plot0 = na
__obs_plot0 := snr
plot(snr, "snr")
