
//@version=5
indicator("LOBSim")
bids = array.new_float(0)
asks = array.new_float(0)
mid = (high + low) / 2.0
for i = 1 to 5
    array.push(bids, mid - float(i) * 0.3)
    array.push(asks, mid + float(i) * 0.3)
bestBid = array.max(bids)
bestAsk = array.min(asks)
bookSpread = nz(bestAsk, mid) - nz(bestBid, mid)
midFromBook = (nz(bestBid, mid) + nz(bestAsk, mid)) / 2.0
var float __obs_plot0 = na
__obs_plot0 := bookSpread + midFromBook
plot(bookSpread + midFromBook, "LOB")
