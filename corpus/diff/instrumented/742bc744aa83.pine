
//@version=5
indicator("Binary Search")
arr = array.from(1.0, 3.0, 5.0, 7.0, 9.0)
idx = array.binary_search(arr, 5.0)
leftmost = array.binary_search_leftmost(arr, 5.0)
var float __obs_plot0 = na
__obs_plot0 := idx
plot(idx, "Found")
var float __obs_plot1 = na
__obs_plot1 := leftmost
plot(leftmost, "Left")
