
//@version=5
indicator("Enum Dir")
enum Direction
    Long = 1
    Short = -1
    Flat = 0

sma3 = ta.sma(close, 3)
dir = close > sma3 ? Direction.Long : close < sma3 ? Direction.Short : Direction.Flat
isLong = dir == Direction.Long
var float __obs_plot0 = na
__obs_plot0 := isLong ? 1 : 0
plot(isLong ? 1 : 0, "Long")
