
//@version=5
indicator("Dyn Label")
sma3 = ta.sma(close, 3)
rsi = ta.rsi(close, 3)
label = ""
if close > sma3
    label := "BULL"
else
    label := "BEAR"
rsiVal = nz(rsi, 50.0)
if rsiVal > 70
    label := label + " OB"
else if rsiVal < 30
    label := label + " OS"
labelLen = str.length(label)
var float __obs_plot0 = na
__obs_plot0 := labelLen
plot(labelLen, "Len")
