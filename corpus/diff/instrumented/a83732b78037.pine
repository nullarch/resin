
//@version=5
indicator("ScaleInv")
scaleResults = map.new<string, float>()
map.put(scaleResults, "s3", nz(ta.stdev(close, 3), 0.0))
map.put(scaleResults, "s5", nz(ta.stdev(close, 5), 0.0))
totalVar = 0.0
for [key, val] in scaleResults
    totalVar := totalVar + val * val
invariance = math.sqrt(totalVar + 0.0001)
var float __obs_plot0 = na
__obs_plot0 := invariance
plot(invariance, "SI")
