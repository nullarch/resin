//@version=5
indicator("Str Dashboard")
rsi_ = ta.rsi(close, 5)
sma_ = ta.sma(close, 5)
txt = "RSI: " + str.tostring(nz(rsi_), "#.#") + " | SMA: " + str.tostring(nz(sma_), "#.##")
if barstate.islast
    label.new(bar_index, close, txt, color=color.blue, textcolor=color.white)
var float __obs_plot0 = na
__obs_plot0 := close
plot(close)
