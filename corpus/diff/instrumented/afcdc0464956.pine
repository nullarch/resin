//@version=5
indicator("W2 Squared")
float mu1 = nz(ta.sma(close, 5), close)
float mu2 = nz(ta.sma(open, 5), open)
float sig1 = math.max(nz(ta.stdev(close, 5), 1.0), 0.01)
float sig2 = math.max(nz(ta.stdev(open, 5), 1.0), 0.01)
float meanTerm = math.pow(mu1 - mu2, 2)
float varTerm = math.pow(sig1 - sig2, 2)
float w2sq = meanTerm + varTerm
var float __obs_plot0 = na
__obs_plot0 := w2sq
plot(w2sq, "W2Sq")
