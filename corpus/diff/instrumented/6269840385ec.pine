
//@version=5
indicator("Mkt Ctx")
type MarketCtx
    float volatility = 0.0
    float trend = 0.0
    float momentum = 0.0
    int regime = 0

var MarketCtx mctx = MarketCtx.new()
atr = ta.atr(3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
mctx.volatility := close > 0 ? atr / close * 100 : 0.0
mctx.trend := sma5 > 0 ? (close - sma5) / sma5 * 100 : 0.0
mctx.momentum := (rsi - 50) / 50
mctx.regime := mctx.trend > 0 and mctx.momentum > 0 ? 1 : mctx.trend < 0 and mctx.momentum < 0 ? -1 : 0
var float __obs_plot0 = na
__obs_plot0 := mctx.regime
plot(mctx.regime, "Reg")
