
//@version=5
indicator("Micro Full")
body = math.abs(close - open)
rng = high - low
eff = rng > 0 ? body / rng : 0.0
tp = (high + low + close) / 3
avgTP = ta.sma(tp, 5)

// Bar metrics map
var bm = map.new<string, float>()
map.put(bm, "efficiency", eff)
map.put(bm, "range_ratio", ta.sma(rng, 5) > 0 ? rng / ta.sma(rng, 5) : 1.0)
map.put(bm, "tp_dev", avgTP > 0 ? (tp - avgTP) / avgTP * 100 : 0.0)

// History
var float[] effHistory = array.new_float(0)
array.push(effHistory, eff)
if array.size(effHistory) > 8
    array.shift(effHistory)

// Composite
rangeRatio = map.get(bm, "range_ratio", 1.0)
composite = eff * (close > open ? 1.0 : -1.0) * math.min(rangeRatio, 2.0)

var int bars = 0
bars := bars + 1

var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "Comp")
var float __obs_plot1 = na
__obs_plot1 := array.avg(effHistory)
plot(array.avg(effHistory), "AvgE")
