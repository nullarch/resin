
//@version=5
indicator("ADX Str")
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
trendStr = avgATR > 0 ? atr / avgATR * 25 : 0.0
strongTrend = trendStr > 25
weakTrend = trendStr < 15
var float __obs_plot0 = na
__obs_plot0 := trendStr
plot(trendStr, "TS")
var float __obs_plot1 = na
__obs_plot1 := strongTrend ? 1 : 0
plot(strongTrend ? 1 : 0, "Strong")
