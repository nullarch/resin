
//@version=5
indicator("Break Levels")
var float[] breakLevels = array.new_float(0)
hi5 = ta.highest(high, 5)
if close > hi5[1]
    array.push(breakLevels, close)
if array.size(breakLevels) > 5
    array.shift(breakLevels)
avgBreak = array.size(breakLevels) > 0 ? array.avg(breakLevels) : close
var float __obs_plot0 = na
__obs_plot0 := array.size(breakLevels)
plot(array.size(breakLevels), "BL")
