
//@version=5
indicator("Nested TA If")
rsiVal = ta.rsi(close, 3)
smaVal = ta.sma(close, 3)
var int score = 0
if close > smaVal
    if rsiVal > 50
        score := 2
    else
        score := 1
else
    if rsiVal < 50
        score := -2
    else
        score := -1
var float __obs_plot0 = na
__obs_plot0 := score
plot(score, "Score")
