//@version=5
indicator("BB Width")
var float maxWidth = 0.0
float basis = ta.sma(close, 5)
float dev = ta.stdev(close, 5)
float upper = nz(basis, close) + 2.0 * nz(dev, 0.0)
float lower = nz(basis, close) - 2.0 * nz(dev, 0.0)
float width = upper - lower
maxWidth := math.max(maxWidth, width)
var float __obs_plot0 = na
__obs_plot0 := width
plot(width, "BBWidth")
