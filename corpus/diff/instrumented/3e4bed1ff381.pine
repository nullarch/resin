
//@version=5
indicator("Sort Pctl")
var float[] data = array.new_float(0)
array.push(data, close)
if array.size(data) > 8
    array.shift(data)
sorted = array.copy(data)
array.sort(sorted)
p25 = array.size(sorted) > 0 ? array.percentile_nearest_rank(sorted, 25) : close
p75 = array.size(sorted) > 0 ? array.percentile_nearest_rank(sorted, 75) : close
iqr = p75 - p25
var float __obs_plot0 = na
__obs_plot0 := iqr
plot(iqr, "IQR")
