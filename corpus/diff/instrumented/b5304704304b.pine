//@version=5
indicator("Geodesic")
float mu = nz(ta.sma(close, 3), close)
float sig = math.max(nz(ta.stdev(close, 3), 1.0), 0.01)
var float prevMu = 0.0
var float prevSig = 1.0
float geoDistSq = math.pow(mu - prevMu, 2) + math.pow(sig - prevSig, 2)
float geoDist = math.sqrt(geoDistSq)
prevMu := mu
prevSig := sig
var float __obs_plot0 = na
__obs_plot0 := geoDist
plot(geoDist, "GeoDist")
