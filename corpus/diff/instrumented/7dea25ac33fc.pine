
//@version=5
indicator("Linear Search")
target = ta.sma(close, 5)
closestIdx = 0
closestDist = 99999.0
for i = 0 to 4
    if not na(close[i])
        dist = math.abs(close[i] - target)
        if dist < closestDist
            closestDist := dist
            closestIdx := i
var float __obs_plot0 = na
__obs_plot0 := closestIdx
plot(closestIdx, "CI")
