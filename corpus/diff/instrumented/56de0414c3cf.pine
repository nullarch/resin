
//@version=5
indicator("MR Full")
rsi = nz(ta.rsi(close, 3), 50.0)
[mid, upper, lower] = ta.bb(close, 5, 2.0)
k = nz(ta.stoch(close, high, low, 3), 50.0)

pctB = upper > lower ? (close - lower) / (upper - lower) : 0.5
composite = (rsi - 50) / 50 * 0.4 + (k - 50) / 50 * 0.3 + (pctB - 0.5) * 2 * 0.3

var int signals = 0
if composite < -0.5
    signals := signals + 1
else if composite > 0.5
    signals := signals - 1

var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "Comp")
var float __obs_plot1 = na
__obs_plot1 := signals
plot(signals, "Sig")
