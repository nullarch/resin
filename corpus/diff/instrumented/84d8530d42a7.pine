//@version=5
indicator("ActionHist")
actions = array.new_float(0)
rsiVal = nz(ta.rsi(close, 3), 50.0)
action = rsiVal > 50 ? 1.0 : 0.0
array.push(actions, action)
buyCount = 0.0
for i = 0 to array.size(actions) - 1
    buyCount := buyCount + array.get(actions, i)
buyPct = array.size(actions) > 0 ? buyCount / float(array.size(actions)) : 0.0
var float __obs_plot0 = na
__obs_plot0 := buyPct
plot(buyPct, "BuyPct")
