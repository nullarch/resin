//@version=5
indicator("DG-09 Mean Curvature")
var float meanK = 0.0
if not na(close[2]) and not na(volume[2])
    kP = (close - close[1]) - (close[1] - close[2])
    kV = ((volume - volume[1]) - (volume[1] - volume[2])) / 1000.0
    meanK := (kP + kV) / 2.0
var float __obs_plot0 = na
__obs_plot0 := meanK
plot(meanK)
