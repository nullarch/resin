//@version=5
indicator("POT Threshold")
float prevC = not na(close[1]) ? close[1] : close
float retAbs = math.abs(close - prevC)
float threshold = nz(ta.atr(5), 1.0) * 1.5
float exceed = retAbs > threshold ? retAbs - threshold : 0.0
var float __obs_plot0 = na
__obs_plot0 := exceed
plot(exceed, "Exceed")
