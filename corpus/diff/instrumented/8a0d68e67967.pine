
//@version=5
indicator("Adaptive System")
// Volatility regime
atrVal = ta.atr(3)
smaATR = ta.sma(atrVal, 5)
highVol = atrVal > smaATR * 1.2

// Adaptive parameters
fastLen = highVol ? 3 : 5
slowLen = highVol ? 5 : 8

// Adaptive MAs
fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)

// Signal generation
var int position = 0
var int totalTrades = 0
if ta.crossover(fastMA, slowMA) and position <= 0
    position := 1
    totalTrades := totalTrades + 1
else if ta.crossunder(fastMA, slowMA) and position >= 0
    position := -1
    totalTrades := totalTrades + 1

// Risk metrics
var float maxDD = 0.0
var float peak = 0.0
if close > peak
    peak := close
dd = peak > 0 ? (peak - close) / peak * 100 : 0.0
if dd > maxDD
    maxDD := dd

// Score tracking
var float[] scores = array.new_float(0)
score = float(position) * (fastMA - slowMA)
array.push(scores, score)

var float __obs_plot0 = na
__obs_plot0 := position
plot(position, "Position")
var float __obs_plot1 = na
__obs_plot1 := totalTrades
plot(totalTrades, "Trades")
var float __obs_plot2 = na
__obs_plot2 := maxDD
plot(maxDD, "MaxDD")
