//@version=5
indicator("KLDiv07")
var float upPrior = 0.5
var float upObs = 0.0
var float cnt = 0.0
cnt := cnt + 1.0
if close > open
    upObs := upObs + 1.0
pObs = cnt > 0 ? upObs / cnt : 0.5
pObsDown = 1.0 - pObs
kl = 0.0
if pObs > 0.001 and upPrior > 0.001
    kl := pObs * math.log(pObs / upPrior)
if pObsDown > 0.001 and (1.0 - upPrior) > 0.001
    kl := kl + pObsDown * math.log(pObsDown / (1.0 - upPrior))
var float __obs_plot0 = na
__obs_plot0 := kl
plot(kl, "kl")
