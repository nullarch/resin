
//@version=5
indicator("Pctile")
var float[] vals = array.new_float(0)
array.push(vals, close)
if array.size(vals) > 10
    array.shift(vals)
sorted = array.copy(vals)
array.sort(sorted)
sz = array.size(sorted)
p25idx = int(sz * 0.25)
p75idx = int(sz * 0.75)
p25idx := p25idx < sz ? p25idx : sz - 1
p75idx := p75idx < sz ? p75idx : sz - 1
p25 = sz > 0 ? array.get(sorted, p25idx) : close
p75 = sz > 0 ? array.get(sorted, p75idx) : close
iqr = p75 - p25
var float __obs_plot0 = na
__obs_plot0 := iqr
plot(iqr, "IQR")
