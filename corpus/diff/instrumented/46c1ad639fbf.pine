//@version=5
indicator("WVF")
pd = 5
bbl = 5
mult = 2.0

highest_close = ta.highest(close, pd)
wvf = (nz(highest_close) - low) / nz(highest_close, 1) * 100
upperBand = nz(ta.sma(wvf, bbl)) + mult * nz(ta.stdev(wvf, bbl))

var bool signal = false
signal := wvf >= upperBand
var float __obs_plot0 = na
__obs_plot0 := close
plot(close)
