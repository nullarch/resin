//@version=5
indicator("TernPeriod16")
atrVal = nz(ta.atr(3), 1.0)
period = atrVal > 5.0 ? 3.0 : atrVal > 3.0 ? 5.0 : 7.0
var int barN = 0
barN := barN + 1
cycleVal = math.sin(2.0 * math.pi * float(barN) / period)
detrended = close - nz(ta.sma(close, 3), close)
correlation = cycleVal * detrended
var float __obs_plot0 = na
__obs_plot0 := correlation
plot(correlation, "corr")
