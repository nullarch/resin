
//@version=5
indicator("Mom Sum")
momSum = 0.0
for i = 0 to 4
    c = close[i]
    prev = close[i + 1]
    if not na(c) and not na(prev) and prev > 0
        momSum := momSum + (c - prev) / prev
avgMom = momSum / 5
var float __obs_plot0 = na
__obs_plot0 := avgMom * 100
plot(avgMom * 100, "AvgMom")
