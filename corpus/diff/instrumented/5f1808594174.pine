//@version=5
indicator("ES Proxy")
float prevC = not na(close[1]) ? close[1] : close
float logRet = prevC > 0 ? math.log(close / prevC) : 0.0
float mu = ta.sma(logRet, 5)
float sigma = ta.stdev(logRet, 5)
float varLevel = mu - 1.65 * sigma
float tailLoss = logRet < varLevel ? logRet : varLevel
float es = ta.sma(tailLoss, 5)
var float __obs_plot0 = na
__obs_plot0 := es
plot(es, "ES")
