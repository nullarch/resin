
//@version=5
indicator("Trend Track")
var int trendBars = 0
var int trendDir = 0
sma3 = ta.sma(close, 3)
newDir = close > sma3 ? 1 : -1
if newDir == trendDir
    trendBars := trendBars + 1
else
    trendDir := newDir
    trendBars := 1
var float __obs_plot0 = na
__obs_plot0 := trendBars * trendDir
plot(trendBars * trendDir, "TB")
