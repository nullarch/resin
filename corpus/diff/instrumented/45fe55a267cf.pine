//@version=5
indicator("ETrace")
var float trace = 0.0
gammaLam = 0.8
reward = close > open ? 1.0 : -1.0
rsiVal = nz(ta.rsi(close, 3), 50.0)
isActive = rsiVal > 50 ? 1.0 : 0.0
trace := gammaLam * trace + isActive
var float valueEst = 0.0
alphaLR = 0.05
tdError = reward - valueEst
valueEst := valueEst + alphaLR * tdError * trace
var float __obs_plot0 = na
__obs_plot0 := valueEst
plot(valueEst, "VEst")
