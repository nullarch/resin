
//@version=5
indicator("Vol Metrics")
var vm = map.new<string, float>()
atr = nz(ta.atr(3), 1.0)
barRange = high - low
map.put(vm, "atr", atr)
map.put(vm, "range", barRange)
map.put(vm, "ratio", barRange > 0 ? atr / barRange : 1.0)
total = 0.0
for [k, v] in vm
    total := total + v
var float __obs_plot0 = na
__obs_plot0 := total
plot(total, "T")
