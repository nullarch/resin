
//@version=5
indicator("Histogram")
posCount = 0
negCount = 0
for i = 0 to 4
    ret = close[i] - close[i+1]
    if not na(ret)
        if ret > 0
            posCount := posCount + 1
        else
            negCount := negCount + 1
skewProxy = posCount - negCount
var float __obs_plot0 = na
__obs_plot0 := skewProxy
plot(skewProxy, "Skew")
