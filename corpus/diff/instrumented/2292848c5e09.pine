
//@version=5
indicator("Trade Res")
var float[] trades = array.new_float(0)
var bool inPos = false
var float entry = 0.0
sma3 = ta.sma(close, 3)
if not inPos and close > sma3
    inPos := true
    entry := close
if inPos and close < sma3
    array.push(trades, close - entry)
    inPos := false
numTrades = array.size(trades)
avgTrade = numTrades > 0 ? array.avg(trades) : 0.0
bestTrade = numTrades > 0 ? array.max(trades) : 0.0
worstTrade = numTrades > 0 ? array.min(trades) : 0.0
var float __obs_plot0 = na
__obs_plot0 := avgTrade
plot(avgTrade, "Avg")
