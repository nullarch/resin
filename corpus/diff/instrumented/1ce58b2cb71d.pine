
//@version=5
indicator("Corr Win")
var float[] xs = array.new_float(0)
var float[] ys = array.new_float(0)
array.push(xs, close - open)
array.push(ys, high - low)
if array.size(xs) > 6
    array.shift(xs)
    array.shift(ys)
cov = array.covariance(xs, ys)
sdX = array.stdev(xs)
sdY = array.stdev(ys)
corr = sdX > 0 and sdY > 0 ? cov / (sdX * sdY) : 0.0
var float __obs_plot0 = na
__obs_plot0 := corr
plot(corr, "Corr")
