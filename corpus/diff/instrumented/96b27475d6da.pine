
//@version=5
indicator("Trend St")
type TrendState
    int direction = 0
    int bars = 0
    float startPrice = 0.0

var TrendState ts = TrendState.new()
sma3 = ta.sma(close, 3)
newDir = close > sma3 ? 1 : -1
if newDir != ts.direction
    ts.direction := newDir
    ts.bars := 1
    ts.startPrice := close
else
    ts.bars := ts.bars + 1
trendReturn = ts.startPrice > 0 ? (close - ts.startPrice) / ts.startPrice * 100 : 0.0
var float __obs_plot0 = na
__obs_plot0 := trendReturn
plot(trendReturn, "TRet")
