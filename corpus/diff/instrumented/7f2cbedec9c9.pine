//@version=5
indicator("Persistence BD")
float rsiVal = nz(ta.rsi(close, 3), 50.0)
var float birthLevel = 0.0
var float deathLevel = 0.0
var bool featureAlive = false
if rsiVal > 60.0 and not featureAlive
    birthLevel := close
    featureAlive := true
if rsiVal < 40.0 and featureAlive
    deathLevel := close
    featureAlive := false
float persistence = math.abs(deathLevel - birthLevel)
var float __obs_plot0 = na
__obs_plot0 := persistence
plot(persistence, "Persist")
