
//@version=5
indicator("Agree")
rsi = nz(ta.rsi(close, 3), 50.0)
[m, s, h] = ta.macd(close, 3, 5, 3)
k = ta.stoch(close, high, low, 5)
sma3 = ta.sma(close, 3)
bullish = 0
bullish := bullish + (rsi > 50 ? 1 : 0)
bullish := bullish + (h > 0 ? 1 : 0)
bullish := bullish + (k > 50 ? 1 : 0)
bullish := bullish + (close > sma3 ? 1 : 0)
agreement = bullish >= 3 ? 1 : bullish <= 1 ? -1 : 0
var float __obs_plot0 = na
__obs_plot0 := agreement
plot(agreement, "Agr")
