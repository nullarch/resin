
//@version=5
indicator("Status")
sma3 = ta.sma(close, 3)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)
status = "["
status := status + (close > sma3 ? "UP" : "DN")
status := status + "|"
rsiVal = nz(rsi, 50.0)
status := status + (rsiVal > 60 ? "STRONG" : rsiVal < 40 ? "WEAK" : "NEUTRAL")
status := status + "]"
var float __obs_plot0 = na
__obs_plot0 := str.length(status)
plot(str.length(status), "Len")
