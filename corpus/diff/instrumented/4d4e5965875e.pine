
//@version=5
indicator("Vol Reg")
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
sd = ta.stdev(close, 5)
avgSD = ta.sma(sd, 3)
volRatio = avgATR > 0 ? atr / avgATR : 1.0
sdRatio = avgSD > 0 ? sd / avgSD : 1.0
regime = (volRatio + sdRatio) / 2
isHighVol = regime > 1.3
var float __obs_plot0 = na
__obs_plot0 := regime
plot(regime, "VR")
