
//@version=5
indicator("MA FI")
var md = map.new<string, float>()
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
map.put(md, "fast_dist", close - sma3)
map.put(md, "slow_dist", close - sma5)
map.put(md, "spread", sma3 - sma5)
total = 0.0
for [k, v] in md
    total := total + v
var float __obs_plot0 = na
__obs_plot0 := total
plot(total, "T")
