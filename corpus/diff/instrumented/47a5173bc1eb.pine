
//@version=5
indicator("Roll Corr")
agreements = 0
total = 0
sma3 = ta.sma(close, 3)
for i = 0 to 4
    c = close[i]
    s = sma3[i]
    if not na(c) and not na(s)
        total := total + 1
        if (c > s and close > sma3) or (c < s and close < sma3)
            agreements := agreements + 1
corr = total > 0 ? agreements / total : 0.0
var float __obs_plot0 = na
__obs_plot0 := corr
plot(corr, "Corr")
