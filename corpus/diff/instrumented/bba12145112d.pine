
//@version=5
indicator("Div Full")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)

var int bullDivs = 0
var int bearDivs = 0

priceUp = close > close[1]
priceDn = close < close[1]
rsiUp = rsi > 50
rsiDn = rsi < 50

if priceUp and rsiDn
    bearDivs := bearDivs + 1
if priceDn and rsiUp
    bullDivs := bullDivs + 1

volConfirm = volume > ta.sma(volume, 3)
confirmedDiv = (priceUp and rsiDn and volConfirm) or (priceDn and rsiUp and volConfirm)

var float __obs_plot0 = na
__obs_plot0 := bullDivs - bearDivs
plot(bullDivs - bearDivs, "Net")
var float __obs_plot1 = na
__obs_plot1 := confirmedDiv ? 1 : 0
plot(confirmedDiv ? 1 : 0, "Conf")
