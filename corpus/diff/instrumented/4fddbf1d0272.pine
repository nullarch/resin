
//@version=5
indicator("Wt Osc")
totalWt = 0.0
totalVal = 0.0
for i = 0 to 4
    wt = float(5 - i)
    if not na(close[i]) and not na(close[i+1])
        chg = close[i] - close[i+1]
        totalVal := totalVal + chg * wt
        totalWt := totalWt + wt
wosc = totalWt > 0 ? totalVal / totalWt : 0.0
var float __obs_plot0 = na
__obs_plot0 := wosc
plot(wosc, "WO")
