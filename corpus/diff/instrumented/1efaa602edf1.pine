
//@version=5
indicator("ATR%")
atr = ta.atr(3)
atrPct = close > 0 ? atr / close * 100 : 0.0
avgAtrPct = ta.sma(atrPct, 5)
isHighVol = atrPct > avgAtrPct * 1.5
var float __obs_plot0 = na
__obs_plot0 := atrPct
plot(atrPct, "ATR%")
var float __obs_plot1 = na
__obs_plot1 := isHighVol ? 1 : 0
plot(isHighVol ? 1 : 0, "HiVol")
