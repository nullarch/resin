
//@version=5
indicator("Reg Full")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
[m, s, h] = ta.macd(close, 3, 5, 3)

trendScore = (close > sma3 ? 1.0 : 0.0) + (sma3 > sma5 ? 1.0 : 0.0)
momScore = (rsi > 50 ? 1.0 : 0.0) + (h > 0 ? 1.0 : 0.0)
volAdj = avgATR > 0 ? math.min(atr / avgATR, 2.0) : 1.0

var int regimeDir = 0
var int duration = 0
newDir = trendScore >= 1.5 and momScore >= 1.5 ? 1 : trendScore <= 0.5 and momScore <= 0.5 ? -1 : 0
if newDir != regimeDir and newDir != 0
    regimeDir := newDir
    duration := 0
duration := duration + 1

var int bars = 0
bars := bars + 1

var float __obs_plot0 = na
__obs_plot0 := float(regimeDir)
plot(float(regimeDir), "Dir")
var float __obs_plot1 = na
__obs_plot1 := duration
plot(duration, "Dur")
