
//@version=5
indicator("MFSpec")
scales = array.new_float(0)
array.push(scales, nz(ta.stdev(close, 3), 0.0))
array.push(scales, nz(ta.stdev(close, 5), 0.0))
minV = array.min(scales)
maxV = array.max(scales)
specWidth = nz(maxV, 0.0) - nz(minV, 0.0)
var float __obs_plot0 = na
__obs_plot0 := specWidth
plot(specWidth, "SW")
