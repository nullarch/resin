
//@version=5
indicator("RSI Slope")
rsi = ta.rsi(close, 3)
rsiSlope = rsi - rsi[1]
accelerating = rsiSlope > 0 and rsi > 50
decelerating = rsiSlope < 0 and rsi > 50
var float __obs_plot0 = na
__obs_plot0 := rsiSlope
plot(rsiSlope, "Slope")
var float __obs_plot1 = na
__obs_plot1 := accelerating ? 1 : decelerating ? -1 : 0
plot(accelerating ? 1 : decelerating ? -1 : 0, "Accel")
