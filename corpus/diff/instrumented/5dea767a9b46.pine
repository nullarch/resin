
//@version=5
indicator("Weighted Sum")
arr = array.from(5.0, 4.0, 3.0, 2.0, 1.0)
total = 0.0
weightTotal = 0.0
for [i, val] in arr
    weight = float(array.size(arr) - i)
    total := total + val * weight
    weightTotal := weightTotal + weight
wAvg = total / weightTotal
var float __obs_plot0 = na
__obs_plot0 := wAvg
plot(wAvg, "WAvg")
