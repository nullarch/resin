
//@version=5
indicator("FC Conv")
target = ta.sma(close, 5)
estimate = close
alpha = 0.3
iters = 0
while math.abs(estimate - target) > 0.01 and iters < 50
    estimate := estimate + (target - estimate) * alpha
    iters := iters + 1
var float __obs_plot0 = na
__obs_plot0 := iters
plot(iters, "Its")
