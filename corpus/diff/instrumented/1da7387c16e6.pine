
//@version=5
indicator("Map Remove")
var m = map.new<string, float>()
map.put(m, "value", close)
map.put(m, "threshold", ta.sma(close, 3))
val = map.get(m, "value", close)
thresh = map.get(m, "threshold", close)
above = val > thresh
map.put(m, "above", above ? 1.0 : 0.0)
result = map.get(m, "above", 0.0)
var float __obs_plot0 = na
__obs_plot0 := result
plot(result, "Above")
