
//@version=5
indicator("FilterHist")
var float[] filterHist = array.new_float(0)
smaVal = nz(ta.sma(close, 3), close)
array.push(filterHist, smaVal)
if array.size(filterHist) > 5
    array.shift(filterHist)
avg = array.avg(filterHist)
maxF = array.max(filterHist)
minF = array.min(filterHist)
spread = maxF - minF
var float __obs_plot0 = na
__obs_plot0 := spread
plot(spread, "S")
