
//@version=5
indicator("BB KC Squeeze")
[bbMid, bbUp, bbLo] = ta.bb(close, 5, 2.0)
[kcMid, kcUp, kcLo] = ta.kc(close, 5, 1.5)
squeeze = bbUp < kcUp and bbLo > kcLo
var int squeezeCount = 0
if squeeze
    squeezeCount := squeezeCount + 1
var float __obs_plot0 = na
__obs_plot0 := squeezeCount
plot(squeezeCount, "Squeezes")
