
//@version=5
indicator("IQR")
var float[] window = array.new_float(0)
array.push(window, close)
if array.size(window) > 8
    array.shift(window)
sorted = array.copy(window)
array.sort(sorted)
q1 = array.percentile_linear_interpolation(sorted, 25.0)
q3 = array.percentile_linear_interpolation(sorted, 75.0)
iqr = q3 - q1
upperFence = q3 + 1.5 * iqr
lowerFence = q1 - 1.5 * iqr
withinFence = close >= lowerFence and close <= upperFence
var float __obs_plot0 = na
__obs_plot0 := withinFence ? 1 : 0
plot(withinFence ? 1 : 0, "In")
