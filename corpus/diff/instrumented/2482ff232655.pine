//@version=5
indicator("AUC Trapezoidal")
var float auc = 0.0
var float prevConc = 0.0
conc = math.abs(close - ta.sma(close, 3))
currConc = not na(conc) ? conc : 0.0
trapezoid = (prevConc + currConc) / 2.0
auc := auc + trapezoid
prevConc := currConc
var float __obs_plot0 = na
__obs_plot0 := auc
plot(auc)
