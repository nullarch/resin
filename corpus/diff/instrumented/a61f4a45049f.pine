
//@version=5
indicator("RSI Zones")
rsi = ta.rsi(close, 3)
smoothRSI = ta.sma(rsi, 3)
zone = smoothRSI > 70 ? 3 : smoothRSI > 50 ? 2 : smoothRSI > 30 ? 1 : 0
var float __obs_plot0 = na
__obs_plot0 := smoothRSI
plot(smoothRSI, "SmRSI")
var float __obs_plot1 = na
__obs_plot1 := zone
plot(zone, "Zone")
