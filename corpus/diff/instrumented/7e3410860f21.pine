
//@version=5
indicator("UDT System")
type TradeSys
    float signal = 0.0
    float confidence = 0.0
    int tradeCount = 0
    float maxSignal = -999.0

var TradeSys sys = TradeSys.new()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
sys.signal := (rsi - 50) / 50 * 0.5 + (sma3 > sma5 ? 1 : -1) * 0.5
sys.confidence := math.min(math.abs(sys.signal) * 100, 100.0)
sys.maxSignal := math.max(sys.maxSignal, sys.signal)
if sys.confidence > 60
    sys.tradeCount := sys.tradeCount + 1
var float __obs_plot0 = na
__obs_plot0 := sys.tradeCount
plot(sys.tradeCount, "TC")
