
//@version=5
indicator("Str Metrics")
var sm = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
map.put(sm, "rsi_str", (rsi - 50) / 50)
map.put(sm, "trend_str", sma5 > 0 ? (sma3 - sma5) / sma5 * 100 : 0.0)
map.put(sm, "price_str", sma3 > 0 ? (close - sma3) / sma3 * 100 : 0.0)
totalStr = 0.0
for [k, v] in sm
    totalStr := totalStr + v
var float __obs_plot0 = na
__obs_plot0 := totalStr
plot(totalStr, "TS")
