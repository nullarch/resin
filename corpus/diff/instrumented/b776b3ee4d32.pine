
//@version=5
indicator("Fcst Model")
var fm = map.new<string, float>()
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
trend = ema3 - sma5
map.put(fm, "level", ema3)
map.put(fm, "trend", trend)
map.put(fm, "forecast", ema3 + trend)
fcst = map.get(fm, "forecast", close)
error = close - fcst
var float __obs_plot0 = na
__obs_plot0 := error
plot(error, "Error")
