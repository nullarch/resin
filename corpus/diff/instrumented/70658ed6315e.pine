
//@version=5
indicator("ROC")
period = 3
prevClose = close[period]
roc = not na(prevClose) and prevClose > 0 ? (close - prevClose) / prevClose * 100 : 0.0
rocMA = ta.sma(roc, 3)
var float __obs_plot0 = na
__obs_plot0 := roc
plot(roc, "ROC")
var float __obs_plot1 = na
__obs_plot1 := rocMA
plot(rocMA, "MA")
