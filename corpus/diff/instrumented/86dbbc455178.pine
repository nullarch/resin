
//@version=5
indicator("Vol Wt")
avgVol = ta.sma(volume, 5)
ratio = avgVol > 0 ? volume / avgVol : 1.0
weight = ratio > 2.0 ? 1.5 : ratio > 1.0 ? 1.0 : ratio > 0.5 ? 0.7 : 0.3
rsi = nz(ta.rsi(close, 3), 50.0)
weightedRSI = rsi * weight
var float __obs_plot0 = na
__obs_plot0 := weightedRSI
plot(weightedRSI, "WRSI")
