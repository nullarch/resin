
//@version=5
indicator("Dash UDT")
type Dashboard
    float health = 0.0
    float risk = 0.0
    int signals = 0

var Dashboard db = Dashboard.new()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
atr = nz(ta.atr(3), 1.0)
db.health := (close > sma3 ? 1 : -1) + (rsi - 50) / 50
db.risk := atr / close * 100
if math.abs(db.health) > 1.0
    db.signals := db.signals + 1
var float __obs_plot0 = na
__obs_plot0 := db.signals
plot(db.signals, "Sig")
