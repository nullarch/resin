//@version=5
indicator("BetaBinom")
var float alphaParam = 1.0
var float betaParam = 1.0
isUp = close > nz(close[1], close) ? 1.0 : 0.0
alphaParam := alphaParam + isUp
betaParam := betaParam + (1.0 - isUp)
postMean = alphaParam / (alphaParam + betaParam)
postMode = (alphaParam > 1 and betaParam > 1) ? (alphaParam - 1.0) / (alphaParam + betaParam - 2.0) : postMean
var float __obs_plot0 = na
__obs_plot0 := postMean
plot(postMean, "PostMean")
var float __obs_plot1 = na
__obs_plot1 := postMode
plot(postMode, "PostMode")
