//@version=5
indicator("NS-04 Reynolds")
var float vel = 0.0
if not na(close[1])
    vel := math.abs(close - close[1])
charLen = nz(ta.atr(5), 1.0)
atrSmooth = nz(ta.atr(3), 1.0)
volFlow = volume > 0 ? volume / 1000.0 : 1.0
viscosity = atrSmooth / volFlow
reynolds = viscosity > 0.01 ? vel * charLen / viscosity : 0.0
var float __obs_plot0 = na
__obs_plot0 := reynolds
plot(reynolds)
