
//@version=5
indicator("Entry Rules")
sma3 = ta.sma(close, 3)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)
entry = 0
if close > sma3
    if rsi > 40 and rsi < 70
        if atr > 0 and volume > ta.sma(volume, 5)
            entry := 1
else
    if rsi < 60 and rsi > 30
        if atr > 0
            entry := -1
var float __obs_plot0 = na
__obs_plot0 := entry
plot(entry, "Entry")
