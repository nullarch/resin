
//@version=5
indicator("Vol Map FI")
var vm = map.new<string, float>()
avgVol = ta.sma(volume, 5)
map.put(vm, "vol_ratio", avgVol > 0 ? volume / avgVol : 1.0)
map.put(vm, "price_vol", close > close[1] and volume > avgVol ? 1.0 : 0.0)
map.put(vm, "vol_trend", ta.sma(volume, 3) > avgVol ? 1.0 : 0.0)
total = 0.0
for [k, v] in vm
    total := total + v
var float __obs_plot0 = na
__obs_plot0 := total
plot(total, "T")
