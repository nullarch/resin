
//@version=5
indicator("MA Full")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema3 = ta.ema(close, 3)

spread = sma3 - sma5
aligned = sma3 > sma5

var int crossEvents = 0
if ta.crossover(sma3, sma5) or ta.crossunder(sma3, sma5)
    crossEvents := crossEvents + 1

score = (close > sma3 ? 1 : -1) + (aligned ? 1 : -1) + (close > ema3 ? 1 : -1)

var float __obs_plot0 = na
__obs_plot0 := score
plot(score, "Sc")
var float __obs_plot1 = na
__obs_plot1 := crossEvents
plot(crossEvents, "CE")
