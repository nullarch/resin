
//@version=5
indicator("Factor Map FI")
var fm = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
map.put(fm, "price_ma", close > sma3 ? 1.0 : 0.0)
map.put(fm, "ma_cross", sma3 > sma5 ? 1.0 : 0.0)
map.put(fm, "rsi_bull", rsi > 55 ? 1.0 : 0.0)
map.put(fm, "vol_confirm", volume > ta.sma(volume, 5) ? 1.0 : 0.0)
total = 0.0
for [k, v] in fm
    total := total + v
var float __obs_plot0 = na
__obs_plot0 := total
plot(total, "T")
