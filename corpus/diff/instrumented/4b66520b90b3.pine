
//@version=5
indicator("Vol Full")
avgVol = ta.sma(volume, 5)
ratio = avgVol > 0 ? volume / avgVol : 1.0

var float cumVol = 0.0
var int spikes = 0
cumVol := cumVol + volume
if ratio > 1.5
    spikes := spikes + 1

mf = close * volume
avgMF = ta.sma(mf, 3)
priceUp = close > close[1]
volConfirm = priceUp and ratio > 1.0

var float __obs_plot0 = na
__obs_plot0 := ratio
plot(ratio, "VR")
var float __obs_plot1 = na
__obs_plot1 := spikes
plot(spikes, "Spk")
