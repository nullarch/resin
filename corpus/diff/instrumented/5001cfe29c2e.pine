
//@version=5
indicator("Perf Map")
var pm = map.new<string, float>()
ret = nz(close - close[1], 0.0)
sd = ta.stdev(ret, 5)
map.put(pm, "avg_return", nz(ta.sma(ret, 5), 0.0))
map.put(pm, "volatility", sd)
map.put(pm, "sharpe", sd > 0 ? nz(ta.sma(ret, 5), 0.0) / sd : 0.0)
bestMetric = ""
bestVal = -999.0
for [k, v] in pm
    if v > bestVal
        bestVal := v
var float __obs_plot0 = na
__obs_plot0 := bestVal
plot(bestVal, "Best")
