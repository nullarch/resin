
//@version=5
indicator("Production System")
// Multi-timeframe analysis
fast = ta.ema(close, 3)
medium = ta.sma(close, 5)
slow = ta.ema(close, 8)

// Momentum suite
rsiVal = ta.rsi(close, 3)
[macdLine, sigLine, macdHist] = ta.macd(close, 3, 5, 3)
chg = ta.change(close, 1)

// Volatility suite
atrVal = ta.atr(3)
[bbMid, bbUp, bbLo] = ta.bb(close, 5, 2.0)

// Signal generation with scoring
trendScore = (fast > medium ? 1 : 0) + (medium > slow ? 1 : 0) + (close > fast ? 1 : 0)
momScore = (rsiVal > 50 ? 1 : 0) + (macdHist > 0 ? 1 : 0) + (chg > 0 ? 1 : 0)
composite = trendScore + momScore

// Risk management
var float equity = 10000.0
var float maxEquity = 10000.0
var float maxDD = 0.0
pnl = chg
equity := equity + nz(pnl, 0.0)
if equity > maxEquity
    maxEquity := equity
dd = (maxEquity - equity) / maxEquity * 100
if dd > maxDD
    maxDD := dd

// Data tracking
var float[] compositeHistory = array.new_float(0)
array.push(compositeHistory, float(composite))
var m = map.new<string, float>()
map.put(m, "composite", float(composite))
map.put(m, "equity", equity)
map.put(m, "maxDD", maxDD)

// State
var int totalBars = 0
totalBars := totalBars + 1

var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "Composite")
var float __obs_plot1 = na
__obs_plot1 := equity
plot(equity, "Equity")
var float __obs_plot2 = na
__obs_plot2 := maxDD
plot(maxDD, "MaxDD%")
