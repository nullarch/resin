
//@version=5
indicator("Pos Info")
type Position
    float entryPrice = 0.0
    float stopLoss = 0.0
    float target = 0.0
    float riskReward = 0.0

var Position pos = Position.new()
atr = ta.atr(3)
pos.entryPrice := close
pos.stopLoss := close - atr * 2
pos.target := close + atr * 3
risk = pos.entryPrice - pos.stopLoss
pos.riskReward := risk > 0 ? (pos.target - pos.entryPrice) / risk : 0.0
var float __obs_plot0 = na
__obs_plot0 := pos.riskReward
plot(pos.riskReward, "RR")
