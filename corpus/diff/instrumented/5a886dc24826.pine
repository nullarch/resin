
//@version=5
indicator("VA Pct")
var float totalRange = 0.0
var float vaRange = 0.0
range_ = high - low
totalRange := totalRange + range_
body = math.abs(close - open)
vaRange := vaRange + body
pct = totalRange > 0 ? vaRange / totalRange * 100.0 : 0.0
var float __obs_plot0 = na
__obs_plot0 := pct
plot(pct, "VAPct")
