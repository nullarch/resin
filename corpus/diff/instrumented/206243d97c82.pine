//@version=5
indicator("BivarRank")
ranksC = array.new_float(0)
ranksV = array.new_float(0)
for i = 0 to 4
    rc = math.sin(float(i) + close * 0.01) * 0.5 + 0.5
    rv = math.cos(float(i) + volume * 0.001) * 0.5 + 0.5
    array.push(ranksC, rc)
    array.push(ranksV, rv)
avgRC = array.avg(ranksC)
avgRV = array.avg(ranksV)
var float __obs_plot0 = na
__obs_plot0 := avgRC - avgRV
plot(avgRC - avgRV, "RankDiff")
