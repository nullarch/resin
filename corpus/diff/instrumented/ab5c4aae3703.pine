
//@version=5
indicator("Stoch RSI")
rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
combined = (rsi * 0.6 + k * 0.4)
crossUp = combined > 50 and combined[1] <= 50
crossDn = combined < 50 and combined[1] >= 50
var float __obs_plot0 = na
__obs_plot0 := combined
plot(combined, "Combo")
var float __obs_plot1 = na
__obs_plot1 := crossUp ? 1 : crossDn ? -1 : 0
plot(crossUp ? 1 : crossDn ? -1 : 0, "Cross")
