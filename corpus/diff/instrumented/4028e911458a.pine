//@version=5
indicator("Surprise17")
var float upRate = 0.5
var float n = 0.0
n := n + 1.0
isUp = close > open
upRate := isUp ? (upRate * (n - 1.0) + 1.0) / n : (upRate * (n - 1.0)) / n
prob = isUp ? upRate : (1.0 - upRate)
surprise = prob > 0.001 ? -math.log(prob) : 10.0
var float __obs_plot0 = na
__obs_plot0 := surprise
plot(surprise, "s")
