
//@version=5
indicator("Multi Cond For")
found = false
target = 0
for i = 1 to 8
    c = close[i]
    if na(c)
        break
    if c > close and c > 106
        target := i
        found := true
        break
var float __obs_plot0 = na
__obs_plot0 := found ? target : -1
plot(found ? target : -1, "Target")
