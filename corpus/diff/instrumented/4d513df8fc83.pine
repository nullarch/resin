//@version=5
indicator("InfoRatio03")
var float cumRet = 0.0
var float cumSqDev = 0.0
var int cnt = 0
ret = open > 0 ? (close - open) / open : 0.0
benchmark = 0.002
excess = ret - benchmark
cumRet := cumRet + excess
cnt := cnt + 1
cumSqDev := cumSqDev + excess * excess
avgExcess = cnt > 0 ? cumRet / float(cnt) : 0.0
variance = cnt > 1 ? cumSqDev / float(cnt) - avgExcess * avgExcess : 1.0
trackErr = variance > 0 ? math.sqrt(math.abs(variance)) : 0.001
infoRatio = trackErr > 0.0001 ? avgExcess / trackErr : 0.0
var float __obs_plot0 = na
__obs_plot0 := infoRatio
plot(infoRatio, "ir")
