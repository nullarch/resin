//@version=5
indicator("BestRespP1")
a11 = close - open
a12 = high - close
a21 = close - low
a22 = high - low
qOpp = nz(ta.rsi(close, 5), 50.0) / 100.0
euRow1 = qOpp * a11 + (1.0 - qOpp) * a12
euRow2 = qOpp * a21 + (1.0 - qOpp) * a22
bestResp = euRow1 >= euRow2 ? 1.0 : 0.0
var float __obs_plot0 = na
__obs_plot0 := bestResp
plot(bestResp, "BR1")
var float __obs_plot1 = na
__obs_plot1 := euRow1
plot(euRow1, "EU1")
