
//@version=5
indicator("3Bar Rev")
bar1Bear = not na(close[2]) and close[2] < open[2]
bar2Small = not na(close[1]) and math.abs(close[1] - open[1]) < math.abs(close[2] - open[2]) * 0.5
bar3Bull = close > open and close > high[1]
bullRev = bar1Bear and bar2Small and bar3Bull
var float __obs_plot0 = na
__obs_plot0 := bullRev ? 1 : 0
plot(bullRev ? 1 : 0, "Rev")
