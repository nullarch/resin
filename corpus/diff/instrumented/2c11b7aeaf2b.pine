
//@version=5
indicator("Top N")
var float[] prices = array.new_float(0)
array.push(prices, close)
if array.size(prices) > 8
    array.shift(prices)
sorted = array.copy(prices)
array.sort(sorted, "descending")
top1 = array.size(sorted) > 0 ? array.get(sorted, 0) : na
top2 = array.size(sorted) > 1 ? array.get(sorted, 1) : na
var float __obs_plot0 = na
__obs_plot0 := nz(top1)
plot(nz(top1), "Top1")
