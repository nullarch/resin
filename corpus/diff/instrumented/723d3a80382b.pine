
//@version=5
indicator("Pct Near Rank")
hi5 = ta.highest(close, 5)
lo5 = ta.lowest(close, 5)
rng = hi5 - lo5
position = rng > 0 ? (close - lo5) / rng * 100 : 50.0
isExtreme = position > 90 or position < 10
var float __obs_plot0 = na
__obs_plot0 := position
plot(position, "Position")
var float __obs_plot1 = na
__obs_plot1 := isExtreme ? 1 : 0
plot(isExtreme ? 1 : 0, "Extreme")
