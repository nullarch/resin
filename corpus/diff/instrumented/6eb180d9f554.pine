
//@version=5
indicator("Zone Lbl")
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
mid = (hi5 + lo5) / 2
zone = close > mid ? "UPPER" : "LOWER"
trend = close > close[1] ? "RISING" : "FALLING"
label = zone + "_" + trend
isUpperRising = label == "UPPER_RISING"
var float __obs_plot0 = na
__obs_plot0 := isUpperRising ? 1 : 0
plot(isUpperRising ? 1 : 0, "UR")
