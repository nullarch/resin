//@version=5
indicator("NA Chain")
rsi = ta.rsi(close, 3)
safeRsi = nz(rsi, 50.0)
isValid = not na(safeRsi)
fixedRsi = fixnan(rsi)
var float __obs_plot0 = na
__obs_plot0 := safeRsi
plot(safeRsi)
var float __obs_plot1 = na
__obs_plot1 := isValid ? 1.0 : 0.0
plot(isValid ? 1.0 : 0.0)
var float __obs_plot2 = na
__obs_plot2 := fixedRsi
plot(fixedRsi)
