
//@version=5
indicator("Spread Conv")
fast = ta.ema(close, 3)
slow = ta.sma(close, 5)
spread = fast - slow
estimate = spread
target = 0.0
iters = 0
while math.abs(estimate - target) > 0.001 and iters < 30
    estimate := estimate * 0.9
    iters := iters + 1
var float __obs_plot0 = na
__obs_plot0 := iters
plot(iters, "Its")
