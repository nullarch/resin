//@version=5
indicator("PopDiversity")
pop = array.new_float(0)
for i = 0 to 5
    gene = close + float(i) * (high - low) * 0.2
    array.push(pop, gene)
avg = array.avg(pop)
sumSqDiff = 0.0
for [idx, val] in pop
    diff = val - avg
    sumSqDiff := sumSqDiff + diff * diff
sz = float(array.size(pop))
diversity = sz > 0 ? math.sqrt(sumSqDiff / sz) : 0.0
var float __obs_plot0 = na
__obs_plot0 := diversity
plot(diversity, "Div")
