
//@version=5
indicator("Idx Track")
var float[] data = array.new_float(0)
array.push(data, close)
if array.size(data) > 5
    array.shift(data)
maxIdx = 0
maxVal = -999999.0
idx = 0
for v in data
    if v > maxVal
        maxVal := v
        maxIdx := idx
    idx := idx + 1
var float __obs_plot0 = na
__obs_plot0 := maxIdx
plot(maxIdx, "MaxIdx")
