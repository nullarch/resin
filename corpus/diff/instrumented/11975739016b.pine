//@version=5
indicator("RegDiscont")
threshold = 106.0
running = close
dist = running - threshold
aboveMean = 0.0
belowMean = 0.0
aboveCnt = 0
belowCnt = 0
arr = array.new_float(0)
for i = 0 to 9
    array.push(arr, 0.0)
treatment = running > threshold ? 1.0 : 0.0
effect = treatment * (close - nz(close[1], close))
var float __obs_plot0 = na
__obs_plot0 := effect
plot(effect, "RDEffect")
var float __obs_plot1 = na
__obs_plot1 := dist
plot(dist, "Dist")
