//@version=5
indicator("NashDetect")
var float p1Prob = 0.5
var float p2Prob = 0.5
a11 = 3.0
a12 = 0.0
a21 = 5.0
a22 = 1.0
lr = 0.1
eu1_play = p2Prob * a11 + (1.0 - p2Prob) * a12
eu1_defect = p2Prob * a21 + (1.0 - p2Prob) * a22
if eu1_play > eu1_defect
    p1Prob := math.min(1.0, p1Prob + lr)
else
    p1Prob := math.max(0.0, p1Prob - lr)
signal = close > nz(close[1], close) ? 1.0 : 0.0
p2Prob := 0.8 * p2Prob + 0.2 * signal
var float __obs_plot0 = na
__obs_plot0 := p1Prob
plot(p1Prob, "P1")
var float __obs_plot1 = na
__obs_plot1 := p2Prob
plot(p2Prob, "P2")
