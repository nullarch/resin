
//@version=5
indicator("Pat Wt")
bodySize = math.abs(close - open_)
fullRange = high - low
ratio = fullRange > 0 ? bodySize / fullRange : 0.0
isBull = close > open_
weight = ratio > 0.7 ? 2.0 : ratio > 0.3 ? 1.0 : 0.5
signal = isBull ? weight : -weight
var float __obs_plot0 = na
__obs_plot0 := signal
plot(signal, "Sig")
