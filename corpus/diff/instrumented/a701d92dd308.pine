
//@version=5
indicator("Sig Agg")
var sigs = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
k = ta.stoch(close, high, low, 5)
map.put(sigs, "rsi", (rsi - 50) / 50)
map.put(sigs, "trend", close > sma3 ? 1.0 : -1.0)
map.put(sigs, "ema", close > ema5 ? 0.5 : -0.5)
map.put(sigs, "stoch", (k - 50) / 50)
totalPos = 0.0
totalNeg = 0.0
for [name, val] in sigs
    if val > 0
        totalPos := totalPos + val
    else
        totalNeg := totalNeg + math.abs(val)
ratio = (totalPos + totalNeg) > 0 ? totalPos / (totalPos + totalNeg) : 0.5
var float __obs_plot0 = na
__obs_plot0 := ratio
plot(ratio, "Ratio")
