//@version=5
indicator("Supertrend", overlay=true)
atr_period = input.int(10, title="ATR Period")
factor = input.float(3.0, title="Factor")
atr_val = ta.atr(atr_period)
up = hl2 - factor * atr_val
dn = hl2 + factor * atr_val
var float upper_band = na
var float lower_band = na
var float supertrend = na
var int direction = 1
prev_lower = nz(lower_band[1])
prev_upper = nz(upper_band[1])
lower_band := up > prev_lower or close[1] < prev_lower ? up : prev_lower
upper_band := dn < prev_upper or close[1] > prev_upper ? dn : prev_upper
direction := na(atr_val[1]) ? 1 : direction[1] > 0 ? close < lower_band ? -1 : 1 : close > upper_band ? 1 : -1
supertrend := direction == 1 ? lower_band : upper_band
var float __obs_plot0 = na
__obs_plot0 := supertrend
plot(supertrend, title="Supertrend", color=direction == 1 ? color.green : color.red)
