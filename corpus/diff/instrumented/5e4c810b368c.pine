//@version=5
indicator("Hurst Proxy")
float smaVal = ta.sma(close, 5)
float dev = close - smaVal
float maxDev = ta.highest(dev, 5)
float minDev = ta.lowest(dev, 5)
float rangeRS = maxDev - minDev
float sigma = ta.stdev(close, 5)
float hurst = sigma > 0.01 ? math.log(rangeRS / sigma + 1) / math.log(5.0) : 0.5
var float __obs_plot0 = na
__obs_plot0 := hurst
plot(hurst, "Hurst")
