//@version=5
indicator("BayesCP")
var float cumLhood = 0.0
var float maxLhood = -999.0
var int cpBar = 0
var int barN = 0
barN := barN + 1
mu = nz(ta.sma(close, 3), close)
sigma = math.max(high - low, 0.01)
diff = close - mu
logL = -(diff * diff) / (2.0 * sigma * sigma)
cumLhood := cumLhood + logL
if cumLhood > maxLhood
    maxLhood := cumLhood
    cpBar := barN
resetMetric = cumLhood - maxLhood
var float __obs_plot0 = na
__obs_plot0 := float(cpBar)
plot(float(cpBar), "CPBar")
var float __obs_plot1 = na
__obs_plot1 := resetMetric
plot(resetMetric, "Reset")
