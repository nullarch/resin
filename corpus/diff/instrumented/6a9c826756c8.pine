
//@version=5
indicator("SignTest")
var int posCount = 0
var int negCount = 0
var int totalBars = 0
prevC = nz(close[1], close)
ret = close - prevC
totalBars := totalBars + 1
if ret > 0
    posCount := posCount + 1
if ret < 0
    negCount := negCount + 1
posPct = totalBars > 0 ? float(posCount) / float(totalBars) * 100 : 50.0
testStat = totalBars > 0 ? (float(posCount) - float(totalBars) * 0.5) / math.sqrt(float(totalBars) * 0.25) : 0.0
var float __obs_plot0 = na
__obs_plot0 := testStat
plot(testStat, "TS")
