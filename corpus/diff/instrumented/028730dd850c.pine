
//@version=5
indicator("Manual ATR")
totalTR = 0.0
count = 0
for i = 0 to 4
    h = high[i]
    l = low[i]
    pc = close[i + 1]
    if not na(h) and not na(l) and not na(pc)
        tr = math.max(h - l, math.max(math.abs(h - pc), math.abs(l - pc)))
        totalTR := totalTR + tr
        count := count + 1
manualATR = count > 0 ? totalTR / count : 0.0
var float __obs_plot0 = na
__obs_plot0 := manualATR
plot(manualATR, "ManATR")
