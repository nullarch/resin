//@version=5
indicator("UDT Copy")
type Pos
    float price = 0.0
    int qty = 0

var Pos orig = Pos.new(50.0, 10)
var Pos dup = Pos.copy(orig)
dup.price := 60.0
var float orig_p = 0.0
orig_p := orig.price
var float dup_p = 0.0
dup_p := dup.price
var float __obs_plot0 = na
__obs_plot0 := close
plot(close)
