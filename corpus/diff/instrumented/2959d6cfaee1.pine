
//@version=5
indicator("StatAccum")
type StatAcc
    float sumX = 0.0
    float sumX2 = 0.0
    int n = 0

var StatAcc acc = StatAcc.new()
acc.sumX := acc.sumX + close
acc.sumX2 := acc.sumX2 + close * close
acc.n := acc.n + 1
mean = acc.n > 0 ? acc.sumX / float(acc.n) : 0.0
meanSq = acc.n > 0 ? acc.sumX2 / float(acc.n) : 0.0
variance = meanSq - mean * mean
stdDev = variance > 0 ? math.sqrt(variance) : 0.0
var float __obs_plot0 = na
__obs_plot0 := stdDev
plot(stdDev, "SD")
