
//@version=5
indicator("Stat Full")
sma5 = ta.sma(close, 5)
sd = ta.stdev(close, 5)
z = sd > 0 ? (close - sma5) / sd : 0.0

var float[] returns = array.new_float(0)
ret = close - open
array.push(returns, ret)
if array.size(returns) > 8
    array.shift(returns)

avg = array.avg(returns)
arrSd = array.stdev(returns)

// Distribution metrics
sorted = array.copy(returns)
array.sort(sorted)
q1 = array.percentile_linear_interpolation(sorted, 25.0)
q3 = array.percentile_linear_interpolation(sorted, 75.0)
iqr = q3 - q1

// Statistical signals
var sm = map.new<string, float>()
map.put(sm, "zscore", z)
map.put(sm, "iqr", iqr)
map.put(sm, "cv", sma5 > 0 ? sd / sma5 : 0.0)

var int bars = 0
bars := bars + 1

var float __obs_plot0 = na
__obs_plot0 := z
plot(z, "Z")
var float __obs_plot1 = na
__obs_plot1 := iqr
plot(iqr, "IQR")
