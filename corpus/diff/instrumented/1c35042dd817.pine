
//@version=5
indicator("RSI EMA Cross")
rsi = ta.rsi(close, 3)
rsiEMA = ta.ema(rsi, 5)
bullCross = ta.crossover(rsi, rsiEMA)
bearCross = ta.crossunder(rsi, rsiEMA)
var float __obs_plot0 = na
__obs_plot0 := rsi
plot(rsi, "RSI")
var float __obs_plot1 = na
__obs_plot1 := bullCross ? 1 : bearCross ? -1 : 0
plot(bullCross ? 1 : bearCross ? -1 : 0, "Cross")
