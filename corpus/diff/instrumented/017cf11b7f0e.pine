//@version=5
indicator("Array Accumulate")
var float[] prices = array.new_float(0)
array.push(prices, close)
float weightedSum = 0.0
float weightTotal = 0.0
for i = 0 to array.size(prices) - 1
    float w = i + 1.0
    float p = array.get(prices, i)
    float score = p > 105.0 ? w * 2.0 : w
    weightedSum := weightedSum + p * score
    weightTotal := weightTotal + score
float wAvg = weightTotal > 0 ? weightedSum / weightTotal : close
var float __obs_plot0 = na
__obs_plot0 := wAvg
plot(wAvg, "WAvg")
