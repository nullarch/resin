//@version=5
indicator("Spectrum08")
spectrum = array.new_float(0)
for f = 1 to 4
    realP = 0.0
    imagP = 0.0
    for k = 0 to 4
        angle = 2.0 * math.pi * float(f) * float(k) / 5.0
        realP := realP + (close + float(k)) * math.cos(angle)
        imagP := imagP - (close + float(k)) * math.sin(angle)
    mag = math.sqrt(realP * realP + imagP * imagP)
    array.push(spectrum, mag)
maxMag = array.max(spectrum)
var float __obs_plot0 = na
__obs_plot0 := nz(maxMag, 0.0)
plot(nz(maxMag, 0.0), "mx")
