//@version=5
indicator("VWPI")
var float totalImpact = 0.0
var float totalVol = 0.0
prevClose = nz(close[1], close)
impact = math.abs(close - prevClose) * float(volume)
totalImpact := totalImpact + impact
totalVol := totalVol + float(volume)
avgImpact = totalVol > 0 ? totalImpact / totalVol : 0.0
var float __obs_plot0 = na
__obs_plot0 := avgImpact
plot(avgImpact, "VWPI")
