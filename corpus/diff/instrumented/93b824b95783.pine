
//@version=5
indicator("Cust MA")
total = 0.0
wt = 0.0
idx = 0
maxLen = 5
while idx < maxLen
    if not na(close[idx])
        w = float(maxLen - idx)
        total := total + close[idx] * w
        wt := wt + w
    idx := idx + 1
wma = wt > 0 ? total / wt : close
var float __obs_plot0 = na
__obs_plot0 := wma
plot(wma, "WMA")
