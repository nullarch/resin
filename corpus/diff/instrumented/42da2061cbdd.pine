
//@version=5
indicator("Chan Track")
type Channel
    float upper = 0.0
    float lower = 0.0
    float mid = 0.0
    float width = 0.0

var Channel ch = Channel.new()
ch.upper := ta.highest(high, 5)
ch.lower := ta.lowest(low, 5)
ch.mid := (ch.upper + ch.lower) / 2.0
ch.width := ch.upper - ch.lower
position = ch.width > 0 ? (close - ch.lower) / ch.width : 0.5
var float __obs_plot0 = na
__obs_plot0 := position
plot(position, "Pos")
