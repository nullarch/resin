
//@version=5
indicator("Mom Lbl")
rsi = nz(ta.rsi(close, 3), 50.0)
momDir = rsi > 55 ? "BULL" : rsi < 45 ? "BEAR" : "FLAT"
momStr = math.abs(rsi - 50) > 20 ? "STRONG" : "MILD"
label = momDir + "_" + momStr
isBullStrong = label == "BULL_STRONG"
var float __obs_plot0 = na
__obs_plot0 := isBullStrong ? 1 : 0
plot(isBullStrong ? 1 : 0, "BS")
