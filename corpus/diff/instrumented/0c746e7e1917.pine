
//@version=5
indicator("Cross Hist")
var float[] crossSigs = array.new_float(0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
sig = ta.crossover(sma3, sma5) ? 1.0 : ta.crossunder(sma3, sma5) ? -1.0 : 0.0
if sig != 0
    array.push(crossSigs, sig)
if array.size(crossSigs) > 6
    array.shift(crossSigs)
netCross = 0.0
for i = 0 to math.max(array.size(crossSigs) - 1, 0)
    if i < array.size(crossSigs)
        netCross := netCross + array.get(crossSigs, i)
var float __obs_plot0 = na
__obs_plot0 := netCross
plot(netCross, "NC")
