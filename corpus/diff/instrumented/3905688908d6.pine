
//@version=5
indicator("Alloc Map")
var am = map.new<string, float>()
map.put(am, "equity", 0.6)
map.put(am, "bond", 0.3)
map.put(am, "cash", 0.1)
totalWeight = 0.0
for [k, v] in am
    totalWeight := totalWeight + v
isValid = math.abs(totalWeight - 1.0) < 0.01
var float __obs_plot0 = na
__obs_plot0 := isValid ? 1 : 0
plot(isValid ? 1 : 0, "V")
