
//@version=5
indicator("Str Map")
var sm = map.new<string, float>()
map.put(sm, "price_vs_ma3", close > ta.sma(close, 3) ? 1.0 : 0.0)
map.put(sm, "price_vs_ma5", close > ta.sma(close, 5) ? 1.0 : 0.0)
map.put(sm, "rsi_bull", nz(ta.rsi(close, 3), 50.0) > 55 ? 1.0 : 0.0)
totalStr = 0.0
for [k, v] in sm
    totalStr := totalStr + v
var float __obs_plot0 = na
__obs_plot0 := totalStr
plot(totalStr, "TS")
