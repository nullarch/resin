
//@version=5
indicator("Stoch Div")
k = ta.stoch(close, high, low, 5)
d = ta.sma(k, 3)
priceHigher = close > close[1]
kLower = k < k[1]
bearDiv = priceHigher and kLower
var float __obs_plot0 = na
__obs_plot0 := k
plot(k, "K")
var float __obs_plot1 = na
__obs_plot1 := bearDiv ? 1 : 0
plot(bearDiv ? 1 : 0, "BearDiv")
