//@version=5
indicator("PriceRev")
var int reversals = 0
var int bars = 0
bars := bars + 1
prevClose = nz(close[1], close)
prevClose2 = nz(close[2], close)
move1 = close - prevClose
move2 = prevClose - prevClose2
if move1 * move2 < 0
    reversals := reversals + 1
revRate = bars > 0 ? float(reversals) / float(bars) : 0.0
var float __obs_plot0 = na
__obs_plot0 := revRate
plot(revRate, "RevRate")
