//@version=5
indicator("RegretMatch")
var float regretA = 0.0
var float regretB = 0.0
payA = close - open
payB = high - close
chosen = regretA >= regretB ? payA : payB
other = regretA >= regretB ? payB : payA
regretA := math.max(0.0, regretA + (payA - chosen))
regretB := math.max(0.0, regretB + (payB - chosen))
totalRegret = regretA + regretB
probA = totalRegret > 0.01 ? regretA / totalRegret : 0.5
var float __obs_plot0 = na
__obs_plot0 := probA
plot(probA, "ProbA")
