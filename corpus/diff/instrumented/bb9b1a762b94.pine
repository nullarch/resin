
//@version=5
indicator("Cross Suite")
fast = ta.ema(close, 3)
slow = ta.ema(close, 5)
crossed = ta.cross(fast, slow)
crossedOver = ta.crossover(fast, slow)
crossedUnder = ta.crossunder(fast, slow)
var int totalCrosses = 0
if crossed
    totalCrosses := totalCrosses + 1
var float __obs_plot0 = na
__obs_plot0 := totalCrosses
plot(totalCrosses, "Total")
