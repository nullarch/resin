
//@version=5
indicator("IM Full")
fast = ta.ema(close, 3)
slow = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)

spread = fast - slow
relStr = slow > 0 ? (close - slow) / slow * 100 : 0.0
volNorm = close > 0 ? atr / close * 100 : 0.0

var im = map.new<string, float>()
map.put(im, "spread", spread)
map.put(im, "rel_str", relStr)
map.put(im, "vol", volNorm)

var float[] spreadHist = array.new_float(0)
array.push(spreadHist, spread)
if array.size(spreadHist) > 8
    array.shift(spreadHist)

composite = relStr * 0.4 + (rsi - 50) / 50 * 0.3 + (spread > 0 ? 0.3 : -0.3)

var int bars = 0
bars := bars + 1

var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "Comp")
var float __obs_plot1 = na
__obs_plot1 := array.avg(spreadHist)
plot(array.avg(spreadHist), "AvgSp")
