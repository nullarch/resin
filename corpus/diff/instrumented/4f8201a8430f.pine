
//@version=5
indicator("UDT Compare")
type PriceLevel
    float price = 0.0
    string label_ = ""

var PriceLevel best = PriceLevel.new(0.0, "none")
current = PriceLevel.new(close, "bar")
if current.price > best.price
    best := PriceLevel.new(current.price, "best")
var float __obs_plot0 = na
__obs_plot0 := best.price
plot(best.price, "Best")
