
//@version=5
indicator("Math Suite")
a = math.abs(-5.5)
b = math.sqrt(16.0)
c = math.pow(2, 3)
d = math.log(math.e)
e = math.round(3.7)
f = math.ceil(3.2)
g = math.floor(3.9)
h = math.max(a, b)
i = math.min(c, d)
var float __obs_plot0 = na
__obs_plot0 := a + b + c + e + f + g + h + i
plot(a + b + c + e + f + g + h + i, "Sum")
