//@version=5
indicator("BayesDash")
var float postMean = 105.0
var float postPrec = 0.1
var float bayesFactor = 1.0
var float kState = 0.0
var float kVar = 10.0
dataPrec = 1.0 / math.max((high - low) * (high - low), 0.01)
totalPrec = postPrec + dataPrec
postMean := (postPrec * postMean + dataPrec * close) / totalPrec
postPrec := totalPrec
postStd = math.sqrt(math.max(1.0 / postPrec, 0.0001))
upperCI = postMean + 1.96 * postStd
retVal = close - nz(close[1], close)
sigma = math.max(high - low, 0.01)
lhUp = math.exp(math.max(-(retVal - 0.5) * (retVal - 0.5) / (2.0 * sigma * sigma), -20.0))
lhDn = math.exp(math.max(-retVal * retVal / (2.0 * sigma * sigma), -20.0))
ratio = lhDn > 0.0001 ? lhUp / lhDn : 1.0
bayesFactor := math.max(0.001, math.min(1000.0, bayesFactor * ratio))
predVar = kVar + 0.5
kGain = predVar / (predVar + math.max((high - low) * (high - low), 0.01))
kState := kState + kGain * (close - kState)
kVar := (1.0 - kGain) * predVar
var float __obs_plot0 = na
__obs_plot0 := postMean
plot(postMean, "PostMean")
var float __obs_plot1 = na
__obs_plot1 := bayesFactor
plot(bayesFactor, "BF")
var float __obs_plot2 = na
__obs_plot2 := kState
plot(kState, "Kalman")
