
//@version=5
indicator("Wt Reg")
weightedSum = 0.0
weightTotal = 0.0
for i = 0 to 4
    c = close[i]
    if not na(c)
        w = math.pow(0.8, i)
        weightedSum := weightedSum + c * w
        weightTotal := weightTotal + w
forecast = weightTotal > 0 ? weightedSum / weightTotal : close
var float __obs_plot0 = na
__obs_plot0 := forecast
plot(forecast, "Fcst")
