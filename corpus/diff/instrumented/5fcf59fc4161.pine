
//@version=5
indicator("Dyn Thresh")
atr = ta.atr(3)
baseThresh = atr * 2
threshold = baseThresh
iters = 0
while threshold > atr * 0.5 and iters < 10
    threshold := threshold * 0.8
    iters := iters + 1
var float __obs_plot0 = na
__obs_plot0 := threshold
plot(threshold, "Thresh")
var float __obs_plot1 = na
__obs_plot1 := iters
plot(iters, "Iters")
