
//@version=5
indicator("Osc State")
var int obCount = 0
var int osCount = 0
rsi = nz(ta.rsi(close, 3), 50.0)
if rsi > 70
    obCount := obCount + 1
if rsi < 30
    osCount := osCount + 1
ratio = (obCount + osCount) > 0 ? float(obCount) / (obCount + osCount) : 0.5
var float __obs_plot0 = na
__obs_plot0 := ratio
plot(ratio, "OB/OS")
