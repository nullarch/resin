
//@version=5
indicator("WeightFilter")
var float[] weights = array.new_float(0)
if bar_index == 0
    array.push(weights, 0.5)
    array.push(weights, 0.3)
    array.push(weights, 0.2)
sumW = 0.0
idx = 0
for [i, w] in weights
    lookback = nz(close[idx], close)
    sumW := sumW + lookback * w
    idx := idx + 1
var float __obs_plot0 = na
__obs_plot0 := sumW
plot(sumW, "WF")
