//@version=5
indicator("Alert Complex")
rsi_ = ta.rsi(close, 5)
sma_ = ta.sma(close, 5)
bullish = not na(rsi_) and rsi_ < 30 and close > sma_
bearish = not na(rsi_) and rsi_ > 70 and close < sma_
alertcondition(bullish, "Bullish", "RSI oversold + above SMA")
alertcondition(bearish, "Bearish", "RSI overbought + below SMA")
var float __obs_plot0 = na
__obs_plot0 := rsi_
plot(rsi_)
