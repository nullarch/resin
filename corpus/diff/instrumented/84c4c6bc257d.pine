
//@version=5
indicator("MA Lbl")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
maStatus = sma3 > sma5 ? "BULL" : "BEAR"
pricePos = close > sma3 ? "ABOVE" : "BELOW"
label = maStatus + "_" + pricePos
isBullAbove = label == "BULL_ABOVE"
var float __obs_plot0 = na
__obs_plot0 := isBullAbove ? 1 : 0
plot(isBullAbove ? 1 : 0, "BA")
