
//@version=5
indicator("Trend Lbl")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
dir = close > sma3 ? "UP" : "DN"
strength = math.abs(close - sma3) > math.abs(sma3 - sma5) ? "STR" : "WK"
label = dir + "_" + strength
isStrongUp = label == "UP_STR"
var float __obs_plot0 = na
__obs_plot0 := isStrongUp ? 1 : 0
plot(isStrongUp ? 1 : 0, "SU")
