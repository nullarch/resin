
//@version=5
indicator("Candle Map")
var cm = map.new<string, float>()
body = math.abs(close - open)
totalRange = high - low
map.put(cm, "body", body)
map.put(cm, "range", totalRange)
map.put(cm, "body_pct", totalRange > 0 ? body / totalRange * 100 : 0.0)
total = 0.0
for [k, v] in cm
    total := total + v
var float __obs_plot0 = na
__obs_plot0 := total
plot(total, "T")
