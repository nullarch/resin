
//@version=5
indicator("SectorRot")
var float[] sectorScores = array.new_float(0)
if bar_index == 0
    array.push(sectorScores, 0.0)
    array.push(sectorScores, 0.0)
    array.push(sectorScores, 0.0)
rsi = nz(ta.rsi(close, 3), 50.0)
array.set(sectorScores, 0, rsi)
array.set(sectorScores, 1, 100.0 - rsi)
array.set(sectorScores, 2, 50.0)
bestIdx = 0
bestScore = 0.0
for i = 0 to array.size(sectorScores) - 1
    sc = array.get(sectorScores, i)
    if sc > bestScore
        bestScore := sc
        bestIdx := i
var float __obs_plot0 = na
__obs_plot0 := float(bestIdx)
plot(float(bestIdx), "BI")
