
//@version=5
indicator("Perf Record")
type PerfRecord
    float bestPnl = 0.0
    float worstPnl = 0.0
    float avgPnl = 0.0
    int count = 0

var PerfRecord pr = PerfRecord.new()
chg = close - close[1]
if not na(chg)
    pr.count := pr.count + 1
    pr.avgPnl := pr.avgPnl + (chg - pr.avgPnl) / pr.count
    if chg > pr.bestPnl
        pr.bestPnl := chg
    if chg < pr.worstPnl
        pr.worstPnl := chg
var float __obs_plot0 = na
__obs_plot0 := pr.avgPnl
plot(pr.avgPnl, "AvgPnl")
