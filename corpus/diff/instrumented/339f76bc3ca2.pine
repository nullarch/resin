
//@version=5
indicator("Wt Sig")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
[m, s, h] = ta.macd(close, 3, 5, 3)
k = ta.stoch(close, high, low, 5)
score = (rsi - 50) / 50 * 0.3 + (close > sma3 ? 1.0 : -1.0) * 0.3 + (h > 0 ? 1.0 : -1.0) * 0.2 + (k - 50) / 50 * 0.2
var float __obs_plot0 = na
__obs_plot0 := score
plot(score, "Score")
