
//@version=5
indicator("Trend Pers")
var int[] directions = array.new_int(0)
sma3 = ta.sma(close, 3)
dir = close > sma3 ? 1 : -1
array.push(directions, dir)
if array.size(directions) > 8
    array.shift(directions)
sameCount = 0
lastDir = array.last(directions)
for v in directions
    if v == lastDir
        sameCount := sameCount + 1
persistence = array.size(directions) > 0 ? sameCount / array.size(directions) : 0.0
var float __obs_plot0 = na
__obs_plot0 := persistence
plot(persistence, "Pers")
