
//@version=5
indicator("Time Full")
var int barNum = 0
barNum := barNum + 1
pos = barNum % 5

var float sessHi = 0.0
var float sessLo = 99999.0
sessHi := math.max(sessHi, high)
sessLo := math.min(sessLo, low)
if pos == 0
    sessHi := high
    sessLo := low

rsi = nz(ta.rsi(close, 3), 50.0)
weight = pos <= 1 ? 1.5 : pos <= 3 ? 1.0 : 0.5
signal = (rsi - 50) / 50 * weight

var float __obs_plot0 = na
__obs_plot0 := sessHi - sessLo
plot(sessHi - sessLo, "SR")
var float __obs_plot1 = na
__obs_plot1 := signal
plot(signal, "Sig")
