
//@version=5
indicator("Multi Cond")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
avgATR = ta.sma(atr, 3)
c1 = close > sma3 ? "1" : "0"
c2 = rsi > 50 ? "1" : "0"
c3 = atr < avgATR ? "1" : "0"
code = c1 + c2 + c3
allTrue = code == "111"
var float __obs_plot0 = na
__obs_plot0 := allTrue ? 1 : 0
plot(allTrue ? 1 : 0, "All")
