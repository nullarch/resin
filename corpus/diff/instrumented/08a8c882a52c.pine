
//@version=5
indicator("Wt Median")
var float[] data = array.new_float(0)
array.push(data, close)
if array.size(data) > 6
    array.shift(data)
sorted = array.copy(data)
array.sort(sorted)
p50 = array.percentile_linear_interpolation(sorted, 50.0)
var float __obs_plot0 = na
__obs_plot0 := p50
plot(p50, "WtMed")
