
//@version=5
indicator("Spread Hist")
var float[] spreads = array.new_float(0)
spread = high - low
array.push(spreads, spread)
if array.size(spreads) > 8
    array.shift(spreads)
avgSp = array.avg(spreads)
sdSp = array.stdev(spreads)
zscore = sdSp > 0 ? (spread - avgSp) / sdSp : 0.0
var float __obs_plot0 = na
__obs_plot0 := zscore
plot(zscore, "Z")
