
//@version=5
indicator("DWMid")
bidSize = close > open ? volume * 0.6 : volume * 0.4
askSize = volume - bidSize
bestBid = low + (high - low) * 0.25
bestAsk = low + (high - low) * 0.75
totalSize = bidSize + askSize + 0.001
dwMid = (bestBid * askSize + bestAsk * bidSize) / totalSize
diff = dwMid - (high + low) / 2.0
var float __obs_plot0 = na
__obs_plot0 := diff
plot(diff, "DWM")
