//@version=5
indicator("Cycle52 All")
// Array sort + stats
var arr = array.from(50.0, 10.0, 30.0, 20.0, 40.0)
array.sort(arr)
var float arr_min = 0.0
arr_min := array.get(arr, 0)  // 10
var float arr_max = 0.0
arr_max := array.get(arr, 4)  // 50

// Math round precision
var float r2 = 0.0
r2 := math.round(3.456, 2)  // 3.46
var float hafz = 0.0
hafz := math.round(2.5)  // 3 (not 2)

// String operations
var parts = str.split("x,y,z", ",")
var int parts_sz = 0
parts_sz := array.size(parts)

// Color
var color c = color.new(#ff0000, 50)

// Multiple plots
sma3 = ta.sma(close, 3)
ema3 = ta.ema(close, 3)
var float __obs_plot0 = na
__obs_plot0 := sma3
plot(sma3, "SMA")
var float __obs_plot1 = na
__obs_plot1 := ema3
plot(ema3, "EMA")

// TA chain (tests _inject_stateful_kwargs isolation)
rsi5 = ta.rsi(close, 5)
sma_rsi = ta.sma(rsi5, 3)

// var counter
var int bars = 0
bars := bars + 1

// Result
var float result = 0.0
result := arr_min + arr_max + r2 + hafz + parts_sz + nz(sma_rsi, 50.0) + bars
var float __obs_plot2 = na
__obs_plot2 := close
plot(close)
