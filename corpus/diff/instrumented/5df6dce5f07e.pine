
//@version=5
indicator("Map Ops")
var m = map.new<string, float>()
map.put(m, "a", close)
map.put(m, "b", open)
map.put(m, "c", high)
k = map.keys(m)
v = map.values(m)
numKeys = array.size(k)
sumVals = array.sum(v)
avgVal = numKeys > 0 ? sumVals / numKeys : 0.0
var float __obs_plot0 = na
__obs_plot0 := avgVal
plot(avgVal, "Avg")
