
//@version=5
indicator("Map Max")
var scores = map.new<string, float>()
map.put(scores, "rsi", nz(ta.rsi(close, 3), 50.0))
map.put(scores, "cci", nz(ta.cci(close, 5), 0.0) + 100)
map.put(scores, "mfi", nz(ta.mfi(close, 5), 50.0))
maxVal = -999999.0
for [k, v] in scores
    if v > maxVal
        maxVal := v
var float __obs_plot0 = na
__obs_plot0 := maxVal
plot(maxVal, "Max")
