
//@version=5
indicator("Event Count")
var int crossEvents = 0
var int spikeEvents = 0
var int extremeEvents = 0
sma3 = ta.sma(close, 3)
if ta.crossover(close, sma3) or ta.crossunder(close, sma3)
    crossEvents := crossEvents + 1
avgVol = ta.sma(volume, 5)
if avgVol > 0 and volume > avgVol * 2
    spikeEvents := spikeEvents + 1
rsi = nz(ta.rsi(close, 3), 50.0)
if rsi > 70 or rsi < 30
    extremeEvents := extremeEvents + 1
var float __obs_plot0 = na
__obs_plot0 := crossEvents + spikeEvents + extremeEvents
plot(crossEvents + spikeEvents + extremeEvents, "Tot")
