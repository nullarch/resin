
//@version=5
indicator("MLFull")
type MLState
    float bestScore = 0.0
    int totalPredictions = 0
    int correctDir = 0

var MLState ml = MLState.new()

rsi = nz(ta.rsi(close, 3), 50.0)
sma5 = ta.sma(close, 5)
ema3 = ta.ema(close, 3)

hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
rng = hi5 - lo5
normClose = rng > 0 ? (close - lo5) / rng : 0.5
normRsi = rsi / 100.0

var float[] scoreHist = array.new_float(0)
score = normClose * 0.4 + normRsi * 0.3 + (close > sma5 ? 0.3 : 0.0)
array.push(scoreHist, score)
if array.size(scoreHist) > 5
    array.shift(scoreHist)

avgScore = array.avg(scoreHist)
prediction = avgScore > 0.5 ? 1 : -1

ml.totalPredictions := ml.totalPredictions + 1
actualDir = close > open ? 1 : -1
if prediction == actualDir
    ml.correctDir := ml.correctDir + 1
ml.bestScore := math.max(ml.bestScore, score)

accuracy = ml.totalPredictions > 0 ? ml.correctDir / ml.totalPredictions * 100.0 : 0.0
var float __obs_plot0 = na
__obs_plot0 := accuracy
plot(accuracy, "Acc")
