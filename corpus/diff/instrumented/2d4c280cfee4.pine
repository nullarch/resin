//@version=5
indicator("For-in Array Enum")
var arr = array.from(10.0, 20.0, 30.0, 40.0)
float idx_sum = 0.0
float val_sum = 0.0
for [idx, val] in arr
    idx_sum := idx_sum + idx
    val_sum := val_sum + val
// idx_sum = 0+1+2+3 = 6, val_sum = 100
var float last_idx = 0.0
last_idx := idx_sum
var float last_val = 0.0
last_val := val_sum
var float __obs_plot0 = na
__obs_plot0 := close
plot(close)
