
//@version=5
indicator("BB Width Pct")
[mid, upper, lower] = ta.bb(close, 5, 2.0)
width = mid != 0 ? (upper - lower) / mid * 100 : 0.0
var float[] widthHist = array.new_float(0)
array.push(widthHist, width)
if array.size(widthHist) > 8
    array.shift(widthHist)
pctRank = array.percentrank(widthHist, width)
var float __obs_plot0 = na
__obs_plot0 := pctRank
plot(pctRank, "PctRank")
