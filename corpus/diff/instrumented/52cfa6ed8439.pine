
//@version=5
indicator("State Trans")
var st = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
prevState = map.get(st, "current", 0.0)
newState = rsi > 60 ? 1.0 : rsi < 40 ? -1.0 : 0.0
map.put(st, "prev", prevState)
map.put(st, "current", newState)
changed = prevState != newState
var float __obs_plot0 = na
__obs_plot0 := changed ? 1 : 0
plot(changed ? 1 : 0, "Chg")
