
//@version=5
indicator("Vol State")
type VolState
    float current = 0.0
    float average = 0.0
    int regime = 0

var VolState vs = VolState.new()
atr = ta.atr(3)
vs.current := atr
vs.average := ta.sma(atr, 5)
vs.regime := vs.current > vs.average * 1.5 ? 2 : vs.current > vs.average ? 1 : 0
var float __obs_plot0 = na
__obs_plot0 := vs.regime
plot(vs.regime, "Regime")
