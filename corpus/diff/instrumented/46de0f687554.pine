
//@version=5
indicator("Vote")
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
volUp = volume > ta.sma(volume, 5)
votes = (close > sma3 ? 1 : 0) + (rsi > 50 ? 1 : 0) + (volUp ? 1 : 0)
bullish = votes >= 2
var float __obs_plot0 = na
__obs_plot0 := bullish ? 1 : 0
plot(bullish ? 1 : 0, "V")
