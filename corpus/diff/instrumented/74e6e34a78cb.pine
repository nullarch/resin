
//@version=5
indicator("Calmar")
var float equity = 100.0
var float peak = 100.0
var float maxDD = 0.0
pnl = close > open ? 1.0 : -0.7
equity := equity + pnl
peak := equity > peak ? equity : peak
dd = peak - equity
maxDD := dd > maxDD ? dd : maxDD
totalReturn = equity - 100.0
calmar = maxDD > 0.1 ? totalReturn / maxDD : 0.0
var float __obs_plot0 = na
__obs_plot0 := calmar
plot(calmar, "Cal")
