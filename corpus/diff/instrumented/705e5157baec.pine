
//@version=5
indicator("SubStr")
full = "SIGNAL:BUY:STRONG"
colonPos = str.pos(full, ":")
prefix = str.substring(full, 0, 6)
prefixLen = str.length(prefix)
hasColon = str.contains(full, ":")
var float __obs_plot0 = na
__obs_plot0 := prefixLen + (hasColon ? 1 : 0)
plot(prefixLen + (hasColon ? 1 : 0), "R")
