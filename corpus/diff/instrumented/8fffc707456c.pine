//@version=5
indicator("Swarm Osc")
fast = ta.ema(close, 3)
slow = ta.ema(close, 7)
rawOsc = fast - slow
maxOsc = ta.highest(math.abs(rawOsc), 5)
swarmOsc = maxOsc > 0 ? rawOsc / maxOsc : 0.0
clamped = math.max(-1.0, math.min(1.0, swarmOsc))
var float __obs_plot0 = na
__obs_plot0 := clamped
plot(clamped)
