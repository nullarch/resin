
//@version=5
indicator("Cum Signal")
var float cumSig = 0.0
var int sigCount = 0
rsi = ta.rsi(close, 3)
sma3 = ta.sma(close, 3)
sig = (close > sma3 ? 1.0 : -1.0) + (rsi > 50 ? 0.5 : -0.5)
cumSig := cumSig + sig
sigCount := sigCount + 1
avgSig = sigCount > 0 ? cumSig / sigCount : 0.0
var float __obs_plot0 = na
__obs_plot0 := avgSig
plot(avgSig, "AvgSig")
