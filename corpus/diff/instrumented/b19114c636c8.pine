
//@version=5
indicator("Band Map")
var bm = map.new<string, float>()
[mid, upper, lower] = ta.bb(close, 5, 2.0)
map.put(bm, "upper", upper)
map.put(bm, "lower", lower)
map.put(bm, "mid", mid)
nearBand = 0
atr = nz(ta.atr(3), 1.0)
for [k, v] in bm
    if math.abs(close - v) < atr * 0.5
        nearBand := nearBand + 1
var float __obs_plot0 = na
__obs_plot0 := nearBand
plot(nearBand, "NB")
