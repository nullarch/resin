
//@version=5
indicator("All TA")
sma3 = ta.sma(close, 3)
ema3 = ta.ema(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
[macd, sig, hist] = ta.macd(close, 3, 5, 3)
stoch = ta.stoch(close, high, low, 5)
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
stdev = ta.stdev(close, 5)
composite = (rsi - 50) + (hist > 0 ? 10 : -10) + (stoch - 50)
var float __obs_plot0 = na
__obs_plot0 := composite
plot(composite, "C")
