//@version=5
indicator("CredInterval")
var float postMean = 105.0
var float postVar = 25.0
dataVar = math.max((high - low) * (high - low), 0.01)
postVar := postVar > 0 ? 1.0 / (1.0 / postVar + 1.0 / dataVar) : dataVar
postMean := postMean + postVar * (close - postMean) / math.max(dataVar, 0.01)
postStd = math.sqrt(math.max(postVar, 0.0001))
upperCI = postMean + 1.96 * postStd
lowerCI = postMean - 1.96 * postStd
var float __obs_plot0 = na
__obs_plot0 := upperCI
plot(upperCI, "UpperCI")
var float __obs_plot1 = na
__obs_plot1 := lowerCI
plot(lowerCI, "LowerCI")
