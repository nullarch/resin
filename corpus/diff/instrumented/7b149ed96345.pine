
//@version=5
indicator("Mom Full")
rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
cci = ta.cci(close, 5)
[m, s, h] = ta.macd(close, 3, 5, 3)
sma3 = ta.sma(close, 3)

rsiScore = (rsi - 50) / 50
kScore = (k - 50) / 50
cciScore = cci > 0 ? math.min(cci / 200, 1.0) : math.max(cci / 200, -1.0)
macdScore = h > 0 ? 1.0 : -1.0
trendScore = close > sma3 ? 1.0 : -1.0

composite = rsiScore * 0.25 + kScore * 0.2 + cciScore * 0.2 + macdScore * 0.2 + trendScore * 0.15
clamped = math.max(-1.0, math.min(1.0, composite))

var int bars = 0
bars := bars + 1

var float __obs_plot0 = na
__obs_plot0 := clamped
plot(clamped, "Mom")
var float __obs_plot1 = na
__obs_plot1 := rsi
plot(rsi, "RSI")
