//@version=5
indicator("Covering Number")
float priceRange = high - low
float ballRadius = 2.0
float coveringNum = ballRadius > 0.0 ? math.ceil(priceRange / ballRadius) : 1.0
var float maxCovering = 0.0
maxCovering := math.max(maxCovering, coveringNum)
var float __obs_plot0 = na
__obs_plot0 := maxCovering
plot(maxCovering, "CoverNum")
