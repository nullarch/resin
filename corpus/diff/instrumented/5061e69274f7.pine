//@version=5
indicator("Topo Complexity")
var int changes = 0
float prevC = not na(close[1]) ? close[1] : close
float prevC2 = not na(close[2]) ? close[2] : close
float dir1 = close - prevC
float dir2 = prevC - prevC2
if dir1 * dir2 < 0
    changes := changes + 1
var float __obs_plot0 = na
__obs_plot0 := changes
plot(changes, "Changes")
