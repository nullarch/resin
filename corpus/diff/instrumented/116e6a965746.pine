
//@version=5
indicator("Chan Width")
widths = array.new_float(0)
for period = 3 to 5
    hi = ta.highest(high, period)
    lo = ta.lowest(low, period)
    w = lo > 0 ? (hi - lo) / lo * 100 : 0.0
    array.push(widths, w)
avgWidth = array.avg(widths)
var float __obs_plot0 = na
__obs_plot0 := avgWidth
plot(avgWidth, "AvgWidth")
