
//@version=5
indicator("Sig Decay")
rsi = nz(ta.rsi(close, 3), 50.0)
initialStrength = math.abs(rsi - 50) / 50
strength = initialStrength
iters = 0
while strength > 0.1 and iters < 30
    strength := strength * 0.8
    iters := iters + 1
halfLife = iters
var float __obs_plot0 = na
__obs_plot0 := halfLife
plot(halfLife, "HL")
