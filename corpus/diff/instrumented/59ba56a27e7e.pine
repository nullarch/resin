//@version=5
indicator("Winding Number")
float mean = nz(ta.sma(close, 5), close)
var float prevAngle = 0.0
float dx = close - mean
float dy = volume / 1000.0 - 1.0
float angle = math.atan(dy > 0 and dx != 0.0 ? dy / math.max(math.abs(dx), 0.001) : 0.0)
float deltaAngle = angle - prevAngle
var float winding = 0.0
winding := winding + deltaAngle
prevAngle := angle
var float __obs_plot0 = na
__obs_plot0 := winding
plot(winding, "Winding")
