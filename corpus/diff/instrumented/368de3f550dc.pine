
//@version=5
indicator("String Builder")
smaVal = ta.sma(close, 3)
rsiVal = ta.rsi(close, 3)
label_text = "SMA:" + str.tostring(smaVal, "#.##") + " RSI:" + str.tostring(rsiVal, "#.##")
hasRSI = str.contains(label_text, "RSI")
var float __obs_plot0 = na
__obs_plot0 := hasRSI ? 1 : 0
plot(hasRSI ? 1 : 0, "HasRSI")
