//@version=5
indicator("Combo01")
var float bestRsi = 0.0
var int bestLen = 3
lengths = array.new_int(0)
array.push(lengths, 3)
array.push(lengths, 5)
array.push(lengths, 7)
for i = 0 to 2
    len = array.get(lengths, i)
    rsiVal = nz(ta.rsi(close, len), 50.0)
    if rsiVal > bestRsi
        bestRsi := rsiVal
        bestLen := len
smoothed = nz(ta.sma(close, bestLen), close)
var float __obs_plot0 = na
__obs_plot0 := bestRsi
plot(bestRsi, "BestRSI")
var float __obs_plot1 = na
__obs_plot1 := smoothed
plot(smoothed, "Smooth")
