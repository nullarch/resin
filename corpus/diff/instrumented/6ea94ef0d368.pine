
//@version=5
indicator("OBV")
var float obv = 0.0
if close > close[1]
    obv := obv + volume
else if close < close[1]
    obv := obv - volume
obvMA = ta.sma(obv, 5)
bullish = obv > obvMA
var float __obs_plot0 = na
__obs_plot0 := obv
plot(obv, "OBV")
var float __obs_plot1 = na
__obs_plot1 := bullish ? 1 : 0
plot(bullish ? 1 : 0, "Bull")
