
//@version=5
indicator("CumSum")
returns = array.from(close - open, high - low, close - low)
cumSum = 0.0
var float[] cumArr = array.new_float(0)
array.clear(cumArr)
for val in returns
    cumSum := cumSum + float(val)
    array.push(cumArr, cumSum)
lastCum = array.size(cumArr) > 0 ? array.last(cumArr) : 0.0
var float __obs_plot0 = na
__obs_plot0 := lastCum
plot(lastCum, "CumSum")
