
//@version=5
indicator("Tick Int")
priceChange = math.abs(nz(close - close[1], 0.0))
volPerTick = priceChange > 0 ? volume / priceChange : 0.0
avgIntensity = ta.sma(volPerTick, 5)
highIntensity = avgIntensity > 0 and volPerTick > avgIntensity * 1.5
var float __obs_plot0 = na
__obs_plot0 := highIntensity ? 1 : 0
plot(highIntensity ? 1 : 0, "HI")
