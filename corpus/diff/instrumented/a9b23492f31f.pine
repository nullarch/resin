//@version=5
indicator("Signal Log")
var signalLog = map.new<string, float>()
float chg = close - open
category = chg > 2.0 ? "big_up" : chg > 0.0 ? "small_up" : chg < -2.0 ? "big_down" : "small_down"
prev = nz(map.get(signalLog, category), 0.0)
map.put(signalLog, category, prev + 1.0)
float total = 0.0
for [key, val] in signalLog
    total := total + val
var float __obs_plot0 = na
__obs_plot0 := total
plot(total, "TotalSignals")
