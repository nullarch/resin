//@version=5
indicator("Hyperbolic Disc")
d0 = 1.0 / (1.0 + 0.5 * 0)
d1 = 1.0 / (1.0 + 0.5 * 1)
d2 = 1.0 / (1.0 + 0.5 * 2)
d3 = 1.0 / (1.0 + 0.5 * 3)
wSum = d0 * close + d1 * nz(close[1]) + d2 * nz(close[2]) + d3 * nz(close[3])
dTotal = d0 + d1 + d2 + d3
discounted = wSum / dTotal
var float __obs_plot0 = na
__obs_plot0 := discounted
plot(discounted)
