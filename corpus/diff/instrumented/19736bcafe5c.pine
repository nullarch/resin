//@version=5
indicator("RecResid")
var float beta = 0.0
var float sse = 0.0
var int cnt = 0
cnt := cnt + 1
x = nz(close[1], close)
y = close
pred = beta * x
resid = y - pred
sse := sse + resid * resid
beta := x * x > 0.01 ? beta + 0.05 * resid * x / (x * x) : beta
normResid = cnt > 2 ? resid / math.max(math.sqrt(sse / float(cnt)), 0.01) : 0.0
var float __obs_plot0 = na
__obs_plot0 := normResid
plot(normResid, "NormRes")
