
//@version=5
indicator("DualTF")
fastMA = nz(ta.ema(close, 2), close)
slowMA = nz(ta.sma(close, 5), close)
spread = fastMA - slowMA
normalized = slowMA > 0 ? spread / slowMA * 100 : 0.0
var float smoothSpread = 0.0
smoothSpread := smoothSpread * 0.7 + normalized * 0.3
var float __obs_plot0 = na
__obs_plot0 := smoothSpread
plot(smoothSpread, "SS")
