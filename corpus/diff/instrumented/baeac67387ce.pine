
//@version=5
indicator("Multi Strat")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
stoch = ta.stoch(close, high, low, 5)
trendSig = sma3 > sma5 ? 1 : -1
momSig = rsi > 55 ? 1 : rsi < 45 ? -1 : 0
stochSig = stoch > 80 ? -1 : stoch < 20 ? 1 : 0
consensus = trendSig + momSig + stochSig
var float __obs_plot0 = na
__obs_plot0 := consensus
plot(consensus, "Con")
