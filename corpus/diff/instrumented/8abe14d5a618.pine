
//@version=5
indicator("Pctl Linear")
arr = array.from(10.0, 20.0, 30.0, 40.0, 50.0)
p50 = array.percentile_linear_interpolation(arr, 50)
p90 = array.percentile_linear_interpolation(arr, 90)
var float __obs_plot0 = na
__obs_plot0 := p50
plot(p50, "P50")
var float __obs_plot1 = na
__obs_plot1 := p90
plot(p90, "P90")
