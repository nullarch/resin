
//@version=5
indicator("Level Map FI")
var lm = map.new<string, float>()
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
sma3 = ta.sma(close, 3)
map.put(lm, "dist_resist", hi5 - close)
map.put(lm, "dist_support", close - lo5)
map.put(lm, "dist_ma", close - sma3)
total = 0.0
for [k, v] in lm
    total := total + v
var float __obs_plot0 = na
__obs_plot0 := total
plot(total, "T")
