
//@version=5
indicator("Trend Lbl")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
dir = close > sma3 ? "UP" : "DN"
align = sma3 > sma5 ? "ALIGN" : "CROSS"
label = dir + "_" + align
isUpAlign = label == "UP_ALIGN"
var float __obs_plot0 = na
__obs_plot0 := isUpAlign ? 1 : 0
plot(isUpAlign ? 1 : 0, "UA")
