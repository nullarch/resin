
//@version=5
indicator("Band UDT")
type BandTracker
    float maxWidth = 0.0
    float minWidth = 99999.0
    int squeezeCount = 0

var BandTracker bt = BandTracker.new()
[mid, upper, lower] = ta.bb(close, 5, 2.0)
width = upper - lower
bt.maxWidth := math.max(bt.maxWidth, width)
bt.minWidth := math.min(bt.minWidth, width)
avgWidth = ta.sma(upper - lower, 3)
if avgWidth > 0 and width / avgWidth < 0.8
    bt.squeezeCount := bt.squeezeCount + 1
var float __obs_plot0 = na
__obs_plot0 := bt.squeezeCount
plot(bt.squeezeCount, "SC")
