//@version=5
indicator("AdaptGain05")
var float est = 100.0
atrVal = nz(ta.atr(3), 1.0)
smaClose = nz(ta.sma(close, 3), close)
baseGain = 0.2
adaptGain = atrVal > 0 ? baseGain * (1.0 + atrVal / smaClose) : baseGain
adaptGain := math.min(adaptGain, 0.9)
est := est + adaptGain * (close - est)
var float __obs_plot0 = na
__obs_plot0 := est
plot(est, "ae")
