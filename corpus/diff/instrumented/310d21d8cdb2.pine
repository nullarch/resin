
//@version=5
indicator("Stat Wt")
sma5 = ta.sma(close, 5)
stdev = nz(ta.stdev(close, 5), 1.0)
z = stdev > 0 ? (close - sma5) / stdev : 0.0
weight = math.abs(z) > 2 ? 0.5 : math.abs(z) > 1 ? 1.0 : 1.5
rsi = nz(ta.rsi(close, 3), 50.0)
signal = (rsi - 50) / 50 * weight
var float __obs_plot0 = na
__obs_plot0 := signal
plot(signal, "Sig")
