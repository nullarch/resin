
//@version=5
indicator("Entropy")
ret = close - close[1]
binned = na(ret) ? 0.0 : ret > 2 ? 4.0 : ret > 1 ? 3.0 : ret > 0 ? 2.0 : ret > -1 ? 1.0 : 0.0
var float s0 = 0.0
var float s1 = 0.0
var float s2 = 0.0
var float s3 = 0.0
var float s4 = 0.0
var float total = 0.0
s0 := s0 + (binned == 0.0 ? 1.0 : 0.0)
s1 := s1 + (binned == 1.0 ? 1.0 : 0.0)
s2 := s2 + (binned == 2.0 ? 1.0 : 0.0)
s3 := s3 + (binned == 3.0 ? 1.0 : 0.0)
s4 := s4 + (binned == 4.0 ? 1.0 : 0.0)
total := total + 1.0
entropy = 0.0
for i = 0 to 4
    p = i == 0 ? s0 / total : i == 1 ? s1 / total : i == 2 ? s2 / total : i == 3 ? s3 / total : s4 / total
    entropy := entropy - (p > 0 ? p * math.log(p) : 0.0)
var float __obs_plot0 = na
__obs_plot0 := entropy
plot(entropy, "E")
