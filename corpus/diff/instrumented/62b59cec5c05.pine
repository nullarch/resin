
//@version=5
indicator("SR Levels")
var float resistance = 0.0
var float support = 99999.0
var int touches = 0
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
if high >= resistance * 0.99 and resistance > 0
    touches := touches + 1
resistance := math.max(resistance, hi5)
support := math.min(support, lo5)
var float __obs_plot0 = na
__obs_plot0 := touches
plot(touches, "T")
