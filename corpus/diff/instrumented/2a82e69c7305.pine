
//@version=5
indicator("Converge")
target = ta.sma(close, 5)
estimate = close
iters = 0
while math.abs(estimate - target) > 0.01 and iters < 20
    estimate := (estimate + target) / 2.0
    iters := iters + 1
var float __obs_plot0 = na
__obs_plot0 := estimate
plot(estimate, "Est")
var float __obs_plot1 = na
__obs_plot1 := iters
plot(iters, "Iters")
