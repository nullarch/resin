
//@version=5
indicator("BB Width")
[mid, upper, lower] = ta.bb(close, 5, 2.0)
bbWidth = mid > 0 ? (upper - lower) / mid * 100 : 0.0
avgWidth = ta.sma(bbWidth, 3)
squeeze = bbWidth < avgWidth * 0.75
var float __obs_plot0 = na
__obs_plot0 := bbWidth
plot(bbWidth, "Width")
var float __obs_plot1 = na
__obs_plot1 := squeeze ? 1 : 0
plot(squeeze ? 1 : 0, "Sq")
