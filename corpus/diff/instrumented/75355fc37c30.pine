
//@version=5
indicator("KC Pos")
[kcMid, kcUp, kcLow] = ta.kc(close, 5, 1.5)
pos = kcUp != kcLow ? (close - kcLow) / (kcUp - kcLow) : 0.5
extreme = pos > 0.9 or pos < 0.1
var float __obs_plot0 = na
__obs_plot0 := pos
plot(pos, "Pos")
var float __obs_plot1 = na
__obs_plot1 := extreme ? 1 : 0
plot(extreme ? 1 : 0, "Ext")
