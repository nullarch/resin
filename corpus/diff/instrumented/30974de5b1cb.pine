
//@version=5
indicator("Multi Score")
var mscore = map.new<string, float>()
sma3 = ta.sma(close, 3)
rsi = ta.rsi(close, 3)
map.put(mscore, "trend", close > sma3 ? 2.0 : -2.0)
map.put(mscore, "momentum", rsi > 60 ? 2.0 : rsi < 40 ? -2.0 : 0.0)
map.put(mscore, "price_action", close > open ? 1.0 : -1.0)
total = 0.0
for [k, v] in mscore
    total := total + v
var float __obs_plot0 = na
__obs_plot0 := total
plot(total, "Total")
