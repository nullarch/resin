//@version=5
indicator("Pivot SR", overlay=true)
pivotLen = 3
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
var float lastHigh = 0.0
var float lastLow = 0.0
if not na(ph)
    lastHigh := ph
if not na(pl)
    lastLow := pl
var float __obs_plot0 = na
__obs_plot0 := lastHigh
plot(lastHigh)
var float __obs_plot1 = na
__obs_plot1 := lastLow
plot(lastLow)
