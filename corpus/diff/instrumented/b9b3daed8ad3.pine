
//@version=5
indicator("WL Ratio")
var int wins = 0
var int losses = 0
chg = close - close[1]
if not na(chg)
    if chg > 0
        wins := wins + 1
    else if chg < 0
        losses := losses + 1
total = wins + losses
winRate = total > 0 ? float(wins) / float(total) * 100 : 50.0
var float __obs_plot0 = na
__obs_plot0 := winRate
plot(winRate, "WinRate")
