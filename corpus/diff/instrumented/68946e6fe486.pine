//@version=5
indicator("Homotopy Equiv")
float ind1 = nz(ta.sma(close, 3), close)
float ind2 = nz(ta.ema(close, 3), close)
float maxDist = math.max(math.abs(ind1 - close), math.abs(ind2 - close))
float minDist = math.min(math.abs(ind1 - close), math.abs(ind2 - close))
float homotopyRatio = maxDist > 0.001 ? minDist / maxDist : 1.0
var float avgHomotopy = 0.0
var int hCnt = 0
hCnt := hCnt + 1
avgHomotopy := avgHomotopy + (homotopyRatio - avgHomotopy) / hCnt
var float __obs_plot0 = na
__obs_plot0 := avgHomotopy
plot(avgHomotopy, "HomotopyEq")
