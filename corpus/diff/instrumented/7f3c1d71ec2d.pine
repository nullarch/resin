
//@version=5
indicator("Manual EMA")
alpha = 2.0 / (5 + 1)
var float ema = 0.0
ema := barstate.isfirst ? close : ema * (1 - alpha) + close * alpha
tEma = ta.ema(close, 5)
var float __obs_plot0 = na
__obs_plot0 := ema
plot(ema, "Manual")
var float __obs_plot1 = na
__obs_plot1 := tEma
plot(tEma, "TA")
