
//@version=5
indicator("UDT Enum Sys")
enum MarketState
    Bull = 1
    Bear = -1
    Neutral = 0

type Analysis
    float trendScore = 0.0
    float momScore = 0.0
    float composite = 0.0

var Analysis a = Analysis.new()
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)

a.trendScore := close > sma3 ? 1.0 : -1.0
a.momScore := (rsi - 50) / 50
a.composite := a.trendScore * 0.6 + a.momScore * 0.4

state = a.composite > 0.3 ? MarketState.Bull : a.composite < -0.3 ? MarketState.Bear : MarketState.Neutral

var float[] history = array.new_float(0)
array.push(history, a.composite)
if array.size(history) > 8
    array.shift(history)

var int bars = 0
bars := bars + 1

var float __obs_plot0 = na
__obs_plot0 := a.composite
plot(a.composite, "Comp")
var float __obs_plot1 = na
__obs_plot1 := float(state)
plot(float(state), "State")
