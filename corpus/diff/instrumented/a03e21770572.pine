
//@version=5
indicator("Vol Met")
var vm = map.new<string, float>()
avgVol = ta.sma(volume, 5)
map.put(vm, "current", volume)
map.put(vm, "average", avgVol)
map.put(vm, "ratio", avgVol > 0 ? volume / avgVol : 1.0)
map.put(vm, "buy_pct", close > open ? 100.0 : 0.0)
isHighVol = map.get(vm, "ratio", 1.0) > 1.5
var float __obs_plot0 = na
__obs_plot0 := isHighVol ? 1 : 0
plot(isHighVol ? 1 : 0, "HiVol")
