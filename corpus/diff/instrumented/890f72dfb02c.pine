//@version=5
indicator("ClosenessCent")
nodes = array.new_float(0)
array.push(nodes, close)
array.push(nodes, open)
array.push(nodes, high)
array.push(nodes, low)
closeness = array.new_float(4, 0.0)
for i = 0 to 3
    totalDist = 0.0
    for j = 0 to 3
        if i != j
            totalDist := totalDist + math.abs(array.get(nodes, i) - array.get(nodes, j))
    avgDist = totalDist / 3.0
    cVal = avgDist > 0.01 ? 1.0 / avgDist : 0.0
    array.set(closeness, i, cVal)
maxCloseness = array.max(closeness)
var float __obs_plot0 = na
__obs_plot0 := maxCloseness
plot(maxCloseness, "MaxClose")
