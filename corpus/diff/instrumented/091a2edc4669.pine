
//@version=5
indicator("Cond UDT")
type Signal
    float value = 0.0
    int age = 0
    bool active = false

var Signal sig = Signal.new()
rsi = nz(ta.rsi(close, 3), 50.0)
if rsi > 65 and not sig.active
    sig.value := 1.0
    sig.age := 0
    sig.active := true
else if rsi < 35 and not sig.active
    sig.value := -1.0
    sig.age := 0
    sig.active := true
else if sig.active
    sig.age := sig.age + 1
    if sig.age > 3
        sig.active := false
var float __obs_plot0 = na
__obs_plot0 := sig.value
plot(sig.value, "Val")
var float __obs_plot1 = na
__obs_plot1 := sig.age
plot(sig.age, "Age")
