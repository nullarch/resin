
//@version=5
indicator("VAM State")
var float[] prices = array.new_float(0)
var stats = map.new<string, float>()
var int barCount = 0
barCount := barCount + 1
array.push(prices, close)
if array.size(prices) > 8
    array.shift(prices)
map.put(stats, "avg", array.avg(prices))
map.put(stats, "max", array.max(prices))
map.put(stats, "min", array.min(prices))
map.put(stats, "bars", float(barCount))
spread = map.get(stats, "max", 0.0) - map.get(stats, "min", 0.0)
var float __obs_plot0 = na
__obs_plot0 := spread
plot(spread, "Spread")
