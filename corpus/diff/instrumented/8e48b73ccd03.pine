
//@version=5
indicator("Trend Met")
var tm = map.new<string, float>()
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
atr = ta.atr(3)
map.put(tm, "trend_dir", close > sma3 ? 1.0 : -1.0)
map.put(tm, "ma_spread", sma3 - ema5)
map.put(tm, "vol_norm", close > 0 ? atr / close * 100 : 0.0)
dir = map.get(tm, "trend_dir", 0.0)
var float __obs_plot0 = na
__obs_plot0 := dir
plot(dir, "Dir")
