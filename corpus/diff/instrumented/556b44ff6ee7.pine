
//@version=5
indicator("For Full")
sma3 = ta.sma(close, 3)
totalDist = 0.0
maxDist = 0.0
upBars = 0
for i = 0 to 4
    if not na(close[i])
        d = close[i] - sma3
        totalDist := totalDist + d
        maxDist := math.max(maxDist, math.abs(d))
        if d > 0
            upBars := upBars + 1
avgDist = totalDist / 5
bullPct = upBars / 5.0 * 100
var float __obs_plot0 = na
__obs_plot0 := bullPct
plot(bullPct, "BP")
