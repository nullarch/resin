//@version=5
indicator("Fib Levels")
lookback = 5
highestHigh = ta.highest(high, lookback)
lowestLow = ta.lowest(low, lookback)
range_ = highestHigh - lowestLow
fib236 = highestHigh - range_ * 0.236
fib382 = highestHigh - range_ * 0.382
fib500 = highestHigh - range_ * 0.500
fib618 = highestHigh - range_ * 0.618
var float __obs_plot0 = na
__obs_plot0 := fib500
plot(fib500)
