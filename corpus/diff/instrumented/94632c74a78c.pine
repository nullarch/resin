
//@version=5
indicator("Period UDT")
type PeriodTracker
    int alignedBars = 0
    float maxSpread = 0.0
    int totalBars = 0

var PeriodTracker pt = PeriodTracker.new()
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
spread = math.abs(sma3 - sma5)
pt.maxSpread := math.max(pt.maxSpread, spread)
pt.totalBars := pt.totalBars + 1
rsi3 = nz(ta.rsi(close, 3), 50.0)
rsi5 = nz(ta.rsi(close, 5), 50.0)
if (sma3 > sma5) == (rsi3 > rsi5)
    pt.alignedBars := pt.alignedBars + 1
pct = pt.totalBars > 0 ? float(pt.alignedBars) / pt.totalBars * 100 : 0.0
var float __obs_plot0 = na
__obs_plot0 := pct
plot(pct, "Pct")
