//@version=5
indicator("Elitism")
var float bestFitness = 0.0
var float bestGene = 0.0
currentFitness = math.abs(close - 105.0)
inverseFit = 1.0 / math.max(currentFitness, 0.01)
if inverseFit > bestFitness
    bestFitness := inverseFit
    bestGene := close
plot(bestGene, "Elite")
plot(bestFitness, "Fit")
