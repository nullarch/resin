
//@version=5
indicator("Milestone 2900")
// TA indicators
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsiVal = ta.rsi(close, 3)
atrVal = ta.atr(3)
[macdLine, sigLine, hist] = ta.macd(close, 3, 5, 3)
[bbMid, bbUp, bbLo] = ta.bb(close, 5, 2.0)

// Scoring
trendScore = (close > sma3 ? 1 : 0) + (sma3 > ema5 ? 1 : 0)
momScore = (rsiVal > 50 ? 1 : 0) + (hist > 0 ? 1 : 0)
totalScore = trendScore + momScore

// State machine
var int state = 0
var int stateChanges = 0
newState = totalScore >= 3 ? 1 : totalScore <= 1 ? -1 : 0
if newState != state
    stateChanges := stateChanges + 1
state := newState

// Array + map tracking
var float[] scores = array.new_float(0)
array.push(scores, float(totalScore))
var m = map.new<string, float>()
map.put(m, "score", float(totalScore))
map.put(m, "state", float(state))
map.put(m, "changes", float(stateChanges))
map.put(m, "bars", float(bar_index + 1))

// Risk metrics
var float peak = 0.0
if close > peak
    peak := close
drawdown = peak > 0 ? (peak - close) / peak * 100 : 0.0

// String summary
summary = "S:" + str.tostring(totalScore) + " St:" + str.tostring(state)

plot(totalScore, "Score")
plot(stateChanges, "Changes")
plot(drawdown, "DD%")
