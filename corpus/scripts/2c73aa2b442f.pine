
//@version=5
indicator("Vol Profile")
avgVol = ta.sma(volume, 5)
relVol = avgVol > 0 ? volume / avgVol : 1.0
profile = switch
    relVol > 2.0 => "climax"
    relVol > 1.5 => "high"
    relVol > 0.8 => "normal"
    relVol > 0.5 => "low"
    => "dry"
isClimax = profile == "climax"
plot(relVol, "RelVol")
