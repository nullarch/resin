//@version=5
indicator("Ultra 017")

weightedAvg(float[] arr) =>
    sz = array.size(arr)
    total = 0.0
    wSum = 0.0
    for i = 0 to sz - 1
        w = (i + 1) * 1.0
        total := total + array.get(arr, i) * w
        wSum := wSum + w
    wSum > 0 ? total / wSum : 0.0

var float[] data = array.new_float(0)
var map<string, float> results_ = map.new<string, float>()
var float peak = 0.0

prevC = not na(close[1]) ? close[1] : close
delta = close - prevC
array.push(data, delta)
if array.size(data) > 5
    array.shift(data)

wavg = weightedAvg(data)

regime = switch
    wavg > 1.0 => "bull"
    wavg < -1.0 => "bear"
    => "neutral"

map.put(results_, "wavg", wavg)
map.put(results_, "regime_val", regime == "bull" ? 1.0 : regime == "bear" ? -1.0 : 0.0)

if wavg > peak
    peak := wavg
    if peak > 5.0
        peak := peak * 0.9
    else
        peak := peak * 1.01

for [key, val] in results_
    peak := peak + val * 0.01
plot(peak)
