//@version=5
indicator("PriceDiscrete")
var int roundCount = 0
var int totalBars = 0
totalBars := totalBars + 1
remainder = close - math.floor(close)
isRound = remainder < 0.01 or remainder > 0.99 ? 1 : 0
roundCount := roundCount + isRound
pct = totalBars > 0 ? float(roundCount) / float(totalBars) : 0.0
plot(pct, "DiscPct")
