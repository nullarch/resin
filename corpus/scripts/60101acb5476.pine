//@version=5
strategy("FE19")
var int entryCount = 0
fast = ta.sma(close, 3)
slow = ta.sma(close, 5)
crossed = ta.crossover(fast, slow)
state = map.new<string, float>()
map.put(state, "fast", fast)
map.put(state, "slow", slow)
fv = nz(map.get(state, "fast"), 0.0)
sv = nz(map.get(state, "slow"), 0.0)
cnt = 0
n = 0
while n < 2
    cnt := cnt + 1
    n := n + 1
if crossed and fv > sv
    strategy.entry("GoldenX", strategy.long)
    entryCount := entryCount + 1
if ta.crossunder(fast, slow)
    strategy.close("GoldenX")
