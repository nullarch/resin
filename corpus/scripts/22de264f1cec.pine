
//@version=5
indicator("MA Hist")
var float[] spreads = array.new_float(0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
spread = sma3 - sma5
array.push(spreads, spread)
if array.size(spreads) > 8
    array.shift(spreads)
avgSpread = array.size(spreads) > 0 ? array.avg(spreads) : 0.0
plot(avgSpread, "AS")
