
//@version=5
indicator("Sig Log")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
direction = close > sma3 ? "LONG" : "SHORT"
strength = rsi > 60 or rsi < 40 ? "STRONG" : "WEAK"
logEntry = direction + "_" + strength
isActionable = str.contains(logEntry, "STRONG")
plot(isActionable ? 1 : 0, "Act")
