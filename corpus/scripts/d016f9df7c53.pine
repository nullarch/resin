
//@version=5
strategy("Adaptive", overlay=true)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
trending = math.abs(sma3 - sma5) > atr * 0.5
lowVol = avgATR > 0 and atr / avgATR < 1.3
if trending and sma3 > sma5 and rsi > 50 and lowVol
    strategy.entry("Long", strategy.long)
if sma3 < sma5 or rsi < 40
    strategy.close("Long")
plot(sma3, "MA")
