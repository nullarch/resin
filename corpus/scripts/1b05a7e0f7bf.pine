
//@version=5
indicator("Risk Sys")
atr = ta.atr(3)
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
[m, s, h] = ta.macd(close, 3, 5, 3)

// Risk metrics
avgATR = ta.sma(atr, 5)
volRatio = avgATR > 0 ? atr / avgATR : 1.0
momRisk = math.abs(rsi - 50) / 50
trendRisk = sma3 > 0 ? math.abs(close - sma3) / sma3 * 100 : 0.0

// Composite risk
var rm = map.new<string, float>()
map.put(rm, "vol", volRatio)
map.put(rm, "mom", momRisk)
map.put(rm, "trend", trendRisk)

totalRisk = 0.0
for [k, v] in rm
    totalRisk := totalRisk + v

// Position sizing
maxRisk = 2.0
posAdj = totalRisk > maxRisk ? maxRisk / totalRisk : 1.0

var int bars = 0
bars := bars + 1

plot(totalRisk, "TotRisk")
plot(posAdj, "PosAdj")
