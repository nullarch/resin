
//@version=5
indicator("Osc State S")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
oscVal = rsi - 50
zone = oscVal > 15 ? "HIGH" : oscVal < -15 ? "LOW" : "MID"
trend = close > sma3 ? "BULL" : "BEAR"
state = zone + "_" + trend
isHighBull = state == "HIGH_BULL"
plot(isHighBull ? 1 : 0, "HB")
