//@version=5
indicator("Log-Rank Test")
var float chiSq = 0.0
bool groupA = close > 105.0
float observed = groupA ? 1.0 : 0.0
float expected = 0.5
float diff = observed - expected
float denominator = math.max(expected * (1.0 - expected), 0.001)
chiSq := chiSq + (diff * diff) / denominator
plot(chiSq, "LogRank")
