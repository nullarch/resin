//@version=5
indicator("Youngs Modulus")
force = volume / 100.0
area = high - low
stress = area > 0 ? force / area : 0.0
strain = math.abs(close - open)
youngs = strain > 0.01 ? stress / strain : 0.0
var float avgYoungs = 0.0
var int cnt = 0
cnt := cnt + 1
avgYoungs := avgYoungs + (youngs - avgYoungs) / cnt
