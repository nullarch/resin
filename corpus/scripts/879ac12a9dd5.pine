//@version=5
indicator("RRT Proxy")
float treeX = nz(ta.sma(close, 3), close)
float treeY = nz(ta.sma(high, 3), high)
float randX = close
float randY = high
float dx = randX - treeX
float dy = randY - treeY
float dist = math.sqrt(dx * dx + dy * dy)
float stepSize = 1.0
float newX = dist > 0.01 ? treeX + stepSize * dx / dist : treeX
float newY = dist > 0.01 ? treeY + stepSize * dy / dist : treeY
