
//@version=5
indicator("UDT Full")
type FullTracker
    float score = 0.0
    float maxScore = -999.0
    float minScore = 999.0
    int bullBars = 0
    int bearBars = 0

var FullTracker ft = FullTracker.new()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ft.score := (rsi - 50) / 50 + (sma3 > sma5 ? 1 : -1)
ft.maxScore := math.max(ft.maxScore, ft.score)
ft.minScore := math.min(ft.minScore, ft.score)
if ft.score > 0
    ft.bullBars := ft.bullBars + 1
else
    ft.bearBars := ft.bearBars + 1
plot(ft.bullBars - ft.bearBars, "Net")
