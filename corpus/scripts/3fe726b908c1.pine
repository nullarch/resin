
//@version=5
indicator("State Machine")
enum MarketState
    StrongBull = 3
    Bull = 2
    Neutral = 1
    Bear = 0
    StrongBear = -1

sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
volHigh = avgATR > 0 and atr > avgATR * 1.3
state = switch
    sma3 > sma5 and rsi > 60 and not volHigh => MarketState.StrongBull
    sma3 > sma5 => MarketState.Bull
    sma3 < sma5 and rsi < 40 and not volHigh => MarketState.StrongBear
    sma3 < sma5 => MarketState.Bear
    => MarketState.Neutral
plot(int(state), "St")
