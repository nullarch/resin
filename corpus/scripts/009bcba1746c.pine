
//@version=5
indicator("Str Enum")
enum Dir
    Bull = 1
    Bear = -1

sma3 = ta.sma(close, 3)
dir = close > sma3 ? Dir.Bull : Dir.Bear
label = dir == Dir.Bull ? "BULLISH" : "BEARISH"
upper = str.upper(label)
hasB = str.contains(upper, "BULL")
prefix = str.substring(upper, 0, 4)
plot(hasB ? 1 : 0, "B")
