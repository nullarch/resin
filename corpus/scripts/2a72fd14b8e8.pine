
//@version=5
strategy("StressUltimate")
enum Signal
    STRONG_BUY
    BUY
    NEUTRAL
    SELL
    STRONG_SELL
type Dashboard
    float composite = 0.0
    string signal = ""
    int checks = 0
getWeight(importance) =>
    importance > 3 ? 2.0 : importance > 1 ? 1.5 : 1.0
var float equity = 10000.0
var int tradeCount = 0
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
sma = ta.sma(close, 5)
indicators = array.new_float(0)
array.push(indicators, rsi)
array.push(indicators, atr)
array.push(indicators, close - nz(sma, close))
dash = Dashboard.new()
weightedSum = 0.0
for i = 0 to array.size(indicators) - 1
    w = getWeight(i + 1)
    weightedSum := weightedSum + array.get(indicators, i) * w
dash.composite := weightedSum / 3.0
signal = switch
    dash.composite > 80 => Signal.STRONG_BUY
    dash.composite > 55 => Signal.BUY
    dash.composite < 20 => Signal.STRONG_SELL
    dash.composite < 45 => Signal.SELL
    => Signal.NEUTRAL
sigName = signal == Signal.STRONG_BUY ? "STRONG_BUY" : signal == Signal.BUY ? "BUY" : signal == Signal.SELL ? "SELL" : signal == Signal.STRONG_SELL ? "STRONG_SELL" : "NEUTRAL"
dash.signal := sigName
convergence = 0.0
temp = math.abs(dash.composite)
checks = 0
while temp > 10.0 and checks < 15
    temp := temp / 1.5
    checks := checks + 1
dash.checks := checks
metrics = map.new<string, float>()
map.put(metrics, "composite", dash.composite)
map.put(metrics, "checks", float(dash.checks))
map.put(metrics, "equity", equity)
metricArr = array.new_float(0)
for [k, v] in metrics
    array.push(metricArr, v)
totalMetric = array.sum(metricArr)
if signal == Signal.STRONG_BUY or signal == Signal.BUY
    strategy.entry("Long", strategy.long)
    tradeCount := tradeCount + 1
if signal == Signal.STRONG_SELL or signal == Signal.SELL
    strategy.close("Long")
equity := equity + (close - open) * 10.0
msg = dash.signal + " | Eq:" + str.tostring(math.round(equity)) + " | Trades:" + str.tostring(tradeCount)
plot(totalMetric + float(str.length(msg)), "ULTIMATE")
