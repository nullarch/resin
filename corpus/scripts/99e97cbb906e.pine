
//@version=5
indicator("Accum")
var float sumClose = 0.0
var float sumVol = 0.0
var float sumRange = 0.0
var int count = 0
sumClose := sumClose + close
sumVol := sumVol + volume
sumRange := sumRange + (high - low)
count := count + 1
avgClose = count > 0 ? sumClose / count : close
avgVol = count > 0 ? sumVol / count : volume
plot(close - avgClose, "Diff")
