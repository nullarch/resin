//@version=5
indicator("FE18")
var float regime = 0.0
classify(v) =>
    switch
        v > 4.0 => 3.0
        v > 2.0 => 2.0
        => 1.0
dev = nz(ta.stdev(close, 5), 0.0)
prevC = not na(close[1]) ? close[1] : close
deltas = array.new_float(0)
for i = 0 to 2
    array.push(deltas, math.abs(close - prevC))
minD = 999.0
for j = 0 to array.size(deltas) - 1
    minD := math.min(minD, array.get(deltas, j))
regime := classify(dev) + minD
