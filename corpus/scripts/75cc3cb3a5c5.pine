
//@version=5
indicator("Sig Quality")
var float[] signals = array.new_float(0)
var float[] outcomes = array.new_float(0)
sma3 = ta.sma(close, 3)
sig = close > sma3 ? 1.0 : -1.0
ret = close - close[1]
array.push(signals, sig)
if not na(ret)
    array.push(outcomes, ret > 0 ? 1.0 : -1.0)
if array.size(signals) > 8
    array.shift(signals)
if array.size(outcomes) > 8
    array.shift(outcomes)
avgSig = array.avg(signals)
avgOut = array.avg(outcomes)
plot(avgSig, "Sig")
plot(avgOut, "Out")
