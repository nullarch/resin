
//@version=5
indicator("CoMove")
prevClose = nz(close[1], close)
prevVol = nz(volume[1], volume)
closeDir = close > prevClose ? 1.0 : close < prevClose ? -1.0 : 0.0
volDir = volume > prevVol ? 1.0 : volume < prevVol ? -1.0 : 0.0
agree = closeDir * volDir
var float cumAgree = 0.0
var int barCount = 0
cumAgree := cumAgree + agree
barCount := barCount + 1
avgAgree = barCount > 0 ? cumAgree / float(barCount) : 0.0
plot(avgAgree, "A")
