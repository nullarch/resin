//@version=5
indicator("Pharmacovigilance")
var int adverse = 0
var int total = 0
total := total + 1
atrVal = nz(ta.atr(3), 1.0)
emaVal = ta.ema(close, 3)
deviation = not na(emaVal) ? math.abs(close - emaVal) : 0.0
if deviation > atrVal * 2
    adverse := adverse + 1
rate = total > 0 ? adverse * 100.0 / total : 0.0
plot(rate)
