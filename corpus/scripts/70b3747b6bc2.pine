
//@version=5
indicator("UDT Meth")
type Score
    float trend = 0.0
    float mom = 0.0
    float total = 0.0

calcTotal(Score s) =>
    s.total := s.trend * 0.6 + s.mom * 0.4

var Score sc = Score.new()
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
sc.trend := close > sma3 ? 1.0 : -1.0
sc.mom := (rsi - 50) / 50
calcTotal(sc)
plot(sc.total, "Tot")
