//@version=5
indicator("Phase Transition")
float sma3 = nz(ta.sma(close, 3), close)
float sma8 = nz(ta.sma(close, 8), close)
float orderParam = sma3 - sma8
float prevOrder = not na(close[1]) ? orderParam : 0.0
float jumpSize = math.abs(orderParam - prevOrder)
var float maxJump = 0.0
maxJump := math.max(maxJump, jumpSize)
bool phaseTransition = jumpSize > 0.5 * maxJump and maxJump > 0.1
