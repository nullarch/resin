
//@version=5
indicator("ArrDecomp")
var float[] trends = array.new_float(0)
var float[] residuals = array.new_float(0)
trend = nz(ta.sma(close, 3), close)
res = close - trend
array.push(trends, trend)
array.push(residuals, res)
if array.size(trends) > 5
    array.shift(trends)
    array.shift(residuals)
plot(array.size(trends), "TSz")
