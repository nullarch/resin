
//@version=5
indicator("Sig Str")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
[m, s, h] = ta.macd(close, 3, 5, 3)
rsiStr = rsi > 60 ? 2.0 : rsi > 50 ? 1.0 : rsi < 40 ? -2.0 : rsi < 50 ? -1.0 : 0.0
trendStr = close > sma3 ? 1.0 : -1.0
macdStr = h > 0 ? 1.0 : -1.0
total = rsiStr + trendStr + macdStr
plot(total, "Total")
