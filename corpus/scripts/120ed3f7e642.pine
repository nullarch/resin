//@version=5
indicator("test")
calcStats(float[] arr, int startIdx = 0) =>
    total = 0.0
    count = 0
    for i = startIdx to array.size(arr) - 1
        total += array.get(arr, i)
        count += 1
    count > 0 ? total / count : 0.0

var float[] prices = array.new_float(0)
array.push(prices, close)
if array.size(prices) > 5
    array.shift(prices)
avg = calcStats(prices)
plot(avg)
