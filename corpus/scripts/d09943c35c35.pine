
//@version=5
indicator("Run Var")
var float[] vals = array.new_float(0)
array.push(vals, close)
if array.size(vals) > 8
    array.shift(vals)
avg = array.avg(vals)
sumSqDiff = 0.0
for v in vals
    sumSqDiff := sumSqDiff + math.pow(v - avg, 2)
variance = array.size(vals) > 1 ? sumSqDiff / array.size(vals) : 0.0
plot(variance, "Var")
