//@version=5
indicator("Comprehensive Cycle 75")

// TA isolation
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)

// OHLCV inject
atr_val = ta.atr(3)

// UDT
type Data
    float sma = 0.0
    float ema = 0.0
    float atr = 0.0

// method style array
a = array.new_float(0)
a.push(sma3)
a.push(ema5)

// control flow expression
var float result = 0.0
float avg = array.avg(a)
result := if avg > 100
    avg + nz(atr_val, 0.0)
else
    avg
