
//@version=5
indicator("AllCF")
var float total = 0.0
direction = switch
    close > open => 1
    close < open => -1
    => 0
for i = 0 to 5
    if i == 0
        continue
    if i > 4
        break
    modifier = direction > 0 ? 1.0 : direction < 0 ? -1.0 : 0.0
    n = i
    subtotal = 0.0
    while n > 0
        subtotal := subtotal + modifier
        n := n - 1
    total := total + subtotal
category = total > 10 ? "HIGH" : total > 0 ? "MID" : "LOW"
code = category == "HIGH" ? 3.0 : category == "MID" ? 2.0 : 1.0
plot(code + math.abs(total), "All")
