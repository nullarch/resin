
//@version=5
indicator("AssetScore")
var scores = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
smaVal = nz(ta.sma(close, 3), close)
momScore = close > smaVal ? 1.0 : -1.0
rsiScore = rsi > 50 ? 1.0 : -1.0
volScore = volume > 1000 ? 1.0 : 0.0
map.put(scores, "momentum", momScore)
map.put(scores, "rsi", rsiScore)
map.put(scores, "volume", volScore)
total = 0.0
for [k, v] in scores
    total := total + v
plot(total, "T")
