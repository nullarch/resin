
//@version=5
indicator("All Types")
type State
    float value = 0.0
    int count = 0

var State st = State.new()
var float[] hist = array.new_float(0)
var scores = map.new<string, float>()

rsi = nz(ta.rsi(close, 3), 50.0)
st.value := rsi
st.count := st.count + 1
array.push(hist, rsi)
if array.size(hist) > 5
    array.shift(hist)
map.put(scores, "rsi", rsi)
map.put(scores, "avg", array.size(hist) > 0 ? array.avg(hist) : rsi)
plot(st.count, "C")
