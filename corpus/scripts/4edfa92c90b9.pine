
//@version=5
indicator("Corr State")
var int sameDir = 0
var int diffDir = 0
priceUp = close > close[1]
volUp = volume > volume[1]
if priceUp == volUp
    sameDir := sameDir + 1
else
    diffDir := diffDir + 1
corrRatio = sameDir + diffDir > 0 ? float(sameDir) / (sameDir + diffDir) : 0.5
plot(corrRatio, "CR")
