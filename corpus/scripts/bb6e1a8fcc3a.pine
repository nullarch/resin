
//@version=5
indicator("Vol Sig")
volSignal(float vol, float avgVol, bool priceUp) =>
    relVol = avgVol > 0 ? vol / avgVol : 1.0
    strength = math.min(relVol, 3.0) / 3.0
    priceUp ? strength : -strength

avgVol = ta.sma(volume, 5)
sig = volSignal(volume, avgVol, close > open)
plot(sig, "Sig")
