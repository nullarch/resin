
//@version=5
indicator("Vol Level E")
enum VolLevel
    Climax = 3
    High = 2
    Normal = 1
    Low = 0

avgVol = ta.sma(volume, 5)
ratio = avgVol > 0 ? volume / avgVol : 1.0
vl = switch
    ratio > 3.0 => VolLevel.Climax
    ratio > 1.5 => VolLevel.High
    ratio < 0.5 => VolLevel.Low
    => VolLevel.Normal
plot(int(vl), "VL")
