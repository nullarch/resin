
//@version=5
indicator("Cond Map Proc")
var indicators = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
map.put(indicators, "rsi", rsi)
map.put(indicators, "trend", close - sma3)
map.put(indicators, "vol", ta.atr(3))
bullScore = 0.0
bearScore = 0.0
for [name, val] in indicators
    if name == "rsi"
        bullScore := bullScore + (val > 50 ? 1.0 : 0.0)
        bearScore := bearScore + (val < 50 ? 1.0 : 0.0)
    else if name == "trend"
        bullScore := bullScore + (val > 0 ? 1.0 : 0.0)
        bearScore := bearScore + (val < 0 ? 1.0 : 0.0)
net = bullScore - bearScore
plot(net, "Net")
