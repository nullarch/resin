
//@version=5
indicator("Smooth Sig")
var float[] signals = array.new_float(0)
rsi = nz(ta.rsi(close, 3), 50.0)
rawSig = rsi > 55 ? 1.0 : rsi < 45 ? -1.0 : 0.0
array.push(signals, rawSig)
if array.size(signals) > 5
    array.shift(signals)
smoothSig = array.size(signals) > 0 ? array.avg(signals) : 0.0
plot(smoothSig, "SS")
