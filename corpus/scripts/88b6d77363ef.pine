//@version=5
strategy("Combo10")
enum Signal
    Buy = 1
    Sell = 2
    Hold = 3
getSignal(rsiVal, trend) =>
    rsiVal < 30.0 and trend > 0.0 ? Signal.Buy : rsiVal > 70.0 and trend < 0.0 ? Signal.Sell : Signal.Hold
var int trades = 0
rsiVal = nz(ta.rsi(close, 5), 50.0)
trend = close - nz(ta.sma(close, 5), close)
sig = getSignal(rsiVal, trend)
confirmCount = 0
for i = 0 to 2
    prev = nz(close[i], close)
    if prev > nz(ta.sma(close, 3), close)
        confirmCount := confirmCount + 1
if sig == Signal.Buy and confirmCount >= 2
    strategy.entry("B", strategy.long)
    trades := trades + 1
else if sig == Signal.Sell
    strategy.close("B")
plot(float(trades), "Trades")
