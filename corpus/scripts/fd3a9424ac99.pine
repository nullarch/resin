//@version=5
indicator("UDT Full")
type Signal
    float price = 0.0
    float strength = 0.0
    bool active = false
method activate(Signal s, float p, float str) =>
    s.price := p
    s.strength := str
    s.active := true
var sig = Signal.new()
if close > open
    sig.activate(close, ta.rsi(close, 5))
