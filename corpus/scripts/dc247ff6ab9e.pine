indicator("Multi Var")
var int count = 0
var float sumClose = 0.0
var float[] recentHighs = array.new_float(0)
count += 1
sumClose += close
array.push(recentHighs, high)
if array.size(recentHighs) > 5
    array.shift(recentHighs)
avgClose = sumClose / count
plot(avgClose)
plot(array.max(recentHighs))
