
//@version=5
indicator("Bar Vote")
var chars = map.new<string, float>()
body = math.abs(close - open)
rng = high - low
map.put(chars, "bull", close > open ? 1.0 : 0.0)
map.put(chars, "efficient", rng > 0 and body / rng > 0.5 ? 1.0 : 0.0)
map.put(chars, "expanding", rng > ta.sma(rng, 5) ? 1.0 : 0.0)
score = 0.0
for [k, v] in chars
    score := score + v
plot(score, "Score")
