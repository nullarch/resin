//@version=5
indicator("ImpulseResp")
var float impulseEma = 0.0
var int shockBar = 3
barIdx = bar_index
shock = barIdx == shockBar ? 10.0 : 0.0
alpha = 0.3
impulseEma := alpha * (close + shock) + (1.0 - alpha) * impulseEma
baseEma = alpha * close + (1.0 - alpha) * nz(impulseEma[1], close)
response = impulseEma - baseEma
plot(response, "ImpResp")
plot(impulseEma, "ImpEMA")
