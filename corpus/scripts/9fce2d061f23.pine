//@version=5
strategy("Materials Strategy")
stress = volume / ((high - low) > 0 ? (high - low) : 1.0)
strain = math.abs(close - open) / (close > 0 ? close : 1.0)
youngs = strain > 0.001 ? stress / strain : 0.0
rsiVal = nz(ta.rsi(close, 3), 50.0)
if youngs > 50.0 and rsiVal > 55
    strategy.entry("Strong", strategy.long)
if youngs < 20.0 or rsiVal < 40
    strategy.close("Strong")
