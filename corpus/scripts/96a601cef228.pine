//@version=5
indicator("Ecology-Climate")
// Climate: temperature trend
tempTrend = ta.ema(close, 5)
tempBaseline = ta.sma(close, 5)
warming = not na(tempTrend) and not na(tempBaseline) ? tempTrend - tempBaseline : 0.0
// Ecology: species range shift
migrationSpeed = warming > 0 ? warming * 10.0 : 0.0
var float totalMigration = 0.0
totalMigration := totalMigration + migrationSpeed
// Biodiversity impact
var float biodiversityIndex = 1.0
if totalMigration > 5.0
    biodiversityIndex := math.max(0.1, biodiversityIndex - 0.05)
