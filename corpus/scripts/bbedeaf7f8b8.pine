
//@version=5
indicator("Roll Ext")
var float[] highs = array.new_float(0)
var float[] lows = array.new_float(0)
array.push(highs, high)
array.push(lows, low)
if array.size(highs) > 8
    array.shift(highs)
    array.shift(lows)
rollingHi = array.size(highs) > 0 ? array.max(highs) : high
rollingLo = array.size(lows) > 0 ? array.min(lows) : low
rangeNorm = rollingHi > rollingLo ? (close - rollingLo) / (rollingHi - rollingLo) : 0.5
plot(rangeNorm, "Norm")
