
//@version=5
indicator("Manual ROC")
lookback = 5
avgROC = 0.0
count = 0
for i = 0 to lookback - 1
    c = close[i]
    cp = close[i + 1]
    if not na(c) and not na(cp) and cp != 0
        avgROC := avgROC + (c - cp) / cp * 100
        count := count + 1
avgROC := count > 0 ? avgROC / count : 0.0
plot(avgROC, "AvgROC")
