
//@version=5
indicator("Stat Track")
type StatTracker
    float sumVal = 0.0
    int count = 0
    float maxVal = -99999.0
    float minVal = 99999.0

var StatTracker st = StatTracker.new()
st.sumVal := st.sumVal + close
st.count := st.count + 1
st.maxVal := math.max(st.maxVal, close)
st.minVal := math.min(st.minVal, close)
mean = st.count > 0 ? st.sumVal / st.count : close
plot(mean, "Mean")
