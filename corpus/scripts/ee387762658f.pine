
//@version=5
indicator("Corr Track")
var ct = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
map.put(ct, "rsi_prev", map.get(ct, "rsi_curr", 50.0))
map.put(ct, "rsi_curr", rsi)
map.put(ct, "ma_prev", map.get(ct, "ma_curr", close))
map.put(ct, "ma_curr", sma3)
rsiChg = map.get(ct, "rsi_curr", 50.0) - map.get(ct, "rsi_prev", 50.0)
maChg = map.get(ct, "ma_curr", close) - map.get(ct, "ma_prev", close)
sameDir = (rsiChg > 0 and maChg > 0) or (rsiChg < 0 and maChg < 0)
plot(sameDir ? 1 : 0, "Same")
