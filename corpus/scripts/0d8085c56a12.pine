
//@version=5
indicator("Cum Stats")
var float totalRet = 0.0
var float maxRet = -99999.0
var float minRet = 99999.0
var int n = 0
ret = not na(close[1]) and close[1] > 0 ? (close - close[1]) / close[1] * 100 : 0.0
totalRet := totalRet + ret
n := n + 1
maxRet := math.max(maxRet, ret)
minRet := math.min(minRet, ret)
avgRet = n > 0 ? totalRet / n : 0.0
plot(avgRet, "Avg")
