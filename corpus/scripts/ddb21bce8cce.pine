
//@version=5
indicator("Quartiles")
var float[] data = array.new_float(0)
array.push(data, close)
if array.size(data) > 8
    array.shift(data)
sorted = array.copy(data)
array.sort(sorted)
q1 = array.percentile_linear_interpolation(sorted, 25.0)
q2 = array.percentile_linear_interpolation(sorted, 50.0)
q3 = array.percentile_linear_interpolation(sorted, 75.0)
iqr = q3 - q1
plot(iqr, "IQR")
