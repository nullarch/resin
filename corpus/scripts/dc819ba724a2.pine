//@version=5
strategy("Mega 20 Ultimate")
type State
    float value = 0.0
    int phase = 0
assess(float price, float ref) =>
    ref > 0.01 ? (price - ref) / ref * 100.0 : 0.0
var float accumulated = 0.0
var int phaseCount = 0
float sma3 = nz(ta.sma(close, 3), close)
float sma5 = nz(ta.sma(close, 5), close)
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float atrVal = nz(ta.atr(3), 1.0)
float dev = assess(close, sma3)
state = State.new(dev, 0)
int phase = 0
switch
    dev > 2.0 =>
        phase := 3
    dev > 0.5 =>
        phase := 2
    dev > -0.5 =>
        phase := 1
    =>
        phase := 0
state := State.new(dev, phase)
metrics = map.new<string, float>()
metrics.put("dev", dev)
metrics.put("rsi", rsiVal)
metrics.put("atr", atrVal)
metrics.put("trend", sma3 - sma5)
signals = array.new<float>(0)
for [mkey, mval] in metrics
    float normalized = mval > 0.0 ? math.min(mval, 100.0) : math.max(mval, -100.0)
    signals.push(normalized * 0.01)
float consensus = 0.0
for s in signals
    consensus := consensus + s
consensus := signals.size() > 0 ? consensus / signals.size() : 0.0
float refined = consensus
int refineStep = 0
while math.abs(refined) > 0.01 and refineStep < 5
    refined := refined * 0.9
    refineStep := refineStep + 1
accumulated := accumulated + math.abs(consensus)
phaseCount := phase > 1 ? phaseCount + 1 : phaseCount
if consensus > 0.3 and phase >= 2
    strategy.entry("Ultimate", strategy.long)
if consensus < -0.2 or phase == 0
    strategy.close("Ultimate")
float finalScore = state.value * 0.5 + consensus * 0.5
