//@version=5
strategy("Orbital Strategy")
kineticE = 0.5 * math.pow(close - nz(close[1], close), 2)
potentialE = -volume / (close > 0 ? close : 1.0)
totalE = kineticE + potentialE
rsiVal = nz(ta.rsi(close, 3), 50.0)
if totalE > 0 and rsiVal > 55
    strategy.entry("Launch", strategy.long)
if totalE < -5
    strategy.close("Launch")
