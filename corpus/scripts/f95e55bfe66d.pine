
//@version=5
indicator("For While")
sma3 = ta.sma(close, 3)
totalDist = 0.0
for i = 0 to 4
    if not na(close[i])
        totalDist := totalDist + math.abs(close[i] - sma3)
avgDist = totalDist / 5
threshold = 10.0
steps = 0
while threshold > avgDist and steps < 15
    threshold := threshold * 0.6
    steps := steps + 1
plot(steps, "St")
