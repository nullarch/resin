//@version=5
indicator("NLP Pipeline")
var float sentiment = 0.0
var float entropyAcc = 0.0
var float cumVol = 0.0
var int vocabCount = 0
var float lastStem = 0.0

// Sentiment from RSI
rsiVal = nz(ta.rsi(close, 3), 50.0)
sentiment := sentiment + (rsiVal > 55 ? 1.0 : rsiVal < 45 ? -1.0 : 0.0)

// Entropy from volume distribution
cumVol := cumVol + volume
pBar = cumVol > 0 ? volume / cumVol : 0.0
entropyAcc := entropyAcc - (pBar > 0.001 ? pBar * math.log(pBar) : 0.0)

// Vocabulary: track stem changes
stem = math.floor(close / 5.0) * 5.0
if stem != lastStem
    vocabCount := vocabCount + 1
    lastStem := stem

// Composite NLP score
nlpScore = sentiment * 0.5 + entropyAcc * 10.0 + vocabCount * 1.0
