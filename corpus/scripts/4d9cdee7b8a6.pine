
//@version=5
indicator("Vol State")
var float cumBuyVol = 0.0
var float cumSellVol = 0.0
var int highVolBars = 0
avgVol = ta.sma(volume, 5)
if close > open
    cumBuyVol := cumBuyVol + volume
else
    cumSellVol := cumSellVol + volume
if volume > avgVol * 1.5
    highVolBars := highVolBars + 1
ratio = (cumBuyVol + cumSellVol) > 0 ? cumBuyVol / (cumBuyVol + cumSellVol) : 0.5
plot(ratio, "Ratio")
