//@version=5
strategy("FullKalman20")
enum Regime
    FAST
    MEDIUM
    SLOW
type KState
    float est = 100.0
    float cov = 1.0
var KState ks = KState.new()
atrVal = nz(ta.atr(3), 1.0)
smaVal = nz(ta.sma(close, 5), close)
regime = switch
    atrVal > 5.0 => Regime.FAST
    atrVal < 2.0 => Regime.SLOW
    => Regime.MEDIUM
gain = switch regime
    Regime.FAST => 0.5
    Regime.MEDIUM => 0.3
    => 0.1
predCov = ks.cov + 0.05
ks.est := ks.est + gain * (close - ks.est)
ks.cov := (1.0 - gain) * predCov
if ks.est > smaVal and close > open
    strategy.entry("KL", strategy.long)
if ks.est < smaVal and close < open
    strategy.entry("KS", strategy.short)
