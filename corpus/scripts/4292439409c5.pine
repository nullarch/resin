
//@version=5
indicator("Risk Full")
atr = nz(ta.atr(3), 1.0)
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)

var float peak = 0.0
var float maxDD = 0.0
peak := math.max(peak, close)
dd = peak > 0 ? (peak - close) / peak * 100 : 0.0
maxDD := math.max(maxDD, dd)

riskPct = atr / close * 100
posSize = riskPct > 0 ? 2.0 / riskPct : 1.0
posSize := math.min(posSize, 5.0)

stopDist = atr * 2
targetDist = stopDist * 2.5

plot(posSize, "PS")
plot(maxDD, "MDD")
