
//@version=5
strategy("Qty Strat", overlay=true)
rsiVal = ta.rsi(close, 3)
sma3 = ta.sma(close, 3)
if ta.crossover(close, sma3)
    qty = rsiVal < 30 ? 3 : rsiVal < 50 ? 2 : 1
    strategy.entry("Long", strategy.long, qty=qty)
if ta.crossunder(close, sma3)
    strategy.close("Long")
plot(rsiVal, "RSI")
