
//@version=5
indicator("Risk Dash")
var rd = map.new<string, float>()
atr = ta.atr(3)
rsi = nz(ta.rsi(close, 3), 50.0)
avgATR = ta.sma(atr, 5)
map.put(rd, "atr_ratio", avgATR > 0 ? atr / avgATR : 1.0)
map.put(rd, "rsi_extreme", math.abs(rsi - 50) / 50)
map.put(rd, "spread_risk", close > 0 ? (high - low) / close * 100 : 0.0)
totalRisk = 0.0
for [k, v] in rd
    totalRisk := totalRisk + v
avgRisk = totalRisk / 3
plot(avgRisk, "Avg")
