
//@version=5
strategy("ATR Stop", overlay=true)
atrVal = ta.atr(3)
sma3 = ta.sma(close, 3)
var float stopPrice = 0.0
if ta.crossover(close, sma3)
    strategy.entry("Long", strategy.long)
    stopPrice := close - atrVal * 2
if close < stopPrice and stopPrice > 0
    strategy.close("Long")
    stopPrice := 0.0
plot(stopPrice, "Stop")
