
//@version=5
indicator("Multi LB")
avgReturn3 = 0.0
avgReturn5 = 0.0
count3 = 0
count5 = 0
for i = 0 to 4
    ret = close[i] - close[i+1]
    if not na(ret)
        count5 := count5 + 1
        avgReturn5 := avgReturn5 + ret
        if i < 3
            count3 := count3 + 1
            avgReturn3 := avgReturn3 + ret
avgReturn3 := count3 > 0 ? avgReturn3 / count3 : 0.0
avgReturn5 := count5 > 0 ? avgReturn5 / count5 : 0.0
plot(avgReturn3, "R3")
plot(avgReturn5, "R5")
