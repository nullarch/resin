
//@version=5
indicator("Mom Lookback")
bestMom = -99999.0
bestPeriod = 0
for period = 1 to 5
    prev = close[period]
    if not na(prev)
        mom = (close - prev) / prev * 100
        if mom > bestMom
            bestMom := mom
            bestPeriod := period
plot(bestMom, "BestMom")
plot(bestPeriod, "BestPeriod")
