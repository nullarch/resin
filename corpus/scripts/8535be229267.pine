//@version=5
strategy("test", overlay=true)
fast = ta.ema(close, 3)
slow = ta.sma(close, 5)
rsiVal = ta.rsi(close, 5)
longCond = ta.crossover(fast, slow) and rsiVal < 70
shortCond = ta.crossunder(fast, slow) and rsiVal > 30
if longCond
    strategy.entry("Long", strategy.long)
if shortCond
    strategy.entry("Short", strategy.short)
