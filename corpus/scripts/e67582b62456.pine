
//@version=5
indicator("Flow Map")
var fm = map.new<string, float>()
totalRange = high - low
buyPress = totalRange > 0 ? (close - low) / totalRange : 0.5
sellPress = totalRange > 0 ? (high - close) / totalRange : 0.5
map.put(fm, "buy_press", buyPress)
map.put(fm, "sell_press", sellPress)
map.put(fm, "net", buyPress - sellPress)
total = 0.0
for [k, v] in fm
    total := total + v
plot(total, "T")
