
//@version=5
indicator("Mom Phase")
rsi = nz(ta.rsi(close, 3), 50.0)
rsiMA = ta.sma(rsi, 3)
phase = switch
    rsi > 65 and rsi > rsiMA => "strong_bull"
    rsi > 50 => "mild_bull"
    rsi < 35 and rsi < rsiMA => "strong_bear"
    => "mild_bear"
isStrongBull = phase == "strong_bull"
plot(isStrongBull ? 1 : 0, "SB")
