
//@version=5
indicator("Comp Score")
var cs = map.new<string, float>()
map.put(cs, "trend", close > ta.sma(close, 3) ? 2.0 : -2.0)
map.put(cs, "mom", ta.rsi(close, 3) > 50 ? 1.5 : -1.5)
map.put(cs, "vol", ta.atr(3) > ta.sma(ta.atr(3), 5) ? 1.0 : -1.0)
total = 0.0
for [k, v] in cs
    total := total + v
normalized = total / 4.5
plot(normalized, "Score")
