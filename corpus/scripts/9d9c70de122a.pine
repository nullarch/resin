//@version=5
indicator("Ultra 018")
type Sampler
    float sum = 0.0
    int n = 0

method add(Sampler this, float val) =>
    this.sum := this.sum + val
    this.n := this.n + 1
    this

method mean(Sampler this) =>
    this.n > 0 ? this.sum / this.n : 0.0

magnitude(float val) =>
    switch
        math.abs(val) > 5 => "extreme"
        math.abs(val) > 2 => "notable"
        => "normal"

var Sampler sampler = Sampler.new(0.0, 0)
var float[] readings = array.new_float(0)
var int extremes = 0

rsiVal = nz(ta.rsi(close, 5), 50.0)
centered = rsiVal - 50.0
sampler.add(centered)

array.push(readings, centered)
if array.size(readings) > 5
    array.shift(readings)

extremes := 0
for [idx, val] in readings
    mag = magnitude(val)
    if mag == "extreme"
        extremes := extremes + 1

idx2 = 0
dampened = sampler.mean()
while idx2 < 3
    dampened := dampened * 0.85
    idx2 := idx2 + 1

summary = str.tostring(extremes) + "/" + str.tostring(sampler.n)
plot(dampened)
