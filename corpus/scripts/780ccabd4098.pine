
//@version=5
indicator("Trend Full")
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
[m, s, h] = ta.macd(close, 3, 5, 3)

maAlign = ema3 > sma5
priceTrend = close > ema3
momOK = rsi > 50 and h > 0

trendScore = (maAlign ? 1.0 : 0.0) + (priceTrend ? 1.0 : 0.0) + (momOK ? 1.0 : 0.0)
normScore = trendScore / 3.0

var float peak = 0.0
peak := math.max(peak, close)
dd = peak > 0 ? (peak - close) / peak * 100 : 0.0

var int bars = 0
bars := bars + 1

plot(normScore, "TS")
plot(dd, "DD")
