//@version=5
indicator("Complex UDT")
var float result = 0.0

type Analyzer
    float sma_val = 0.0
    float ema_val = 0.0

method spread(Analyzer self) =>
    math.abs(self.sma_val - self.ema_val)

sma3 = ta.sma(close, 3)
ema3 = ta.ema(close, 3)
a = Analyzer.new(nz(sma3, 0.0), nz(ema3, 0.0))
result := a.spread()
