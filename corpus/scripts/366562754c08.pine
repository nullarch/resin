
//@version=5
indicator("Event Map")
var em = map.new<string, float>()
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
map.put(em, "ma_cross", ta.crossover(close, sma3) ? 1.0 : 0.0)
map.put(em, "rsi_high", rsi > 65 ? 1.0 : 0.0)
map.put(em, "rsi_low", rsi < 35 ? 1.0 : 0.0)
activeEvents = 0
for [k, v] in em
    if v > 0
        activeEvents := activeEvents + 1
plot(activeEvents, "AE")
