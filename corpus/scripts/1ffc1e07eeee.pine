
//@version=5
indicator("Wt Signal")
weightedSig(float trendSig, float momSig, float volSig) =>
    trendSig * 0.5 + momSig * 0.3 + volSig * 0.2

t = close > ta.sma(close, 3) ? 1.0 : -1.0
m = ta.rsi(close, 3) > 50 ? 1.0 : -1.0
v = ta.atr(3) > ta.sma(ta.atr(3), 5) ? 1.0 : -1.0
ws = weightedSig(t, m, v)
plot(ws, "WtSig")
