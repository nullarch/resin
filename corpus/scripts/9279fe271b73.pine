//@version=5
indicator("Qubit Superposition")
float rawAlpha = close - 105.0
float rawBeta = high - low
float norm = math.sqrt(rawAlpha * rawAlpha + rawBeta * rawBeta)
float safeNorm = math.max(norm, 0.001)
float alpha = rawAlpha / safeNorm
float beta = rawBeta / safeNorm
float probZero = alpha * alpha
float probOne = beta * beta
