
//@version=5
strategy("Mom Strat", overlay=true)
rsi = nz(ta.rsi(close, 3), 50.0)
[m, s, h] = ta.macd(close, 3, 5, 3)
sma3 = ta.sma(close, 3)
bullMom = rsi > 55 and h > 0 and close > sma3
if bullMom
    strategy.entry("Long", strategy.long)
if rsi < 40 or h < 0
    strategy.close("Long")
plot(sma3, "MA")
