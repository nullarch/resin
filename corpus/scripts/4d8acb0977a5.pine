//@version=5
indicator("BayesEMA")
var float bema = 0.0
var int barN = 0
barN := barN + 1
if barN == 1
    bema := close
else
    noise = math.max(math.abs(close - nz(close[1], close)), 0.01)
    signal = math.max(math.abs(nz(ta.sma(close, 3), close) - nz(ta.sma(close, 5), close)), 0.01)
    snr = signal / noise
    alpha = snr / (1.0 + snr)
    bema := alpha * close + (1.0 - alpha) * bema
plot(bema, "BEMA")
