
//@version=5
indicator("StatReport")
var float[] prices = array.new_float(0)
array.push(prices, close)
if array.size(prices) > 5
    array.shift(prices)
mean = array.avg(prices)
maxP = array.max(prices)
minP = array.min(prices)
rangeP = maxP - minP
report = "M:" + str.tostring(math.round(mean, 2))
report := report + " R:" + str.tostring(math.round(rangeP, 2))
report := report + " N:" + str.tostring(array.size(prices))
reportLen = str.length(report)
plot(float(reportLen), "RL")
