
//@version=5
indicator("Risk Rpt")
atr = ta.atr(3)
rsi = nz(ta.rsi(close, 3), 50.0)
avgATR = ta.sma(atr, 5)
volStatus = atr > avgATR * 1.3 ? "HIGH" : "NORM"
momStatus = rsi > 65 ? "OB" : rsi < 35 ? "OS" : "OK"
report = volStatus + "_" + momStatus
isRisky = report == "HIGH_OB" or report == "HIGH_OS"
plot(isRisky ? 1 : 0, "Risky")
