
//@version=5
indicator("Avg Bar Rng")
totalRange = 0.0
count = 0
for i = 0 to 4
    h = high[i]
    l = low[i]
    if not na(h) and not na(l)
        totalRange := totalRange + (h - l)
        count := count + 1
avgRange = count > 0 ? totalRange / count : 0.0
currentRatio = avgRange > 0 ? (high - low) / avgRange : 1.0
plot(currentRatio, "Ratio")
