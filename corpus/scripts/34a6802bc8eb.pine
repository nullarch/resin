
//@version=5
indicator("Range Dist")
var float[] ranges = array.new_float(0)
barRange = high - low
array.push(ranges, barRange)
if array.size(ranges) > 10
    array.shift(ranges)
avgRange = array.size(ranges) > 0 ? array.avg(ranges) : barRange
medRange = array.size(ranges) > 0 ? array.median(ranges) : barRange
plot(avgRange, "Avg")
