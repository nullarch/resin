//@version=5
indicator("Attractive Field")
float goalX = 110.0
float goalY = 112.0
float posX = close
float posY = high
float dx = goalX - posX
float dy = goalY - posY
float dist = math.sqrt(dx * dx + dy * dy)
float kAtt = 0.5
float forceX = kAtt * dx
float forceY = kAtt * dy
float forceMag = math.sqrt(forceX * forceX + forceY * forceY)
