
//@version=5
strategy("Cust Osc", overlay=true)
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
rangeVal = hi5 - lo5
osc = rangeVal > 0 ? (close - lo5) / rangeVal * 100 - 50 : 0.0
sma3 = ta.sma(close, 3)
if osc < -20 and close > sma3
    strategy.entry("Long", strategy.long)
if osc > 30
    strategy.close("Long")
plot(sma3, "MA")
