
//@version=5
indicator("Multi Key")
var mk = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
map.put(mk, "rsi", rsi)
map.put(mk, "trend", close - sma3)
map.put(mk, "vol", atr)
map.put(mk, "score", (rsi - 50) / 50 + (close > sma3 ? 0.5 : -0.5))
score = map.get(mk, "score", 0.0)
keyCount = map.size(mk)
plot(score, "Score")
plot(keyCount, "Keys")
