
//@version=5
indicator("Newton Sqrt")
val = math.abs(close)
guess = val / 2.0
iterations = 0
while iterations < 20 and guess > 0
    newGuess = (guess + val / guess) / 2.0
    if math.abs(newGuess - guess) < 0.0001
        guess := newGuess
        iterations := 20
    else
        guess := newGuess
    iterations := iterations + 1
plot(guess, "Sqrt")
