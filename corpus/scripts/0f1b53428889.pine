//@version=5
indicator("test")
var int sessionBars = 0
var float sessionHigh = 0.0
var float sessionLow = 99999.0
if session.isfirstbar
    sessionBars := 0
    sessionHigh := high
    sessionLow := low
sessionBars := sessionBars + 1
sessionHigh := math.max(sessionHigh, high)
sessionLow := math.min(sessionLow, low)
range_ = sessionHigh - sessionLow
plot(range_)
