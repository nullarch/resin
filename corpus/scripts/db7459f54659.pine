
//@version=5
indicator("Profit Track")
var float entryPrice = 0.0
var float totalPnL = 0.0
var bool inPosition = false
sma3 = ta.sma(close, 3)
if ta.crossover(close, sma3) and not inPosition
    entryPrice := close
    inPosition := true
else if ta.crossunder(close, sma3) and inPosition
    totalPnL := totalPnL + (close - entryPrice)
    inPosition := false
plot(totalPnL, "PnL")
