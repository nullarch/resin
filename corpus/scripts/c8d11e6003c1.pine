
//@version=5
indicator("Risk Score UDF")
riskScore(float volRatio, float dd, float rsi) =>
    volRisk = volRatio > 1.5 ? 2.0 : volRatio > 1.0 ? 1.0 : 0.5
    ddRisk = dd > 5 ? 2.0 : dd > 2 ? 1.0 : 0.0
    momRisk = rsi > 70 or rsi < 30 ? 1.0 : 0.0
    volRisk + ddRisk + momRisk

atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
ratio = avgATR > 0 ? atr / avgATR : 1.0
rsi = nz(ta.rsi(close, 3), 50.0)
score = riskScore(ratio, 2.0, rsi)
plot(score, "RS")
