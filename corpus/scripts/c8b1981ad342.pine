
//@version=5
indicator("Bar Type")
body = math.abs(close - open_)
barRange = high - low
eff = barRange > 0 ? body / barRange : 0.0
upperW = high - math.max(close, open_)
lowerW = math.min(close, open_) - low
bType = switch
    eff > 0.8 => "marubozu"
    eff < 0.1 => "doji"
    lowerW > body * 2 => "hammer"
    upperW > body * 2 => "star"
    => "normal"
isSignal = bType == "hammer" or bType == "star"
plot(isSignal ? 1 : 0, "Sig")
