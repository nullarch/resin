//@version=5
indicator("Archimedes Buoyancy")
objectDensity = close * 0.01
fluidDensity = 1.025
displacedVolume = volume * 0.001
buoyantForce = fluidDensity * 9.81 * displacedVolume
weight = objectDensity * 9.81 * displacedVolume
netForce = buoyantForce - weight
floats = netForce > 0 ? 1.0 : 0.0
plot(netForce)
