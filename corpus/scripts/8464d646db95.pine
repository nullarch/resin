//@version=5
strategy("Full Strategy", overlay=true)
sma20 = ta.sma(close, 5)
rsi_ = ta.rsi(close, 5)
longCond = ta.crossover(close, sma20) and not na(rsi_) and rsi_ < 50
shortCond = ta.crossunder(close, sma20) and not na(rsi_) and rsi_ > 50
if longCond
    strategy.entry("Long", strategy.long)
    label.new(bar_index, low, "BUY", color=color.green)
if shortCond
    strategy.entry("Short", strategy.short)
    label.new(bar_index, high, "SELL", color=color.red)
plot(sma20)
