//@version=5
indicator("Community2")
mid = nz(ta.sma(close, 5), close)
comm1 = array.new_float(0)
comm2 = array.new_float(0)
vals = array.new_float(0)
array.push(vals, close)
array.push(vals, open)
array.push(vals, high)
array.push(vals, low)
for i = 0 to 3
    v = array.get(vals, i)
    if v >= mid
        array.push(comm1, v)
    else
        array.push(comm2, v)
sz1 = float(array.size(comm1))
sz2 = float(array.size(comm2))
balance = sz1 > 0.0 and sz2 > 0.0 ? math.min(sz1, sz2) / math.max(sz1, sz2) : 0.0
plot(balance, "Balance")
plot(sz1, "Comm1Sz")
