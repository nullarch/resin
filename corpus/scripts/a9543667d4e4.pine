
//@version=5
indicator("Lag Series")
var float[] lags = array.new_float(0)
array.push(lags, close)
if array.size(lags) > 6
    array.shift(lags)
lag1 = array.size(lags) >= 2 ? array.get(lags, array.size(lags) - 2) : close
lag3 = array.size(lags) >= 4 ? array.get(lags, array.size(lags) - 4) : close
momentum = close - lag3
plot(momentum, "Mom")
