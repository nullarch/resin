//@version=5
indicator("Torture 5")
var float maxRSI = 0.0
var float minRSI = 100.0
varip int tickCount = 0
tickCount := tickCount + 1
float rsiVal = nz(ta.rsi(close, 5), 50.0)
maxRSI := math.max(maxRSI, rsiVal)
minRSI := math.min(minRSI, rsiVal)
float rsiRange = maxRSI - minRSI
weights = array.new<float>(0)
for idx = 0 to 2
    float wt = idx == 0 ? 0.5 :
        idx == 1 ? 0.3 :
        0.2
    weights.push(wt)
float zone = switch
    rsiVal > 70 => 3.0
    rsiVal > 50 => 2.0
    rsiVal > 30 => 1.0
    => 0.0
float score = zone * rsiRange / math.max(tickCount, 1)
