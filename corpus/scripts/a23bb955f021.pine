//@version=5
strategy("Cycle 130 Milestone", overlay=true)
type Position
    string side = "flat"
    float entry = 0.0
    float pnl = 0.0
    int bars = 0
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema5 = ta.ema(close, 5)
rsi5 = ta.rsi(close, 5)
atr3 = ta.atr(3)
[macdL, sigL, hist] = ta.macd(close, 3, 5, 3)
[bbU, bbM, bbL] = ta.bb(close, 5, 2.0)
var prices = array.new_float(0)
var m = map.new<string, float>()
var int totalBars = 0
var int signals = 0
var float maxPnL = 0.0
pos = Position.new()
array.push(prices, close)
if array.size(prices) > 5
    array.shift(prices)
score = 0
if not na(sma3) and close > nz(sma3)
    score := score + 1
if not na(rsi5) and nz(rsi5) > 50
    score := score + 1
if not na(hist) and nz(hist) > 0
    score := score + 1
if score >= 2 and not na(atr3)
    pos.side := "long"
    pos.entry := close
    strategy.entry("L", strategy.long)
    strategy.exit("TP", "L", profit=100, loss=50)
    signals := signals + 1
else if score <= 0
    pos.side := "flat"
    strategy.close("L")
map.put(m, "score", float(score))
map.put(m, "signals", float(signals))
clr = score >= 2 ? color.green : score <= 0 ? color.red : color.gray
plot(sma3, "Fast", color=clr)
plot(sma5, "Slow")
totalBars := totalBars + 1
