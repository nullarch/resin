//@version=5
indicator("Window analytics")
var window = array.new_float(0)
array.push(window, close)
if array.size(window) > 5
    array.shift(window)
sz = array.size(window)
avg_val = array.avg(window)
min_val = array.min(window)
max_val = array.max(window)
rng = array.range(window)
med = sz >= 1 ? array.median(window) : 0.0
