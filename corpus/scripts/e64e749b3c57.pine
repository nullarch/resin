
//@version=5
indicator("RSI Div Str")
rsi = ta.rsi(close, 3)
priceSlope = close - close[2]
rsiSlope = rsi - rsi[2]
divergence = priceSlope > 0 and rsiSlope < 0 ? -1 : priceSlope < 0 and rsiSlope > 0 ? 1 : 0
strength = math.abs(priceSlope) + math.abs(rsiSlope)
plot(divergence, "Div")
plot(strength, "Str")
