
//@version=5
indicator("Level Track")
var float resistLevel = 0.0
var float supportLevel = 99999.0
var int touchCount = 0
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
resistLevel := math.max(resistLevel, hi5)
supportLevel := math.min(supportLevel, lo5)
if close >= resistLevel * 0.99 or close <= supportLevel * 1.01
    touchCount := touchCount + 1
plot(touchCount, "TC")
