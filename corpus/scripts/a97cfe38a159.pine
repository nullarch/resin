//@version=5
indicator("Grover Search")
float target = 107.0
float tolerance = 2.0
float dist = math.abs(close - target)
float rawAmp = dist < tolerance ? 2.0 : 0.5
var float amplitude = 1.0
amplitude := amplitude * rawAmp
amplitude := math.max(0.01, math.min(amplitude, 100.0))
float probability = amplitude * amplitude / (amplitude * amplitude + 1.0)
