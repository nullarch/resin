
//@version=5
indicator("Circ Buf")
var float[] buf = array.new_float(0)
array.push(buf, close)
if array.size(buf) > 5
    array.shift(buf)
first = array.size(buf) > 0 ? array.get(buf, 0) : close
last = array.size(buf) > 0 ? array.get(buf, array.size(buf) - 1) : close
change = last - first
plot(change, "Chg")
