
//@version=5
strategy("Risk Mgd", overlay=true)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
lowRisk = avgATR > 0 and atr < avgATR * 1.5
if close > sma3 and rsi > 50 and lowRisk
    strategy.entry("Long", strategy.long)
if close < sma3 or atr > avgATR * 2
    strategy.close("Long")
plot(sma3, "MA")
