//@version=5
strategy("MicroFilter", overlay=true)
prevClose = nz(close[1], close)
absRet = math.abs(close - prevClose)
midRange = (high - low) / 2.0
lowToxic = absRet <= midRange
rsiVal = nz(ta.rsi(close, 5), 50.0)
if lowToxic and rsiVal < 30
    strategy.entry("Long", strategy.long)
if rsiVal > 70
    strategy.close("Long")
