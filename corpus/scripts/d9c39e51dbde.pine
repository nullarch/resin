//@version=5
indicator("Gompertz")
float aParam = 0.01
float bParam = 0.3
var int tStep = 0
tStep := tStep + 1
float gompertzHaz = aParam * math.exp(bParam * tStep)
var float cumGompertz = 0.0
cumGompertz := cumGompertz + gompertzHaz
float survGompertz = math.exp(-cumGompertz)
plot(survGompertz, "GompertzSurv")
