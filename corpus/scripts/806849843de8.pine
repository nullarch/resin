//@version=5
indicator("Criticality State")
enum CritState
    Subcritical
    Critical
    Supercritical
float kEff = 0.98 + (close - 100.0) / 500.0
state = switch
    kEff > 1.01 => CritState.Supercritical
    kEff >= 0.99 => CritState.Critical
    => CritState.Subcritical
var int criticalBars = 0
if kEff >= 0.99 and kEff <= 1.01
    criticalBars := criticalBars + 1
