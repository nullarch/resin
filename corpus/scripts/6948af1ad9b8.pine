//@version=5
indicator("RollEntropy02")
bins = array.new_float(3, 0.0)
diff = close - open
if diff > 1.0
    array.set(bins, 0, nz(array.get(bins, 0), 0.0) + 1.0)
else if diff < -1.0
    array.set(bins, 2, nz(array.get(bins, 2), 0.0) + 1.0)
else
    array.set(bins, 1, nz(array.get(bins, 1), 0.0) + 1.0)
total = array.sum(bins)
entropy = 0.0
for i = 0 to 2
    p = total > 0 ? nz(array.get(bins, i), 0.0) / total : 0.0
    if p > 0.001
        entropy := entropy - p * math.log(p)
plot(entropy, "e")
