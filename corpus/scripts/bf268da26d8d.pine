
//@version=5
indicator("Trend Score")
trendScore(float price, float ma3, float ma5, float rsi) =>
    maScore = price > ma3 ? 1.0 : -1.0
    alignScore = ma3 > ma5 ? 1.0 : -1.0
    rsiScore = (rsi - 50) / 25
    maScore + alignScore + rsiScore

sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
score = trendScore(close, sma3, sma5, rsi)
plot(score, "TS")
