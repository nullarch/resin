//@version=5
strategy("Congestion Relief")
float volSma = ta.sma(volume, 3)
float prevVol = not na(volume[1]) ? volume[1] : volume
bool wasCongested = prevVol > nz(volSma, volume) * 1.3
bool relieved = volume < nz(volSma, volume) * 0.9
if wasCongested and relieved
    strategy.entry("Relief", strategy.long)
if close < open
    strategy.close("Relief")
