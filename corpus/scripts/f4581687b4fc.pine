//@version=5
indicator("Comprehensive Analyzer")

type Config
    float factor = 1.0

enum Mode
    Simple = 1
    Complex = 2

scale(float x, float f) =>
    x * f

Config cfg = Config.new(factor=2.0)
Mode m = Mode.Complex

float base = math.abs(-10.0)
float scaled = scale(base, cfg.factor)

float total = 0.0
for i = 1 to 3
    total := total + float(i)

var float result = 0.0
result := switch m
    Mode.Simple => scaled
    Mode.Complex => scaled + total
    => 0.0
