//@version=5
indicator("Mega 6")
type Asset
    float price = 0.0
    float score = 0.0
rank(float val, float base) =>
    base > 0.01 ? val / base : 0.0
var float bestScore = 0.0
float sma3 = nz(ta.sma(close, 3), close)
float atrVal = nz(ta.atr(3), 1.0)
scores = map.new<string, float>()
scores.put("momentum", rank(close, sma3))
scores.put("volatility", rank(atrVal, close) * 100.0)
scores.put("strength", close > open ? 1.0 : 0.0)
keys = array.from("momentum", "volatility", "strength")
float total = 0.0
for k in keys
    float val = scores.get(k)
    total := total + nz(val, 0.0)
float avg = total / 3.0
bestScore := math.max(bestScore, avg)
asset = Asset.new(close, avg)
float premium = asset.score > 0.5 ? asset.price * 1.01 : asset.price * 0.99
