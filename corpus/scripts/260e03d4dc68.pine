
//@version=5
indicator("Trend Full")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema3 = ta.ema(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)

maScore = sma5 > 0 ? (sma3 - sma5) / sma5 * 100 : 0.0
priceScore = sma3 > 0 ? (close - sma3) / sma3 * 100 : 0.0
rsiScore = (rsi - 50) / 50
composite = maScore * 0.4 + priceScore * 0.3 + rsiScore * 30 * 0.3

atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
volAdj = avgATR > 0 and atr / avgATR > 1.3 ? 0.5 : 1.0

var int trendBars = 0
if composite > 0
    trendBars := trendBars + 1

plot(composite * volAdj, "C")
plot(trendBars, "TB")
