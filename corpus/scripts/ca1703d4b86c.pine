
//@version=5
indicator("4 Regime")
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
trend = close > sma3
highVol = avgATR > 0 and atr > avgATR * 1.3
regime = switch
    trend and not highVol => "bull_quiet"
    trend and highVol => "bull_volatile"
    not trend and not highVol => "bear_quiet"
    => "bear_volatile"
isBullQuiet = regime == "bull_quiet"
plot(isBullQuiet ? 1 : 0, "BQ")
