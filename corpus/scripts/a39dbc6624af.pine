
//@version=5
indicator("Dist Type")
mean = ta.sma(close, 5)
sd = ta.stdev(close, 5)
zscore = sd > 0 ? (close - mean) / sd : 0.0
absZ = math.abs(zscore)
distType = switch
    absZ > 3 => "extreme"
    absZ > 2 => "outlier"
    absZ > 1 => "spread"
    => "normal"
isNormal = distType == "normal"
plot(isNormal ? 1 : 0, "Norm")
