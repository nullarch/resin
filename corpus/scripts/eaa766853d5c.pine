//@version=5
indicator("Grand Comprehensive")
calcWeight(val, threshold) =>
    val > threshold ? 2.0 : 1.0
var float[] weights = array.new_float(0)
var float weightedSum = 0.0
smaVal = ta.sma(close, 3)
emaVal = ta.ema(close, 3)
signal = not na(smaVal) and not na(emaVal) ? (smaVal + emaVal) / 2.0 : close
w = calcWeight(close, 105.0)
array.push(weights, w)
trend = switch
    close > 108 => "strong_bull"
    close > 104 => "bull"
    close > 100 => "neutral"
    => "bear"
weightedSum := weightedSum + signal * w
