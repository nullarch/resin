//@version=5
indicator("Cycle51 All")
// For expression result (_gen_for_with_result)
var float for_r = 0.0
for_r := 0.0
for i = 1 to 5
    for_r := for_r + i
// 15

// Switch expression result
var float sw_r = 0.0
x = 2
sw_r := switch x
    1 => 10.0
    2 => 20.0
    => 0.0

// If expression result
var float if_r = 0.0
if_r := if close > 100
    1.0
else
    0.0

// TA stateful (_CTX_KWARG/_STATE_KEY_KWARG injection)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema3 = ta.ema(close, 3)

// Input
length = input.int(5, title="Len")

// Log (no-op)
log.info("bar processed")

// Nested TA
rsi5 = ta.rsi(close, 5)
sma_rsi = ta.sma(rsi5, 3)

// bar_index
var float bi = 0.0
bi := bar_index

// var counter
var int bars = 0
bars := bars + 1

// Result
var float result = 0.0
result := for_r + sw_r + if_r + nz(sma3) + nz(sma5) + nz(ema3) + nz(sma_rsi, 50.0) + bi + bars
plot(close)
