
//@version=5
indicator("Sig Str")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
score = (close > sma3 ? 1 : 0) + (sma3 > sma5 ? 1 : 0) + (rsi > 55 ? 1 : 0)
strength = switch score
    3 => "strong"
    2 => "moderate"
    1 => "weak"
    => "none"
isStrong = strength == "strong"
plot(isStrong ? 1 : 0, "S")
