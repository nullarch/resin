
//@version=5
indicator("Body Analysis")
totalBody = 0.0
bullBodies = 0.0
count = 0
for i = 0 to 4
    c = close[i]
    o = open[i]
    if not na(c) and not na(o)
        body = math.abs(c - o)
        totalBody := totalBody + body
        if c > o
            bullBodies := bullBodies + body
        count := count + 1
bullPct = totalBody > 0 ? bullBodies / totalBody * 100 : 50.0
plot(bullPct, "BullPct")
