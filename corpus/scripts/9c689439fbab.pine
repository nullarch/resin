//@version=5
indicator("ForInResid19")
var float est = 100.0
est := est + 0.3 * (close - est)
residuals = array.new_float(0)
for i = 0 to 4
    array.push(residuals, close + float(i) - est)
sumR = 0.0
for [idx, val] in residuals
    sumR := sumR + val * val
mse = array.size(residuals) > 0 ? sumR / float(array.size(residuals)) : 0.0
plot(mse, "mse")
