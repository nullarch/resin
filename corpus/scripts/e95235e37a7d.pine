
//@version=5
indicator("Opt F")
optimalF(float winRate, float avgWin, float avgLoss) =>
    avgLoss > 0 ? winRate - (1 - winRate) / (avgWin / avgLoss) : 0.0

var int wins = 0
var int total = 0
ret = close - close[1]
if not na(ret)
    total := total + 1
    if ret > 0
        wins := wins + 1
wr = total > 0 ? float(wins) / total : 0.5
f = optimalF(wr, 2.0, 1.0)
safef = math.max(0.0, math.min(0.25, f))
plot(safef, "F")
