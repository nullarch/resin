
//@version=5
indicator("Micro")
var md = map.new<string, float>()
body = math.abs(close - open_)
barRange = high - low
map.put(md, "body", body)
map.put(md, "range", barRange)
map.put(md, "eff", barRange > 0 ? body / barRange : 0.0)
map.put(md, "vol", volume)
eff = map.get(md, "eff", 0.0)
plot(eff, "Eff")
