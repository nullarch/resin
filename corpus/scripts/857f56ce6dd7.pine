
//@version=5
indicator("Map Prev")
var prev = map.new<string, float>()
prevClose = map.get(prev, "close", close)
prevRSI = map.get(prev, "rsi", 50.0)
rsi = nz(ta.rsi(close, 3), 50.0)
closeChg = close - prevClose
rsiChg = rsi - prevRSI
map.put(prev, "close", close)
map.put(prev, "rsi", rsi)
sameDir = (closeChg > 0 and rsiChg > 0) or (closeChg < 0 and rsiChg < 0)
plot(sameDir ? 1 : 0, "Same")
