
//@version=5
indicator("Streak")
var int streak = 0
var int maxStreak = 0
isWin = close > open
if isWin
    streak := streak > 0 ? streak + 1 : 1
else
    streak := streak < 0 ? streak - 1 : -1
if math.abs(streak) > maxStreak
    maxStreak := math.abs(streak)
plot(streak, "Streak")
plot(maxStreak, "Max")
