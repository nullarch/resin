
//@version=5
indicator("Regime Lbl")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
trendLabel = sma3 > sma5 ? "BULL" : "BEAR"
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
volLabel = avgATR > 0 and atr > avgATR * 1.3 ? "VOLATILE" : "CALM"
label = trendLabel + "_" + volLabel
isBullCalm = label == "BULL_CALM"
plot(isBullCalm ? 1 : 0, "BC")
