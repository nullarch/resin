
//@version=5
indicator("DI Proxy")
upMove = nz(high - high[1], 0.0)
downMove = nz(low[1] - low, 0.0)
plusDM = upMove > downMove and upMove > 0 ? upMove : 0.0
minusDM = downMove > upMove and downMove > 0 ? downMove : 0.0
smoothPlus = ta.sma(plusDM, 5)
smoothMinus = ta.sma(minusDM, 5)
diDiff = smoothPlus - smoothMinus
plot(diDiff, "DI")
