
//@version=5
indicator("Optimize")
rsi = nz(ta.rsi(close, 3), 50.0)
bestThresh = 50.0
bestScore = 0.0
thresh = 40.0
while thresh <= 70
    score = rsi > thresh ? 1.0 : 0.0
    if score > bestScore
        bestScore := score
        bestThresh := thresh
    thresh := thresh + 5
plot(bestThresh, "BT")
