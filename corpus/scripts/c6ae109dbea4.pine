//@version=5
indicator("Multi Enum")
enum Trend
    Up = 1
    Down = -1
    Flat = 0
enum Strength
    Strong = 2
    Normal = 1
    Weak = 0
t = close > open ? Trend.Up : close < open ? Trend.Down : Trend.Flat
s = math.abs(close - open) > 3 ? Strength.Strong : Strength.Normal
plot(t == Trend.Up ? 1 : -1)
