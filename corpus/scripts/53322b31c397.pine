//@version=5
indicator("ZeroCross03")
var int crossings = 0
var float prevCycle = 0.0
trend = nz(ta.sma(close, 3), close)
cycle = close - trend
if (cycle > 0 and prevCycle < 0) or (cycle < 0 and prevCycle > 0)
    crossings := crossings + 1
prevCycle := cycle
halfCycles = float(crossings)
plot(halfCycles, "hc")
