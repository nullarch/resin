//@version=5
indicator("Torture 16")
type Composite
    float fast = 0.0
    float slow = 0.0
    float rsi = 0.0
method divergence(Composite this) =>
    math.abs(this.fast - this.slow)
var float maxDiv = 0.0
comp = Composite.new(
    nz(ta.ema(close, 2), close),
    nz(ta.sma(close, 5), close),
    nz(ta.rsi(close, 5), 50.0))
float div = comp.divergence()
maxDiv := math.max(maxDiv, div)
indicators = array.new<float>(0)
indicators.push(comp.fast)
indicators.push(comp.slow)
indicators.push(comp.rsi)
float sumInd = 0.0
for ind in indicators
    sumInd := sumInd + ind
float avgInd = indicators.size() > 0 ?
    sumInd / indicators.size() :
    0.0
float regime = switch
    comp.rsi > 70 and comp.fast > comp.slow => 3.0
    comp.rsi < 30 and comp.fast < comp.slow => 1.0
    => 2.0
float relDiv = maxDiv > 0.01 ? div / maxDiv : 0.0
