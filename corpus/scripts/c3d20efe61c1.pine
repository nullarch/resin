//@version=5
indicator("Entanglement")
float ema2 = nz(ta.ema(close, 2), close)
float ema5 = nz(ta.ema(close, 5), close)
var float sumProd = 0.0
var float sumSq1 = 0.0
var float sumSq2 = 0.0
var int cnt = 0
cnt := cnt + 1
float d1 = ema2 - close
float d2 = ema5 - close
sumProd := sumProd + d1 * d2
sumSq1 := sumSq1 + d1 * d1
sumSq2 := sumSq2 + d2 * d2
float denom = math.sqrt(sumSq1 * sumSq2)
float entanglement = denom > 0.001 ? math.abs(sumProd / denom) : 0.0
