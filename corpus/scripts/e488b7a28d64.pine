
//@version=5
indicator("Level Lbl")
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
rng = hi5 - lo5
pos = rng > 0 ? (close - lo5) / rng * 100 : 50.0
zone = pos > 60 ? "UPPER" : pos < 40 ? "LOWER" : "MID"
trend = close > ta.sma(close, 3) ? "UP" : "DN"
label = zone + "_" + trend
isUpperUp = label == "UPPER_UP"
plot(isUpperUp ? 1 : 0, "UU")
