//@version=5
indicator("PolicyGrad")
var float weight = 0.0
var float avgReward = 0.0
var int steps = 0
steps := steps + 1
reward = close > open ? 1.0 : -1.0
avgReward := avgReward + (reward - avgReward) / float(steps)
advantage = reward - avgReward
lr = 0.05
rsiVal = nz(ta.rsi(close, 3), 50.0)
action = rsiVal > 50 ? 1.0 : -1.0
weight := weight + lr * advantage * action
plot(weight, "W")
