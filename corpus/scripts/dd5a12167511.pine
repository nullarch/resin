//@version=5
indicator("Cipher Block Chain")
var blocks = array.new<float>(0)
var float prevCipher = 42.0
plainBlock = close * 10.0
xored = math.abs(plainBlock - prevCipher)
encrypted = xored - math.floor(xored / 997.0) * 997.0
prevCipher := encrypted
array.push(blocks, encrypted)
if array.size(blocks) > 5
    array.shift(blocks)
lastBlock = array.get(blocks, array.size(blocks) - 1)
plot(lastBlock)
