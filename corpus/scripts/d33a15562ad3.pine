
//@version=5
indicator("Event Log")
var float[] events = array.new_float(0)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
if ta.crossover(close, sma3)
    array.push(events, 1.0)
if rsi > 70
    array.push(events, 2.0)
if array.size(events) > 10
    array.shift(events)
plot(array.size(events), "EC")
