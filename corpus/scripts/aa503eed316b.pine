
//@version=5
indicator("Regime Hist")
var float[] regimes = array.new_float(0)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
regime = close > sma3 and rsi > 55 ? 1.0 : close < sma3 and rsi < 45 ? -1.0 : 0.0
array.push(regimes, regime)
if array.size(regimes) > 6
    array.shift(regimes)
avgRegime = array.avg(regimes)
persistent = math.abs(avgRegime) > 0.5
plot(persistent ? avgRegime : 0.0, "Pers")
