//@version=5
indicator("C300-12")
var float bullSum = 0.0
var float bearSum = 0.0
var int bullN = 0
var int bearN = 0
if close > open
    bullSum := bullSum + close - open
    bullN := bullN + 1
else
    bearSum := bearSum + open - close
    bearN := bearN + 1
avgBull = bullN > 0 ? bullSum / bullN : 0.0
avgBear = bearN > 0 ? bearSum / bearN : 0.0
plot(avgBull - avgBear)
