
//@version=5
indicator("Map Sum")
var scores = map.new<string, float>()
map.put(scores, "a", close > ta.sma(close, 3) ? 1.0 : 0.0)
map.put(scores, "b", ta.rsi(close, 3) > 50 ? 1.0 : 0.0)
map.put(scores, "c", close > open ? 1.0 : 0.0)
total = 0.0
for [k, v] in scores
    total := total + v
plot(total, "Total")
