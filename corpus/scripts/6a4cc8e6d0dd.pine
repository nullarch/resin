//@version=5
strategy("EMA Cross", overlay=true)
fastLen = 3
slowLen = 5
fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
longCond = ta.crossover(fastEma, slowEma)
shortCond = ta.crossunder(fastEma, slowEma)
if longCond
    strategy.entry("Long", strategy.long)
if shortCond
    strategy.close("Long")
