
//@version=5
indicator("Mkt Phase")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = ta.rsi(close, 3)
phase = switch
    close > sma3 and sma3 > sma5 and rsi > 50 => "markup"
    close > sma3 and rsi > 70 => "distribution"
    close < sma3 and sma3 < sma5 and rsi < 50 => "markdown"
    close < sma3 and rsi < 30 => "accumulation"
    => "transition"
isMarkup = phase == "markup"
plot(isMarkup ? 1 : 0, "Markup")
