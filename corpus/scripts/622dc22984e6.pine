//@version=5
indicator("Cycle46 All")
// UDT with copy (uses import copy, not __import__)
type Signal
    float price = 0.0
    int direction = 0
    string label_ = ""

var sig = Signal.new()

// Operator precedence
up = not (close < close[1]) and close > 105  // (not ...) and ...
neg_vol = -volume * 0.001  // (-vol) * 0.001

// Ternary right-associative
var int level = 0
level := close > 110 ? 3 : close > 107 ? 2 : close > 104 ? 1 : 0

// For single iteration
var int single = 0
single := 0
for i = 0 to 0
    single := single + 1

// Multi-line continuation
cond = close > 100 and
    high > low and
    volume > 0

// Switch expression
var string trend = "flat"
trend := switch
    level == 3 => "strong"
    level >= 2 => "moderate"
    => "weak"

// Compound on UDT field
sig.price := close
sig.direction := level
sig.label_ := trend

// na default in UDF
safeDiv(float a, float b = na) =>
    na(b) or b == 0 ? 0.0 : a / b

var float ratio = 0.0
ratio := safeDiv(close, volume)

var float result = 0.0
result := sig.price + level + single + ratio
plot(close)
