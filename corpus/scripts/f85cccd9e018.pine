
//@version=5
indicator("Cross Div")
fast = ta.ema(close, 3)
slow = ta.ema(close, 5)
rsi = ta.rsi(close, 3)
bullCross = ta.crossover(fast, slow)
bearCross = ta.crossunder(fast, slow)
rsiDiv = close > close[2] and rsi < rsi[2]
var int signals = 0
if bullCross or bearCross or rsiDiv
    signals := signals + 1
plot(signals, "Signals")
