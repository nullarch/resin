
//@version=5
indicator("Resilience")
rsi = nz(ta.rsi(close, 5), 50.0)
vol = nz(ta.stdev(close, 5), 1.0)
resilience = switch
    rsi > 70 and vol < 2.0 => "STRONG"
    rsi > 50 => "MODERATE"
    rsi > 30 and vol < 3.0 => "WEAK"
    => "FRAGILE"
score = resilience == "STRONG" ? 4.0 : resilience == "MODERATE" ? 3.0 : resilience == "WEAK" ? 2.0 : 1.0
plot(score, "R")
