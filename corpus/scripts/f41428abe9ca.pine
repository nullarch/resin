//@version=5
indicator("Volcanic Tremor")
var float tremorEnergy = 0.0
var int consecutiveHigh = 0
atrVal = nz(ta.atr(3), 1.0)
isActive = (high - low) > atrVal * 1.5
if isActive
    consecutiveHigh := consecutiveHigh + 1
    tremorEnergy := tremorEnergy + (high - low) * 0.5
else
    consecutiveHigh := 0
    tremorEnergy := tremorEnergy * 0.7
eruptionRisk = consecutiveHigh > 2 ? tremorEnergy : tremorEnergy * 0.5
plot(eruptionRisk)
