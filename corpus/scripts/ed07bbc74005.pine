//@version=5
indicator("Medicine-Pharmacology")
// Pharmacology: drug concentration (first-order kinetics)
doseAmount = 100.0
halfLife = 3.0
decayRate = math.log(2.0) / halfLife
var float drugConcentration = 0.0
// Medicine: dosing schedule (every 3 bars)
if bar_index % 3 == 0
    drugConcentration := drugConcentration + doseAmount
// Decay each bar
drugConcentration := drugConcentration * math.exp(-decayRate)
// Therapeutic window
therapeuticMin = 20.0
therapeuticMax = 150.0
var int inWindow = 0
if drugConcentration >= therapeuticMin and drugConcentration <= therapeuticMax
    inWindow := inWindow + 1
