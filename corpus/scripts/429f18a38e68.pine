
//@version=5
indicator("PainIdx")
var float equity = 100.0
var float peak = 100.0
var float ddSum = 0.0
var int bars = 0
pnl = close > open ? 1.0 : -0.8
equity := equity + pnl
peak := equity > peak ? equity : peak
dd = peak - equity
ddSum := ddSum + dd
bars := bars + 1
painIdx = bars > 0 ? ddSum / bars : 0.0
plot(painIdx, "PI")
