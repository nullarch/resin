
//@version=5
strategy("Multi Exit", overlay=true)
sma3 = ta.sma(close, 3)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)
if ta.crossover(close, sma3)
    strategy.entry("Long", strategy.long)
if rsi > 70
    strategy.close("Long", comment="RSI exit")
if ta.crossunder(close, sma3)
    strategy.close("Long", comment="MA exit")
plot(sma3, "SMA")
