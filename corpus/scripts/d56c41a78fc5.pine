//@version=5
indicator("Full Indicator", overlay=true)
// Input
length = input.int(5, "Length")

// TA
sma_ = ta.sma(close, length)
ema_ = ta.ema(close, length)
rsi_ = ta.rsi(close, length)
atr_ = ta.atr(high, low, close, length)
[macdLine, signal, hist] = ta.macd(close, 3, 5, 3)

// UDT
type State
    float trend = 0.0
    int count = 0
var st = State.new()
st.trend := not na(sma_) ? (close > sma_ ? 1.0 : -1.0) : 0.0
st.count := st.count + 1

// Array
var levels = array.new<float>(0)
if not na(atr_)
    if array.size(levels) >= 5
        array.shift(levels)
    array.push(levels, close + atr_)

// Map
var m = map.new<string, float>()
map.put(m, "rsi", nz(rsi_))
map.put(m, "sma", nz(sma_))

// Conditional
signal_ = switch
    st.trend > 0 and not na(rsi_) and rsi_ < 30 => 2
    st.trend < 0 and not na(rsi_) and rsi_ > 70 => -2
    st.trend > 0 => 1
    => -1

// Drawing
if barstate.islast
    label.new(bar_index, close, str.tostring(signal_))
    line.new(bar_index - 5, nz(sma_), bar_index, nz(sma_), color=color.blue)

plot(sma_)
plot(ema_)
