
//@version=5
indicator("Mean Reversion")
// Core indicators
sma5 = ta.sma(close, 5)
stdev = ta.stdev(close, 5)
zscore = stdev != 0 ? (close - sma5) / stdev : 0.0

// Bollinger Bands
[bbMid, bbUp, bbLo] = ta.bb(close, 5, 2.0)
pctB = (close - bbLo) / (bbUp - bbLo)

// RSI filter
rsiVal = ta.rsi(close, 3)

// Signal generation
oversold = zscore < -1.5 and rsiVal < 30
overbought = zscore > 1.5 and rsiVal > 70

// State tracking
var int longSignals = 0
var int shortSignals = 0
var float bestZscore = 0.0
if oversold
    longSignals := longSignals + 1
if overbought
    shortSignals := shortSignals + 1
if math.abs(zscore) > math.abs(bestZscore)
    bestZscore := zscore

// History array
var float[] zHistory = array.new_float(0)
array.push(zHistory, zscore)

// Map summary
var m = map.new<string, float>()
map.put(m, "zscore", zscore)
map.put(m, "pctB", pctB)
map.put(m, "rsi", rsiVal)

plot(zscore, "Z-Score")
plot(longSignals, "Long Signals")
plot(shortSignals, "Short Signals")
