
//@version=5
indicator("Vol Regime")
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
ratio = avgATR > 0 ? atr / avgATR : 1.0
regime = switch
    ratio > 2.0 => "extreme"
    ratio > 1.3 => "high"
    ratio > 0.7 => "normal"
    => "low"
isExtreme = regime == "extreme"
plot(isExtreme ? 1 : 0, "E")
