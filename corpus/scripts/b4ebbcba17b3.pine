//@version=5
indicator("Comprehensive 59")

// Number literal types
int x_int = 42
float x_float = 3.14
float x_sci = 1e2

// Multi-TA (squeeze-like)
sma_val = ta.sma(close, 5)
sd = ta.stdev(close, 5)
atr_val = ta.atr(5)

// Array ops
var arr = array.from(1.0, 2.0, 3.0)
var int idx = array.indexof(arr, 2.0)
var bool has_3 = array.includes(arr, 3.0)

// Map
var m = map.new<string, float>()
map.put(m, "ta", nz(sma_val, 0.0))

// Switch
var int mode = 1
float sw_val = switch mode
    1 => nz(sma_val, 0.0)
    => 0.0

// str
var string lbl = str.format("{0}: {1}", "SMA", "5")

// var sliding window
var window = array.new<float>(0)
array.push(window, close)
if array.size(window) > 3
    array.shift(window)

var float result = 0.0
result := x_int + x_float + x_sci + nz(sma_val, 0.0) + sw_val + array.size(window)
plot(close)
