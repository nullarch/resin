
//@version=5
indicator("Bar Qual")
barQuality(float o, float h, float l, float c, float v, float avgV) =>
    body = math.abs(c - o)
    range_ = h - l
    eff = range_ > 0 ? body / range_ : 0.0
    volConf = avgV > 0 ? v / avgV : 1.0
    eff * volConf

avgVol = ta.sma(volume, 5)
qual = barQuality(open_, high, low, close, volume, avgVol)
plot(qual, "Q")
