
//@version=5
indicator("Trade Log")
var float[] pnls = array.new_float(0)
var bool inPos = false
var float entry = 0.0
sma3 = ta.sma(close, 3)
if not inPos and close > sma3
    inPos := true
    entry := close
if inPos and close < sma3
    array.push(pnls, close - entry)
    inPos := false
totalPnl = array.sum(pnls)
numTrades = array.size(pnls)
plot(totalPnl, "PnL")
plot(numTrades, "N")
