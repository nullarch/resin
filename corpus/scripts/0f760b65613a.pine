
//@version=5
indicator("UDF Chain")
normalize(float val, float min_, float max_) =>
    range_ = max_ - min_
    range_ > 0 ? (val - min_) / range_ : 0.5

weightedAvg(float a, float b, float wA) =>
    a * wA + b * (1.0 - wA)

classify(float score) =>
    score > 0.7 ? "strong" : score > 0.3 ? "moderate" : "weak"

rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
normRSI = normalize(rsi, 0.0, 100.0)
normK = normalize(k, 0.0, 100.0)
combined = weightedAvg(normRSI, normK, 0.6)
label = classify(combined)
isStrong = label == "strong"
plot(combined, "Comb")
