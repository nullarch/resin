
//@version=5
indicator("Trade Results")
var float[] results2 = array.new_float(0)
ret = nz(close - close[1], 0.0)
sma3 = ta.sma(close, 3)
if close[1] > sma3
    array.push(results2, ret)
if array.size(results2) > 10
    array.shift(results2)
avgResult = array.size(results2) > 0 ? array.avg(results2) : 0.0
plot(avgResult, "AR")
