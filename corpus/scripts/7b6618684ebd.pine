
//@version=5
indicator("Triple Accum")
sumH = 0.0
sumL = 0.0
sumC = 0.0
count = 0
for i = 0 to 4
    h = high[i]
    l = low[i]
    c = close[i]
    if not na(h) and not na(l) and not na(c)
        sumH := sumH + h
        sumL := sumL + l
        sumC := sumC + c
        count := count + 1
avgRange = count > 0 ? (sumH - sumL) / count : 0.0
plot(avgRange, "AvgRange")
