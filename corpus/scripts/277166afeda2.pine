//@version=5
indicator("Nested Switch")
category = close > 108 ? "high" : close > 104 ? "mid" : "low"
trend = close > open ? "up" : "down"
score = switch category
    "high" =>
        switch trend
            "up" => 3
            => 2
    "mid" =>
        switch trend
            "up" => 1
            => 0
    => -1
plot(score)
