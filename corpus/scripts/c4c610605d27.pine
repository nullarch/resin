
//@version=5
indicator("Sharpe UDF")
calcSharpe(float avgRet, float sdRet, float riskFree) =>
    excessRet = avgRet - riskFree
    sdRet > 0 ? excessRet / sdRet : 0.0

ret = close - close[1]
avgRet = ta.sma(ret, 5)
sdRet = ta.stdev(ret, 5)
sharpe = calcSharpe(nz(avgRet, 0.0), sdRet, 0.0)
plot(sharpe, "Sharpe")
