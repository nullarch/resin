
//@version=5
indicator("Ensemble")
inp = (close - 100.0) / 10.0
model1 = math.max(0.5 * inp + 0.1, 0.0)
model2 = 1.0 / (1.0 + math.exp(-math.max(math.min(inp, 10.0), -10.0)))
model3 = math.max(math.min(inp, 1.0), -1.0) * 0.5 + 0.5
ensemble = (model1 + model2 + model3) / 3.0
plot(ensemble, "Ensemble")
