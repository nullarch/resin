
//@version=5
indicator("Stat Map")
var sm = map.new<string, float>()
ret = close[1] > 0 ? (close - close[1]) / close[1] * 100 : 0.0
map.put(sm, "return", ret)
map.put(sm, "avg_ret", ta.sma(ret, 5))
map.put(sm, "stdev", ta.stdev(close, 5))
total = 0.0
for [k, v] in sm
    total := total + v
plot(total, "T")
