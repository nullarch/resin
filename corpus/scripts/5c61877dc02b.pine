
//@version=5
indicator("Flow Full")
totalRange = high - low
buyPress = totalRange > 0 ? (close - low) / totalRange : 0.5
sellPress = totalRange > 0 ? (high - close) / totalRange : 0.5
netPress = buyPress - sellPress

avgVol = ta.sma(volume, 5)
volRatio = avgVol > 0 ? volume / avgVol : 1.0
rsi = nz(ta.rsi(close, 3), 50.0)

flowSignal = netPress * volRatio * 100
momConfirm = rsi > 55 ? 1.0 : rsi < 45 ? -1.0 : 0.0
composite = flowSignal * 0.6 + momConfirm * 40 * 0.4

var int strongFlowBars = 0
if math.abs(composite) > 30
    strongFlowBars := strongFlowBars + 1

plot(composite, "C")
plot(strongFlowBars, "SFB")
