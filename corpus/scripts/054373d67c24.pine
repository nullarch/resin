//@version=5
indicator("MapFreqPeak15")
peaks = map.new<string, float>()
for f = 1 to 3
    rp = 0.0
    ip = 0.0
    for k = 0 to 4
        angle = 2.0 * math.pi * float(f) * float(k) / 5.0
        rp := rp + (close + float(k)) * math.cos(angle)
        ip := ip - (close + float(k)) * math.sin(angle)
    mag = math.sqrt(rp * rp + ip * ip)
    map.put(peaks, str.tostring(f), mag)
numPeaks = float(map.size(peaks))
plot(numPeaks, "np")
