
//@version=5
indicator("Cyc Amps")
var float[] amps = array.new_float(0)
var float cycleHi = 0.0
var float cycleLo = 99999.0
var int cycleBar = 0
cycleBar := cycleBar + 1
cycleHi := math.max(cycleHi, close)
cycleLo := math.min(cycleLo, close)
if cycleBar >= 5
    amp = cycleHi - cycleLo
    array.push(amps, amp)
    if array.size(amps) > 4
        array.shift(amps)
    cycleBar := 0
    cycleHi := close
    cycleLo := close
avgAmp = array.size(amps) > 0 ? array.avg(amps) : 0.0
plot(avgAmp, "AvgAmp")
