//@version=5
indicator("Rolling Momentum")
var float[] momWindow = array.new_float(0)
float prevC = not na(close[1]) ? close[1] : close
float mom = close - prevC
array.push(momWindow, mom)
if array.size(momWindow) > 5
    array.remove(momWindow, 0)
float total = 0.0
for i = 0 to array.size(momWindow) - 1
    total := total + array.get(momWindow, i)
float avgMom = array.size(momWindow) > 0 ? total / array.size(momWindow) : 0.0
plot(avgMom, "AvgMom")
