
//@version=5
indicator("Enum Actions")
enum Action
    Buy = 1
    Sell = -1
    Hold = 0

rsiVal = ta.rsi(close, 3)
act = rsiVal < 30 ? Action.Buy : rsiVal > 70 ? Action.Sell : Action.Hold
result = switch act
    Action.Buy => close * 1.01
    Action.Sell => close * 0.99
    => close
plot(result, "Target")
