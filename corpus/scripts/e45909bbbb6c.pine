
//@version=5
indicator("Roll State")
var rs = map.new<string, float>()
map.put(rs, "prev_rsi", map.get(rs, "curr_rsi", 50.0))
map.put(rs, "curr_rsi", nz(ta.rsi(close, 3), 50.0))
map.put(rs, "prev_close", map.get(rs, "curr_close", close))
map.put(rs, "curr_close", close)
rsiChg = map.get(rs, "curr_rsi", 50.0) - map.get(rs, "prev_rsi", 50.0)
plot(rsiChg, "RSIChg")
