
//@version=5
indicator("Squeeze")
basis = ta.sma(close, 5)
bbDev = ta.stdev(close, 5)
bbUpper = basis + bbDev * 2
bbLower = basis - bbDev * 2
atr = nz(ta.atr(3), 1.0)
ema5 = ta.ema(close, 5)
kUpper = ema5 + atr * 1.5
kLower = ema5 - atr * 1.5
squeeze = bbLower > kLower and bbUpper < kUpper
plot(squeeze ? 1 : 0, "Sqz")
