
//@version=5
indicator("Mkt Reg")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
regime = switch
    close > sma3 and sma3 > sma5 and rsi > 60 => "strong_bull"
    close > sma3 and rsi > 50 => "bull"
    close < sma3 and sma3 < sma5 and rsi < 40 => "strong_bear"
    close < sma3 and rsi < 50 => "bear"
    => "range"
isStrong = regime == "strong_bull" or regime == "strong_bear"
plot(isStrong ? 1 : 0, "S")
