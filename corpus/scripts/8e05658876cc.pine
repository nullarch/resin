//@version=5
indicator("DiffInDiff")
var float preTreat = 0.0
var float postTreat = 0.0
var float preCtrl = 0.0
var float postCtrl = 0.0
var int preCnt = 0
var int postCnt = 0
cutoff = 5
treat = close
ctrl = nz(ta.sma(close, 3), close)
if bar_index < cutoff
    preCnt := preCnt + 1
    preTreat := preTreat + (treat - preTreat) / float(preCnt)
    preCtrl := preCtrl + (ctrl - preCtrl) / float(preCnt)
else
    postCnt := postCnt + 1
    postTreat := postTreat + (treat - postTreat) / float(postCnt)
    postCtrl := postCtrl + (ctrl - postCtrl) / float(postCnt)
did = postCnt > 0 ? (postTreat - preTreat) - (postCtrl - preCtrl) : 0.0
plot(did, "DiD")
