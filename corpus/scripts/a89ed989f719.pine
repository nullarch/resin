
//@version=5
indicator("Mkt Depth")
var float cumBuyVol = 0.0
var float cumSellVol = 0.0
buyVol = close >= (high + low) / 2 ? volume : 0.0
sellVol = close < (high + low) / 2 ? volume : 0.0
cumBuyVol := cumBuyVol + buyVol
cumSellVol := cumSellVol + sellVol
imbalance = (cumBuyVol + cumSellVol) > 0 ? (cumBuyVol - cumSellVol) / (cumBuyVol + cumSellVol) : 0.0
plot(imbalance, "Imb")
