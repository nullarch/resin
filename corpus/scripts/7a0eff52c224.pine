
//@version=5
strategy("Comp Strat", overlay=true)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
score = (close > sma3 ? 1 : 0) + (sma3 > sma5 ? 1 : 0) + (rsi > 55 ? 1 : 0)
if score >= 3
    strategy.entry("Long", strategy.long)
if score <= 1
    strategy.close("Long")
plot(sma3, "MA")
