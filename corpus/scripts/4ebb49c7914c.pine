
//@version=5
indicator("Thresh Cfg")
var tc = map.new<string, float>()
atr = nz(ta.atr(3), 1.0)
map.put(tc, "rsi_upper", 70.0 - atr)
map.put(tc, "rsi_lower", 30.0 + atr)
map.put(tc, "atr_mult", atr > 2.0 ? 1.5 : 2.0)
rsi = nz(ta.rsi(close, 3), 50.0)
isOB = rsi > map.get(tc, "rsi_upper", 70.0)
plot(isOB ? 1 : 0, "OB")
