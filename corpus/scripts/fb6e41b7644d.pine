//@version=5
indicator("Method Chain")
type Indicator
    float value = 0.0
    string name = ""
method update(Indicator this, float newVal) =>
    this.value := newVal
    this
method scale(Indicator this, float factor) =>
    this.value := this.value * factor
    this
ind = Indicator.new(value=close, name="test")
ind.update(ta.sma(close, 5))
ind.scale(2.0)
plot(ind.value)
