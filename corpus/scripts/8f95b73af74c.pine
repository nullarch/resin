//@version=5
indicator("State machine")
var int state = 0
var float entryPrice = 0.0
var int holdBars = 0
sma5 = ta.sma(close, 5)
if state == 0 and not na(sma5) and close > nz(sma5)
    state := 1
    entryPrice := close
    holdBars := 0
else if state == 1
    holdBars := holdBars + 1
    if holdBars >= 3 or close < entryPrice * 0.98
        state := 0
        entryPrice := 0.0
