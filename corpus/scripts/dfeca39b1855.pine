
//@version=5
indicator("Div Scores")
var float[] scores = array.new_float(0)
rsi = nz(ta.rsi(close, 3), 50.0)
priceChg = nz(close - close[1], 0.0)
rsiChg = rsi - 50
score = 0.0
if priceChg > 0 and rsiChg < 0
    score := -1.0
else if priceChg < 0 and rsiChg > 0
    score := 1.0
array.push(scores, score)
if array.size(scores) > 8
    array.shift(scores)
totalDiv = 0.0
for i = 0 to math.max(array.size(scores) - 1, 0)
    if i < array.size(scores)
        totalDiv := totalDiv + math.abs(array.get(scores, i))
plot(totalDiv, "TD")
