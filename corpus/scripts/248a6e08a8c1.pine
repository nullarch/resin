//@version=5
indicator("Alert Cond")
fast = ta.ema(close, 3)
slow = ta.ema(close, 5)
bullCross = ta.crossover(fast, slow)
bearCross = ta.crossunder(fast, slow)
alertcondition(bullCross, "Bull Cross", "Fast EMA crossed above slow EMA")
alertcondition(bearCross, "Bear Cross", "Fast EMA crossed below slow EMA")
plot(fast - slow)
