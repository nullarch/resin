
//@version=5
indicator("DS Full")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)

// Map config + state
var state = map.new<string, float>()
map.put(state, "rsi", rsi)
map.put(state, "trend", close - sma3)
map.put(state, "vol", atr)

// Array history
var float[] history = array.new_float(0)
score = (rsi - 50) / 50 + (close > sma3 ? 0.5 : -0.5)
array.push(history, score)
if array.size(history) > 8
    array.shift(history)

// Compute from structures
smoothScore = array.avg(history)
totalFromMap = 0.0
for [k, v] in state
    if k == "rsi"
        totalFromMap := totalFromMap + (v > 50 ? 1.0 : -1.0)
    else if k == "trend"
        totalFromMap := totalFromMap + (v > 0 ? 1.0 : -1.0)

var int bars = 0
bars := bars + 1

plot(smoothScore, "Smooth")
plot(totalFromMap, "MapScore")
