
//@version=5
indicator("Trend Lbl")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
trendDir = sma3 > sma5 ? "UP" : "DN"
rsi = nz(ta.rsi(close, 3), 50.0)
strength = rsi > 60 or rsi < 40 ? "STRONG" : "WEAK"
label = trendDir + "_" + strength
isUpStrong = label == "UP_STRONG"
plot(isUpStrong ? 1 : 0, "US")
