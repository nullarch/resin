//@version=5
indicator("ChiSqProxy")
var int n11 = 0
var int n12 = 0
var int n21 = 0
var int n22 = 0
smaC = nz(ta.sma(close, 3), close)
smaV = nz(ta.sma(volume, 3), volume)
cUp = close > smaC
vUp = volume > smaV
if cUp and vUp
    n11 := n11 + 1
else if cUp and not vUp
    n12 := n12 + 1
else if not cUp and vUp
    n21 := n21 + 1
else
    n22 := n22 + 1
total = float(n11 + n12 + n21 + n22)
chiSq = total > 0 ? math.abs(float(n11 * n22 - n12 * n21)) / math.max(total, 1.0) : 0.0
plot(chiSq, "ChiSq")
