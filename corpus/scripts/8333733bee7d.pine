
//@version=5
indicator("Trade Dur")
var int inTrade = 0
var int currentDur = 0
var float totalDur = 0.0
var int tradeCount = 0
sma3 = ta.sma(close, 3)
if close > sma3 and inTrade == 0
    inTrade := 1
    currentDur := 0
if inTrade == 1
    currentDur := currentDur + 1
if close < sma3 and inTrade == 1
    inTrade := 0
    totalDur := totalDur + currentDur
    tradeCount := tradeCount + 1
avgDur = tradeCount > 0 ? totalDur / tradeCount : 0.0
plot(avgDur, "AvgDur")
