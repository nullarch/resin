
//@version=5
indicator("Ultimate")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema3 = ta.ema(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
[bbMid, bbUp, bbLo] = ta.bb(close, 5, 2.0)

var int barNum = 0
var float peak = 0.0
var int bullSignals = 0
barNum := barNum + 1
peak := math.max(peak, close)

trendScore = (close > sma3 ? 1 : -1) + (sma3 > sma5 ? 1 : -1)
momScore = (rsi - 50) / 25
bbPos = bbUp > bbLo ? (close - bbLo) / (bbUp - bbLo) : 0.5

composite = trendScore * 0.3 + momScore * 0.4 + (bbPos - 0.5) * 2 * 0.3
if composite > 0.5
    bullSignals := bullSignals + 1

dd = peak > 0 ? (peak - close) / peak * 100 : 0.0

plot(composite, "Comp")
plot(dd, "DD")
