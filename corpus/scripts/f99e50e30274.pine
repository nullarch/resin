
//@version=5
indicator("Type Ops")
// Numeric
rsi = nz(ta.rsi(close, 3), 50.0)
intRsi = int(rsi)
atr = ta.atr(3)
roundedATR = math.round(atr * 100) / 100

// String
direction = close > ta.sma(close, 3) ? "LONG" : "SHORT"
strength = rsi > 60 or rsi < 40 ? "STRONG" : "WEAK"
signal = direction + "_" + strength
isTarget = str.contains(signal, "LONG") and str.contains(signal, "STRONG")

// Boolean to numeric
score = (isTarget ? 2.0 : 0.0) + (rsi > 50 ? 1.0 : 0.0)

// Array storage
var float[] scores = array.new_float(0)
array.push(scores, score)
if array.size(scores) > 5
    array.shift(scores)

var int bars = 0
bars := bars + 1

plot(score, "Score")
plot(array.avg(scores), "AvgScore")
