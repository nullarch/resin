//@version=5
indicator("FE06")
var int crossCount = 0
[bbMid, bbUp, bbLow] = ta.bb(close, 5, 2.0)
crossed = ta.crossover(close, bbMid)
if crossed
    crossCount := crossCount + 1
width = bbUp - bbLow
sqrtWidth = math.sqrt(math.abs(width))
signal = crossed ? sqrtWidth : 0.0
plot(signal, title="bbsig")
