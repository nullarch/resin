
//@version=5
strategy("Full Strat", overlay=true)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
bullEntry = sma3 > sma5 and rsi > 50 and close > sma3 and (avgATR > 0 and atr / avgATR < 1.5)
if bullEntry
    strategy.entry("Long", strategy.long)
bearExit = sma3 < sma5 or rsi < 40 or (avgATR > 0 and atr > avgATR * 2)
if bearExit
    strategy.close("Long")
plot(sma3, "Fast")
plot(sma5, "Slow")
