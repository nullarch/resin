
//@version=5
indicator("Osc Score")
oscScore(float rsi, float stoch, float pctB) =>
    rsiS = rsi < 30 ? 1.0 : rsi > 70 ? -1.0 : 0.0
    stochS = stoch < 20 ? 1.0 : stoch > 80 ? -1.0 : 0.0
    bbS = pctB < 0 ? 1.0 : pctB > 1 ? -1.0 : 0.0
    (rsiS + stochS + bbS) / 3

rsi = nz(ta.rsi(close, 3), 50.0)
k = nz(ta.stoch(close, high, low, 3), 50.0)
[mid, upper, lower] = ta.bb(close, 5, 2.0)
pctB = upper > lower ? (close - lower) / (upper - lower) : 0.5
score = oscScore(rsi, k, pctB)
plot(score, "OS")
