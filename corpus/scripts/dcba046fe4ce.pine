
//@version=5
indicator("Complete State")
var float equity = 10000.0
var float maxEquity = 10000.0
var float maxDD = 0.0
var int totalBars = 0
var int upBars = 0
var int downBars = 0

totalBars := totalBars + 1
chg = ta.change(close, 1)
if not na(chg)
    if chg > 0
        upBars := upBars + 1
        equity := equity + chg
    else
        downBars := downBars + 1
        equity := equity + chg

if equity > maxEquity
    maxEquity := equity
dd = maxEquity > 0 ? (maxEquity - equity) / maxEquity * 100 : 0.0
if dd > maxDD
    maxDD := dd

winRate = totalBars > 0 ? float(upBars) / float(totalBars) * 100 : 50.0
plot(equity, "Equity")
plot(maxDD, "MaxDD")
plot(winRate, "WinRate")
