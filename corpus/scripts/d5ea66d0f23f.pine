//@version=5
indicator("C300-10")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema3 = ta.ema(close, 3)
signals = array.new_float(0)
if not na(sma3) and not na(sma5)
    array.push(signals, nz(sma3, 0.0) - nz(sma5, 0.0))
if not na(ema3) and not na(sma3)
    array.push(signals, nz(ema3, 0.0) - nz(sma3, 0.0))
total = 0.0
for i = 0 to array.size(signals) - 1
    total := total + array.get(signals, i)
plot(total)
