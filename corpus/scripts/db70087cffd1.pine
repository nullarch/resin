
//@version=5
indicator("Manual SMA")
length = 5
sum = 0.0
count = 0
for i = 0 to length - 1
    val = close[i]
    if not na(val)
        sum := sum + val
        count := count + 1
manualSMA = count > 0 ? sum / count : close
taSMA = ta.sma(close, length)
plot(manualSMA, "Manual")
plot(taSMA, "TA")
