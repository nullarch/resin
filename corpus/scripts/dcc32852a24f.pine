
//@version=5
indicator("Trend Phase")
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
spread = ema3 - sma5
prevSpread = ema3[1] - sma5[1]
expanding = not na(prevSpread) and math.abs(spread) > math.abs(prevSpread)
phase = switch
    spread > 0 and expanding => "acceleration"
    spread > 0 and not expanding => "deceleration"
    spread < 0 and expanding => "decline"
    => "recovery"
isAccel = phase == "acceleration"
plot(isAccel ? 1 : 0, "Accel")
