
//@version=5
indicator("Stress07")
type BarInfo
    float range = 0.0
    string kind = ""
var float maxRange = 0.0
info = BarInfo.new()
info.range := high - low
info.kind := switch
    info.range > 5.0 => "WIDE"
    info.range > 3.0 => "NORMAL"
    => "NARROW"
maxRange := math.max(maxRange, info.range)
rangeHistory = array.new_float(0)
for i = 0 to 4
    array.push(rangeHistory, info.range + float(i) * 0.1)
kindMap = map.new<string, float>()
map.put(kindMap, info.kind, info.range)
map.put(kindMap, "max", maxRange)
total = 0.0
for [k, v] in kindMap
    total := total + v
output = total + array.avg(rangeHistory) + float(str.length(info.kind))
plot(nz(output, 0.0), "S07")
