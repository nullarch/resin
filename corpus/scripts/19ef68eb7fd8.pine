
//@version=5
indicator("Cycle 86 Comprehensive")

// Generic types
var array<float> prices = array.new<float>(0)
var map<string, float> stats = map.new<string, float>()

// Array operations
array.push(prices, close)
if array.size(prices) > 5
    array.shift(prices)

// Map with default
stats.put("avg", array.avg(prices))
stats.put("max", array.max(prices))
avg_val = stats.get("avg", 0.0)
max_val = stats.get("max", 0.0)

// TA isolation
sma_val = ta.sma(close, 5)
rsi_val = ta.rsi(close, 14)

// Drawing noop
lbl = label.new(bar_index, close, str.tostring(rsi_val))

// Complex expression
result = avg_val > 0 ? (rsi_val > 50 ? max_val : avg_val) : sma_val
plot(result)
