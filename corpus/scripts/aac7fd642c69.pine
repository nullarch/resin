
//@version=5
indicator("Kurt")
var float[] vals = array.new_float(0)
array.push(vals, close)
if array.size(vals) > 5
    array.shift(vals)
mean = array.avg(vals)
sumFourth = 0.0
sumSq = 0.0
for [i, v] in vals
    d = v - mean
    sumFourth := sumFourth + math.pow(d, 4)
    sumSq := sumSq + math.pow(d, 2)
sz = array.size(vals)
variance = sz > 1 ? sumSq / float(sz - 1) : 1.0
kurt = variance > 0.0001 ? (sumFourth / float(sz)) / math.pow(variance, 2) - 3.0 : 0.0
plot(kurt, "K")
