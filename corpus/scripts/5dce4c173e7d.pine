
//@version=5
indicator("Lag Feat")
var float[] lags = array.new_float(0)
array.push(lags, close)
if array.size(lags) > 6
    array.shift(lags)
n = array.size(lags)
latest = n > 0 ? array.get(lags, n - 1) : close
oldest = n > 0 ? array.get(lags, 0) : close
momentum = latest - oldest
plot(momentum, "Mom")
