//@version=5
indicator("Switch Multiline TA")
mode = 1
result = switch mode
    1 =>
        fast = ta.ema(close, 3)
        slow = ta.ema(close, 5)
        fast - slow
    2 =>
        upper = ta.highest(high, 5)
        lower = ta.lowest(low, 5)
        (close - lower) / (upper - lower + 0.0001)
    =>
        ta.sma(close, 3)
plot(result)
