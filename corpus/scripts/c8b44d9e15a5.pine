
//@version=5
indicator("Strat UDT")
type StratState
    int totalTrades = 0
    int wins = 0
    float maxDD = 0.0

var StratState ss = StratState.new()
var float peak = 0.0
peak := math.max(peak, close)
dd = peak > 0 ? (peak - close) / peak * 100 : 0.0
ss.maxDD := math.max(ss.maxDD, dd)
if close > close[1]
    ss.wins := ss.wins + 1
ss.totalTrades := ss.totalTrades + 1
winRate = ss.totalTrades > 0 ? float(ss.wins) / ss.totalTrades * 100 : 0.0
plot(winRate, "WR")
