
//@version=5
strategy("Triple MA", overlay=true)
ema2 = ta.ema(close, 2)
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
allBull = ema2 > ema3 and ema3 > sma5
rsi = nz(ta.rsi(close, 3), 50.0)
if allBull and rsi > 45
    strategy.entry("Long", strategy.long)
if ema2 < sma5 or rsi > 80
    strategy.close("Long")
plot(ema3, "EMA3")
