
//@version=5
indicator("Str Ops")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
t = close > sma3 ? "BULL" : "BEAR"
a = sma3 > sma5 ? "ALIGNED" : "CROSS"
m = rsi > 55 ? "STRONG" : rsi < 45 ? "WEAK" : "NEUTRAL"
full = t + "_" + a + "_" + m
isBest = full == "BULL_ALIGNED_STRONG"
plot(isBest ? 1 : 0, "B")
