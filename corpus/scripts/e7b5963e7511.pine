//@version=5
indicator("ProdCons Buffer")
var int bufferCount = 0
int bufferSize = 5
bool produce = close > open
bool consume = close < open
if produce and bufferCount < bufferSize
    bufferCount := bufferCount + 1
if consume and bufferCount > 0
    bufferCount := bufferCount - 1
float fillRatio = bufferCount / bufferSize
