//@version=5
indicator("Torture 11")
type Rank
    float value = 0.0
    int position = 0
method isTop(Rank this) =>
    this.position == 0
var float bestRank = 999.0
maValues = array.new<float>(0)
maValues.push(nz(ta.sma(close, 3), close))
maValues.push(nz(ta.ema(close, 3), close))
maValues.push(nz(ta.rma(close, 3), close))
maValues.push(nz(ta.wma(close, 3), close))
array.sort(maValues, order.ascending)
float median = maValues.size() >= 2 ? (maValues.get(1) + maValues.get(2)) / 2.0 : close
float closeDist = math.abs(close - median)
int bestIdx = 0
float minDist = 999.0
for idx = 0 to 3
    float dist = math.abs(close - maValues.get(idx))
    if dist < minDist
        minDist := dist
        bestIdx := idx
rk = Rank.new(minDist, bestIdx)
bool top = rk.isTop()
bestRank := math.min(bestRank, minDist)
float normalizedRank = bestRank > 0.001 ? minDist / bestRank : 1.0
