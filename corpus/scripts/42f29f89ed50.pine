
//@version=5
indicator("Mom Reg")
rsi = nz(ta.rsi(close, 3), 50.0)
[m, s, h] = ta.macd(close, 3, 5, 3)
regime = switch
    rsi > 70 and h > 0 => "strong_bull"
    rsi > 50 and h > 0 => "bull"
    rsi < 30 and h < 0 => "strong_bear"
    rsi < 50 and h < 0 => "bear"
    => "neutral"
isBull = str.contains(regime, "bull")
plot(isBull ? 1 : 0, "Bull")
