
//@version=5
indicator("Cond Accum")
sma3 = ta.sma(close, 3)
aboveCount = 0
totalBars = 0
iters = 0
while iters < 8
    c = close[iters]
    if not na(c)
        totalBars := totalBars + 1
        if c > sma3
            aboveCount := aboveCount + 1
    iters := iters + 1
ratio = totalBars > 0 ? aboveCount / totalBars : 0.0
plot(ratio, "Ratio")
