
//@version=5
indicator("Math All")
a = math.abs(close - open)
s = math.sign(close - open)
sq = math.sqrt(a)
pw = math.pow(a, 2)
lg = a > 0 ? math.log(a) : 0.0
ex = math.exp(math.min(a * 0.01, 5))
sn = math.sin(close * 0.01)
cs = math.cos(close * 0.01)
tn = math.tan(math.min(close * 0.01, 1.5))
at = math.atan2(close - open, high - low)
mn = math.min(close, open)
mx = math.max(close, open)
rd = math.round(close)
fl = math.floor(close)
cl = math.ceil(close)
plot(sq + sn + cs, "All")
