//@version=5
indicator("VFH")
sectors = array.new<float>(4, 0.0)
float range1 = high - close
float range2 = close - low
float range3 = high - open
float range4 = open - low
sectors.set(0, range1)
sectors.set(1, range2)
sectors.set(2, range3)
sectors.set(3, range4)
float minSector = 999.0
int bestIdx = 0
for i = 0 to 3
    float val = sectors.get(i)
    if val < minSector
        minSector := val
        bestIdx := i
float steerAngle = bestIdx * 90.0
