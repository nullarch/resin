//@version=5
indicator("Regression")
// Bug 1: variable step for loop
step_ = 2
var float loopSum = 0.0
loopSum := 0.0
for i = 0 to 8 by step_
    loopSum := loopSum + i

// Bug 2: switch with default in middle
direction = close > close[1] ? 1 : close < close[1] ? -1 : 0
label_ = switch direction
    1 => "up"
    => "flat"
    -1 => "down"

// Bug 3: no duplicate kwargs (implicit)
sma_ = ta.sma(close, 3)
ema_ = ta.ema(close, 3)
result = nz(sma_) + nz(ema_) + loopSum
plot(result)
