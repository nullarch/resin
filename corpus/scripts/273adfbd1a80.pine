
//@version=5
indicator("Exp Weights")
var float[] weights = array.new_float(0)
array.clear(weights)
decay = 0.85
w = 1.0
for i = 0 to 4
    array.push(weights, w)
    w := w * decay
totalWt = array.sum(weights)
normalizedFirst = totalWt > 0 ? array.get(weights, 0) / totalWt : 0.2
plot(normalizedFirst, "W0")
