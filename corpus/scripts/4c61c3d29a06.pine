
//@version=5
indicator("Risk Full")
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
rsi = nz(ta.rsi(close, 3), 50.0)

volRatio = avgATR > 0 ? atr / avgATR : 1.0
var float peak = 0.0
peak := math.max(peak, close)
dd = peak > 0 ? (peak - close) / peak * 100 : 0.0

volRisk = volRatio > 1.5 ? 2.0 : volRatio > 1.0 ? 1.0 : 0.5
momRisk = rsi > 70 or rsi < 30 ? 1.5 : 0.5
ddRisk = dd > 3 ? 2.0 : dd > 1 ? 1.0 : 0.0
totalRisk = volRisk + momRisk + ddRisk

sizeAdj = totalRisk > 4 ? 0.25 : totalRisk > 2 ? 0.5 : 1.0

plot(totalRisk, "TR")
plot(sizeAdj * 100, "Size")
