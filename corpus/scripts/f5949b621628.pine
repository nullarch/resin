//@version=5
indicator("MegaDash")
enum Trend
    Up = 1
    Down = 2
    Flat = 3
classify(x) =>
    x > 1.0 ? Trend.Up : x < -1.0 ? Trend.Down : Trend.Flat
var float cumScore = 0.0
var int trendStreak = 0
rsiVal = nz(ta.rsi(close, 5), 50.0)
smaVal = nz(ta.sma(close, 3), close)
atrVal = nz(ta.atr(3), 1.0)
diff = close - smaVal
trend = classify(diff)
prices = array.new_float(0)
idx = 0
while idx < 4
    array.push(prices, nz(close[idx], close))
    idx := idx + 1
array.sort(prices)
rangeVal = array.max(prices) - array.min(prices)
meta = map.new<string, float>()
map.put(meta, "rsi", rsiVal)
map.put(meta, "atr", atrVal)
map.put(meta, "range", rangeVal)
score = 0.0
for [key, val] in meta
    w = switch key
        "rsi" => 0.4
        "atr" => 0.3
        => 0.3
    score := score + w * val
if trend == Trend.Up
    trendStreak := trendStreak + 1
    cumScore := cumScore + score * 0.01
else if trend == Trend.Down
    trendStreak := 0
    cumScore := cumScore - score * 0.01
normScore = atrVal > 0.01 ? cumScore / atrVal : 0.0
plot(normScore, "NormScore")
plot(float(trendStreak), "Streak")
plot(score, "Score")
