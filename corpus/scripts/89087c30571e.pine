
//@version=5
indicator("UDTFilter")
type FilterState
    float value = 0.0
    float alpha = 0.5
    int count = 0

var FilterState fs = FilterState.new()
rsi = nz(ta.rsi(close, 3), 50.0)
fs.alpha := rsi > 60 ? 0.8 : rsi < 40 ? 0.2 : 0.5
fs.value := fs.value * (1.0 - fs.alpha) + close * fs.alpha
fs.count := fs.count + 1
plot(fs.value, "V")
