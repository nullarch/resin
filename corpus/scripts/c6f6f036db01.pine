
//@version=5
indicator("Pos Heat")
atr = ta.atr(3)
capital = 10000.0
numPositions = 3.0
maxRiskPerPos = 2.0
maxPortRisk = 6.0
posRisk = atr * 2
posRiskPct = close > 0 ? posRisk / close * 100 : 0.0
totalHeat = posRiskPct * numPositions
withinLimits = totalHeat <= maxPortRisk
plot(totalHeat, "Heat")
