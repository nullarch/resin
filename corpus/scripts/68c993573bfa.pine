
//@version=5
indicator("Sig Comb")
combineSignals(float s1, float w1, float s2, float w2, float s3, float w3) =>
    total = s1 * w1 + s2 * w2 + s3 * w3
    totalWt = w1 + w2 + w3
    totalWt > 0 ? total / totalWt : 0.0

rsi = nz(ta.rsi(close, 3), 50.0)
rsiSig = (rsi - 50) / 50
sma3 = ta.sma(close, 3)
trendSig = close > sma3 ? 1.0 : -1.0
momSig = close > close[1] ? 1.0 : -1.0
combined = combineSignals(rsiSig, 0.4, trendSig, 0.35, momSig, 0.25)
plot(combined, "Comb")
