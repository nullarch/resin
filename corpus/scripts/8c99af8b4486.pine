
//@version=5
indicator("Switch Default")
vol = volume
avgVol = ta.sma(volume, 5)
volLevel = switch
    vol > avgVol * 2 => "extreme"
    vol > avgVol * 1.5 => "high"
    vol > avgVol => "above_avg"
    => "normal"
isHigh = volLevel == "extreme" or volLevel == "high"
plot(isHigh ? 1 : 0, "HighVol")
