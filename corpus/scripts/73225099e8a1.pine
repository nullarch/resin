
//@version=5
indicator("Risk Action")
var float maxDD = 0.0
var float peak = 0.0
if close > peak
    peak := close
dd = peak > 0 ? (peak - close) / peak * 100 : 0.0
if dd > maxDD
    maxDD := dd
action = switch
    maxDD > 10 => "halt"
    maxDD > 5 => "reduce"
    maxDD > 2 => "caution"
    => "normal"
isNormal = action == "normal"
plot(isNormal ? 1 : 0, "Normal")
