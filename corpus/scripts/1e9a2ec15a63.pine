//@version=5
indicator("Combo02")
classify(val) =>
    val > 70.0 ? "high" : val > 30.0 ? "mid" : "low"
var int highCnt = 0
var int midCnt = 0
var int lowCnt = 0
rsiVal = nz(ta.rsi(close, 5), 50.0)
label = classify(rsiVal)
switch label
    "high" =>
        highCnt := highCnt + 1
    "mid" =>
        midCnt := midCnt + 1
    =>
        lowCnt := lowCnt + 1
total = highCnt + midCnt + lowCnt
ratio = total > 0 ? float(highCnt) / float(total) : 0.0
plot(ratio, "HiRatio")
plot(rsiVal, "RSI")
