//@version=5
indicator("Boolean multiline")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema5 = ta.ema(close, 5)
rsi5 = ta.rsi(close, 5)
atr3 = ta.atr(3)
longSetup = not na(sma3) and
    not na(sma5) and
    not na(rsi5) and
    close > nz(sma3) and
    nz(sma3) > nz(sma5) and
    nz(rsi5) > 40 and
    nz(rsi5) < 70
