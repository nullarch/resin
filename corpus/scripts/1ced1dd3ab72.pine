
//@version=5
indicator("MapConcat")
var info = map.new<string, string>()
map.put(info, "price", str.tostring(close))
map.put(info, "vol", str.tostring(volume))
map.put(info, "dir", close > open ? "UP" : "DN")

combined = ""
for [k, v] in info
    combined := combined + k + "=" + v + ";"

totalLen = str.length(combined)
plot(totalLen, "TL")
