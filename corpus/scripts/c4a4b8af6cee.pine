//@version=5
strategy("FullEntropy20")
enum Regime
    TRENDING
    RANGING
    CHAOTIC
type EntState
    float entropy = 0.0
    float upRatio = 0.5
    float barCount = 0.0
var EntState es = EntState.new()
es.barCount := es.barCount + 1.0
es.upRatio := close > open ? (es.upRatio * (es.barCount - 1.0) + 1.0) / es.barCount : (es.upRatio * (es.barCount - 1.0)) / es.barCount
pD = 1.0 - es.upRatio
es.entropy := 0.0
if es.upRatio > 0.01 and pD > 0.01
    es.entropy := -(es.upRatio * math.log(es.upRatio) + pD * math.log(pD))
maxEnt = math.log(2.0)
normEnt = maxEnt > 0 ? es.entropy / maxEnt : 1.0
regime = switch
    normEnt < 0.5 => Regime.TRENDING
    normEnt > 0.9 => Regime.CHAOTIC
    => Regime.RANGING
scores = array.new_float(0)
for i = 0 to 2
    array.push(scores, normEnt + float(i) * 0.1)
avgScore = array.sum(scores) / math.max(float(array.size(scores)), 1.0)
if regime == Regime.TRENDING and close > open
    strategy.entry("EL", strategy.long)
if regime == Regime.TRENDING and close < open
    strategy.entry("ES", strategy.short)
