//@version=5
indicator("Combo07")
var float momentum = 0.0
rsiVal = nz(ta.rsi(close, 5), 50.0)
atrVal = nz(ta.atr(5), 1.0)
prices = array.new_float(0)
for i = 0 to 4
    p = nz(close[i], close)
    array.push(prices, p)
highest = array.max(prices)
lowest = array.min(prices)
spread = highest - lowest
if rsiVal > 50.0
    if spread > atrVal
        momentum := momentum + 1.0
    else
        momentum := momentum + 0.5
else
    if spread > atrVal * 2.0
        momentum := momentum - 1.0
    else
        momentum := momentum - 0.5
plot(momentum, "Mom")
plot(spread, "Spread")
