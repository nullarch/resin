//@version=5
indicator("FE20 Grand Finale")
var float masterScore = 0.0
scoreCalc(a, b) =>
    math.sqrt(math.abs(a * a + b * b))
emaVal = ta.ema(close, 3)
rsiVal = nz(ta.rsi(close, 3), 50.0)
prevC = not na(close[1]) ? close[1] : close
bucket = switch
    rsiVal > 70 => 3
    rsiVal > 50 => 2
    => 1
vals = array.new_float(0)
for i = 1 to bucket
    array.push(vals, i * 1.0)
total = 0.0
for [idx, v] in vals
    total := total + v
metrics = map.new<string, float>()
map.put(metrics, "ema", emaVal)
map.put(metrics, "rsi", rsiVal)
cnt = 0
n = 0
while n < 2
    cnt := cnt + 1
    n := n + 1
sc = scoreCalc(total, cnt * 1.0)
if sc > 0 and close > prevC
    masterScore := masterScore + (sc > 10 ? 10.0 : sc)
else
    masterScore := masterScore * 0.95
label = str.tostring(math.round(masterScore))
plot(masterScore, title="master")
