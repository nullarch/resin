
//@version=5
indicator("Adaptive Sys")
// Core indicators
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
atr = ta.atr(3)
[m, s, h] = ta.macd(close, 3, 5, 3)

// Adaptive weights based on volatility
avgATR = ta.sma(atr, 5)
volRatio = avgATR > 0 ? atr / avgATR : 1.0
trendWeight = volRatio > 1.5 ? 0.2 : 0.4
momWeight = volRatio > 1.5 ? 0.3 : 0.3
volWeight = 1.0 - trendWeight - momWeight

// Scores
trendScore = close > sma3 and sma3 > ema5 ? 1.0 : close < sma3 and sma3 < ema5 ? -1.0 : 0.0
momScore = rsi > 55 ? 1.0 : rsi < 45 ? -1.0 : 0.0
macdScore = h > 0 ? 1.0 : -1.0

// Weighted composite
composite = trendScore * trendWeight + momScore * momWeight + macdScore * volWeight

// History
var float[] history = array.new_float(0)
array.push(history, composite)
if array.size(history) > 8
    array.shift(history)

var int bars = 0
bars := bars + 1

plot(composite, "Comp")
plot(array.avg(history), "AvgComp")
