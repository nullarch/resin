
//@version=5
indicator("Adapt Wt")
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
volState = avgATR > 0 ? atr / avgATR : 1.0
rsiWt = volState > 1.5 ? 0.2 : volState > 1.0 ? 0.4 : 0.6
trendWt = 1.0 - rsiWt
sma3 = ta.sma(close, 3)
trendScore = close > sma3 ? 1.0 : -1.0
rsiScore = (rsi - 50) / 50
combined = rsiScore * rsiWt + trendScore * trendWt
plot(combined, "Comb")
