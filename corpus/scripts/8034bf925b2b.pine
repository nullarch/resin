//@version=5
indicator("UDF Switch Multi")
f_compute(mode) =>
    switch mode
        1 =>
            float a = 10.0
            float b = 20.0
            a + b
        2 =>
            float c = 100.0
            c
        => 0.0

var float result = 0.0
result := f_compute(1) + f_compute(2)
plot(result)
