//@version=5
indicator("Torture 19")
type Weights
    float alpha = 0.5
    float beta = 0.3
    float gamma = 0.2
method normalize(Weights this) =>
    this.alpha + this.beta + this.gamma
var float runningBlend = 0.0
wt = Weights.new(0.5, 0.3, 0.2)
float norm = wt.normalize()
float sma3 = nz(ta.sma(close, 3), close)
float ema3 = nz(ta.ema(close, 3), close)
float rma3 = nz(ta.rma(close, 3), close)
sources = map.new<string, float>()
sources.put("sma", sma3)
sources.put("ema", ema3)
sources.put("rma", rma3)
vals = array.new<float>(0)
vals.push(sma3)
vals.push(ema3)
vals.push(rma3)
float blend = 0.0
float wAlpha = wt.alpha / norm
float wBeta = wt.beta / norm
float wGamma = wt.gamma / norm
blend := wAlpha * vals.get(0) + wBeta * vals.get(1) + wGamma * vals.get(2)
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float signal = switch
    blend > close and rsiVal > 60 => 2.0
    blend < close and rsiVal < 40 => -2.0
    => 0.0
runningBlend := runningBlend + (blend - runningBlend) * 0.1
float finalScore = signal != 0.0 ?
    signal * math.abs(blend - close) :
    0.0
