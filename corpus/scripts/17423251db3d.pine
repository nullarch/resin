
//@version=5
indicator("Equity Curve")
// Indicators
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsiVal = ta.rsi(close, 3)
atrVal = ta.atr(3)

// Signal
signal = close > sma3 and rsiVal > 50 ? 1 : close < sma3 and rsiVal < 50 ? -1 : 0

// Equity simulation
var float equity = 10000.0
var float position = 0.0
var int trades = 0
chg = ta.change(close, 1)

if signal == 1 and position <= 0
    position := 1.0
    trades := trades + 1
else if signal == -1 and position >= 0
    position := -1.0
    trades := trades + 1

pnl = position * nz(chg, 0.0)
equity := equity + pnl

// Tracking
var float maxEquity = 10000.0
if equity > maxEquity
    maxEquity := equity
drawdown = (maxEquity - equity) / maxEquity * 100

var float[] equityHistory = array.new_float(0)
array.push(equityHistory, equity)

var m = map.new<string, float>()
map.put(m, "equity", equity)
map.put(m, "dd", drawdown)
map.put(m, "trades", float(trades))

plot(equity, "Equity")
plot(drawdown, "DD%")
plot(trades, "Trades")
