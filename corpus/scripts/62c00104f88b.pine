
//@version=5
indicator("Run Stats")
var rs = map.new<string, float>()
var int barCount = 0
barCount := barCount + 1
prevSum = map.get(rs, "sum", 0.0)
map.put(rs, "sum", prevSum + close)
map.put(rs, "avg", (prevSum + close) / barCount)
map.put(rs, "last", close)
runAvg = map.get(rs, "avg", close)
plot(runAvg, "RunAvg")
