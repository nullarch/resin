//@version=5
indicator("SimAnneal")
var float temp = 100.0
var float bestSoln = 0.0
var float currSoln = 0.0
cooling = 0.9
newSoln = close * math.sin(close * 0.1)
delta = newSoln - currSoln
if delta > 0
    currSoln := newSoln
else
    acceptProb = temp > 0.01 ? math.exp(delta / temp) : 0.0
    if acceptProb > 0.5
        currSoln := newSoln
bestSoln := math.max(bestSoln, currSoln)
temp := temp * cooling
plot(bestSoln, "Best")
plot(temp, "Temp")
