
//@version=5
indicator("Post 3000")
// TA core
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)
[macd, sig, hist] = ta.macd(close, 3, 5, 3)
[bbM, bbU, bbL] = ta.bb(close, 5, 2.0)
[kcM, kcU, kcL] = ta.kc(close, 5, 1.5)

// Squeeze detection
squeeze = bbU < kcU and bbL > kcL

// Scoring
score = (close > sma3 ? 1 : 0) + (close > ema5 ? 1 : 0) + (rsi > 50 ? 1 : 0) + (hist > 0 ? 1 : 0) + (squeeze ? 1 : 0)

// State
var int totalBars = 0
var int squeezeBars = 0
var float maxScore = 0.0
totalBars := totalBars + 1
if squeeze
    squeezeBars := squeezeBars + 1
if float(score) > maxScore
    maxScore := float(score)

// Data
var float[] scores = array.new_float(0)
array.push(scores, float(score))
avgScore = array.avg(scores)

var m = map.new<string, float>()
map.put(m, "score", float(score))
map.put(m, "squeeze", float(squeezeBars))

// String
info = "S:" + str.tostring(score) + " Sq:" + str.tostring(squeezeBars)

plot(score, "Score")
plot(avgScore, "Avg")
plot(maxScore, "Max")
