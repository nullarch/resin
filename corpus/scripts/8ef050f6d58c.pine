
//@version=5
indicator("Pos Sizer")
calcPosSize(float account, float riskPct, float entry, float stop) =>
    riskAmt = account * riskPct / 100
    dist = math.abs(entry - stop)
    dist > 0 ? riskAmt / dist : 0.0

atr = nz(ta.atr(3), 1.0)
stopPrice = close - atr * 2
sz = calcPosSize(10000.0, 2.0, close, stopPrice)
plot(sz, "Sz")
