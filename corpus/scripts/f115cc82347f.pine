
//@version=5
indicator("Long Elif")
rsi = nz(ta.rsi(close, 3), 50.0)
grade = 0
if rsi > 90
    grade := 10
else if rsi > 80
    grade := 9
else if rsi > 70
    grade := 8
else if rsi > 60
    grade := 7
else if rsi > 50
    grade := 6
else if rsi > 40
    grade := 5
else if rsi > 30
    grade := 4
else
    grade := 3
plot(grade, "Grade")
