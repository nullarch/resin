
//@version=5
indicator("Osc Read")
var osc = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
cci = ta.cci(close, 5)
map.put(osc, "rsi", rsi)
map.put(osc, "stoch", k)
map.put(osc, "cci", cci)
obCount = 0.0
for [name, val] in osc
    norm = name == "cci" ? (val > 100 ? 1.0 : 0.0) : (val > 70 ? 1.0 : 0.0)
    obCount := obCount + norm
plot(obCount, "OB")
