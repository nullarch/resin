
//@version=5
indicator("BT Scan")
sma3 = ta.sma(close, 3)
profitBars = 0
for i = 0 to 4
    if not na(close[i]) and not na(close[i+1])
        wasAboveMA = close[i+1] > sma3
        priceUp = close[i] > close[i+1]
        if wasAboveMA and priceUp
            profitBars := profitBars + 1
plot(profitBars, "PB")
