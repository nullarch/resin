
//@version=5
indicator("Risk UDT")
type RiskMetrics
    float currentDD = 0.0
    float maxDD = 0.0
    float volatility = 0.0
    int riskLevel = 0

var RiskMetrics rm = RiskMetrics.new()
var float peak = 0.0
peak := math.max(peak, close)
rm.currentDD := peak > 0 ? (peak - close) / peak * 100 : 0.0
rm.maxDD := math.max(rm.maxDD, rm.currentDD)
atr = ta.atr(3)
rm.volatility := close > 0 ? atr / close * 100 : 0.0
rm.riskLevel := rm.volatility > 3 ? 3 : rm.volatility > 2 ? 2 : rm.volatility > 1 ? 1 : 0
plot(rm.riskLevel, "RL")
