
//@version=5
indicator("Break Type")
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
avgVol = ta.sma(volume, 5)
volHigh = avgVol > 0 and volume > avgVol * 1.5
bType = switch
    close > hi5[1] and volHigh => "strong_up"
    close > hi5[1] => "weak_up"
    close < lo5[1] and volHigh => "strong_dn"
    close < lo5[1] => "weak_dn"
    => "none"
isStrong = bType == "strong_up" or bType == "strong_dn"
plot(isStrong ? 1 : 0, "S")
