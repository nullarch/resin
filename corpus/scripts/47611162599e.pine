//@version=5
indicator("Mediation")
var float aPath = 0.0
var float bPath = 0.0
exposure = nz(ta.rsi(close, 5), 50.0) - 50.0
mediator = volume - nz(ta.sma(volume, 3), volume)
outcome = close - nz(close[1], close)
lr = 0.01
aPath := aPath + lr * (mediator - aPath * exposure) * exposure / math.max(exposure * exposure, 0.01)
bPath := bPath + lr * (outcome - bPath * mediator) * mediator / math.max(mediator * mediator, 0.01)
indirectEffect = aPath * bPath
plot(indirectEffect, "Indirect")
plot(aPath, "APath")
