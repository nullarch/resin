//@version=5
indicator("comprehensive 108")
type Signal
    float price = 0.0
    int direction = 0
enum Mode
    Fast = 1
    Slow = 2
calcMA(src, len) =>
    ta.sma(src, len)
var float maxVal = 0.0
var int hitCount = 0
s = calcMA(close, 3)
e = ta.ema(close, 3)
sig = Signal.new(close, 1)
m = Mode.Fast
x = if close > 108
    s
else
    e
y = switch m
    Mode.Fast => s
    Mode.Slow => e
    => 0.0
atrVal = ta.atr(5)
trVal = ta.tr
ratio = close / (close + 1.0)
z = na(atrVal) ? 0.0 : atrVal
arr = array.from(1.0, 2.0, 3.0)
float total = 0.0
for [i, v] in arr
    total := total + v
if not na(s) and s > maxVal
    maxVal := s
hitCount := hitCount + 1
