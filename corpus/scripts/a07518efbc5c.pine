//@version=5
indicator("Loading Dose")
var float plasma = 0.0
var bool loaded = false
atrVal = nz(ta.atr(3), 1.0)
if not loaded and atrVal > 2.0
    plasma := 50.0
    loaded := true
decayRate = 0.1
plasma := plasma * (1.0 - decayRate)
maintenance = volume > 1100 ? 5.0 : 2.0
plasma := plasma + maintenance
plot(plasma)
