
//@version=5
indicator("Enum UDT")
enum State
    Bull = 1
    Bear = -1
    Neutral = 0

type Market
    float score = 0.0
    int regime = 0

var Market mkt = Market.new()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
mkt.score := (rsi - 50) / 50 + (close > sma3 ? 0.5 : -0.5)
state = mkt.score > 0.3 ? State.Bull : mkt.score < -0.3 ? State.Bear : State.Neutral
mkt.regime := int(state)
plot(mkt.score, "Score")
plot(float(state), "State")
