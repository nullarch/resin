
//@version=5
indicator("Bar Info")
type BarInfo
    float body = 0.0
    float range_ = 0.0
    float efficiency = 0.0
    bool isBull = true

var BarInfo bi = BarInfo.new()
bi.body := math.abs(close - open)
bi.range_ := high - low
bi.efficiency := bi.range_ > 0 ? bi.body / bi.range_ : 0.0
bi.isBull := close > open
plot(bi.efficiency, "Eff")
