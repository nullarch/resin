
//@version=5
indicator("Mom State")
type MomState
    float rsiVal = 50.0
    float macdHist = 0.0
    int bullCount = 0

var MomState ms = MomState.new()
ms.rsiVal := nz(ta.rsi(close, 3), 50.0)
[m, s, h] = ta.macd(close, 3, 5, 3)
ms.macdHist := h
ms.bullCount := (ms.rsiVal > 50 ? 1 : 0) + (h > 0 ? 1 : 0)
plot(ms.bullCount, "BC")
