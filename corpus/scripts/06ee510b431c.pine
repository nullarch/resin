
//@version=5
indicator("Vol Cone")
var float[] vols = array.new_float(0)
array.clear(vols)
for period = 3 to 5
    sd = ta.stdev(close, period)
    pct = close > 0 ? sd / close * 100 : 0.0
    array.push(vols, pct)
avgVol = array.avg(vols)
maxVol = array.max(vols)
plot(avgVol, "AvgVol")
plot(maxVol, "MaxVol")
