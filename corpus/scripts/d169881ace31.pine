
//@version=5
indicator("Pos Size")
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
volR = avgATR > 0 ? atr / avgATR : 1.0
volSize = volR > 2.0 ? 0.2 : volR > 1.5 ? 0.4 : volR > 1.0 ? 0.7 : 1.0
momSize = math.abs(rsi - 50) > 30 ? 0.5 : 1.0
finalSize = math.min(volSize, momSize)
capital = 10000.0
dollarSize = capital * finalSize * 0.1
plot(dollarSize, "Size")
