
//@version=5
indicator("Corr Win")
var float[] prices = array.new_float(0)
var float[] volumes = array.new_float(0)
array.push(prices, close)
array.push(volumes, volume)
if array.size(prices) > 8
    array.shift(prices)
    array.shift(volumes)
avgP = array.size(prices) > 0 ? array.avg(prices) : close
avgV = array.size(volumes) > 0 ? array.avg(volumes) : volume
prodSum = 0.0
sz = array.size(prices)
for i = 0 to math.max(sz - 1, 0)
    if i < sz
        prodSum := prodSum + (array.get(prices, i) - avgP) * (array.get(volumes, i) - avgV)
plot(prodSum, "PS")
