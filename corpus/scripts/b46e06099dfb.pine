//@version=5
indicator("Comprehensive 114")
myCalc(src, len) =>
    ta.sma(src, len)
var arr = array.new_float(0)
var m = map.new<string, float>()
smaVal = myCalc(close, 3)
emaVal = ta.ema(close, 5)
rsiVal = ta.rsi(close, 5)
if not na(smaVal)
    array.push(arr, smaVal)
    map.put(m, "sma", smaVal)
mode = close > open ? 1 : 2
result = switch mode
    1 => nz(smaVal, 0.0)
    2 => nz(emaVal, 0.0)
    => close
var float maxVal = 0.0
for i = 0 to math.min(array.size(arr) - 1, 5)
    v = array.get(arr, i)
    if v > maxVal
        maxVal := v
