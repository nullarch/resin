
//@version=5
indicator("PA Full")
body = math.abs(close - open)
rng = high - low
bPct = rng > 0 ? body / rng : 0.0
isBull = close > open

// Pattern detection
hh = not na(high[1]) and high > high[1]
hl = not na(low[1]) and low > low[1]
uptrend = hh and hl

// Candle quality
sma3 = ta.sma(close, 3)
aboveMA = close > sma3

// Composite
paScore = (isBull ? 1.0 : -1.0) * bPct
trendBonus = uptrend ? 0.5 : 0.0
maBonus = aboveMA ? 0.3 : -0.3
composite = paScore + trendBonus + maBonus

var float[] history = array.new_float(0)
array.push(history, composite)
if array.size(history) > 8
    array.shift(history)

var int bars = 0
bars := bars + 1

plot(composite, "PA")
plot(array.avg(history), "AvgPA")
