//@version=5
strategy("Crypto Momentum Strategy")
hashRate = math.abs(close - open) * volume * 0.001
avgHash = ta.sma(close, 3)
highHash = not na(avgHash) and hashRate > avgHash * 0.5
lowHash = not na(avgHash) and hashRate < avgHash * 0.1
if highHash
    strategy.entry("MinerLong", strategy.long)
if lowHash
    strategy.close("MinerLong")
