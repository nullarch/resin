
//@version=5
indicator("Vol UDT")
type VolTracker
    float totalVol = 0.0
    float maxVol = 0.0
    int spikes = 0

var VolTracker vt = VolTracker.new()
vt.totalVol := vt.totalVol + volume
vt.maxVol := math.max(vt.maxVol, volume)
avgVol = ta.sma(volume, 5)
if avgVol > 0 and volume > avgVol * 2
    vt.spikes := vt.spikes + 1
plot(vt.spikes, "Spk")
