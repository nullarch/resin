//@version=5
indicator("Vol RSI")
length = 14
src = close
change = ta.change(src)
vol = nz(volume, 1.0)
upVol = change > 0 ? vol * change : 0.0
dnVol = change < 0 ? vol * math.abs(change) : 0.0
upSum = math.sum(upVol, length)
dnSum = math.sum(dnVol, length)
vrsi = dnSum != 0 ? 100 - 100 / (1 + upSum / dnSum) : 50
plot(vrsi)
plot(70)
plot(30)
