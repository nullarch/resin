
//@version=5
strategy("UDT Strat", overlay=true)
type TradeState
    bool inPosition = false
    float entryPrice = 0.0
    int holdBars = 0

var TradeState ts = TradeState.new()
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
if not ts.inPosition and close > sma3 and rsi > 50
    strategy.entry("Long", strategy.long)
    ts.inPosition := true
    ts.entryPrice := close
    ts.holdBars := 0
if ts.inPosition
    ts.holdBars := ts.holdBars + 1
    if close < sma3 or ts.holdBars > 5
        strategy.close("Long")
        ts.inPosition := false
plot(sma3, "MA")
