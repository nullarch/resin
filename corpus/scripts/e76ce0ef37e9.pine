//@version=5
indicator("UDTKal14")
type KalState
    float estimate = 100.0
    float errCov = 1.0
    float gain = 0.0
var KalState ks = KalState.new()
measNoise = 2.0
predCov = ks.errCov + 0.05
ks.gain := predCov > 0 ? predCov / (predCov + measNoise) : 0.0
ks.estimate := ks.estimate + ks.gain * (close - ks.estimate)
ks.errCov := (1.0 - ks.gain) * predCov
plot(ks.estimate, "ke")
