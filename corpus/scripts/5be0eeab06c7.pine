//@version=5
indicator("Complex UDF")
getSignal(float src, int fast, int slow) =>
    fastMA = ta.ema(src, fast)
    slowMA = ta.ema(src, slow)
    rsi = ta.rsi(src, fast)
    macd = fastMA - slowMA
    signal = macd > 0 and rsi > 50 ? 1.0 : macd < 0 and rsi < 50 ? -1.0 : 0.0
    signal
sig = getSignal(close, 3, 5)
plot(sig)
