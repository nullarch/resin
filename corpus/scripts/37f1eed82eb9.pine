
//@version=5
indicator("All CF")
rsi = nz(ta.rsi(close, 3), 50.0)
result = 0
if rsi > 60
    result := 3
else if rsi > 50
    result := 2
else
    result := 1

total = 0
for i = 0 to 2
    total := total + result

count = 0
threshold = 10
while threshold > result and count < 5
    threshold := threshold - 2
    count := count + 1

label = switch result
    3 => "high"
    2 => "medium"
    => "low"
isHigh = label == "high"
plot(total + count + (isHigh ? 1 : 0), "R")
