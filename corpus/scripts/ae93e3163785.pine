
//@version=5
indicator("Osc Label")
rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
rsiTag = rsi > 70 ? "OB" : rsi < 30 ? "OS" : "N"
kTag = k > 80 ? "OB" : k < 20 ? "OS" : "N"
label = "RSI:" + rsiTag + "_K:" + kTag
allOB = rsiTag == "OB" and kTag == "OB"
allOS = rsiTag == "OS" and kTag == "OS"
plot(allOB ? 1 : allOS ? -1 : 0, "Sig")
