
//@version=5
indicator("Regime UDF")
classifyRegime(float trendStr, float volRatio, float rsi) =>
    trend = trendStr > 0.5 ? 1.0 : trendStr < -0.5 ? -1.0 : 0.0
    vol = volRatio > 1.3 ? 1.0 : 0.0
    mom = rsi > 60 ? 1.0 : rsi < 40 ? -1.0 : 0.0
    trend + vol + mom

sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
trendStr = sma5 > 0 ? (sma3 - sma5) / sma5 * 100 : 0.0
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
ratio = avgATR > 0 ? atr / avgATR : 1.0
rsi = nz(ta.rsi(close, 3), 50.0)
score = classifyRegime(trendStr, ratio, rsi)
plot(score, "RS")
