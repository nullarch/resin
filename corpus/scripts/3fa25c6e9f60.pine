
//@version=5
indicator("MA Regime")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
spread = sma3 - sma5
regime = switch
    spread > 1.0 => "strong_bull"
    spread > 0 => "mild_bull"
    spread > -1.0 => "mild_bear"
    => "strong_bear"
isStrongBull = regime == "strong_bull"
plot(isStrongBull ? 1 : 0, "SB")
