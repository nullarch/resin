
//@version=5
indicator("Alert Full")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
avgVol = ta.sma(volume, 5)
c1 = ta.crossover(sma3, sma5)
c2 = ta.crossunder(sma3, sma5)
c3 = rsi > 70
c4 = rsi < 30
c5 = avgVol > 0 and volume > avgVol * 2
alertcondition(c1, "Golden Cross")
alertcondition(c2, "Death Cross")
alertcondition(c3, "Overbought")
alertcondition(c4, "Oversold")
alertcondition(c5, "Volume Spike")
total = (c1?1:0) + (c2?1:0) + (c3?1:0) + (c4?1:0) + (c5?1:0)
plot(total, "T")
