//@version=5
indicator("Mega 5")
clamp(float val, float lo, float hi) =>
    math.max(lo, math.min(hi, val))
lerp(float a, float b, float t) =>
    a + (b - a) * clamp(t, 0.0, 1.0)
var float smoothed = 0.0
float sma3 = nz(ta.sma(close, 3), close)
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float alpha = clamp(rsiVal / 100.0, 0.1, 0.9)
smoothed := lerp(smoothed, close, alpha)
diffs = array.new<float>(0)
for i = 0 to 4
    float projected = lerp(smoothed, close, i * 0.25)
    float diff = math.abs(projected - sma3)
    diffs.push(diff)
float maxDiff = 0.0
for d in diffs
    maxDiff := math.max(maxDiff, d)
float normalized = maxDiff > 0.01 ? smoothed / maxDiff : 0.0
