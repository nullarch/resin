//@version=5
indicator("SARSA")
var float qUp = 0.0
var float qDown = 0.0
alphaLR = 0.1
gammaDisc = 0.9
reward = close > open ? 1.0 : -1.0
rsiVal = nz(ta.rsi(close, 3), 50.0)
curAction = rsiVal > 50 ? 1 : 0
nextQ = curAction == 1 ? qUp : qDown
if curAction == 1
    qUp := qUp + alphaLR * (reward + gammaDisc * nextQ - qUp)
else
    qDown := qDown + alphaLR * (reward + gammaDisc * nextQ - qDown)
plot(math.max(qUp, qDown), "MaxQ")
