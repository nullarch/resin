//@version=5
indicator("Epicenter Distance")
var float prevShock = 0.0
currentShock = math.abs(close - open)
aftershock = not na(close[1]) ? math.abs(close[1] - open[1]) : 0.0
distance = math.abs(currentShock - aftershock) * 8.0
prevShock := currentShock
emaD = ta.ema(close, 3)
ratio = not na(emaD) and emaD > 0 ? distance : 0.0
plot(ratio)
