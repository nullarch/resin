
//@version=5
indicator("Mkt Profile")
type Profile
    float poc = 0.0
    float valueHigh = 0.0
    float valueLow = 0.0

var Profile p = Profile.new()
p.poc := (high + low + close) / 3.0
atr = ta.atr(3)
p.valueHigh := p.poc + atr * 0.5
p.valueLow := p.poc - atr * 0.5
inValue = close >= p.valueLow and close <= p.valueHigh
plot(p.poc, "POC")
plot(inValue ? 1 : 0, "InValue")
