
//@version=5
indicator("UDF Chain")
normalize(float val, float mn, float mx) =>
    rng = mx - mn
    rng > 0 ? (val - mn) / rng : 0.5

scale(float val, float factor) =>
    val * factor

rsi = nz(ta.rsi(close, 3), 50.0)
normed = normalize(rsi, 0.0, 100.0)
scaled = scale(normed, 2.0) - 1.0
plot(scaled, "Result")
