
//@version=5
indicator("Osc Dist")
var float[] rsiArr = array.new_float(0)
rsi = nz(ta.rsi(close, 3), 50.0)
array.push(rsiArr, rsi)
if array.size(rsiArr) > 8
    array.shift(rsiArr)
sorted = array.copy(rsiArr)
array.sort(sorted)
p10 = array.percentile_linear_interpolation(sorted, 10.0)
p90 = array.percentile_linear_interpolation(sorted, 90.0)
breadth = p90 - p10
plot(breadth, "Brd")
