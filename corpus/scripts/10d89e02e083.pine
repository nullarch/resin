
//@version=5
indicator("Eq Track")
var float equity = 10000.0
var float maxEquity = 10000.0
var bool inPos = false
var float entry = 0.0
sma3 = ta.sma(close, 3)
if not inPos and close > sma3
    inPos := true
    entry := close
if inPos and close < sma3
    pnl = (close - entry) * 100
    equity := equity + pnl
    maxEquity := math.max(maxEquity, equity)
    inPos := false
ddPct = maxEquity > 0 ? (maxEquity - equity) / maxEquity * 100 : 0.0
plot(ddPct, "DD%")
