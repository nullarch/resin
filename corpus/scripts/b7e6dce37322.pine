//@version=5
indicator("MinimaxRow")
r1 = array.new_float(0)
r2 = array.new_float(0)
array.push(r1, close - open)
array.push(r1, -(high - close))
array.push(r2, -(close - low))
array.push(r2, high - low)
minR1 = array.min(r1)
minR2 = array.min(r2)
maximin = math.max(minR1, minR2)
plot(maximin, "Maximin")
