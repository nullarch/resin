
//@version=5
indicator("Ret Dist")
var float[] rets = array.new_float(0)
ret = close - close[1]
if not na(ret)
    array.push(rets, ret)
if array.size(rets) > 8
    array.shift(rets)
sorted = array.copy(rets)
array.sort(sorted)
p10 = array.percentile_linear_interpolation(sorted, 10.0)
p90 = array.percentile_linear_interpolation(sorted, 90.0)
tailRatio = p10 != 0 ? math.abs(p90 / p10) : 1.0
plot(tailRatio, "Tail")
