
//@version=5
indicator("Param Sweep")
bestScore = 0.0
bestMult = 1
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
for mult = 1 to 5
    level = sma3 + atr * mult
    dist = math.abs(close - level)
    score = dist > 0 ? 1.0 / dist : 0.0
    if score > bestScore
        bestScore := score
        bestMult := mult
plot(bestMult, "Best")
