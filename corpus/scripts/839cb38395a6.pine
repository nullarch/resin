//@version=5
strategy("Swarm Strategy")
ma3 = ta.sma(close, 3)
ma5 = ta.sma(close, 5)
ma7 = ta.sma(close, 7)
vote1 = close > ma3 ? 1 : 0
vote2 = close > ma5 ? 1 : 0
vote3 = close > ma7 ? 1 : 0
votes = vote1 + vote2 + vote3
if votes >= 3
    strategy.entry("SwarmLong", strategy.long)
if votes <= 0
    strategy.close("SwarmLong")
