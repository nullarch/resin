
//@version=5
strategy("Complex Exit", overlay=true)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
var float entryPx = 0.0
var int barsHeld = 0

if close > sma3 and rsi > 50
    strategy.entry("Long", strategy.long)
    entryPx := close
    barsHeld := 0
barsHeld := barsHeld + 1

tpHit = entryPx > 0 and close > entryPx + atr * 3
slHit = entryPx > 0 and close < entryPx - atr * 2
timeExit = barsHeld > 5
rsiExit = rsi > 85

if tpHit or slHit or timeExit or rsiExit
    strategy.close("Long")
plot(sma3, "MA")
