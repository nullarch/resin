//@version=5
indicator("Momentum lookback")
var float avgMom = 0.0
mom = close - nz(close[1])
momSum = 0.0
momCount = 0
for i = 0 to 4
    pastMom = close[i] - nz(close[i + 1])
    if not na(pastMom)
        momSum := momSum + pastMom
        momCount := momCount + 1
avgMom := momCount > 0 ? momSum / float(momCount) : 0.0
