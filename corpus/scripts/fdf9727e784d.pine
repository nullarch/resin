
//@version=5
indicator("Osc Ext")
var float[] extremes = array.new_float(0)
rsi = nz(ta.rsi(close, 3), 50.0)
if rsi > 70 or rsi < 30
    array.push(extremes, rsi)
if array.size(extremes) > 6
    array.shift(extremes)
avgExtreme = array.size(extremes) > 0 ? array.avg(extremes) : 50.0
plot(array.size(extremes), "EC")
