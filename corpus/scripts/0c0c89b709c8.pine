
//@version=5
indicator("UDT TA Method")
type Analyzer
    float trend = 0.0
    float momentum = 0.0

method analyze(Analyzer a, float src) =>
    sma3 = ta.sma(src, 3)
    rsi3 = ta.rsi(src, 3)
    a.trend := src > sma3 ? 1.0 : -1.0
    a.momentum := rsi3

var Analyzer analyzer = Analyzer.new()
analyzer.analyze(close)
plot(analyzer.trend, "Trend")
plot(analyzer.momentum, "Mom")
