//@version=5
indicator("NS-20 Composite")
var float nsIndex = 0.0
vel = 0.0
if not na(close[1])
    vel := close - close[1]
pressure = volume / 1000.0
viscosity = nz(ta.atr(3), 1.0)
diffusion = nz(ta.stdev(close, 5), 0.0)
nsIndex := vel * pressure - viscosity * diffusion
smoothNs = ta.ema(close, 3)
plot(nsIndex)
