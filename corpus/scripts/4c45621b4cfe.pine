
//@version=5
indicator("Break Full")
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
atr = nz(ta.atr(3), 1.0)
rsi = nz(ta.rsi(close, 3), 50.0)
avgVol = ta.sma(volume, 5)

isBreakUp = close > hi5[1]
isBreakDn = close < lo5[1]
volConfirm = avgVol > 0 and volume > avgVol * 1.3
momConfirm = isBreakUp ? rsi > 55 : rsi < 45

var int totalBreaks = 0
var int confirmedBreaks = 0
if isBreakUp or isBreakDn
    totalBreaks := totalBreaks + 1
    if volConfirm and momConfirm
        confirmedBreaks := confirmedBreaks + 1

plot(totalBreaks, "TB")
plot(confirmedBreaks, "CB")
