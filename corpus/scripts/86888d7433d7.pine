//@version=5
indicator("Signal System")
type Signal
    string direction = "none"
    float confidence = 0.0
    float target = 0.0
    float stop = 0.0
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
atr3 = ta.atr(3)
sig = Signal.new()
if not na(sma3) and not na(sma5) and not na(atr3)
    if nz(sma3) > nz(sma5)
        sig.direction := "long"
        sig.confidence := (nz(sma3) - nz(sma5)) / nz(atr3)
        sig.target := close + nz(atr3) * 2
        sig.stop := close - nz(atr3)
    else
        sig.direction := "short"
        sig.confidence := (nz(sma5) - nz(sma3)) / nz(atr3)
        sig.target := close - nz(atr3) * 2
        sig.stop := close + nz(atr3)
