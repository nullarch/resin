//@version=5
indicator("FE14")
valley = ta.lowest(low, 5)
dist = close - valley
bucket = switch
    dist > 10 => 4
    dist > 5 => 3
    dist > 2 => 2
    => 1
levels = array.new_float(0)
cnt = 0
while cnt < bucket
    array.push(levels, cnt * 1.0)
    cnt := cnt + 1
sz = array.size(levels)
plotVal = math.ceil(sz * 1.0)
plot(plotVal, title="valley")
