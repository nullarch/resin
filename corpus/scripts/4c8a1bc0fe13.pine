
//@version=5
indicator("Multi UDT")
type Accumulator
    float sum = 0.0
    int n = 0

var Accumulator priceAcc = Accumulator.new()
var Accumulator volAcc = Accumulator.new()
priceAcc.sum := priceAcc.sum + close
priceAcc.n := priceAcc.n + 1
volAcc.sum := volAcc.sum + volume
volAcc.n := volAcc.n + 1
avgPrice = priceAcc.sum / priceAcc.n
avgVol = volAcc.sum / volAcc.n
plot(avgPrice, "AvgP")
plot(avgVol, "AvgV")
