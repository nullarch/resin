
//@version=5
indicator("Stress10")
enum Category
    ALPHA
    BETA
    GAMMA
categorize(val) =>
    val > 3.0 ? Category.ALPHA : val > 1.0 ? Category.BETA : Category.GAMMA
var float history = 0.0
diff = close - open
cat = categorize(diff)
catName = cat == Category.ALPHA ? "ALPHA" : cat == Category.BETA ? "BETA" : "GAMMA"
history := history + diff
scores = array.new_float(0)
for i = 0 to 3
    array.push(scores, diff * float(i + 1))
catMap = map.new<string, float>()
map.put(catMap, catName, array.sum(scores))
map.put(catMap, "history", history)
total = 0.0
for [k, v] in catMap
    total := total + v
plot(total + float(str.length(catName)), "S10")
