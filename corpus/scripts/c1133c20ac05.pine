//@version=5
indicator("Comono")
var int comoCount = 0
var int total = 0
total := total + 1
dC = close - nz(close[1], close)
dV = volume - nz(volume[1], volume)
sameDir = (dC > 0 and dV > 0) or (dC < 0 and dV < 0) or (dC == 0 and dV == 0)
if sameDir
    comoCount := comoCount + 1
comoRatio = total > 0 ? float(comoCount) / float(total) : 0.5
plot(comoRatio, "Comono")
