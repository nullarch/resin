
//@version=5
indicator("Consensus")
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi = ta.rsi(close, 3)
wma3 = ta.wma(close, 3)
votes = (close > sma3 ? 1 : 0) + (close > ema5 ? 1 : 0) + (rsi > 50 ? 1 : 0) + (close > wma3 ? 1 : 0)
consensus = votes >= 3
plot(votes, "Votes")
plot(consensus ? 1 : 0, "Consensus")
