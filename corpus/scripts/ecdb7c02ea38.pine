//@version=5
indicator("Bankers Algo")
float available = 10.0
float p1Need = math.floor(close) % 5 + 1
float p2Need = math.floor(open) % 5 + 1
float p1Alloc = math.min(p1Need, available)
float remaining = available - p1Alloc
float p2Alloc = math.min(p2Need, remaining)
bool safe = (p1Alloc >= p1Need) or (p2Alloc >= p2Need)
float safetyMargin = remaining - p2Alloc
