//@version=5
indicator("Cycle 122 Comprehensive", overlay=true)
type TradeInfo
    string direction = "none"
    float entry = 0.0
    float target = 0.0
    float stop = 0.0
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema5 = ta.ema(close, 5)
rsi5 = ta.rsi(close, 5)
atr3 = ta.atr(3)
var arr = array.new_float(0)
var m = map.new<string, float>()
var int signals = 0
var float bestRSI = 0.0
trade = TradeInfo.new()
if not na(sma3) and not na(sma5) and not na(atr3)
    if ta.crossover(sma3, sma5)
        trade.direction := "long"
        trade.entry := close
        trade.target := close + nz(atr3) * 2
        trade.stop := close - nz(atr3)
        signals := signals + 1
    if ta.crossunder(sma3, sma5)
        trade.direction := "short"
        signals := signals + 1
if not na(rsi5)
    if nz(rsi5) > bestRSI
        bestRSI := nz(rsi5)
array.push(arr, close)
if array.size(arr) > 5
    array.shift(arr)
map.put(m, "sma", nz(sma3))
map.put(m, "ema", nz(ema5))
clr = close > nz(sma5) ? color.green : color.red
plot(sma3, "Fast", color=clr)
plot(sma5, "Slow")
var int barCount = 0
barCount := barCount + 1
