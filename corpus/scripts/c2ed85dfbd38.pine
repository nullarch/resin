//@version=5
indicator("BoS")
prefA1 = 3.0
prefA2 = 0.0
prefB1 = 0.0
prefB2 = 2.0
signal = nz(ta.rsi(close, 3), 50.0) / 100.0
euA_pick1 = signal * prefA1 + (1.0 - signal) * prefA2
euA_pick2 = signal * prefB1 + (1.0 - signal) * prefB2
choiceA = euA_pick1 >= euA_pick2 ? 1.0 : 2.0
plot(choiceA, "ChoiceA")
plot(euA_pick1, "EU1")
