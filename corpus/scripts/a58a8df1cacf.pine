//@version=5
indicator("Signal Track")
type TradeSignal
    float strength
    int direction
var float bestStrength = 0.0
float rsiVal = nz(ta.rsi(close, 3), 50.0)
float strength = math.abs(rsiVal - 50.0)
int dir = rsiVal > 50.0 ? 1 : -1
if strength > bestStrength
    bestStrength := strength
plot(bestStrength, "BestStr")
