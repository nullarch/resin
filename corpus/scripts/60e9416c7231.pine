
//@version=5
strategy("Micro Filt", overlay=true)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
avgVol = ta.sma(volume, 5)
goodLiquidity = volume > avgVol * 0.8
if close > sma3 and rsi > 50 and goodLiquidity
    strategy.entry("Long", strategy.long)
if close < sma3
    strategy.close("Long")
plot(sma3, "MA")
