
//@version=5
indicator("Risk Lvl")
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
ratio = avgATR > 0 ? atr / avgATR : 1.0
rsi = nz(ta.rsi(close, 3), 50.0)
riskLvl = switch
    ratio > 2.0 and (rsi > 75 or rsi < 25) => "critical"
    ratio > 1.5 => "high"
    ratio > 1.0 => "medium"
    => "low"
isCritical = riskLvl == "critical"
plot(isCritical ? 1 : 0, "C")
