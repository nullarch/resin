
//@version=5
indicator("Welford")
welfordUpdate(float mean, float m2, int n, float x) =>
    delta = x - mean
    newMean = mean + delta / float(n)
    delta2 = x - newMean
    newM2 = m2 + delta * delta2
    newMean

var float wMean = 0.0
var float wM2 = 0.0
var int wN = 0
wN := wN + 1
delta = close - wMean
wMean := welfordUpdate(wMean, wM2, wN, close)
delta2 = close - wMean
wM2 := wM2 + delta * delta2
variance = wN > 1 ? wM2 / float(wN - 1) : 0.0
plot(math.sqrt(math.max(0.0, variance)), "SD")
