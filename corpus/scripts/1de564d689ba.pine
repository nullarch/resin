//@version=5
strategy("Topology Breakout Strategy")
float eps = 4.0
float d1 = math.abs(close - open)
float d2 = math.abs(high - low)
float d3 = math.abs(close - low)
int edgeCount = (d1 < eps ? 1 : 0) + (d2 < eps ? 1 : 0) + (d3 < eps ? 1 : 0)
if edgeCount >= 2 and close > open
    strategy.entry("Long", strategy.long)
if edgeCount == 0
    strategy.close("Long")
