//@version=5
strategy("Mega 14")
momentum(float price, float avg) =>
    avg > 0.01 ? (price - avg) / avg * 100.0 : 0.0
var int winStreak = 0
float sma3 = nz(ta.sma(close, 3), close)
float sma5 = nz(ta.sma(close, 5), close)
float atrVal = nz(ta.atr(3), 1.0)
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float mom = momentum(close, sma3)
indicators = map.new<string, float>()
indicators.put("mom", mom)
indicators.put("rsi", rsiVal)
indicators.put("atr", atrVal)
thresholds = array.new<float>(0)
float thr = 0.5
int cnt = 0
while thr < 3.0 and cnt < 10
    thresholds.push(thr)
    thr := thr + 0.5
    cnt := cnt + 1
float bestThr = 0.0
for t in thresholds
    if mom > t
        bestThr := t
if mom > bestThr and rsiVal > 50.0
    strategy.entry("MomLong", strategy.long)
    winStreak := winStreak + 1
if rsiVal < 35.0
    strategy.close("MomLong")
    winStreak := 0
