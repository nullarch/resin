//@version=5
indicator("Complex Bool")
rsi = ta.rsi(close, 14)
[macdLine, signal, hist] = ta.macd(close, 12, 26, 9)
atrVal = ta.atr(14)
bullish = rsi > 50 and
    macdLine > signal and
    close > ta.sma(close, 5)
bearish = rsi < 50 and
    macdLine < signal and
    close < ta.sma(close, 5)
plotshape(bullish, style=shape.triangleup, location=location.belowbar, color=color.green)
plotshape(bearish, style=shape.triangledown, location=location.abovebar, color=color.red)
