
//@version=5
strategy("Div Strat", overlay=true)
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
priceDn = close < close[1]
rsiUp = rsi > 45
bullDiv = priceDn and rsiUp and close < sma3
if bullDiv
    strategy.entry("Long", strategy.long)
if rsi > 65
    strategy.close("Long")
plot(sma3, "MA")
