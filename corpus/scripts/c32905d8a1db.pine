
//@version=5
indicator("Alloc")
var aa = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
bullish = rsi > 55
map.put(aa, "equity", bullish ? 0.7 : 0.3)
map.put(aa, "bond", bullish ? 0.2 : 0.5)
map.put(aa, "cash", bullish ? 0.1 : 0.2)
eqAlloc = map.get(aa, "equity", 0.5)
plot(eqAlloc, "Eq")
