
//@version=5
indicator("Trans Hist")
var float[] transitions = array.new_float(0)
var int lastRegime = 0
sma3 = ta.sma(close, 3)
regime = close > sma3 ? 1 : -1
if regime != lastRegime
    array.push(transitions, float(regime))
    if array.size(transitions) > 8
        array.shift(transitions)
lastRegime := regime
transCount = array.size(transitions)
plot(transCount, "TC")
