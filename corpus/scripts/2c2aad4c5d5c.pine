//@version=5
strategy("Antenna Gain Strategy")
float fastMA = nz(ta.sma(close, 3), close)
float slowMA = nz(ta.sma(close, 5), close)
float gain = fastMA - slowMA
float prevGain = not na(close[1]) ? fastMA - slowMA : 0.0
float atrVal = nz(ta.atr(3), 1.0)
float normGain = gain / math.max(atrVal, 0.01)
if normGain > 0.5
    strategy.entry("Long", strategy.long)
if normGain < -0.5
    strategy.close("Long")
