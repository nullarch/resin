//@version=5
indicator("Mega 13")
type Layer
    float bias = 0.0
    float output = 0.0
var float epoch = 0.0
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float sma3 = nz(ta.sma(close, 3), close)
epoch := epoch + 1.0
layers = array.new<float>(0)
for i = 0 to 3
    float nodeVal = close * math.pow(0.8, i) + sma3 * math.pow(0.2, i)
    layers.push(nodeVal)
float layerResult = 0.0
for val in layers
    layerResult := layerResult + val
float normResult = layers.size() > 0 ? layerResult / layers.size() : 0.0
int category = 0
switch
    normResult > close * 1.02 =>
        category := 3
    normResult > close =>
        category := 2
    normResult > close * 0.98 =>
        category := 1
    =>
        category := 0
layer = Layer.new(rsiVal * 0.01, normResult)
float decayedEpoch = epoch * 0.99
