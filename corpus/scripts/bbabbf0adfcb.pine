//@version=5
indicator("SCAN Disk")
var bool movingUp = true
var float headPos = 50.0
float request = math.floor(close) % 100
float distance = math.abs(request - headPos)
if movingUp
    headPos := headPos + 5.0
    if headPos >= 100.0
        movingUp := false
else
    headPos := headPos - 5.0
    if headPos <= 0.0
        movingUp := true
float seekTime = distance * 0.1
