//@version=5
indicator("Thermocline Depth")
surfaceTemp = ta.ema(high, 3)
deepTemp = ta.ema(low, 3)
thermoclineStrength = not na(surfaceTemp) and not na(deepTemp) ? surfaceTemp - deepTemp : 0.0
var float avgThermocline = 0.0
var int count = 0
if thermoclineStrength > 0
    avgThermocline := avgThermocline + thermoclineStrength
    count := count + 1
