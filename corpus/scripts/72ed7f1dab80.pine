//@version=5
strategy("CausalStrat")
var float cumSignal = 0.0
var int pos = 0
prevVol = nz(volume[1], volume)
retNow = close - nz(close[1], close)
signal = prevVol > 1000 ? retNow : 0.0
cumSignal := 0.8 * cumSignal + 0.2 * signal
if cumSignal > 0.5 and pos == 0
    strategy.entry("CL", strategy.long)
    pos := 1
else if cumSignal < -0.5 and pos == 1
    strategy.close("CL")
    pos := 0
plot(cumSignal, "CumSig")
