//@version=5
indicator("LaplacianTr")
nodes = array.new_float(0)
array.push(nodes, close)
array.push(nodes, open)
array.push(nodes, high)
array.push(nodes, low)
thresh = 6.0
traceL = 0.0
for i = 0 to 3
    deg = 0.0
    for j = 0 to 3
        if i != j and math.abs(array.get(nodes, i) - array.get(nodes, j)) < thresh
            deg := deg + 1.0
    traceL := traceL + deg
plot(traceL, "TraceL")
