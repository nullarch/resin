
//@version=5
indicator("EventHist")
var events = map.new<string, float>()
var int barNum = 0
barNum := barNum + 1

if close > 105
    map.put(events, "last_above_105", float(barNum))
if volume > 1200
    map.put(events, "last_high_vol", float(barNum))

lastAbove = map.get(events, "last_above_105", 0.0)
lastVol = map.get(events, "last_high_vol", 0.0)
plot(lastAbove + lastVol, "EH")
