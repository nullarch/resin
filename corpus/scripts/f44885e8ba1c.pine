
//@version=5
indicator("Pat Name")
dir = close > open ? "Bull" : "Bear"
body = math.abs(close - open)
range_ = high - low
size = range_ > 0 and body / range_ > 0.7 ? "Marubozu" : range_ > 0 and body / range_ < 0.1 ? "Doji" : "Normal"
name = dir + "_" + size
isMaru = str.contains(name, "Marubozu")
plot(isMaru ? 1 : 0, "Maru")
