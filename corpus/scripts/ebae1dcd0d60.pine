//@version=5
indicator("Ichimoku Full", overlay=true)
convLen = 9
baseLen = 26
tenkan = (ta.highest(high, convLen) + ta.lowest(low, convLen)) / 2
kijun = (ta.highest(high, baseLen) + ta.lowest(low, baseLen)) / 2
senkouA = (tenkan + kijun) / 2
senkouB = (ta.highest(high, 52) + ta.lowest(low, 52)) / 2
chikou = close
bullish = tenkan > kijun and close > senkouA and close > senkouB
plot(tenkan)
plot(kijun)
plot(senkouA)
plot(senkouB)
plot(bullish ? 1.0 : 0.0)
