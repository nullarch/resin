//@version=5
strategy("AllFeat 010", overlay=true)
enum Signal
    Buy
    Sell
    Hold
type Level
    float price
    int direction
var int tradeCount = 0
var levels = array.new_float(0)
array.push(levels, close)
rsiVal = nz(ta.rsi(close, 3), 50.0)
sig = switch
    rsiVal > 65 => 1
    rsiVal < 35 => -1
    => 0
best = 0.0
for i = 0 to array.size(levels) - 1
    v = array.get(levels, i)
    best := v > best ? v : best
if sig == 1
    strategy.entry("B", strategy.long)
    tradeCount := tradeCount + 1
else if sig == -1
    strategy.entry("S", strategy.short)
    tradeCount := tradeCount + 1
