
//@version=5
indicator("Port Wt")
var pw = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
invVol = atr > 0 ? 1.0 / atr : 1.0
map.put(pw, "asset1", invVol * 0.5)
map.put(pw, "asset2", invVol * 0.3)
map.put(pw, "cash", 0.2)
totalWt = 0.0
for [k, v] in pw
    totalWt := totalWt + v
normFactor = totalWt > 0 ? 1.0 / totalWt : 1.0
plot(map.get(pw, "asset1", 0.0) * normFactor, "W1")
