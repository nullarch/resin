
//@version=5
strategy("Full Strat", overlay=true)
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
[m, s, h] = ta.macd(close, 3, 5, 3)

trendOK = close > ema3 and ema3 > sma5
momOK = rsi > 45 and rsi < 75 and h > 0
volOK = atr < ta.sma(atr, 5) * 2

if trendOK and momOK and volOK
    strategy.entry("Long", strategy.long)
if close < sma5 or rsi > 80
    strategy.close("Long")

plot(ema3, "EMA")
plot(sma5, "SMA")
