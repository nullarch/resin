//@version=5
indicator("Torture 8")
var float peak = 0.0
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float smaVal = nz(ta.sma(close, 3), close)
float emaVal = nz(ta.ema(close, 3), close)
float selector = rsiVal > 70 ? smaVal :
    rsiVal > 50 ? emaVal :
    rsiVal > 30 ? (smaVal + emaVal) / 2.0 :
    close
arr = array.new<float>(0)
arr.push(math.abs(close - smaVal))
arr.push(math.abs(close - emaVal))
arr.push(math.abs(smaVal - emaVal))
float maxDev = 0.0
for dev in arr
    maxDev := math.max(maxDev, dev)
peak := math.max(peak, maxDev)
float normalized = peak > 0.01 ? maxDev / peak : 0.0
float grade = normalized > 0.8 ? 3.0 :
    normalized > 0.5 ? 2.0 :
    normalized > 0.2 ? 1.0 :
    0.0
