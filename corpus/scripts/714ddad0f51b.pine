//@version=5
indicator("Post Milestone")
type Trade
    float entry = 0.0
    float target = 0.0
    string direction = ""
// TA
sma_ = ta.sma(close, 3)
ema_ = ta.ema(close, 3)
rsi_ = ta.rsi(close, 5)
atr_ = ta.atr(5)
[macdLine, signalLine, histLine] = ta.macd(close, 3, 5, 3)
// UDF
calcTarget(entry, atr_val, is_long) =>
    is_long ? entry + atr_val * 2.0 : entry - atr_val * 2.0
// Logic
is_bull = close > sma_ and macdLine > signalLine
dir = is_bull ? "long" : "short"
target = calcTarget(close, nz(atr_, 0.0), is_bull)
trade = Trade.new(close, target, dir)
// Array
var trades = array.new_float(0)
trades.push(trade.entry)
// Map
m = map.new<string, float>()
m.put("entry", trade.entry)
m.put("target", trade.target)
// Switch
signal = switch
    rsi_ > 70 and not is_bull => -1.0
    rsi_ < 30 and is_bull => 1.0
    => 0.0
// For
sum_ = 0.0
for i = 0 to 2
    sum_ := sum_ + nz(close[i], 0.0)
avg_ = sum_ / 3.0
// Result
result = signal * avg_
