
//@version=5
indicator("All TA")
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
[m, s, h] = ta.macd(close, 3, 5, 3)
[mid, upper, lower] = ta.bb(close, 5, 2.0)
k = ta.stoch(close, high, low, 5)
cci = ta.cci(close, 5)
sd = ta.stdev(close, 5)
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
cumVol = ta.cum(volume)
score = (rsi > 50 ? 1 : 0) + (h > 0 ? 1 : 0) + (close > mid ? 1 : 0) + (k > 50 ? 1 : 0) + (cci > 0 ? 1 : 0)
plot(score, "Score")
