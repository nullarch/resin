
//@version=5
indicator("All Features")
// TA
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsiVal = ta.rsi(close, 3)
atrVal = ta.atr(3)
[macdLine, sigLine, hist] = ta.macd(close, 3, 5, 3)

// Enum
enum Dir
    Up = 1
    Down = -1
    Flat = 0

// Classification
dir = sma3 > ema5 ? Dir.Up : sma3 < ema5 ? Dir.Down : Dir.Flat

// Switch
weight = switch dir
    Dir.Up => 1.5
    Dir.Down => 0.5
    => 1.0

// State tracking
var int bullBars = 0
var int bearBars = 0
var float maxRSI = 0.0
if int(dir) > 0
    bullBars := bullBars + 1
else if int(dir) < 0
    bearBars := bearBars + 1
if rsiVal > maxRSI
    maxRSI := rsiVal

// Array
var float[] rsiHistory = array.new_float(0)
array.push(rsiHistory, rsiVal)
if array.size(rsiHistory) > 5
    array.shift(rsiHistory)
rsiAvg = array.avg(rsiHistory)

// Map
var m = map.new<string, float>()
map.put(m, "rsi", rsiVal)
map.put(m, "atr", atrVal)

// For loop
lookbackMax = 0.0
for i = 0 to 3
    val = close[i]
    if not na(val) and val > lookbackMax
        lookbackMax := val

// String
info = "D:" + str.tostring(int(dir)) + " R:" + str.tostring(rsiVal, "#.#")

// Plot
adjustedClose = close * weight
plot(adjustedClose, "Adj")
plot(bullBars, "Bulls")
plot(bearBars, "Bears")
