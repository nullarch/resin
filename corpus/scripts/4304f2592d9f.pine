
//@version=5
indicator("All Math")
sinVal = math.sin(close * 0.01)
cosVal = math.cos(close * 0.01)
logVal = close > 0 ? math.log(close) : 0.0
expVal = math.exp(math.min(close * 0.001, 5))
sqrtVal = math.sqrt(math.abs(close))
powVal = math.pow(close / 100, 2)
absVal = math.abs(close - open)
signVal = math.sign(close - open)
roundVal = math.round(close)
floorVal = math.floor(close)
ceilVal = math.ceil(close)
minVal = math.min(close, open)
maxVal = math.max(close, open)
plot(sinVal + cosVal, "Trig")
