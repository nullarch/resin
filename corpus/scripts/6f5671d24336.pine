
//@version=5
indicator("RR Calc")
calcRR(float entry, float stop, float target) =>
    risk = math.abs(entry - stop)
    reward = math.abs(target - entry)
    risk > 0 ? reward / risk : 0.0

sma3 = ta.sma(close, 3)
atr = ta.atr(3)
entry = close
stop = close - atr * 2
target = close + atr * 3
rr = calcRR(entry, stop, target)
plot(rr, "RR")
