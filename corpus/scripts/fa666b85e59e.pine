
//@version=5
indicator("Brk Cont")
sma3 = ta.sma(close, 3)
firstCross = -1
for i = 0 to 7
    c = close[i]
    m = sma3[i]
    if na(c) or na(m)
        continue
    if c > m
        firstCross := i
        break
target = close * 0.95
est = close
steps = 0
while est > target
    est := est - 0.5
    steps := steps + 1
    if steps > 20
        break
plot(firstCross, "FC")
plot(steps, "St")
