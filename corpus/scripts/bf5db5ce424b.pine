
//@version=5
indicator("Break Str")
breakStrength(float price, float level, float atr, float vol, float avgVol) =>
    dist = price - level
    atrMult = atr > 0 ? dist / atr : 0.0
    volConf = avgVol > 0 ? vol / avgVol : 1.0
    atrMult * volConf

hi5 = ta.highest(high, 5)
atr = nz(ta.atr(3), 1.0)
avgVol = ta.sma(volume, 5)
str = breakStrength(close, hi5[1], atr, volume, avgVol)
plot(str, "BS")
