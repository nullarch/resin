//@version=5
indicator("UdfRecForMathVar")
geoMean(a, b, c) =>
    product = a * b * c
    product > 0 ? math.pow(product, 1.0 / 3.0) : 0.0
var float cumGeo = 0.0
a = math.max(high - low, 0.1)
b = math.max(close - low, 0.1)
c = math.max(high - close, 0.1)
gm = geoMean(a, b, c)
cumGeo := cumGeo + gm
plot(cumGeo, "GM")
