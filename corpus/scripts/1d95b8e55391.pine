
//@version=5
indicator("MaxDDDur")
var float equity = 100.0
var float peak = 100.0
var int curDur = 0
var int maxDur = 0
pnl = close > open ? 1.0 : -0.6
equity := equity + pnl
peak := equity > peak ? equity : peak
curDur := equity < peak ? curDur + 1 : 0
maxDur := curDur > maxDur ? curDur : maxDur
plot(maxDur, "MDur")
