
//@version=5
strategy("ML Strat", overlay=true)
rsi = nz(ta.rsi(close, 3), 50.0)
sma5 = ta.sma(close, 5)
volOk = volume > 1000

score = 0.0
score := score + (rsi > 50 ? 1.0 : -1.0)
score := score + (close > sma5 ? 1.0 : -1.0)
score := score + (volOk ? 1.0 : -1.0)

if score >= 2.0
    strategy.entry("Long", strategy.long)
if score <= -2.0
    strategy.entry("Short", strategy.short)
plot(score, "SC")
