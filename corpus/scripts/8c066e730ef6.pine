
//@version=5
indicator("Cross Offset")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
crossNow = ta.crossover(sma3, sma5)
wasCross = ta.crossover(sma3[1], sma5[1])
recentCross = crossNow or (not na(wasCross) and wasCross)
var int crosses = 0
if crossNow
    crosses := crosses + 1
plot(crosses, "Crosses")
