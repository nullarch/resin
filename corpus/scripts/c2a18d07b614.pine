
//@version=5
indicator("Complex For")
sma3 = ta.sma(close, 3)
bullBars = 0
bearBars = 0
totalRange = 0.0
for i = 0 to 4
    if not na(close[i]) and not na(open_[i])
        if close[i] > open_[i] and close[i] > sma3
            bullBars := bullBars + 1
        else if close[i] < open_[i]
            bearBars := bearBars + 1
        totalRange := totalRange + (high[i] - low[i])
plot(bullBars - bearBars, "Net")
