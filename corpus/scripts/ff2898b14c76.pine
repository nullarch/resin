
//@version=5
indicator("Multi Field")
type Analysis
    float trend = 0.0
    float momentum = 0.0
    float volatility = 0.0
    float volume_sig = 0.0

var Analysis a = Analysis.new()
sma3 = ta.sma(close, 3)
a.trend := close > sma3 ? 1.0 : -1.0
a.momentum := ta.rsi(close, 3) > 50 ? 1.0 : -1.0
a.volatility := ta.atr(3) > ta.sma(ta.atr(3), 5) ? 1.0 : -1.0
a.volume_sig := volume > ta.sma(volume, 5) ? 1.0 : -1.0
composite = (a.trend + a.momentum + a.volatility + a.volume_sig) / 4.0
plot(composite, "Comp")
