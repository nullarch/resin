//@version=5
strategy("Cycle 124 Comprehensive", overlay=true)
type SignalInfo
    string trend = "none"
    float strength = 0.0
    float stopLoss = 0.0
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema5 = ta.ema(close, 5)
rsi5 = ta.rsi(close, 5)
atr3 = ta.atr(3)
[bbU, bbM, bbL] = ta.bb(close, 5, 2.0)
var prices = array.new_float(0)
var m = map.new<string, float>()
var int totalTrades = 0
sig = SignalInfo.new()
if not na(sma3) and not na(sma5) and not na(atr3)
    sig.trend := sma3 > sma5 ? "bull" : "bear"
    sig.strength := math.abs(nz(sma3) - nz(sma5))
    sig.stopLoss := nz(atr3) * 1.5
array.push(prices, close)
if array.size(prices) > 5
    array.shift(prices)
map.put(m, "trend_str", sig.strength)
if sig.trend == "bull" and not na(rsi5) and nz(rsi5) < 70
    strategy.entry("Long", strategy.long)
    strategy.exit("SL", "Long", stop=close - sig.stopLoss)
    totalTrades := totalTrades + 1
if sig.trend == "bear"
    strategy.close("Long")
bbSqueeze = not na(bbU) and not na(bbL) ? (nz(bbU) - nz(bbL)) / nz(bbM) : 0.0
plot(sma3, "Fast")
plot(sma5, "Slow")
var int barCount = 0
barCount := barCount + 1
