
//@version=5
strategy("Multi Cond", overlay=true)
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
bullCross = ta.crossover(ema3, sma5)
momOK = rsi > 45 and rsi < 75
if bullCross and momOK
    strategy.entry("Long", strategy.long)
if ta.crossunder(ema3, sma5)
    strategy.close("Long")
plot(ema3, "EMA")
