
//@version=5
indicator("RSI Div")
rsi = nz(ta.rsi(close, 3), 50.0)
priceHigher = close > close[2]
rsiLower = rsi < rsi[2]
bearDiv = priceHigher and rsiLower and not na(close[2])
priceLower = close < close[2]
rsiHigher = rsi > rsi[2]
bullDiv = priceLower and rsiHigher and not na(close[2])
plot(bullDiv ? 1 : bearDiv ? -1 : 0, "Div")
