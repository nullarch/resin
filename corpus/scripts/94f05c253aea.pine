//@version=5
strategy("Ultra 008", overlay=true)

sigmoid(float x) =>
    1.0 / (1.0 + math.exp(-x))

var map<string, float> features = map.new<string, float>()
var float cumSignal = 0.0

rsiVal = nz(ta.rsi(close, 5), 50.0)
emaVal = ta.ema(close, 3)
trend = not na(emaVal) ? close - emaVal : 0.0

map.put(features, "rsi", (rsiVal - 50.0) / 50.0)
map.put(features, "trend", trend > 0 ? 1.0 : -1.0)
map.put(features, "volume", volume > 1100 ? 0.5 : -0.5)

rawSignal = 0.0
for [key, val] in features
    rawSignal := rawSignal + val

prob = sigmoid(rawSignal)
cumSignal := cumSignal + (prob - 0.5)

action = switch
    prob > 0.65 => "buy"
    prob < 0.35 => "sell"
    => "hold"

if action == "buy"
    strategy.entry("Long", strategy.long)
if action == "sell"
    strategy.close("Long")
plot(math.round(prob * 100) / 100)
