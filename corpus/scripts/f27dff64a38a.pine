//@version=5
indicator("CF All")
var float total = 0.0
if close > open
    total := total + 1.0
for i = 1 to 3
    total := total + 0.1
arr = array.from(1.0, 2.0, 3.0)
for val in arr
    total := total + val * 0.01
int n = 3
while n > 0
    total := total + 0.001
    n := n - 1
mode = switch
    close > 110 => 1
    close > 105 => 2
    => 3
