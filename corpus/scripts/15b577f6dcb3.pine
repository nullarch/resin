//@version=5
indicator("Neurotransmitter Release")
var float vesiclePool = 100.0
var float released = 0.0
spike = math.abs(close - open)
releaseRate = spike > 2.0 ? 10.0 : 3.0
released := math.min(vesiclePool, releaseRate)
vesiclePool := vesiclePool - released + 5.0
vesiclePool := math.min(vesiclePool, 100.0)
plot(vesiclePool)
