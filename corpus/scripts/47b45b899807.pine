//@version=5
indicator("Combo05")
enum Regime
    Bull = 1
    Bear = 2
    Side = 3
getRegime(rsiVal) =>
    rsiVal > 60.0 ? Regime.Bull : rsiVal < 40.0 ? Regime.Bear : Regime.Side
var int bullBars = 0
var int bearBars = 0
rsiVal = nz(ta.rsi(close, 5), 50.0)
regime = getRegime(rsiVal)
if regime == Regime.Bull
    bullBars := bullBars + 1
else if regime == Regime.Bear
    bearBars := bearBars + 1
scores = array.new_float(0)
array.push(scores, float(bullBars))
array.push(scores, float(bearBars))
dominance = array.max(scores)
plot(dominance, "Dominance")
plot(rsiVal, "RSI")
