
//@version=5
indicator("Bar Met")
var bm = map.new<string, float>()
body = math.abs(close - open)
rng = high - low
map.put(bm, "body", body)
map.put(bm, "range", rng)
map.put(bm, "upper_shadow", high - math.max(open, close))
map.put(bm, "lower_shadow", math.min(open, close) - low)
map.put(bm, "efficiency", rng > 0 ? body / rng : 0.0)
eff = map.get(bm, "efficiency", 0.0)
plot(eff, "Eff")
