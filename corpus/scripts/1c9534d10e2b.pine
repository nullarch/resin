
//@version=5
indicator("Strat Mode")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
volHigh = avgATR > 0 and atr > avgATR * 1.3
mode = switch
    sma3 > sma5 and not volHigh => "trend_follow"
    volHigh => "mean_revert"
    => "range_trade"
isTrend = mode == "trend_follow"
plot(isTrend ? 1 : 0, "TF")
