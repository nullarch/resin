//@version=5
indicator("Ultra 012")

zscore(float val, float mean, float std) =>
    std > 0.01 ? (val - mean) / std : 0.0

var map<string, float> stats = map.new<string, float>()
var int anomalies = 0
var float cumZ = 0.0

smaVal = ta.sma(close, 5)
devVal = nz(ta.stdev(close, 5), 1.0)
zVal = not na(smaVal) ? zscore(close, smaVal, devVal) : 0.0

map.put(stats, "zscore", zVal)
map.put(stats, "mean", nz(smaVal, close))
map.put(stats, "dev", devVal)

total = 0.0
for [key, val] in stats
    total := total + math.abs(val)

idx = 0
decayed = zVal
while idx < 2
    decayed := decayed * 0.85
    idx := idx + 1

regime = switch
    zVal > 2.0 => "extreme_high"
    zVal > 1.0 => "high"
    zVal < -2.0 => "extreme_low"
    zVal < -1.0 => "low"
    => "normal"

if regime == "extreme_high" or regime == "extreme_low"
    anomalies := anomalies + 1
    if math.abs(zVal) > 3.0
        anomalies := anomalies + 1

cumZ := cumZ + decayed
label = str.tostring(anomalies) + ":" + regime
plot(cumZ)
