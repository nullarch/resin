//@version=5
indicator("MultiPlotIfTern")
var float upperBand = 0.0
var float lowerBand = 999.0
mid = (high + low) / 2.0
if close > open
    upperBand := math.max(upperBand, high)
else
    lowerBand := math.min(lowerBand, low)
width = upperBand > lowerBand ? upperBand - lowerBand : 0.0
plot(mid, "Mid")
plot(width, "W")
