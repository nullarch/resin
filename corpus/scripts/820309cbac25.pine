
//@version=5
indicator("Bar Pat")
body = math.abs(close - open)
rng = high - low
upperShadow = high - math.max(open, close)
lowerShadow = math.min(open, close) - low
bodyPct = rng > 0 ? body / rng : 0.0
pattern = switch
    bodyPct < 0.1 => "doji"
    bodyPct > 0.8 => "marubozu"
    lowerShadow > body * 2 and upperShadow < body * 0.5 => "hammer"
    upperShadow > body * 2 and lowerShadow < body * 0.5 => "shooting_star"
    => "standard"
isSpecial = pattern != "standard"
plot(isSpecial ? 1 : 0, "Spec")
