//@version=5
strategy("Mean Rev", overlay=true)
length = 5
mult = 2.0
basis = ta.sma(close, length)
dev = mult * ta.stdev(close, length)
upper = basis + dev
lower = basis - dev
if close < lower
    strategy.entry("Long", strategy.long)
if close > upper
    strategy.entry("Short", strategy.short)
if close > basis and strategy.position_size > 0
    strategy.close("Long")
