
//@version=5
indicator("Algo Switch")
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
ratio = avgATR > 0 ? atr / avgATR : 1.0
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
result = switch
    ratio > 1.5 => ta.sma(close, 3)
    sma3 > sma5 => ta.ema(close, 3)
    => (sma3 + sma5) / 2
plot(result, "R")
