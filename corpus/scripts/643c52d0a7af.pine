//@version=5
indicator("Diffusion Array")
var float[] increments = array.new_float(0)
float prevC = not na(close[1]) ? close[1] : close
float inc = close - prevC
if array.size(increments) >= 5
    array.shift(increments)
array.push(increments, inc)
float avgInc = array.size(increments) > 0 ?
    array.get(increments, 0) : 0.0
plot(avgInc, "AvgInc")
