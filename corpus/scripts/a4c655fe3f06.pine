
//@version=5
indicator("Map Counter")
var counters = map.new<string, float>()
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
aboveMA = map.get(counters, "above_ma", 0.0)
belowMA = map.get(counters, "below_ma", 0.0)
if close > sma3
    map.put(counters, "above_ma", aboveMA + 1)
else
    map.put(counters, "below_ma", belowMA + 1)
net = map.get(counters, "above_ma", 0.0) - map.get(counters, "below_ma", 0.0)
plot(net, "Net")
