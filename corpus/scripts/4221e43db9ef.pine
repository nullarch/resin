
//@version=5
indicator("4 Phase")
var int phase = 0
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
if phase == 0 and close > sma3
    phase := 1
else if phase == 1 and rsi > 65
    phase := 2
else if phase == 2 and close < sma3
    phase := 3
else if phase == 3 and rsi < 35
    phase := 0
plot(phase, "Ph")
