//@version=5
indicator("ModelBIC")
var float sseTrend = 0.0
var float sseFlat = 0.0
var int nObs = 0
nObs := nObs + 1
flatPred = nz(ta.sma(close, 5), close)
trendPred = nz(ta.ema(close, 3), close)
errFlat = close - flatPred
errTrend = close - trendPred
sseTrend := sseTrend + errTrend * errTrend
sseFlat := sseFlat + errFlat * errFlat
n = float(nObs)
kFlat = 1.0
kTrend = 2.0
bicFlat = n > 0 ? n * math.log(math.max(sseFlat / n, 0.0001)) + kFlat * math.log(n) : 0.0
bicTrend = n > 0 ? n * math.log(math.max(sseTrend / n, 0.0001)) + kTrend * math.log(n) : 0.0
deltaBIC = bicFlat - bicTrend
plot(deltaBIC, "dBIC")
