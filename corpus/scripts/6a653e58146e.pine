
//@version=5
strategy("Multi Exit", overlay=true)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
if close > sma3 and rsi > 50
    strategy.entry("Long", strategy.long)
tpHit = close > sma3 + atr * 3
slHit = close < sma3 - atr * 2
timeExit = rsi > 80
if tpHit or slHit or timeExit
    strategy.close("Long")
plot(sma3, "MA")
