//@version=5
strategy("Mega 17")
type Band
    float upper = 0.0
    float lower = 0.0
    float mid = 0.0
calcBand(float center, float width) =>
    Band.new(center + width, center - width, center)
var int regime = 0
float sma3 = nz(ta.sma(close, 3), close)
float atrVal = nz(ta.atr(3), 1.0)
float rsiVal = nz(ta.rsi(close, 5), 50.0)
band = calcBand(sma3, atrVal * 2.0)
breakouts = array.new<float>(0)
float threshold = atrVal * 0.5
int iter = 0
while threshold < atrVal * 3.0 and iter < 10
    float dist = close - band.mid
    if math.abs(dist) > threshold
        breakouts.push(threshold)
    threshold := threshold + atrVal * 0.25
    iter := iter + 1
float breakoutCount = breakouts.size()
switch
    breakoutCount > 3 =>
        regime := 2
    breakoutCount > 1 =>
        regime := 1
    =>
        regime := 0
if regime >= 2 and close > band.upper
    strategy.entry("BreakLong", strategy.long)
if close < band.lower
    strategy.close("BreakLong")
