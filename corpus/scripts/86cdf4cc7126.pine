
//@version=5
indicator("Higuchi")
var float sumDiff1 = 0.0
var float sumDiff2 = 0.0
var int bars = 0
d1 = math.abs(close - close[1])
d2 = not na(close[2]) ? math.abs(close - close[2]) : 0.0
if not na(d1)
    sumDiff1 := sumDiff1 + d1
    sumDiff2 := sumDiff2 + d2
    bars := bars + 1
fd = bars > 2 and sumDiff1 > 0 ? math.log(sumDiff2 / (sumDiff1 + 0.0001)) / math.log(2.0) : 1.0
plot(fd, "FD")
