
//@version=5
indicator("Ind Weights")
var iw = map.new<string, float>()
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
volHigh = atr > avgATR
map.put(iw, "trend_wt", volHigh ? 0.5 : 0.3)
map.put(iw, "mom_wt", volHigh ? 0.3 : 0.5)
map.put(iw, "vol_wt", 0.2)
trendWt = map.get(iw, "trend_wt", 0.33)
plot(trendWt, "TrendWt")
