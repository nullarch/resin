
//@version=5
strategy("Var Track Strat", overlay=true)
sma3 = ta.sma(close, 3)
var int entries = 0
var int exits = 0
if ta.crossover(close, sma3)
    strategy.entry("Long", strategy.long)
    entries := entries + 1
if ta.crossunder(close, sma3)
    strategy.close("Long")
    exits := exits + 1
plot(entries - exits, "Net")
