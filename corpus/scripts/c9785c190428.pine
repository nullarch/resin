
//@version=5
indicator("Alert Prio")
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
avgVol = ta.sma(volume, 5)
volSpike = avgVol > 0 and volume > avgVol * 2
priority = switch
    rsi > 80 and volSpike => "critical"
    rsi > 70 or rsi < 30 => "high"
    ta.crossover(close, sma3) => "medium"
    => "low"
isCritical = priority == "critical"
plot(isCritical ? 1 : 0, "C")
