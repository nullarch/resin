
//@version=5
indicator("Vol Score UDF")
volScore(float vol, float avgVol, bool priceUp) =>
    ratio = avgVol > 0 ? vol / avgVol : 1.0
    dirScore = priceUp ? 1.0 : -1.0
    ratio * dirScore

avgVol = ta.sma(volume, 5)
priceUp = close > close[1]
score = volScore(volume, avgVol, priceUp)
plot(score, "VS")
