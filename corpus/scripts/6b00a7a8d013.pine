//@version=5
indicator("State Machine")
var int state = 0
var float entryPrice = 0.0
rsi_ = ta.rsi(close, 5)
if state == 0
    if not na(rsi_) and rsi_ < 40
        state := 1
        entryPrice := close
if state == 1
    if close > entryPrice * 1.02
        state := 2
    if close < entryPrice * 0.98
        state := 0
plot(state)
