//@version=5
indicator("Comprehensive Dispatch")

// if expression
var float if_r = 0.0
if_r := if close > ta.sma(close, 5)
    1.0
else
    -1.0

// for expression
var float for_r = 0.0
float f_acc = 0.0
for_r := for i = 1 to 4
    f_acc := f_acc + float(i)
    f_acc

// while expression
var float while_r = 0.0
float wval = 16.0
while_r := while wval > 2.0
    wval := wval / 2.0
    wval

// switch expression
var float switch_r = 0.0
switch_r := switch
    close > 110 => 100.0
    close > 100 => 50.0
    => 0.0

// Combine with array
arr = array.new<float>(0)
array.push(arr, if_r)
array.push(arr, for_r)
array.push(arr, while_r)
array.push(arr, switch_r)

var float total = 0.0
total := array.sum(arr)
plot(total)
