
//@version=5
strategy("Triple MA", overlay=true)
fast = ta.sma(close, 3)
mid = ta.sma(close, 5)
slow = ta.sma(close, 8)
bullAlign = fast > mid and mid > slow
bearAlign = fast < mid and mid < slow
if bullAlign
    strategy.entry("Long", strategy.long)
if bearAlign
    strategy.close("Long")
plot(fast, "Fast")
