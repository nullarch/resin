//@version=5
strategy("NetStrat")
var int pos = 0
nodes = array.new_float(0)
array.push(nodes, close)
array.push(nodes, open)
array.push(nodes, high)
array.push(nodes, low)
thresh = 5.0
closeDeg = 0.0
for j = 1 to 3
    if math.abs(array.get(nodes, 0) - array.get(nodes, j)) < thresh
        closeDeg := closeDeg + 1.0
centrality = closeDeg / 3.0
rsiConf = nz(ta.rsi(close, 5), 50.0)
if centrality > 0.6 and rsiConf > 55.0 and pos == 0
    strategy.entry("NE", strategy.long)
    pos := 1
else if centrality < 0.3 and pos == 1
    strategy.close("NE")
    pos := 0
plot(centrality, "Cent")
