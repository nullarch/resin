
//@version=5
strategy("ComplexEntry")
var int state = 0
rsi = nz(ta.rsi(close, 5), 50.0)
smaVal = nz(ta.sma(close, 3), close)
if state == 0
    if close > smaVal and rsi < 70
        strategy.entry("L", strategy.long)
        state := 1
else if state == 1
    if close < smaVal
        strategy.close("L")
        state := 0
    else if rsi > 80
        strategy.close("L")
        state := 2
else
    if rsi < 50
        state := 0
plot(float(state), "S")
