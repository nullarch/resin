//@version=5
indicator("GenConverge")
var int gen = 0
var float prevBest = 0.0
gen := gen + 1
currentBest = nz(ta.highest(close, 5), close)
improvement = math.abs(currentBest - prevBest)
converged = improvement < 0.5 ? 1.0 : 0.0
prevBest := currentBest
plot(float(gen), "Gen")
plot(converged, "Conv")
