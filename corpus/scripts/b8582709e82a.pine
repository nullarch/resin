//@version=5
indicator("Walk Regression")
type Data
    float value = 0.0
d = Data.new(close)
myFunc(float x = close) =>
    y = x * 2
    y + 1
for i = 0 to 5
    d.value := d.value + myFunc(high)
switch
    close > open =>
        d.value := d.value + 1
    =>
        d.value := d.value - 1
arr = array.from(1.0, 2.0)
for [idx, val] in arr
    d.value := d.value + val
plot(d.value)
