
//@version=5
indicator("Multi Met")
var metrics = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
map.put(metrics, "trend", close > sma3 ? 1.0 : -1.0)
map.put(metrics, "mom", (rsi - 50) / 50)
map.put(metrics, "vol_adj", atr > 0 ? 1.0 / (1.0 + atr) : 0.5)
composite = 0.0
for [k, v] in metrics
    composite := composite + v
plot(composite, "Comp")
