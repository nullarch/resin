//@version=5
strategy("Mega Ultra 020", overlay=true)
type Engine
    float power = 0.0
    float heat = 0.0

method throttle(Engine this, float input_) =>
    this.power := this.power * 0.8 + input_ * 0.2
    this.heat := this.heat + math.abs(input_) * 0.1
    this

method cooldown(Engine this) =>
    this.heat := this.heat * 0.9
    this

efficiency(float power, float heat) =>
    heat > 0.01 ? power / heat : power > 0 ? 999.0 : 0.0

var Engine eng = Engine.new(0.0, 1.0)
var float[] effHistory = array.new_float(0)
var map<string, float> dashboard = map.new<string, float>()
var int cycles = 0

rsiVal = nz(ta.rsi(close, 5), 50.0)
atrVal = nz(ta.atr(3), 1.0)
emaVal = ta.ema(close, 3)
prevC = not na(close[1]) ? close[1] : close
impulse = close - prevC

eng.throttle(impulse)
eng.cooldown()
cycles := cycles + 1

eff = efficiency(eng.power, eng.heat)
array.push(effHistory, eff)
if array.size(effHistory) > 5
    array.shift(effHistory)

map.put(dashboard, "power", eng.power)
map.put(dashboard, "heat", eng.heat)
map.put(dashboard, "eff", eff)

avgEff = 0.0
for i = 0 to array.size(effHistory) - 1
    avgEff := avgEff + array.get(effHistory, i)
avgEff := array.size(effHistory) > 0 ? avgEff / array.size(effHistory) : 0.0

dashTotal = 0.0
for [key, val] in dashboard
    dashTotal := dashTotal + math.abs(val)

idx = 0
smoothEff = avgEff
while idx < 3
    smoothEff := smoothEff * 0.85
    idx := idx + 1

zone = switch
    smoothEff > 5.0 => "turbo"
    smoothEff > 1.0 => "normal"
    smoothEff > 0 => "idle"
    => "stall"

if zone == "turbo" or zone == "normal"
    if rsiVal < 65
        strategy.entry("Long", strategy.long)
    if eng.heat > 5.0
        strategy.close("Long")
else if zone == "stall"
    strategy.close("Long")

label = zone + " C" + str.tostring(cycles)
plot(math.round(smoothEff * 100) / 100)
