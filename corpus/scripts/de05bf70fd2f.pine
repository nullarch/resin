
//@version=5
indicator("Regime UDT")
type RegimeTracker
    int bullRegimeBars = 0
    int bearRegimeBars = 0
    int transitions = 0

var RegimeTracker rgt = RegimeTracker.new()
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
isBull = sma3 > sma5
if isBull
    rgt.bullRegimeBars := rgt.bullRegimeBars + 1
else
    rgt.bearRegimeBars := rgt.bearRegimeBars + 1
plot(rgt.bullRegimeBars - rgt.bearRegimeBars, "Net")
