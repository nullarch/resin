
//@version=5
indicator("Waterfall")
score = 5.0
sma3 = ta.sma(close, 3)
rsi = ta.rsi(close, 3)
if close < sma3
    score := score - 1.0
if rsi < 40
    score := score - 1.0
if rsi > 70
    score := score - 0.5
if ta.atr(3) > ta.sma(ta.atr(3), 5) * 2
    score := score - 1.0
if volume < ta.sma(volume, 5) * 0.5
    score := score - 0.5
plot(score, "Score")
