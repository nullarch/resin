//@version=5
strategy("Combo18")
enum Action
    Enter = 1
    Exit = 2
    Wait = 3
decide(score, threshold) =>
    score > threshold ? Action.Enter : score < -threshold ? Action.Exit : Action.Wait
var int posState = 0
factors = map.new<string, float>()
map.put(factors, "mom", close - nz(close[3], close))
map.put(factors, "rsi", nz(ta.rsi(close, 5), 50.0) - 50.0)
map.put(factors, "vol", volume > 1200 ? 1.0 : -1.0)
totalScore = 0.0
for [name, val] in factors
    totalScore := totalScore + val
action = decide(totalScore, 5.0)
switch action
    Action.Enter =>
        if posState == 0
            strategy.entry("ME", strategy.long)
            posState := 1
    Action.Exit =>
        if posState == 1
            strategy.close("ME")
            posState := 0
    =>
        na
plot(totalScore, "Score")
