
//@version=5
indicator("Ternary Switch")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
primary = rsi > 60 ? "BULL" : rsi < 40 ? "BEAR" : "NEUTRAL"
secondary = switch primary
    "BULL" => sma3 > sma5 ? 2.0 : 1.0
    "BEAR" => sma3 < sma5 ? -2.0 : -1.0
    => 0.0
weight = math.abs(secondary) > 1.5 ? 1.5 : 1.0
plot(secondary * weight, "S")
