
//@version=5
indicator("Map Cond Update")
var m = map.new<string, int>()
if close > open
    prev = map.get(m, "green", 0)
    map.put(m, "green", prev + 1)
else
    prev = map.get(m, "red", 0)
    map.put(m, "red", prev + 1)
green = map.get(m, "green", 0)
red = map.get(m, "red", 0)
ratio = green + red > 0 ? float(green) / float(green + red) : 0.5
plot(ratio, "Green Ratio")
