//@version=5
indicator("Combo13")
clamp(x, lo, hi) =>
    math.max(lo, math.min(hi, x))
var float adaptiveAlpha = 0.5
rsiVal = nz(ta.rsi(close, 5), 50.0)
atrVal = nz(ta.atr(3), 1.0)
levels = array.new_float(0)
idx = 0
while idx < 4
    level = close + atrVal * float(idx - 2)
    array.push(levels, level)
    idx := idx + 1
nearLevel = false
for i = 0 to 3
    lev = array.get(levels, i)
    if math.abs(close - lev) < atrVal * 0.5
        nearLevel := true
if nearLevel
    if rsiVal > 50.0
        adaptiveAlpha := clamp(adaptiveAlpha + 0.05, 0.1, 0.9)
    else
        adaptiveAlpha := clamp(adaptiveAlpha - 0.05, 0.1, 0.9)
plot(adaptiveAlpha, "Alpha")
plot(float(array.size(levels)), "Levels")
