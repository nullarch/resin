
//@version=5
indicator("Final Validation")
// All indicator types
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)
[macd, sig, hist] = ta.macd(close, 3, 5, 3)
k = ta.stoch(close, high, low, 5)

// Complex signal
tSig = close > sma3 ? 1.0 : -1.0
mSig = rsi > 55 ? 1.0 : rsi < 45 ? -1.0 : 0.0
hSig = hist > 0 ? 1.0 : -1.0
kSig = k > 50 ? 1.0 : -1.0
composite = (tSig + mSig + hSig + kSig) / 4.0

// Risk
var float peak = 0.0
var float maxDD = 0.0
if close > peak
    peak := close
dd = peak > 0 ? (peak - close) / peak : 0.0
if dd > maxDD
    maxDD := dd

// History
var float[] hist2 = array.new_float(0)
array.push(hist2, composite)
if array.size(hist2) > 8
    array.shift(hist2)
avgSig = array.avg(hist2)

// State
var state = map.new<string, float>()
map.put(state, "signal", composite)
map.put(state, "maxDD", maxDD * 100)

var int bars = 0
bars := bars + 1

plot(composite, "Signal")
plot(avgSig, "AvgSig")
plot(maxDD * 100, "DD%")
