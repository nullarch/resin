
//@version=5
indicator("5000th Test")
type FinalSystem
    float score = 0.0
    int bullBars = 0
    float peak = 0.0

var FinalSystem fs = FinalSystem.new()
var metrics = map.new<string, float>()
var float[] scoreHist = array.new_float(0)

sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema3 = ta.ema(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
stoch = ta.stoch(close, high, low, 5)
[macdL, sigL, histL] = ta.macd(close, 3, 5, 3)
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)

map.put(metrics, "trend", sma5 > 0 ? (sma3 - sma5) / sma5 * 100 : 0.0)
map.put(metrics, "momentum", (rsi - 50) / 50 * 30)
map.put(metrics, "volatility", avgATR > 0 ? atr / avgATR * 10 : 10.0)
map.put(metrics, "position", hi5 > lo5 ? (close - lo5) / (hi5 - lo5) * 10 - 5 : 0.0)
map.put(metrics, "macd_sig", histL > 0 ? 5.0 : -5.0)

composite = 0.0
for [k, v] in metrics
    composite := composite + v
composite := composite / 5

volAdj = avgATR > 0 and atr / avgATR > 1.5 ? 0.5 : 1.0
finalScore = composite * volAdj

array.push(scoreHist, finalScore)
if array.size(scoreHist) > 8
    array.shift(scoreHist)
avgScore = array.size(scoreHist) > 0 ? array.avg(scoreHist) : 0.0

fs.score := finalScore
fs.peak := math.max(fs.peak, finalScore)
if finalScore > 2
    fs.bullBars := fs.bullBars + 1

improving = finalScore > avgScore
trendLabel = fs.score > 0 ? "BULL" : "BEAR"
confidence = math.abs(fs.score) > 3 ? "HIGH" : "LOW"

plot(fs.score, "Score")
plot(fs.bullBars, "BB")
plot(improving ? 1 : 0, "Imp")
