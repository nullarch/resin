
//@version=5
indicator("Micro Full")
spread = high - low
avgSpread = ta.sma(spread, 5)
avgVol = ta.sma(volume, 5)

relSpread = avgSpread > 0 ? spread / avgSpread : 1.0
relVol = avgVol > 0 ? volume / avgVol : 1.0
efficiency = spread > 0 ? math.abs(close - open) / spread : 0.0
intensity = spread > 0 ? volume / spread : 0.0

var float[] effHist = array.new_float(0)
array.push(effHist, efficiency)
if array.size(effHist) > 6
    array.shift(effHist)

var micro = map.new<string, float>()
map.put(micro, "rel_spread", relSpread)
map.put(micro, "rel_vol", relVol)
map.put(micro, "efficiency", efficiency)

quality = (1.0 - math.min(relSpread, 2.0) / 2) * 0.4 + math.min(relVol, 2.0) / 2 * 0.3 + efficiency * 0.3

var int bars = 0
bars := bars + 1

plot(quality, "Qual")
plot(relVol, "RV")
