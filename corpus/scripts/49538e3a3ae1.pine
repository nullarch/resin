
//@version=5
indicator("Ret Dist")
var float[] rets = array.new_float(0)
ret = close[1] > 0 ? (close - close[1]) / close[1] * 100 : 0.0
array.push(rets, ret)
if array.size(rets) > 10
    array.shift(rets)
posRets = 0
for i = 0 to math.max(array.size(rets) - 1, 0)
    if i < array.size(rets) and array.get(rets, i) > 0
        posRets := posRets + 1
winRate = array.size(rets) > 0 ? float(posRets) / array.size(rets) * 100 : 50.0
plot(winRate, "WR")
