//@version=5
indicator("Acoustics-Geophysics")
// Geophysics: seismic energy from price shock
seismicEnergy = math.pow(high - low, 2) * 10
// Acoustics: wave attenuation with distance
attenuationCoeff = 0.1
var distances = array.new<float>(5, 0.0)
for i = 0 to 4
    dist = (i + 1) * 10.0
    attenuated = seismicEnergy * math.exp(-attenuationCoeff * dist)
    array.set(distances, i, attenuated)
var float nearField = 0.0
var float farField = 0.0
nearField := array.get(distances, 0)
farField := array.get(distances, 4)
