//@version=5
indicator("Ultra 009")
type Oscillator
    float pos = 0.0
    float vel = 0.0

method step(Oscillator this, float target) =>
    force = (target - this.pos) * 0.3
    this.vel := this.vel * 0.7 + force
    this.pos := this.pos + this.vel
    this

method energy(Oscillator this) =>
    0.5 * this.vel * this.vel

var Oscillator osc = Oscillator.new(100.0, 0.0)
var float[] energies = array.new_float(0)

target = not na(close[1]) ? (close + close[1]) / 2.0 : close
osc.step(target)

e = osc.energy()
array.push(energies, e)
if array.size(energies) > 5
    array.shift(energies)

idx = 0
maxE = 0.0
while idx < array.size(energies)
    val = array.get(energies, idx)
    maxE := math.max(maxE, val)
    idx := idx + 1

avgE = 0.0
for i = 0 to array.size(energies) - 1
    avgE := avgE + array.get(energies, i)
avgE := array.size(energies) > 0 ? avgE / array.size(energies) : 0.0

phase = switch
    osc.vel > 0.5 => 3
    osc.vel > 0 => 2
    osc.vel > -0.5 => 1
    => 0
plot(avgE)
