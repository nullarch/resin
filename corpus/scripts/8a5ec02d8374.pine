//@version=5
indicator("GraphDensity")
var float avgDensity = 0.0
var int cnt = 0
cnt := cnt + 1
n0 = close
n1 = open
n2 = high
n3 = low
thresh = 5.0
edges = 0.0
if math.abs(n0 - n1) < thresh
    edges := edges + 1.0
if math.abs(n0 - n2) < thresh
    edges := edges + 1.0
if math.abs(n0 - n3) < thresh
    edges := edges + 1.0
if math.abs(n1 - n2) < thresh
    edges := edges + 1.0
if math.abs(n1 - n3) < thresh
    edges := edges + 1.0
if math.abs(n2 - n3) < thresh
    edges := edges + 1.0
density = edges / 6.0
avgDensity := avgDensity + (density - avgDensity) / float(cnt)
plot(density, "Density")
plot(avgDensity, "AvgDens")
