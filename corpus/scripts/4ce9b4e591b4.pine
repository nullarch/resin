
//@version=5
indicator("Sig Type")
enum SigType
    StrongBuy = 2
    Buy = 1
    Neutral = 0
    Sell = -1
    StrongSell = -2

rsi = nz(ta.rsi(close, 3), 50.0)
sig = switch
    rsi > 70 => SigType.StrongBuy
    rsi > 55 => SigType.Buy
    rsi < 30 => SigType.StrongSell
    rsi < 45 => SigType.Sell
    => SigType.Neutral
plot(int(sig), "Sig")
