
//@version=5
indicator("Str Build")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
part1 = sma3 > sma5 ? "TREND_UP" : "TREND_DN"
part2 = rsi > 55 ? "_MOM_BULL" : rsi < 45 ? "_MOM_BEAR" : "_MOM_FLAT"
part3 = volume > ta.sma(volume, 5) ? "_VOL_HIGH" : "_VOL_LOW"
fullLabel = part1 + part2 + part3
isBestCase = fullLabel == "TREND_UP_MOM_BULL_VOL_HIGH"
plot(isBestCase ? 1 : 0, "BC")
