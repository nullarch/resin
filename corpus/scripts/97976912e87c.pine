
//@version=5
indicator("Arr Full")
var float[] data2 = array.new_float(0)
array.push(data2, close)
if array.size(data2) > 10
    array.shift(data2)
sz = array.size(data2)
avg = sz > 0 ? array.avg(data2) : close
maxV = sz > 0 ? array.max(data2) : close
minV = sz > 0 ? array.min(data2) : close
rng = maxV - minV
pos = rng > 0 ? (close - minV) / rng * 100 : 50.0
aboveAvg = 0
for i = 0 to math.max(sz - 1, 0)
    if i < sz and array.get(data2, i) > avg
        aboveAvg := aboveAvg + 1
plot(pos, "Pos")
