
//@version=5
indicator("If with For")
sma3 = ta.sma(close, 3)
lookbackSum = 0.0
if close > sma3
    for i = 0 to 2
        val = high[i]
        if not na(val)
            lookbackSum := lookbackSum + val
else
    for i = 0 to 2
        val = low[i]
        if not na(val)
            lookbackSum := lookbackSum + val
plot(lookbackSum, "Sum")
