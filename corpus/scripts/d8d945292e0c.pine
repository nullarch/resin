
//@version=5
indicator("Sig Strength")
type Signal
    float value = 0.0
    float confidence = 0.0
    int age = 0

var Signal sig = Signal.new()
rsi = ta.rsi(close, 3)
sma3 = ta.sma(close, 3)
newVal = close > sma3 ? 1.0 : -1.0
if newVal == sig.value
    sig.age := sig.age + 1
    sig.confidence := math.min(1.0, sig.confidence + 0.1)
else
    sig.value := newVal
    sig.age := 1
    sig.confidence := 0.3
plot(sig.confidence, "Conf")
