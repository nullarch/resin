//@version=5
indicator("EntRegime12")
enum EntLevel
    LOW
    MEDIUM
    HIGH
var float upR = 0.5
var float n = 0.0
n := n + 1.0
upR := close > open ? (upR * (n - 1.0) + 1.0) / n : (upR * (n - 1.0)) / n
downR = 1.0 - upR
ent = 0.0
if upR > 0.01 and downR > 0.01
    ent := -(upR * math.log(upR) + downR * math.log(downR))
regime = switch
    ent < 0.3 => EntLevel.LOW
    ent > 0.6 => EntLevel.HIGH
    => EntLevel.MEDIUM
plot(ent, "ent")
