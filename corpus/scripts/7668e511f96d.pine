//@version=5
indicator("OptionPnL")
var float cumPnl = 0.0
var float entryPrice = 0.0
var bool inPosition = false
strike = 105.0
if not inPosition and close < strike
    entryPrice := strike - close
    inPosition := true
else if inPosition
    currentVal = math.max(strike - close, 0.0)
    cumPnl := cumPnl + (currentVal - entryPrice)
    entryPrice := currentVal
plot(cumPnl, "PnL")
