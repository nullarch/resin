
//@version=5
strategy("Spread Trade", overlay=true)
fast = ta.ema(close, 3)
slow = ta.sma(close, 5)
spread = fast - slow
spreadMA = ta.sma(spread, 3)
spreadSD = ta.stdev(spread, 5)
z = spreadSD > 0 ? (spread - spreadMA) / spreadSD : 0.0
if z < -1.5
    strategy.entry("Long", strategy.long)
if z > 0.5
    strategy.close("Long")
plot(fast, "Fast")
