
//@version=5
indicator("RSI Hist")
var float[] rsiHist = array.new_float(0)
rsi = nz(ta.rsi(close, 3), 50.0)
array.push(rsiHist, rsi)
if array.size(rsiHist) > 8
    array.shift(rsiHist)
avgRSI = array.size(rsiHist) > 0 ? array.avg(rsiHist) : 50.0
risingRSI = rsi > avgRSI
plot(risingRSI ? 1 : 0, "R")
