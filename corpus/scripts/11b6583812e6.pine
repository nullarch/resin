//@version=5
indicator("DG-04 Radius")
var float radius = 0.0
if not na(close[2])
    dp1 = close - close[1]
    dp0 = close[1] - close[2]
    d2p = dp1 - dp0
    denom = math.pow(1.0 + dp1 * dp1, 1.5)
    kappa = denom > 0.001 ? math.abs(d2p) / denom : 0.0
    radius := kappa > 0.0001 ? 1.0 / kappa : 10000.0
plot(radius)
