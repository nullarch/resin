
//@version=5
indicator("Nested Switch")
rsiVal = ta.rsi(close, 3)
var int action = 0
if close > ta.sma(close, 3)
    action := switch
        rsiVal > 70 => 3
        rsiVal > 50 => 2
        => 1
else
    action := switch
        rsiVal < 30 => -3
        rsiVal < 50 => -2
        => -1
plot(action, "Action")
