
//@version=5
indicator("Flow Map FI")
var fm = map.new<string, float>()
totalRange = high - low
map.put(fm, "buy_press", totalRange > 0 ? (close - low) / totalRange : 0.5)
map.put(fm, "sell_press", totalRange > 0 ? (high - close) / totalRange : 0.5)
map.put(fm, "vol_weight", volume > ta.sma(volume, 5) ? 1.5 : 1.0)
total = 0.0
for [k, v] in fm
    total := total + v
plot(total, "T")
