
//@version=5
indicator("Algo Type E")
enum AlgoType
    TrendFollow = 2
    MeanRevert = 1
    Breakout = 0
    Scalp = -1

sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
volHigh = avgATR > 0 and atr > avgATR * 1.3
at = switch
    sma3 > sma5 and not volHigh => AlgoType.TrendFollow
    volHigh => AlgoType.MeanRevert
    math.abs(sma3 - sma5) < 0.5 => AlgoType.Scalp
    => AlgoType.Breakout
plot(int(at), "AT")
