
//@version=5
indicator("Asset Met")
var am = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
map.put(am, "return", close > 0 ? (close - close[1]) / close * 100 : 0.0)
map.put(am, "volatility", close > 0 ? atr / close * 100 : 0.0)
map.put(am, "momentum", rsi)
ret = map.get(am, "return", 0.0)
vol = map.get(am, "volatility", 0.0)
sharpeProxy = vol > 0 ? ret / vol : 0.0
plot(sharpeProxy, "Sharpe")
