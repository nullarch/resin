
//@version=5
indicator("Config")
var cfg = map.new<string, float>()
map.put(cfg, "rsi_period", 3.0)
map.put(cfg, "sma_period", 5.0)
map.put(cfg, "risk_pct", 2.0)
map.put(cfg, "max_dd", 10.0)
riskPct = map.get(cfg, "risk_pct", 1.0)
maxDD = map.get(cfg, "max_dd", 5.0)
plot(riskPct, "Risk%")
plot(maxDD, "MaxDD")
