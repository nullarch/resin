//@version=5
indicator("Topo Features")
var float[] features = array.new_float(0)
float smaVal = ta.sma(close, 3)
float dev = math.abs(close - smaVal)
if array.size(features) < 5
    array.push(features, dev)
float feat0 = array.size(features) > 0 ? array.get(features, 0) : 0.0
plot(feat0, "Feat0")
