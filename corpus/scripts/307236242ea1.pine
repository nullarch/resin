
//@version=5
indicator("Thresh Alerts")
var thresholds = map.new<string, float>()
map.put(thresholds, "rsi_high", 70.0)
map.put(thresholds, "rsi_low", 30.0)
map.put(thresholds, "atr_mult", 1.5)
rsi = ta.rsi(close, 3)
rsiHigh = map.get(thresholds, "rsi_high", 70.0)
rsiLow = map.get(thresholds, "rsi_low", 30.0)
alert = rsi > rsiHigh or rsi < rsiLow
plot(alert ? 1 : 0, "Alert")
