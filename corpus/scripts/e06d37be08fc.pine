//@version=5
indicator("AllFeat 006")
enum Trend
    Bull
    Bear
    Side
type BarInfo
    float mid
    int trend
getMid(h, l) =>
    (h + l) / 2.0
var mids = array.new_float(0)
var int trendCount = 0
midVal = getMid(high, low)
array.push(mids, midVal)
trendDir = switch
    close > open + 2 => 1
    close < open - 2 => -1
    => 0
trendCount := trendDir != 0 ? trendCount + 1 : trendCount
label = trendDir == 1 ? "up" : trendDir == -1 ? "down" : "side"
