
//@version=5
indicator("Vol Full")
sma5 = ta.sma(close, 5)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)

volRatio = avgATR > 0 ? atr / avgATR : 1.0
upper = sma5 + atr * 1.5
lower = sma5 - atr * 1.5
bandPos = upper > lower ? (close - lower) / (upper - lower) * 100 : 50.0

rsi = nz(ta.rsi(close, 3), 50.0)
weight = volRatio > 1.3 ? 0.5 : 1.0
signal = (rsi - 50) / 50 * weight

var int highVolBars = 0
if volRatio > 1.3
    highVolBars := highVolBars + 1

plot(bandPos, "BP")
plot(highVolBars, "HVB")
