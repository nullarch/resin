//@version=5
indicator("DepDashboard")
var int concord = 0
var int discord = 0
var float jointAbove = 0.0
var float margAbove = 0.0
var int nBars = 0
nBars := nBars + 1
dC = close - nz(close[1], close)
dV = volume - nz(volume[1], volume)
prod = dC * dV
if prod > 0
    concord := concord + 1
else if prod < 0
    discord := discord + 1
totalPairs = concord + discord
tau = totalPairs > 0 ? float(concord - discord) / float(totalPairs) : 0.0
smaC = nz(ta.sma(close, 3), close)
cAbove = close > smaC
if cAbove
    margAbove := margAbove + 1.0
if cAbove and volume > nz(ta.sma(volume, 3), volume)
    jointAbove := jointAbove + 1.0
tailDep = margAbove > 0 ? jointAbove / margAbove : 0.0
plot(tau, "Tau")
plot(tailDep, "TailDep")
