//@version=5
indicator("Astro Comprehensive")
var float cumEnergy = 0.0
var float cumMag = 0.0
var float cumEcc = 0.0
var int cnt = 0
cnt := cnt + 1

// Kepler orbital speed proxy
semiMajor = (high + low) / 2.0
orbSpeed = semiMajor > 0 ? math.sqrt(1.0 / (semiMajor / 100.0)) : 0.0

// Gravitational energy
mass = volume / 100.0
radius = high - low
gEnergy = radius > 0 ? -mass / radius : 0.0
cumEnergy := cumEnergy + gEnergy

// Apparent magnitude
brightness = volume / 1000.0
mag = brightness > 0.01 ? -2.5 * math.log10(brightness) : 10.0
cumMag := cumMag + mag

// Eccentricity
sumAP = high + low
ecc = sumAP > 0 ? (high - low) / sumAP : 0.0
cumEcc := cumEcc + ecc

avgEnergy = cnt > 0 ? cumEnergy / cnt : 0.0
avgMag = cnt > 0 ? cumMag / cnt : 0.0
avgEcc = cnt > 0 ? cumEcc / cnt : 0.0

astroScore = avgEnergy * 10.0 + avgMag + avgEcc * 100.0
