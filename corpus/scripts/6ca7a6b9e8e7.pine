
//@version=5
indicator("ZScore")
var float[] prices = array.new_float(0)
array.push(prices, close)
if array.size(prices) > 5
    array.shift(prices)
mean = array.avg(prices)
variance = 0.0
for [i, p] in prices
    variance := variance + math.pow(p - mean, 2)
sz = array.size(prices)
stdDev = sz > 1 ? math.sqrt(variance / float(sz - 1)) : 1.0
zScore = stdDev > 0.0001 ? (close - mean) / stdDev : 0.0
plot(zScore, "Z")
