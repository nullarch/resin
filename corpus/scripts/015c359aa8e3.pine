
//@version=5
indicator("WeightFwd")
weights = array.new_float(0)
array.push(weights, 0.3)
array.push(weights, -0.2)
array.push(weights, 0.5)
inputs = array.new_float(0)
array.push(inputs, (close - 100.0) / 10.0)
array.push(inputs, (high - low) / 10.0)
array.push(inputs, (volume - 1000.0) / 500.0)
dotProduct = 0.0
for i = 0 to 2
    dotProduct := dotProduct + array.get(weights, i) * array.get(inputs, i)
out = math.max(dotProduct, 0.0)
plot(out, "FwdPass")
