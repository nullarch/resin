
//@version=5
indicator("Micro Met")
var mm = map.new<string, float>()
spread = high - low
map.put(mm, "spread", spread)
map.put(mm, "rel_spread", close > 0 ? spread / close * 100 : 0.0)
map.put(mm, "volume_intensity", spread > 0 ? volume / spread : 0.0)
map.put(mm, "price_impact", volume > 0 ? spread / volume * 1000 : 0.0)
relSp = map.get(mm, "rel_spread", 0.0)
plot(relSp, "RelSp")
