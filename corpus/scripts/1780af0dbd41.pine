//@version=5
indicator("Table dashboard")
var t = table.new(position.top_right, 3, 2)
sma5 = ta.sma(close, 5)
rsi5 = ta.rsi(close, 5)
table.cell(t, 0, 0, "SMA")
table.cell(t, 1, 0, str.tostring(nz(sma5), "#.##"))
table.cell(t, 0, 1, "RSI")
table.cell(t, 1, 1, str.tostring(nz(rsi5), "#.##"))
table.cell(t, 0, 2, "Price")
table.cell(t, 1, 2, str.tostring(close, "#.##"))
