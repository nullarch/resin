
//@version=5
indicator("Pat Data")
var pd = map.new<string, float>()
bodySize = math.abs(close - open_)
fullRange = high - low
map.put(pd, "body", bodySize)
map.put(pd, "range", fullRange)
map.put(pd, "ratio", fullRange > 0 ? bodySize / fullRange : 0.0)
bodyRatio = map.get(pd, "ratio", 0.0)
plot(bodyRatio, "BR")
