
//@version=5
strategy("Full Strategy", overlay=true)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)
longCond = ta.crossover(sma3, sma5) and rsi > 40
shortCond = ta.crossunder(sma3, sma5) and rsi < 60
if longCond
    strategy.entry("Long", strategy.long)
    strategy.exit("LX", "Long", profit=10, loss=5)
if shortCond
    strategy.close("Long")
plot(sma3, "Fast")
plot(sma5, "Slow")
