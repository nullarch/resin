//@version=5
strategy("EmaBbVarSwitch")
var int posState = 0
emaVal = nz(ta.ema(close, 3), close)
bbMiddle = nz(ta.sma(close, 5), close)
bbDev = nz(ta.stdev(close, 5), 1.0)
bbUpper = bbMiddle + 2.0 * bbDev
bbLower = bbMiddle - 2.0 * bbDev
signal = switch
    close < bbLower => 1
    close > bbUpper => -1
    => 0
if signal == 1 and posState == 0
    strategy.entry("L", strategy.long)
    posState := 1
else if signal == -1 and posState == 1
    strategy.close("L")
    posState := 0
plot(float(posState), "P")
