
//@version=5
indicator("RiskDash")
var float equity = 100.0
var float peak = 100.0
var float maxDD = 0.0
var float sumRet = 0.0
var float sumRetSq = 0.0
var int wins = 0
var int total = 0
ret = close - open
pnl = ret > 0 ? 1.0 : -0.5
equity := equity + pnl
peak := equity > peak ? equity : peak
dd = peak - equity
maxDD := dd > maxDD ? dd : maxDD
sumRet := sumRet + ret
sumRetSq := sumRetSq + ret * ret
total := total + 1
wins := ret > 0 ? wins + 1 : wins
meanRet = total > 0 ? sumRet / total : 0.0
variance = total > 1 ? (sumRetSq / total - meanRet * meanRet) : 1.0
stddev = math.sqrt(math.abs(variance))
sharpe = stddev > 0.001 ? meanRet / stddev : 0.0
winRate = total > 0 ? wins / total * 100.0 : 0.0
composite = sharpe + winRate - maxDD
plot(composite, "Comp")
