//@version=5
indicator("Quantum Annealing")
var int barNum = 0
barNum := barNum + 1
float initTemp = 100.0
float decayFactor = 0.8
float temperature = initTemp * math.pow(decayFactor, barNum)
float energy = math.abs(close - 106.0)
float acceptProb = temperature > 0.01 ? math.exp(-energy / temperature) : 0.0
var float bestEnergy = 999.0
bestEnergy := energy < bestEnergy ? energy : bestEnergy
