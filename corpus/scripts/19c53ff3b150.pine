
//@version=5
indicator("Ind State")
type IndState
    float sma = 0.0
    float rsi = 0.0
    float atr = 0.0
    bool bullish = false

var IndState state = IndState.new()
state.sma := ta.sma(close, 3)
state.rsi := ta.rsi(close, 3)
state.atr := ta.atr(3)
state.bullish := close > state.sma and state.rsi > 50
plot(state.bullish ? 1 : 0, "Bull")
