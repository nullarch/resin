//@version=5
indicator("RSI Divergence")
rsi = ta.rsi(close, 5)
priceHigh = ta.highest(close, 5)
rsiHigh = ta.highest(rsi, 5)
priceLow = ta.lowest(close, 5)
rsiLow = ta.lowest(rsi, 5)
bearDiv = close == priceHigh and rsi < rsiHigh
bullDiv = close == priceLow and rsi > rsiLow
plot(bearDiv ? -1.0 : bullDiv ? 1.0 : 0.0)
