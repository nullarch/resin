//@version=5
indicator("Comprehensive 58")

// Barstate
var bool saw_first = false
var bool saw_last = false
if barstate.isfirst
    saw_first := true
if barstate.islast
    saw_last := true

// Map
var m = map.new<string, float>()
map.put(m, "count", 0.0)
map.put(m, "count", map.get(m, "count") + 1.0)

// TA with precision
sma5 = ta.sma(close, 5)

// Derived series
var float last_hl2 = 0.0
last_hl2 := hl2

// for accumulation
float loop_sum = 0.0
for i = 1 to 3
    loop_sum := loop_sum + i

// var counter
var float cnt = 0.0
cnt := cnt + 1.0

var float result = 0.0
result := cnt + loop_sum + last_hl2 + nz(sma5, 0.0) + map.get(m, "count")
plot(close)
