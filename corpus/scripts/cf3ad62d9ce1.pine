
//@version=5
indicator("UDF Tern")
classify(float rsi, float k, float cci) =>
    bullCount = (rsi > 50 ? 1 : 0) + (k > 50 ? 1 : 0) + (cci > 0 ? 1 : 0)
    bullCount >= 2 ? 1.0 : bullCount <= 0 ? -1.0 : 0.0

rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
cci = nz(ta.cci(close, 5), 0.0)
result = classify(rsi, k, cci)
plot(result, "Cls")
