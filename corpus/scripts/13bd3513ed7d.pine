//@version=5
strategy("Mega 2")
type TradeSetup
    float entry = 0.0
    float stopLoss = 0.0
    float takeProfit = 0.0
var int tradeCount = 0
float sma3 = nz(ta.sma(close, 3), close)
float atrVal = nz(ta.atr(3), 1.0)
float rsiVal = nz(ta.rsi(close, 5), 50.0)
setup = TradeSetup.new(close, close - atrVal * 2.0, close + atrVal * 3.0)
levels = array.new<float>(0)
float level = setup.stopLoss
int safety = 0
while level < setup.takeProfit and safety < 20
    levels.push(level)
    level := level + atrVal * 0.5
    safety := safety + 1
bool bullish = rsiVal > 50.0 and close > sma3
if bullish
    strategy.entry("Long", strategy.long)
    tradeCount := tradeCount + 1
if rsiVal < 30.0
    strategy.close("Long")
float riskReward = atrVal > 0.01 ? (setup.takeProfit - setup.entry) / (setup.entry - setup.stopLoss + 0.01) : 0.0
