
//@version=5
indicator("Vol Prof")
totalVol = 0.0
upVol = 0.0
for i = 0 to 4
    v = volume[i]
    c = close[i]
    o = open[i]
    if not na(v) and not na(c) and not na(o)
        totalVol := totalVol + v
        if c > o
            upVol := upVol + v
upRatio = totalVol > 0 ? upVol / totalVol : 0.5
plot(upRatio, "UpR")
