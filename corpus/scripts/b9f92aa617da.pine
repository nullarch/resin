//@version=5
indicator("Ultra 007")
type Meter
    float reading = 0.0
    float peak = 0.0

method update(Meter this, float val) =>
    this.reading := val
    if val > this.peak
        this.peak := val
    this

var Meter gauge = Meter.new(0.0, 0.0)
var map<string, float> thresholds = map.new<string, float>()

if barstate.isfirst
    map.put(thresholds, "warn", 3.0)
    map.put(thresholds, "critical", 6.0)
    map.put(thresholds, "safe", 1.0)

atrVal = nz(ta.atr(3), 1.0)
prevC = not na(close[1]) ? close[1] : close
delta = math.abs(close - prevC)
gauge.update(delta)

alertLevel = 0
warnThresh = nz(map.get(thresholds, "warn"), 3.0)
critThresh = nz(map.get(thresholds, "critical"), 6.0)

if gauge.reading > critThresh
    alertLevel := 3
    if gauge.peak > critThresh * 2
        alertLevel := 4
else if gauge.reading > warnThresh
    alertLevel := 2
else
    alertLevel := 1

total = 0.0
for i = 1 to alertLevel
    total := total + i * 1.0
plot(total)
