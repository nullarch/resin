
//@version=5
indicator("MA Data")
var md = map.new<string, float>()
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema3 = ta.ema(close, 3)
map.put(md, "sma3", sma3)
map.put(md, "sma5", sma5)
map.put(md, "ema3", ema3)
map.put(md, "spread", sma3 - sma5)
spread = map.get(md, "spread", 0.0)
plot(spread, "Sp")
