
//@version=5
strategy("Filter Strat", overlay=true)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
lowVol = atr < avgATR * 1.5
if close > sma3 and rsi > 50 and lowVol
    strategy.entry("Long", strategy.long)
if close < sma3 or rsi < 35
    strategy.close("Long")
plot(sma3, "MA")
