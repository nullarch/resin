
//@version=5
indicator("Enum Multi")
enum Zone
    Overbought = 1
    Neutral = 0
    Oversold = -1

rsiVal = ta.rsi(close, 3)
zone = rsiVal > 70 ? Zone.Overbought : rsiVal < 30 ? Zone.Oversold : Zone.Neutral

color_ = switch zone
    Zone.Overbought => color.red
    Zone.Oversold => color.green
    => color.gray

weight = switch zone
    Zone.Overbought => 0.5
    Zone.Oversold => 1.5
    => 1.0

plot(close * weight, "Weighted", color=color_)
