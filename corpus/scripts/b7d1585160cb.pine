//@version=5
strategy("Ultra 016", overlay=true)
type Position
    float entryPrice = 0.0
    int bars = 0

method age(Position this) =>
    this.bars

calcRisk(float entry, float current, float atr) =>
    atr > 0 ? math.abs(current - entry) / atr : 0.0

var Position pos = Position.new(0.0, 0)
var float[] risks = array.new_float(0)
var bool inTrade = false

atrVal = nz(ta.atr(3), 1.0)
emaVal = ta.ema(close, 3)
signal = not na(emaVal) ? close - emaVal : 0.0

if not inTrade and signal > atrVal * 0.5
    pos := Position.new(close, 0)
    inTrade := true
    strategy.entry("Long", strategy.long)

if inTrade
    pos.bars := pos.bars + 1
    risk = calcRisk(pos.entryPrice, close, atrVal)
    array.push(risks, risk)
    if array.size(risks) > 5
        array.shift(risks)

    idx = 0
    maxRisk = 0.0
    while idx < array.size(risks)
        maxRisk := math.max(maxRisk, array.get(risks, idx))
        idx := idx + 1

    exitReason = switch
        maxRisk > 2.0 => "stop"
        pos.age() > 5 => "time"
        signal < -atrVal => "reversal"
        => "hold"

    if exitReason != "hold"
        strategy.close("Long")
        inTrade := false

plot(pos.bars * 1.0)
