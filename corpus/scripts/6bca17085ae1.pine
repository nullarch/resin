
//@version=5
indicator("Quantiles")
var quantiles = map.new<string, float>()
var float[] window = array.new_float(0)
array.push(window, close)
if array.size(window) > 5
    array.shift(window)
sorted = array.copy(window)
array.sort(sorted, order.ascending)
sz = array.size(sorted)
q25Idx = math.max(0, math.floor(float(sz) * 0.25))
q50Idx = math.max(0, math.floor(float(sz) * 0.5))
q75Idx = math.min(sz - 1, math.floor(float(sz) * 0.75))
map.put(quantiles, "q25", array.get(sorted, int(q25Idx)))
map.put(quantiles, "q50", array.get(sorted, int(q50Idx)))
map.put(quantiles, "q75", array.get(sorted, int(q75Idx)))
iqr = map.get(quantiles, "q75", 0.0) - map.get(quantiles, "q25", 0.0)
plot(iqr, "IQR")
