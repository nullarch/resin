
//@version=5
indicator("AssetClass")
enum AssetType
    Equity = 1
    FixedIncome = 2
    Commodity = 3

rsi = nz(ta.rsi(close, 3), 50.0)
aType = rsi > 60 ? AssetType.Equity : rsi < 40 ? AssetType.Commodity : AssetType.FixedIncome
riskMult = int(aType) == 1 ? 1.5 : int(aType) == 3 ? 1.2 : 0.8
atrVal = nz(ta.atr(3), 1.0)
adjRisk = atrVal * riskMult
plot(adjRisk, "AR")
