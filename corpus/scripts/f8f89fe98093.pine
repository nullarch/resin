
//@version=5
indicator("Long Trend")
var int trendLen = 0
var int maxTrendLen = 0
var bool prevUp = false
isUp = close > ta.sma(close, 3)
if isUp == prevUp
    trendLen := trendLen + 1
else
    if trendLen > maxTrendLen
        maxTrendLen := trendLen
    trendLen := 1
prevUp := isUp
plot(trendLen, "Len")
plot(maxTrendLen, "Max")
