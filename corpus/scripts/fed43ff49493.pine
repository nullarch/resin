
//@version=5
indicator("Map Full")
var dashboard = map.new<string, float>()
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
map.put(dashboard, "trend_score", sma5 > 0 ? (sma3 - sma5) / sma5 * 100 : 0.0)
map.put(dashboard, "mom_score", (rsi - 50) / 50 * 30)
map.put(dashboard, "vol_score", atr * 10)
map.put(dashboard, "price_score", sma3 > 0 ? (close - sma3) / sma3 * 100 : 0.0)
total = 0.0
count = 0
for [k, v] in dashboard
    total := total + v
    count := count + 1
avg = count > 0 ? total / count : 0.0
plot(avg, "A")
