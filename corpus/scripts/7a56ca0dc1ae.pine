
//@version=5
indicator("Mom Class")
classifyMom(float rsiVal, float macdHist) =>
    rsiScore = rsiVal > 60 ? 1.0 : rsiVal < 40 ? -1.0 : 0.0
    macdScore = macdHist > 0 ? 1.0 : -1.0
    (rsiScore + macdScore) / 2.0

rsi = nz(ta.rsi(close, 3), 50.0)
[m, s, h] = ta.macd(close, 3, 5, 3)
momClass = classifyMom(rsi, h)
plot(momClass, "MomClass")
