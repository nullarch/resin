
//@version=5
indicator("All DS")
type Signal
    string name = ""
    float value = 0.0
    int weight = 1

var sig = Signal.new("composite", 0.0, 1)
var float[] history = array.new_float(0)
var metrics = map.new<string, float>()

rsi = nz(ta.rsi(close, 3), 50.0)
array.push(history, rsi)
if array.size(history) > 6
    array.shift(history)
map.put(metrics, "avg_rsi", array.avg(history))
map.put(metrics, "cur_rsi", rsi)
sig.value := map.get(metrics, "avg_rsi", 50.0)
sig.weight := rsi > 60 ? 2 : 1
plot(sig.value, "Val")
