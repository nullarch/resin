
//@version=5
indicator("Osc Full")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)

rangeOsc = hi5 > lo5 ? (close - lo5) / (hi5 - lo5) * 100 - 50 : 0.0
momOsc = (rsi - 50) * (sma3 > sma5 ? 1.2 : 0.8)
composite = rangeOsc * 0.4 + momOsc * 0.6

var int bullBars = 0
if composite > 10
    bullBars := bullBars + 1

plot(composite, "C")
plot(bullBars, "BB")
