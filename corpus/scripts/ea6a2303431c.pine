
//@version=5
indicator("Candle UDT")
type CandleTracker
    int bullBars = 0
    int bearBars = 0
    float maxBody = 0.0

var CandleTracker ct = CandleTracker.new()
body = math.abs(close - open)
ct.maxBody := math.max(ct.maxBody, body)
if close > open
    ct.bullBars := ct.bullBars + 1
else
    ct.bearBars := ct.bearBars + 1
plot(ct.bullBars - ct.bearBars, "Net")
