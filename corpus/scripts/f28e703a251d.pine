//@version=5
indicator("Cycle 128 Final", overlay=true)
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rma5 = ta.rma(close, 5)
wma5 = ta.wma(close, 5)
rsi5 = ta.rsi(close, 5)
atr3 = ta.atr(3)
[diP, diM, adx] = ta.dmi(5, 5)
[macdL, sigL, hist] = ta.macd(close, 3, 5, 3)
[bbU, bbM, bbL] = ta.bb(close, 5, 2.0)
chg = ta.change(close)
isRising = ta.rising(close, 3)
var prices = array.new_float(0)
var m = map.new<string, float>()
var int barCount = 0
var float maxADX = 0.0
array.push(prices, close)
if array.size(prices) > 5
    array.shift(prices)
if not na(adx) and nz(adx) > maxADX
    maxADX := nz(adx)
score = 0
if not na(sma3) and close > nz(sma3)
    score := score + 1
if not na(rsi5) and nz(rsi5) > 50
    score := score + 1
if isRising
    score := score + 1
if not na(hist) and nz(hist) > 0
    score := score + 1
zone = switch
    score >= 3 => "strong_bull"
    score >= 2 => "bull"
    score <= 0 => "bear"
    => "neutral"
map.put(m, "score", float(score))
map.put(m, "zone", zone == "strong_bull" ? 3.0 : zone == "bull" ? 2.0 : zone == "bear" ? -1.0 : 0.0)
clr = score >= 3 ? color.green : score >= 2 ? color.lime : score <= 0 ? color.red : color.gray
plot(sma3, "SMA", color=clr)
plot(ema5, "EMA")
barCount := barCount + 1
