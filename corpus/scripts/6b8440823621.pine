
//@version=5
indicator("Cross Ind")
var xState = map.new<string, float>()
sma3 = ta.sma(close, 3)
rsi = ta.rsi(close, 3)
map.put(xState, "price_vs_ma", close > sma3 ? 1.0 : -1.0)
map.put(xState, "rsi_zone", rsi > 60 ? 1.0 : rsi < 40 ? -1.0 : 0.0)
map.put(xState, "vol_state", close > open ? 1.0 : -1.0)
agreement = map.get(xState, "price_vs_ma", 0.0) + map.get(xState, "rsi_zone", 0.0) + map.get(xState, "vol_state", 0.0)
plot(agreement, "Agreement")
