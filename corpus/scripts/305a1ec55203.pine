
//@version=5
indicator("Full Suite")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema3 = ta.ema(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
[bbMid, bbUp, bbLo] = ta.bb(close, 5, 2.0)
k = nz(ta.stoch(close, high, low, 3), 50.0)
score = (close > sma3 ? 1 : -1) + (sma3 > sma5 ? 1 : -1) + (rsi > 50 ? 1 : -1)
plot(score, "S")
