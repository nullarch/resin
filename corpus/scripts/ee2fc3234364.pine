
//@version=5
indicator("MTF Proxy")
var mtf = map.new<string, float>()
map.put(mtf, "fast_rsi", ta.rsi(close, 3))
map.put(mtf, "slow_rsi", ta.rsi(close, 5))
map.put(mtf, "fast_ma", ta.sma(close, 3))
map.put(mtf, "slow_ma", ta.sma(close, 5))
fastRSI = map.get(mtf, "fast_rsi", 50.0)
slowRSI = map.get(mtf, "slow_rsi", 50.0)
aligned = fastRSI > 50 and slowRSI > 50
plot(aligned ? 1 : 0, "Aligned")
