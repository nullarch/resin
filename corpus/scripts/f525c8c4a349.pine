
//@version=5
indicator("Regime")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
atr = ta.atr(3)
smaATR = ta.sma(atr, 5)
trendUp = sma3 > sma5
volHigh = atr > smaATR
regime = switch
    trendUp and volHigh => "trending_volatile"
    trendUp and not volHigh => "trending_quiet"
    not trendUp and volHigh => "ranging_volatile"
    => "ranging_quiet"
isTrending = regime == "trending_volatile" or regime == "trending_quiet"
plot(isTrending ? 1 : 0, "Trending")
