
//@version=5
indicator("Cond Chain")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)
c1 = close > sma3
c2 = sma3 > sma5
c3 = rsi > 40 and rsi < 70
c4 = atr > 0
strongBuy = c1 and c2 and c3 and c4
weakBuy = (c1 or c2) and (c3 or c4)
plot(strongBuy ? 2 : weakBuy ? 1 : 0, "Signal")
