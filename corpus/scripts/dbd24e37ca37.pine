
//@version=5
indicator("Reg LB")
sma3 = ta.sma(close, 3)
bullBars = 0
bearBars = 0
for i = 0 to 4
    c = close[i]
    m = sma3[i]
    if not na(c) and not na(m)
        if c > m
            bullBars := bullBars + 1
        else
            bearBars := bearBars + 1
dominance = bullBars - bearBars
plot(dominance, "Dom")
