
//@version=5
indicator("Port Weights")
var w = map.new<string, float>()
rsi = ta.rsi(close, 3)
rsiVal = nz(rsi, 50.0)
if rsiVal > 60
    map.put(w, "equity", 0.7)
    map.put(w, "bond", 0.3)
else if rsiVal < 40
    map.put(w, "equity", 0.3)
    map.put(w, "bond", 0.7)
else
    map.put(w, "equity", 0.5)
    map.put(w, "bond", 0.5)
eqWeight = map.get(w, "equity", 0.5)
plot(eqWeight, "EqWt")
