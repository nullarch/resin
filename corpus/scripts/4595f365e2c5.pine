
//@version=5
indicator("Level Map")
var lm = map.new<string, float>()
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
sma5 = ta.sma(close, 5)
map.put(lm, "resistance", hi5)
map.put(lm, "support", lo5)
map.put(lm, "mid", (hi5 + lo5) / 2)
map.put(lm, "ma", sma5)
total = 0.0
for [k, v] in lm
    total := total + v
plot(total / 4, "Avg")
