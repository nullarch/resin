
//@version=5
strategy("Full Strat", overlay=true)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgVol = ta.sma(volume, 5)
bullish = close > sma3 and sma3 > sma5 and rsi > 50
volConf = volume > avgVol
if bullish and volConf
    strategy.entry("Long", strategy.long)
if close < sma3 - atr or rsi < 40
    strategy.close("Long")
plot(sma3, "F")
