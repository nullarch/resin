
//@version=5
indicator("Str Complex")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
trend = sma3 > sma5 ? "BULL" : "BEAR"
strength = rsi > 60 ? "STRONG" : rsi < 40 ? "WEAK" : "MODERATE"
vol = volume > ta.sma(volume, 5) ? "HIGH_VOL" : "LOW_VOL"
combined = trend + "_" + strength + "_" + vol
isBullStrongHighVol = combined == "BULL_STRONG_HIGH_VOL"
plot(isBullStrongHighVol ? 1 : 0, "BSH")
