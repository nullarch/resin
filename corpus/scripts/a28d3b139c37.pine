
//@version=5
indicator("Filt Cfg")
var fc = map.new<string, float>()
map.put(fc, "rsi_threshold", 60.0)
map.put(fc, "confirm_bars", 2.0)
map.put(fc, "min_atr_mult", 0.5)
rsi = nz(ta.rsi(close, 3), 50.0)
threshold = map.get(fc, "rsi_threshold", 60.0)
passed = rsi > threshold
plot(passed ? 1 : 0, "P")
