//@version=5
indicator("Torture 18")
type Node
    float value = 0.0
    int depth = 0
method transform(Node this) =>
    this.value * math.pow(0.9, this.depth)
var float deepestValue = 0.0
float seed = nz(ta.rsi(close, 5), 50.0) / 100.0
root = Node.new(seed, 0)
transformed = array.new<float>(0)
for d = 0 to 4
    child = Node.copy(root)
    child.depth := d
    child.value := seed * (d + 1) / 5.0
    float tVal = child.transform()
    transformed.push(tVal)
float totalT = 0.0
float maxT = 0.0
for t in transformed
    totalT := totalT + t
    maxT := math.max(maxT, t)
float avgT = transformed.size() > 0 ? totalT / transformed.size() : 0.0
float category = switch
    avgT > 0.5 => 3.0
    avgT > 0.3 => 2.0
    avgT > 0.1 => 1.0
    => 0.0
deepestValue := math.max(deepestValue, maxT)
