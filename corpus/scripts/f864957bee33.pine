
//@version=5
indicator("Mkt Regime")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
atr = ta.atr(3)
avgATR = ta.sma(atr, 3)
trendUp = close > sma3 and sma3 > sma5
trendDn = close < sma3 and sma3 < sma5
highVol = atr > avgATR * 1.2
regime = switch
    trendUp and not highVol => 1
    trendDn and not highVol => -1
    highVol => 2
    => 0
plot(regime, "Regime")
