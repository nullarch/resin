
//@version=5
indicator("Softmax")
softmaxWeight(float val, float total) =>
    total > 0 ? math.exp(val) / total : 0.0

rsi = nz(ta.rsi(close, 3), 50.0) / 100
k = ta.stoch(close, high, low, 5) / 100
expSum = math.exp(rsi) + math.exp(k)
wRSI = softmaxWeight(rsi, expSum)
wK = softmaxWeight(k, expSum)
weighted = wRSI * rsi + wK * k
plot(weighted, "Wt")
