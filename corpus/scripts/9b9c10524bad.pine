
//@version=5
strategy("Multi Ind", overlay=true)
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
k = ta.stoch(close, high, low, 5)
bullCount = (rsi > 50 ? 1 : 0) + (close > sma3 ? 1 : 0) + (sma3 > ema5 ? 1 : 0) + (k > 50 ? 1 : 0)
if bullCount >= 3
    strategy.entry("Long", strategy.long)
if bullCount <= 1
    strategy.close("Long")
plot(sma3, "MA")
