
//@version=5
strategy("Scale In", overlay=true)
sma3 = ta.sma(close, 3)
rsiVal = ta.rsi(close, 3)
if close > sma3 and rsiVal > 40
    strategy.entry("Long", strategy.long, qty=1)
if close > sma3 and rsiVal > 60
    strategy.entry("Long", strategy.long, qty=1)
if rsiVal > 75
    strategy.close("Long")
plot(rsiVal, "RSI")
