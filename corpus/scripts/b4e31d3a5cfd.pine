//@version=5
indicator("Modularity")
mid = (high + low) / 2.0
inGroup1 = close >= mid and open >= mid ? 1.0 : 0.0
inGroup2 = close < mid and open < mid ? 1.0 : 0.0
crossEdge = (close >= mid and open < mid) or (close < mid and open >= mid) ? 1.0 : 0.0
intraEdge = inGroup1 + inGroup2
totalEdge = intraEdge + crossEdge
modularity = totalEdge > 0.0 ? intraEdge / totalEdge : 0.0
plot(modularity, "Mod")
