
//@version=5
indicator("Candle Stats")
bullCount = 0
avgBody = 0.0
for i = 0 to 4
    o = open[i]
    c = close[i]
    if not na(o) and not na(c)
        if c > o
            bullCount := bullCount + 1
        avgBody := avgBody + math.abs(c - o)
avgBody := avgBody / 5
plot(bullCount, "Bull")
plot(avgBody, "AvgB")
