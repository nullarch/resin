
//@version=5
indicator("VaR")
var float[] rets = array.new_float(0)
ret = close > 0 ? (close - close[1]) / close[1] : 0.0
if not na(ret) and not na(close[1])
    array.push(rets, ret)
if array.size(rets) > 8
    array.shift(rets)
sorted = array.copy(rets)
array.sort(sorted)
var5pct = array.size(sorted) >= 3 ? array.percentile_linear_interpolation(sorted, 5.0) : 0.0
plot(var5pct * 100, "VaR5")
