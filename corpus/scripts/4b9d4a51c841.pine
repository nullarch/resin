//@version=5
indicator("Repulsive Field")
float obsX = 104.0
float obsY = 106.0
float posX = close
float posY = high
float dx = posX - obsX
float dy = posY - obsY
float dist = math.sqrt(dx * dx + dy * dy)
float threshold = 5.0
float kRep = 100.0
float repForce = dist > 0.01 and dist < threshold ? kRep * (1.0 / dist - 1.0 / threshold) / (dist * dist) : 0.0
