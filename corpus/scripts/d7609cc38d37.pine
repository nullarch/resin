//@version=5
indicator("BB + RSI Combo")
[basis, upper, lower] = ta.bb(close, 20, 2.0)
bbWidth = (upper - lower) / basis * 100
rsiVal = ta.rsi(close, 14)
rsiMA = ta.sma(rsiVal, 5)
bullSignal = rsiVal > rsiMA and close > basis
bearSignal = rsiVal < rsiMA and close < basis
plot(rsiVal, "RSI")
plot(rsiMA, "RSI MA")
