//@version=5
indicator("Conway Birth")
var int alive = 0
n1 = close > open ? 1 : 0
n2 = high > nz(ta.sma(high, 3), high) ? 1 : 0
n3 = low < nz(ta.sma(low, 3), low) ? 1 : 0
n4 = volume > 1000 ? 1 : 0
n5 = nz(ta.rsi(close, 3), 50.0) > 50 ? 1 : 0
neighbors = n1 + n2 + n3 + n4 + n5
alive := alive == 0 and neighbors >= 2 and neighbors <= 3 ? 1 : alive == 1 and (neighbors < 2 or neighbors > 3) ? 0 : alive
