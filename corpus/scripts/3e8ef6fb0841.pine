
//@version=5
indicator("Micro UDT")
type MicroData
    float spread = 0.0
    float intensity = 0.0
    float efficiency = 0.0

var MicroData md = MicroData.new()
md.spread := high - low
md.intensity := md.spread > 0 ? volume / md.spread : 0.0
netMove = math.abs(close - open)
md.efficiency := md.spread > 0 ? netMove / md.spread : 0.0
plot(md.efficiency, "Eff")
