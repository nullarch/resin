//@version=5
indicator("Ultra 013")
type Tracker
    float ema = 0.0
    int streak = 0

method update(Tracker this, float val) =>
    this.ema := this.ema * 0.7 + val * 0.3
    if val > this.ema
        this.streak := this.streak + 1
    else
        this.streak := 0
    this

safeDiv(float a, float b) =>
    b > 0.001 ? a / b : 0.0

var Tracker trk = Tracker.new(0.0, 0)
var float[] streaks = array.new_float(0)

rsiVal = nz(ta.rsi(close, 5), 50.0)
trk.update(rsiVal)

array.push(streaks, trk.streak * 1.0)
if array.size(streaks) > 5
    array.shift(streaks)

maxStreak = 0.0
for i = 0 to array.size(streaks) - 1
    val = array.get(streaks, i)
    maxStreak := math.max(maxStreak, val)

momentum = not na(close[1]) ? close - close[1] : 0.0
normalized = safeDiv(momentum, nz(ta.atr(3), 1.0))

bucket = switch
    normalized > 1.0 => 3.0
    normalized > 0.0 => 2.0
    normalized > -1.0 => 1.0
    => 0.0
plot(maxStreak + bucket)
