//@version=5
indicator("Array Stats")
var float[] closes = array.new<float>(0)
closes.push(close)
sz = closes.size()
var float customStd = 0.0
if sz >= 3
    mean = closes.avg()
    sumSqDiff = 0.0
    for i = 0 to sz - 1
        diff = closes.get(i) - mean
        sumSqDiff := sumSqDiff + diff * diff
    customStd := math.sqrt(sumSqDiff / sz)
plot(customStd)
