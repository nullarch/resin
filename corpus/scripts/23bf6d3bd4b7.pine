//@version=5
indicator("Sector Rotation")
var sectors = map.new<string, float>()
float momentum = close - open
label = momentum > 2.0 ? "strong" : momentum > 0.0 ? "mild" : "weak"
prev = nz(map.get(sectors, label), 0.0)
map.put(sectors, label, prev + 1.0)
float strongCount = nz(map.get(sectors, "strong"), 0.0)
float mildCount = nz(map.get(sectors, "mild"), 0.0)
float weakCount = nz(map.get(sectors, "weak"), 0.0)
float total = strongCount + mildCount + weakCount + 0.01
plot(strongCount / total, "StrongPct")
