//@version=5
indicator("Functor Laws")
values = array.new<float>(0)
values.push(close)
values.push(open)
values.push(high)
idMapped = array.new<float>(0)
for v in values
    idMapped.push(v)
float law1Diff = 0.0
for i = 0 to values.size() - 1
    law1Diff := law1Diff + math.abs(array.get(values, i) - array.get(idMapped, i))
composed = array.new<float>(0)
for v in values
    float step1 = v - 100.0
    float step2 = step1 * 2.0
    composed.push(step2)
separate = array.new<float>(0)
for v in values
    separate.push((v - 100.0) * 2.0)
float law2Diff = 0.0
for i = 0 to composed.size() - 1
    law2Diff := law2Diff + math.abs(array.get(composed, i) - array.get(separate, i))
