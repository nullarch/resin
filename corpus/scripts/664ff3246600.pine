
//@version=5
indicator("Cat Label")
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
avgATR = ta.sma(atr, 3)
momCat = rsi > 60 ? "bull" : rsi < 40 ? "bear" : "neutral"
volCat = atr > avgATR ? "high" : "low"
label = momCat + "_" + volCat
isBullHigh = label == "bull_high"
plot(isBullHigh ? 1 : 0, "BH")
