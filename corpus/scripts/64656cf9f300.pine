
//@version=5
indicator("Stress05")
enum State
    INIT
    RUNNING
    DONE
type Machine
    float value = 0.0
    int iterations = 0
m = Machine.new()
m.value := close - open
state = State.INIT
iterations = 0
temp = math.abs(m.value)
while state != State.DONE and iterations < 10
    temp := temp * 0.9
    iterations := iterations + 1
    state := temp < 0.5 ? State.DONE : State.RUNNING
m.iterations := iterations
results = map.new<string, float>()
map.put(results, "iters", float(m.iterations))
map.put(results, "final", temp)
map.put(results, "original", m.value)
score = 0.0
for [k, v] in results
    score := score + math.abs(v)
label = state == State.DONE ? "CONVERGED" : "TIMEOUT"
plot(score + float(str.length(label)), "S05")
