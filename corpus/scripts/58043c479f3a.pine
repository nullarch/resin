
//@version=5
indicator("Strat Res")
type StratResult
    int wins = 0
    int losses = 0
    float totalPnl = 0.0

var StratResult sr = StratResult.new()
pnl = close - open
if pnl > 0
    sr.wins := sr.wins + 1
else
    sr.losses := sr.losses + 1
sr.totalPnl := sr.totalPnl + pnl
total = sr.wins + sr.losses
winRate = total > 0 ? sr.wins / total : 0.0
plot(winRate, "WR")
