
//@version=5
indicator("Bar Pat")
body = close - open
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
totalRange = high - low
bodyPct = totalRange > 0 ? math.abs(body) / totalRange : 0.5
pattern = switch
    bodyPct > 0.8 and body > 0 => "strong_bull"
    bodyPct > 0.8 and body < 0 => "strong_bear"
    bodyPct < 0.1 => "doji"
    lowerWick > math.abs(body) * 2 => "hammer"
    => "other"
isStrong = pattern == "strong_bull" or pattern == "strong_bear"
plot(isStrong ? 1 : 0, "Strong")
