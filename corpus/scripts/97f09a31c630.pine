//@version=5
indicator("6000 Celebration")
scoreIt(val, threshold) =>
    val > threshold ? 1.0 : 0.0
var float[] scores = array.new_float(0)
var celebrations = map.new<string, float>()
float rsiVal = nz(ta.rsi(close, 3), 50.0)
float atrVal = nz(ta.atr(3), 1.0)
float smaVal = ta.sma(close, 5)
float emaVal = nz(ta.ema(close, 2), close)
float s1 = scoreIt(rsiVal, 50.0)
float s2 = scoreIt(close, nz(smaVal, close))
float s3 = scoreIt(emaVal, nz(smaVal, close))
float barScore = s1 + s2 + s3
array.push(scores, barScore)
label = barScore >= 2.0 ? "bullish" : barScore >= 1.0 ? "neutral" : "bearish"
prev = nz(map.get(celebrations, label), 0.0)
map.put(celebrations, label, prev + 1.0)
float total = 0.0
for i = 0 to array.size(scores) - 1
    total := total + array.get(scores, i)
float avg = array.size(scores) > 0 ? total / array.size(scores) : 0.0
plot(avg, "AvgScore")
