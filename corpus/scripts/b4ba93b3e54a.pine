
//@version=5
indicator("TS Full")
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
trend = ema3 - sma5

// Exponential smoothing
var float smooth = 0.0
alpha = 0.3
smooth := alpha * close + (1 - alpha) * smooth

// Error tracking
var float[] errors = array.new_float(0)
err = math.abs(close - smooth)
array.push(errors, err)
if array.size(errors) > 8
    array.shift(errors)
mae = array.avg(errors)

// Forecast
forecast = smooth + trend

// Model map
var fm = map.new<string, float>()
map.put(fm, "smooth", smooth)
map.put(fm, "trend", trend)
map.put(fm, "forecast", forecast)
map.put(fm, "mae", mae)

var int bars = 0
bars := bars + 1

plot(forecast, "Fcst")
plot(mae, "MAE")
