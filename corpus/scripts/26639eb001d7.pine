//@version=5
indicator("Complex05")
prices = array.new_float(0)
for i = 0 to 4
    array.push(prices, close + float(i) * 0.5 - 1.0)
transitions = 0
for i = 1 to 4
    prev = nz(array.get(prices, i - 1), 0.0)
    curr = nz(array.get(prices, i), 0.0)
    if (curr > prev and i > 1) or (curr < prev and i > 1)
        transitions := transitions + 1
complexity = float(transitions) / 4.0
plot(complexity, "cx")
