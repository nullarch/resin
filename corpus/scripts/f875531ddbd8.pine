
//@version=5
strategy("Event Strat", overlay=true)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
avgVol = ta.sma(volume, 5)
bullEvent = ta.crossover(close, sma3) and rsi > 50 and volume > avgVol
if bullEvent
    strategy.entry("Long", strategy.long)
if ta.crossunder(close, sma3)
    strategy.close("Long")
plot(sma3, "MA")
