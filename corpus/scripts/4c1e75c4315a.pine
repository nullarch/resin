
//@version=5
indicator("OB Sim")
type Level
    float price = 0.0
    float size = 0.0

var Level bestBid = Level.new()
var Level bestAsk = Level.new()
bestBid.price := close - ta.atr(3) * 0.5
bestBid.size := volume * 0.4
bestAsk.price := close + ta.atr(3) * 0.5
bestAsk.size := volume * 0.6
spread = bestAsk.price - bestBid.price
plot(spread, "Spread")
