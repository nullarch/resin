//@version=5
indicator("All CF Expr")
// if expression
float if_val = if close > 100
    1.0
else
    0.0

// for expression
float total = 0.0
float for_val = for i = 1 to 3
    total := total + i
    total

// while expression
int w = 0
float while_val = while w < 3
    w := w + 1
    w * 10.0

// switch expression
var int mode = 2
float sw_val = switch mode
    1 => 100.0
    2 => 200.0
    => 0.0

var float result = 0.0
result := if_val + for_val + while_val + sw_val
plot(result)
