
//@version=5
indicator("RS Full")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)

rs = sma5 > 0 ? sma3 / sma5 : 1.0
priceStr = sma3 > 0 ? (close - sma3) / sma3 * 100 : 0.0
momStr = (rsi - 50) / 50

composite = rs * 50 + priceStr + momStr * 10

var int strongBars = 0
if composite > 52
    strongBars := strongBars + 1

plot(composite, "C")
plot(strongBars, "SB")
