
//@version=5
indicator("Nested State")
var ns = map.new<string, float>()
map.put(ns, "prev_signal", map.get(ns, "curr_signal", 0.0))
map.put(ns, "prev_strength", map.get(ns, "curr_strength", 0.0))
sig = close > ta.sma(close, 3) ? 1.0 : -1.0
str2 = math.abs(close - ta.sma(close, 3))
map.put(ns, "curr_signal", sig)
map.put(ns, "curr_strength", str2)
sigChange = map.get(ns, "curr_signal", 0.0) != map.get(ns, "prev_signal", 0.0)
plot(sigChange ? 1 : 0, "Change")
