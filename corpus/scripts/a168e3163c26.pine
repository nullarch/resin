
//@version=5
indicator("Pat Scan")
bullCount = 0
bearCount = 0
for i = 0 to 4
    c = close[i]
    o = open[i]
    if not na(c) and not na(o)
        if c > o
            bullCount := bullCount + 1
        else
            bearCount := bearCount + 1
dominance = bullCount - bearCount
plot(dominance, "Dom")
