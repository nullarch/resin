
//@version=5
indicator("Switch Var")
var int mode = 0
var int modeChanges = 0
rsiVal = ta.rsi(close, 3)
newMode = switch
    rsiVal > 70 => 2
    rsiVal > 50 => 1
    rsiVal > 30 => -1
    => -2
if newMode != mode
    modeChanges := modeChanges + 1
mode := newMode
plot(mode, "Mode")
plot(modeChanges, "Changes")
