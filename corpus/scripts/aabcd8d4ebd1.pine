//@version=5
indicator("Torture 4")
type Band
    float upper = 0.0
    float lower = 0.0
method width(Band this) =>
    this.upper - this.lower
type BandSet
    float avgWidth = 0.0
bands = array.new<float>(0)
float sma3 = nz(ta.sma(close, 3), close)
float atrVal = nz(ta.atr(3), 1.0)
float mul1 = 1.0
float mul2 = 2.0
float mul3 = 3.0
b1 = Band.new(sma3 + atrVal * mul1, sma3 - atrVal * mul1)
b2 = Band.new(sma3 + atrVal * mul2, sma3 - atrVal * mul2)
b3 = Band.new(sma3 + atrVal * mul3, sma3 - atrVal * mul3)
bands.push(b1.width())
bands.push(b2.width())
bands.push(b3.width())
float totalW = 0.0
for w in bands
    totalW := totalW + w
float avgW = bands.size() > 0 ? totalW / bands.size() : 0.0
bs = BandSet.new(avgW)
float normalized = bs.avgWidth > 0.01 ? close / bs.avgWidth : 0.0
