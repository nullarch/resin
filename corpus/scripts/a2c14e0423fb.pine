
//@version=5
indicator("UDT Factory")
type Band
    float upper = 0.0
    float lower = 0.0
    float mid = 0.0

makeBand(float src, int len, float mult) =>
    m = ta.sma(src, len)
    s = ta.stdev(src, len)
    Band.new(m + s * mult, m - s * mult, m)

band = makeBand(close, 5, 2.0)
width = band.upper - band.lower
plot(width, "Width")
