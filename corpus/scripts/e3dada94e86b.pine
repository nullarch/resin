
//@version=5
indicator("ForInSwitch")
diff = close - open
result = switch
    diff > 2 =>
        sum = 0.0
        for i = 0 to 3
            sum := sum + float(i)
        sum
    diff > 0 =>
        sum = 0.0
        for i = 0 to 1
            sum := sum + float(i)
        sum
    => 0.0
plot(result, "R")
