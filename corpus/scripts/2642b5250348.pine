
//@version=5
indicator("MA Spread")
var float[] spreads = array.new_float(0)
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
spread = ema3 - sma5
array.push(spreads, spread)
if array.size(spreads) > 6
    array.shift(spreads)
avgSpread = array.avg(spreads)
expanding = spread > avgSpread
plot(spread, "Sp")
plot(expanding ? 1 : 0, "Exp")
