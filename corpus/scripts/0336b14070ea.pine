
//@version=5
strategy("Trend Follow", overlay=true)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
bullTrend = sma3 > sma5 and close > sma3 and rsi > 50
if bullTrend
    strategy.entry("Long", strategy.long)
if sma3 < sma5 or rsi < 40
    strategy.close("Long")
plot(sma3, "Fast")
