
//@version=5
indicator("Osc Zone E")
enum OscZone
    ExtremeUp = 2
    Up = 1
    Neutral = 0
    Down = -1
    ExtremeDn = -2

rsi = nz(ta.rsi(close, 3), 50.0)
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
rangeVal = hi5 - lo5
pos = rangeVal > 0 ? (close - lo5) / rangeVal * 100 : 50.0
zone = switch
    pos > 80 and rsi > 65 => OscZone.ExtremeUp
    pos > 60 => OscZone.Up
    pos < 20 and rsi < 35 => OscZone.ExtremeDn
    pos < 40 => OscZone.Down
    => OscZone.Neutral
plot(int(zone), "Z")
