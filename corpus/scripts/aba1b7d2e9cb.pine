//@version=5
indicator("Full Regression C83")
var float result = 0.0

// UDF
my_avg(float a, float b) =>
    (a + b) / 2.0

// UDT
type Stats
    float value = 0.0

// TA
sma3 = ta.sma(close, 3)
ema3 = ta.ema(close, 3)

// Var state
var float max_close = 0.0
max_close := math.max(max_close, close)

// Array
float[] arr = array.from(1.0, 2.0, 3.0)
float arr_sum = 0.0
for v in arr
    arr_sum += v

// Map
map<string, float> m = map.new<string, float>()
m.put("sma", nz(sma3, 0.0))

// Switch
float category = switch
    close > 110 => 3.0
    close > 105 => 2.0
    => 1.0

// String
string label = str.tostring(close)

// Safe div
float ratio = nz(close / open, 1.0)

// UDT usage
s = Stats.new(my_avg(nz(sma3, 0.0), nz(ema3, 0.0)))

result := s.value + arr_sum + category + max_close + ratio + m.get("sma")
