//@version=5
strategy("Torture 17")
enum Side
    Long = 1
    Short = 2
type Order
    float qty = 1.0
    float stopPct = 0.02
method riskAmount(Order this, float price) =>
    price * this.stopPct * this.qty
var float totalRisk = 0.0
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float atrVal = nz(ta.atr(3), 1.0)
float sma3 = nz(ta.sma(close, 3), close)
float ema5 = nz(ta.ema(close, 5), close)
conditions = array.new<float>(0)
conditions.push(close > sma3 ? 1.0 : 0.0)
conditions.push(rsiVal > 50 ? 1.0 : 0.0)
conditions.push(close > ema5 ? 1.0 : 0.0)
float bullScore = 0.0
for c in conditions
    bullScore := bullScore + c
float side = switch
    bullScore >= 2.0 => 1.0
    bullScore <= 1.0 => 2.0
    => 0.0
ord = Order.new(1.0, atrVal > 0.01 ? atrVal / close : 0.02)
float risk = ord.riskAmount(close)
if side == 1.0
    strategy.entry("ML", strategy.long)
if side == 2.0
    strategy.close("ML")
totalRisk := totalRisk + risk
