
//@version=5
strategy("Multi Period", overlay=true)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi3 = nz(ta.rsi(close, 3), 50.0)
aligned = sma3 > sma5 and rsi3 > 50 and close > sma3
if aligned
    strategy.entry("Long", strategy.long)
if sma3 < sma5 or rsi3 < 40
    strategy.close("Long")
plot(sma3, "F")
