//@version=5
indicator("PostPredCheck")
var float sumAbsErr = 0.0
var int nObs = 0
nObs := nObs + 1
predicted = nz(ta.sma(close, 3), close)
absErr = math.abs(close - predicted)
sumAbsErr := sumAbsErr + absErr
mae = nObs > 0 ? sumAbsErr / float(nObs) : 0.0
pValue = mae < 2.0 ? 0.9 : 0.1
plot(mae, "MAE")
plot(pValue, "PVal")
