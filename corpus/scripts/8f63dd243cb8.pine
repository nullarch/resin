
//@version=5
indicator("Multi Strat")
type MultiStrat
    float trendScore = 0.0
    float revScore = 0.0
    float momScore = 0.0
    float best = 0.0

var MultiStrat ms = MultiStrat.new()
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
ms.trendScore := close > sma3 ? 1.0 : -1.0
ms.revScore := rsi < 30 ? 1.0 : rsi > 70 ? -1.0 : 0.0
ms.momScore := (rsi - 50) / 50
ms.best := math.max(ms.trendScore, math.max(ms.revScore, ms.momScore))
plot(ms.best, "Best")
