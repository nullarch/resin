
//@version=5
indicator("BB Stoch RSI")
[mid, upper, lower] = ta.bb(close, 5, 2.0)
k = nz(ta.stoch(close, high, low, 3), 50.0)
rsi = nz(ta.rsi(close, 3), 50.0)
pctB = upper > lower ? (close - lower) / (upper - lower) : 0.5
allOB = rsi > 70 and k > 80 and pctB > 1.0
allOS = rsi < 30 and k < 20 and pctB < 0.0
plot(allOB ? 1 : allOS ? -1 : 0, "Sig")
