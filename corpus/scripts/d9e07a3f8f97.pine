
//@version=5
indicator("MA Sprd H")
var float[] spreads = array.new_float(0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
array.push(spreads, sma3 - sma5)
if array.size(spreads) > 8
    array.shift(spreads)
avgSpread = array.size(spreads) > 0 ? array.avg(spreads) : 0.0
currentSpread = sma3 - sma5
widening = currentSpread > avgSpread
plot(widening ? 1 : 0, "W")
