
//@version=5
indicator("Candle Vote")
var metrics = map.new<string, float>()
body = math.abs(close - open)
rng = high - low
map.put(metrics, "body_big", body > ta.sma(body, 5) ? 1.0 : 0.0)
map.put(metrics, "range_big", rng > ta.sma(rng, 5) ? 1.0 : 0.0)
map.put(metrics, "bullish", close > open ? 1.0 : 0.0)
score = 0.0
for [k, v] in metrics
    score := score + v
plot(score, "Score")
