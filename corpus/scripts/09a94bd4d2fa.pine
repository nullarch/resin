//@version=5
indicator("Full", overlay=true)
len = input(14, "Length")
mult = input(2.0, "Mult")
src = close
basis = ta.sma(src, len)
dev = ta.stdev(src, len) * mult
upper = basis + dev
lower = basis - dev
var float prevUpper = na
var float prevLower = na
if not na(upper)
    prevUpper := upper
    prevLower := lower
pctB = (close - lower) / (upper - lower)
plot(basis)
