//@version=5
indicator("Digit Sum")
val = math.floor(math.abs(close))
d1 = val - math.floor(val / 10.0) * 10.0
d2 = math.floor(val / 10.0) - math.floor(math.floor(val / 10.0) / 10.0) * 10.0
d3 = math.floor(val / 100.0) - math.floor(math.floor(val / 100.0) / 10.0) * 10.0
digitSum = d1 + d2 + d3
plot(digitSum, "DigitSum")
