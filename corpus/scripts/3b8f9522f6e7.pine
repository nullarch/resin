//@version=5
indicator("Combo08")
calcBands(src, len, mult) =>
    basis = nz(ta.sma(src, len), src)
    dev = nz(ta.stdev(src, len), 0.0)
    upper = basis + mult * dev
    lower = basis - mult * dev
    [upper, lower, basis]
var float touchCount = 0.0
[upper, lower, mid] = calcBands(close, 5, 2.0)
arr = array.new_float(0)
array.push(arr, upper)
array.push(arr, lower)
array.push(arr, mid)
bandwidth = array.max(arr) - array.min(arr)
if close > upper or close < lower
    touchCount := touchCount + 1.0
pctTouch = bar_index > 0 ? touchCount / float(bar_index + 1) * 100.0 : 0.0
plot(pctTouch, "PctTouch")
plot(bandwidth, "BW")
