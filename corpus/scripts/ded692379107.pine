
//@version=5
indicator("MsgTemplate")
buildMsg(string template, string val1, string val2) =>
    step1 = str.replace_all(template, "{1}", val1)
    str.replace_all(step1, "{2}", val2)

tmpl = "Close={1}, Dir={2}"
dir = close > open ? "UP" : "DOWN"
msg = buildMsg(tmpl, str.tostring(close), dir)
msgLen = str.length(msg)
plot(msgLen, "ML")
