
//@version=5
indicator("Sig State")
var int bullSignals = 0
var int bearSignals = 0
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
isBull = close > sma3 and sma3 > sma5 and rsi > 50
if isBull
    bullSignals := bullSignals + 1
else
    bearSignals := bearSignals + 1
plot(bullSignals - bearSignals, "Net")
