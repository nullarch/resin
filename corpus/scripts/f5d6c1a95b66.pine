//@version=5
indicator("Switch No Disc Multi")
var float score = 0.0
switch
    close > open and volume > 100 =>
        bonus = (close - open) / open * 100
        score := score + bonus
    close < open =>
        penalty = (open - close) / open * 100
        score := score - penalty
    =>
        score := score
plot(score)
