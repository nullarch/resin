
//@version=5
indicator("All Map")
var m = map.new<string, float>()
map.put(m, "rsi", nz(ta.rsi(close, 3), 50.0))
map.put(m, "atr", ta.atr(3))
map.put(m, "close", close)
hasRSI = map.contains(m, "rsi")
rsiVal = map.get(m, "rsi", 50.0)
keys = map.keys(m)
vals = map.values(m)
sz = map.size(m)
total = 0.0
for [k, v] in m
    total := total + v
plot(total, "Tot")
