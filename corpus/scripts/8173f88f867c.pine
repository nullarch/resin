//@version=5
indicator("RSI Rule")
var int ruleApplied = 0
rsiVal = nz(ta.rsi(close, 3), 50.0)
ruleNum = math.floor(rsiVal * 2.55)
ruleNum := math.max(0, math.min(ruleNum, 255))
left = close > open ? 1 : 0
center = high > low + 3 ? 1 : 0
right = volume > 1000 ? 1 : 0
idx = left * 4 + center * 2 + right
bit = math.floor(ruleNum / math.pow(2, idx))
ruleApplied := bit % 2 == 1 ? 1 : 0
