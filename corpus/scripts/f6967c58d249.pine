
//@version=5
indicator("All Math")
val = close - open
absVal = math.abs(val)
sqrtVal = math.sqrt(absVal)
logVal = absVal > 0 ? math.log(1 + absVal) : 0.0
expVal = math.exp(math.min(val, 3.0))
powVal = math.pow(absVal, 0.5)
sinVal = math.sin(val)
cosVal = math.cos(val)
roundVal = math.round(val * 100) / 100
signVal = math.sign(val)
result = (sqrtVal + logVal + powVal) * signVal
plot(result, "R")
