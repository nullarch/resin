//@version=5
indicator("Epi-Demography Model")
// Demography: population age structure
youngPop = volume * 0.3
elderPop = volume * 0.2
// Epidemiology: SIR model simplified
var float susceptible = 900.0
var float infected = 100.0
var float recovered = 0.0
infectionRate = 0.003
recoveryRate = 0.1
newInfections = susceptible * infected * infectionRate / 1000.0
newRecoveries = infected * recoveryRate
susceptible := math.max(0.0, susceptible - newInfections)
infected := math.max(0.0, infected + newInfections - newRecoveries)
recovered := recovered + newRecoveries
