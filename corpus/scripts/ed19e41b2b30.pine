
//@version=5
indicator("Dashboard")
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
[m, s, h] = ta.macd(close, 3, 5, 3)
k = ta.stoch(close, high, low, 5)
sd = ta.stdev(close, 5)

trendScore = (close > ema3 ? 1 : 0) + (ema3 > sma5 ? 1 : 0)
momScore = (rsi > 50 ? 1 : 0) + (h > 0 ? 1 : 0) + (k > 50 ? 1 : 0)
volScore = atr < ta.sma(atr, 5) * 1.5 ? 1 : 0

composite = (trendScore + momScore + volScore) / 6.0

var metrics = map.new<string, float>()
map.put(metrics, "trend", float(trendScore))
map.put(metrics, "mom", float(momScore))
map.put(metrics, "vol", float(volScore))

plot(composite, "Comp")
