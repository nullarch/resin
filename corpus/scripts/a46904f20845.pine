
//@version=5
strategy("Brk Vol", overlay=true)
hi5 = ta.highest(high, 5)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
lowVol = avgATR > 0 and atr < avgATR
breakout = close > hi5[1] and not na(hi5[1])
if breakout and lowVol
    strategy.entry("Long", strategy.long)
if close < ta.sma(close, 3)
    strategy.close("Long")
plot(hi5, "Hi")
