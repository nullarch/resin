
//@version=5
indicator("Level Map")
var lm = map.new<string, float>()
map.put(lm, "r1", ta.highest(high, 5))
map.put(lm, "s1", ta.lowest(low, 5))
map.put(lm, "pivot", (high + low + close) / 3)
nearLevel = 0
atr = nz(ta.atr(3), 1.0)
for [k, v] in lm
    if math.abs(close - v) < atr
        nearLevel := nearLevel + 1
plot(nearLevel, "NL")
