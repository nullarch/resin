//@version=5
indicator("Monge Map")
float muSource = nz(ta.sma(close, 5), close)
float muTarget = nz(ta.sma(high, 5), high)
float sigSource = nz(ta.stdev(close, 5), 1.0)
float sigTarget = nz(ta.stdev(high, 5), 1.0)
float scaling = sigSource > 0.001 ? sigTarget / sigSource : 1.0
float transported = scaling * (close - muSource) + muTarget
plot(transported, "MongeT")
