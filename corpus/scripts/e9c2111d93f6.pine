
//@version=5
indicator("SR Full")
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)

rng = hi5 - lo5
pos = rng > 0 ? (close - lo5) / rng * 100 : 50.0

atr = nz(ta.atr(3), 1.0)
resistDist = atr > 0 ? (hi5 - close) / atr : 0.0
supportDist = atr > 0 ? (close - lo5) / atr : 0.0

signal = (pos - 50) / 50 * (rsi - 50) / 50

var int breakouts = 0
if close >= hi5
    breakouts := breakouts + 1

plot(signal, "Sig")
plot(breakouts, "BO")
