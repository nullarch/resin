//@version=5
strategy("Ultra 014", overlay=true)

momentum(float price, float baseline) =>
    baseline > 0 ? (price - baseline) / baseline * 100.0 : 0.0

var map<string, float> signals = map.new<string, float>()
var int positionBars = 0
var float maxDrawdown = 0.0

emaFast = ta.ema(close, 3)
emaSlow = ta.ema(close, 5)
mom = not na(emaFast) and not na(emaSlow) ? momentum(emaFast, emaSlow) : 0.0

map.put(signals, "momentum", mom)
map.put(signals, "rsi", nz(ta.rsi(close, 5), 50.0) - 50.0)

total = 0.0
for [key, val] in signals
    total := total + val

idx = 0
smoothed = total
while idx < 2
    smoothed := smoothed * 0.9
    idx := idx + 1

if smoothed > 0.5
    strategy.entry("Long", strategy.long)
    positionBars := positionBars + 1
    if positionBars > 3
        if smoothed < 1.0
            strategy.close("Long")
            positionBars := 0
else if smoothed < -0.5
    strategy.close("Long")
    positionBars := 0

maxDrawdown := math.min(maxDrawdown, smoothed)
plot(smoothed)
