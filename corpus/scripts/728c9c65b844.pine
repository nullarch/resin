
//@version=5
strategy("Regime Strat", overlay=true)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
trending = sma3 > sma5 and close > sma3
lowVol = avgATR > 0 and atr < avgATR * 1.5
if trending and lowVol
    strategy.entry("Long", strategy.long)
if not trending or atr > avgATR * 2
    strategy.close("Long")
plot(sma3, "MA")
