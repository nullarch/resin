
//@version=5
indicator("Contains")
var m = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
if rsi > 65
    map.put(m, "overbought", rsi)
if rsi < 35
    map.put(m, "oversold", rsi)
hasOB = map.contains(m, "overbought")
hasOS = map.contains(m, "oversold")
plot(hasOB ? 1 : hasOS ? -1 : 0, "Signal")
