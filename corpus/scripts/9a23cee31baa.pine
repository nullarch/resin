
//@version=5
strategy("Multi Confirm", overlay=true)
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
bull = close > sma3 and sma3 > sma5 and rsi > 50
bear = close < sma3 and rsi < 45
if bull
    strategy.entry("Long", strategy.long)
if bear
    strategy.close("Long")
plot(sma3, "MA3")
