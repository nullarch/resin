
//@version=5
strategy("DepthImbalStrat")
buyPressure = close > open ? volume * (close - open) / (high - low + 0.001) : 0.0
sellPressure = close < open ? volume * (open - close) / (high - low + 0.001) : 0.0
imbalance = buyPressure - sellPressure
smoothImb = ta.sma(imbalance, 3)
if nz(smoothImb, 0.0) > 100
    strategy.entry("Buy", strategy.long)
if nz(smoothImb, 0.0) < -100
    strategy.close("Buy")
plot(nz(smoothImb, 0.0), "DI")
