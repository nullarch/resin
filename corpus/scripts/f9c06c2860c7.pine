//@version=5
strategy("RL_QTrade", overlay=true)
var float qLong = 0.0
var float qFlat = 0.0
alphaLR = 0.1
reward = close > open ? 1.0 : -0.5
if qLong >= qFlat
    qLong := qLong + alphaLR * (reward - qLong)
    strategy.entry("Long", strategy.long)
else
    qFlat := qFlat + alphaLR * (reward - qFlat)
    strategy.close("Long")
