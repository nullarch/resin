
//@version=5
indicator("Algo Lbl")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
algoName = sma3 > sma5 ? "TREND" : "REVERT"
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
speed = avgATR > 0 and atr > avgATR * 1.3 ? "FAST" : "SLOW"
label = algoName + "_" + speed
isTrendFast = label == "TREND_FAST"
plot(isTrendFast ? 1 : 0, "TF")
