
//@version=5
indicator("UDT Cond")
type Stats
    float highVal = 0.0
    float lowVal = 999999.0
    float avgVal = 0.0
    int count = 0

var Stats s = Stats.new()
s.count := s.count + 1
if close > s.highVal
    s.highVal := close
if close < s.lowVal
    s.lowVal := close
s.avgVal := s.avgVal + (close - s.avgVal) / s.count
plot(s.avgVal, "Avg")
