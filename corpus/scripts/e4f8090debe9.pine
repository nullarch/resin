
//@version=5
indicator("Mom Track")
type MomState
    float rsiVal = 50.0
    float macdHist = 0.0
    int bullCount = 0

var MomState mom = MomState.new()
mom.rsiVal := nz(ta.rsi(close, 3), 50.0)
[m, s, h] = ta.macd(close, 3, 5, 3)
mom.macdHist := h
if mom.rsiVal > 50 and h > 0
    mom.bullCount := mom.bullCount + 1
plot(mom.bullCount, "BullCount")
