
//@version=5
strategy("Risk Mgd", overlay=true)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
lowRisk = avgATR > 0 and atr / avgATR < 1.5
if close > sma3 and rsi > 50 and lowRisk
    strategy.entry("Long", strategy.long)
if close < sma3 or rsi < 40
    strategy.close("Long")
plot(sma3, "MA")
