//@version=5
indicator("MutualInfo")
var float sumLogJoint = 0.0
var float sumLogMargC = 0.0
var float sumLogMargV = 0.0
var int nBars = 0
nBars := nBars + 1
pC = nz(ta.rsi(close, 3), 50.0) / 100.0
pV = nz(ta.rsi(volume, 3), 50.0) / 100.0
safePc = math.max(pC, 0.01)
safePv = math.max(pV, 0.01)
joint = safePc * safePv
sumLogJoint := sumLogJoint + math.log(math.max(joint, 0.0001))
sumLogMargC := sumLogMargC + math.log(safePc)
sumLogMargV := sumLogMargV + math.log(safePv)
n = float(nBars)
mi = n > 0 ? (sumLogJoint - sumLogMargC - sumLogMargV) / n : 0.0
plot(mi, "MI")
