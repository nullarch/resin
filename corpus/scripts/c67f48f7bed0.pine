//@version=5
indicator("Squeeze")
length = 20
mult = 2.0
lengthKC = 20
multKC = 1.5
ma = ta.sma(close, length)
rangeBB = mult * ta.stdev(close, length)
upperBB = ma + rangeBB
lowerBB = ma - rangeBB
maKC = ta.sma(close, lengthKC)
rangeKC = multKC * ta.atr(lengthKC)
upperKC = maKC + rangeKC
lowerKC = maKC - rangeKC
sqzOn = lowerBB > lowerKC and upperBB < upperKC
plot(sqzOn ? 1 : 0)
