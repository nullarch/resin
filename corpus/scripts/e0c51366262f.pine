
//@version=5
indicator("Period Comp UDF")
periodComposite(float fast, float slow, float rsi, float atr) =>
    trendScore = slow > 0 ? (fast - slow) / slow * 100 : 0.0
    momScore = (rsi - 50) / 50
    trendScore * 0.5 + momScore * 30 * 0.5

sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
comp = periodComposite(sma3, sma5, rsi, atr)
plot(comp, "PC")
