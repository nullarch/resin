
//@version=5
indicator("Vol Class")
enum VolClass
    Climax = 3
    High = 2
    Normal = 1
    Low = 0

avgVol = ta.sma(volume, 5)
ratio = avgVol > 0 ? volume / avgVol : 1.0
vc = switch
    ratio > 2.0 => VolClass.Climax
    ratio > 1.3 => VolClass.High
    ratio < 0.7 => VolClass.Low
    => VolClass.Normal
plot(int(vc), "VC")
