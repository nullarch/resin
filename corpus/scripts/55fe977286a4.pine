//@version=5
indicator("NodeStrength")
nodes = array.new_float(0)
array.push(nodes, close)
array.push(nodes, open)
array.push(nodes, high)
strength = array.new_float(3, 0.0)
for i = 0 to 2
    for j = 0 to 2
        if i != j
            w = 1.0 / math.max(math.abs(array.get(nodes, i) - array.get(nodes, j)), 0.01)
            prev = array.get(strength, i)
            array.set(strength, i, prev + w)
maxStrength = array.max(strength)
minStrength = array.min(strength)
plot(maxStrength, "MaxStr")
plot(minStrength, "MinStr")
