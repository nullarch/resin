
//@version=5
indicator("Period Mode")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi3 = nz(ta.rsi(close, 3), 50.0)
rsi5 = nz(ta.rsi(close, 5), 50.0)
mode = switch
    sma3 > sma5 and rsi3 > rsi5 => "all_bull"
    sma3 > sma5 => "trend_bull"
    sma3 < sma5 and rsi3 < rsi5 => "all_bear"
    => "mixed"
isAllBull = mode == "all_bull"
plot(isAllBull ? 1 : 0, "AB")
