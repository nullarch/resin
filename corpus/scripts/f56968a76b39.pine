//@version=5
indicator("Binary search")
arr = array.from(10.0, 20.0, 30.0, 40.0, 50.0, 60.0, 70.0, 80.0, 90.0, 100.0)
target = 55.0
lo = 0
hi = array.size(arr) - 1
var int foundIdx = -1
while lo <= hi
    mid_idx = int((lo + hi) / 2)
    midVal = array.get(arr, mid_idx)
    if midVal == target
        foundIdx := mid_idx
        break
    else if midVal < target
        lo := mid_idx + 1
    else
        hi := mid_idx - 1
