
//@version=5
indicator("Stress Test")
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)
[macd, sig, hist] = ta.macd(close, 3, 5, 3)
k = ta.stoch(close, high, low, 5)

// All feature types combined
signals = array.from(
    close > sma3 ? 1.0 : -1.0,
    rsi > 50 ? 1.0 : -1.0,
    hist > 0 ? 1.0 : -1.0,
    k > 50 ? 1.0 : -1.0
)
composite = array.avg(signals)

var float peak = 0.0
var float maxDD = 0.0
if close > peak
    peak := close
dd = peak > 0 ? (peak - close) / peak : 0.0
if dd > maxDD
    maxDD := dd

var float[] compHist = array.new_float(0)
array.push(compHist, composite)
if array.size(compHist) > 8
    array.shift(compHist)

var state = map.new<string, float>()
map.put(state, "sig", composite)
map.put(state, "dd", maxDD * 100)

var int bars = 0
bars := bars + 1

plot(composite, "Comp")
plot(maxDD * 100, "DD%")
