//@version=5
indicator("Switch in if")
sma5 = ta.sma(close, 5)
rsi5 = ta.rsi(close, 5)
var string signal = "wait"
if not na(sma5) and close > nz(sma5)
    signal := switch
        not na(rsi5) and nz(rsi5) > 70 => "overbought_bull"
        not na(rsi5) and nz(rsi5) > 50 => "bullish"
        => "weak_bull"
else
    signal := "bearish"
