
//@version=5
indicator("Str Lbl")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
trend = sma3 > sma5 ? "OUT" : "UNDER"
rsi = nz(ta.rsi(close, 3), 50.0)
mom = rsi > 55 ? "STRONG" : rsi < 45 ? "WEAK" : "NEUTRAL"
label = trend + "_" + mom
isOutStrong = label == "OUT_STRONG"
plot(isOutStrong ? 1 : 0, "OS")
