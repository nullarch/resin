//@version=5
strategy("AllFeat 013", overlay=true)
calcWeight(idx, total) =>
    total > 0 ? (total - idx) * 1.0 / total : 1.0
var counters = map.new<string, int>()
map.put(counters, "longs", 0)
map.put(counters, "shorts", 0)
var float weightedScore = 0.0
rsiVal = nz(ta.rsi(close, 3), 50.0)
side = rsiVal > 55 ? "longs" : "shorts"
prev = nz(map.get(counters, side), 0)
map.put(counters, side, prev + 1)
wSum = 0.0
for [key, val] in counters
    w = calcWeight(val, 10)
    wSum := wSum + w * val
idx = 0
while idx < 3
    wSum := wSum + 0.0
    idx := idx + 1
weightedScore := wSum
if rsiVal > 60
    strategy.entry("L", strategy.long)
