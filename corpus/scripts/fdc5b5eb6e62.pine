
//@version=5
indicator("MaxDD")
var float equity = 100.0
var float peak = 100.0
var float maxDD = 0.0
pnl = close > open ? 2.0 : -1.0
equity := equity + pnl
peak := equity > peak ? equity : peak
dd = peak > 0 ? (peak - equity) / peak * 100.0 : 0.0
maxDD := dd > maxDD ? dd : maxDD
plot(maxDD, "MDD")
