
//@version=5
indicator("PF")
var float grossProfit = 0.0
var float grossLoss = 0.0
chg = close - close[1]
if not na(chg)
    if chg > 0
        grossProfit := grossProfit + chg
    else if chg < 0
        grossLoss := grossLoss + math.abs(chg)
pf = grossLoss > 0 ? grossProfit / grossLoss : 1.0
plot(pf, "PF")
