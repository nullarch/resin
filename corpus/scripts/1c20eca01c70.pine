
//@version=5
strategy("Bar Pat Strat", overlay=true)
body = math.abs(close - open)
rng = high - low
eff = rng > 0 ? body / rng : 0.0
sma3 = ta.sma(close, 3)
if close > open and eff > 0.6 and close > sma3
    strategy.entry("Long", strategy.long)
if close < sma3
    strategy.close("Long")
plot(sma3, "MA")
