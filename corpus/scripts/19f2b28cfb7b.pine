//@version=5
indicator("Enum method")
enum Signal
    Buy = 1
    Sell = -1
    Hold = 0
type Position
    Signal sig = Signal.Hold
    float price = 0.0
getScore(Position p) =>
    p.sig == Signal.Buy ? 1 : p.sig == Signal.Sell ? -1 : 0
pos = Position.new()
pos.sig := close > open ? Signal.Buy : Signal.Sell
pos.price := close
score = getScore(pos)
