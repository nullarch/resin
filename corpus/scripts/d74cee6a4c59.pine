
//@version=5
indicator("Var State")
var float entryPrice = 0.0
var bool inPosition = false
var int holdBars = 0
sma3 = ta.sma(close, 3)
if not inPosition and close > sma3
    entryPrice := close
    inPosition := true
    holdBars := 0
if inPosition
    holdBars := holdBars + 1
    if holdBars > 3 or close < sma3
        inPosition := false
pnl = inPosition ? (close - entryPrice) : 0.0
plot(pnl, "PnL")
