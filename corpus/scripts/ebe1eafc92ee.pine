
//@version=5
indicator("Stat Map FI")
var sm = map.new<string, float>()
sma5 = ta.sma(close, 5)
stdev5 = ta.stdev(close, 5)
map.put(sm, "z_score", stdev5 > 0 ? (close - sma5) / stdev5 : 0.0)
map.put(sm, "cv", sma5 > 0 ? stdev5 / sma5 * 100 : 0.0)
map.put(sm, "range_pct", close > 0 ? (high - low) / close * 100 : 0.0)
total = 0.0
for [k, v] in sm
    total := total + v
plot(total, "T")
