//@version=5
strategy("Chaos Filter")
float chg = not na(close[1]) ? math.abs(close - close[1]) : 0.001
float logDiv = math.log(math.max(chg, 0.001))
var float sumLog = 0.0
var int cnt = 0
cnt := cnt + 1
sumLog := sumLog + logDiv
float lyap = cnt > 0 ? sumLog / cnt : 0.0
if lyap < 0.0 and close > open
    strategy.entry("Order", strategy.long)
if lyap > 1.0
    strategy.close("Order")
