
//@version=5
indicator("Candle Full")
body = math.abs(close - open)
totalRange = high - low
topBody = math.max(close, open)
botBody = math.min(close, open)

bodyPct = totalRange > 0 ? body / totalRange * 100 : 0.0
upperPct = totalRange > 0 ? (high - topBody) / totalRange * 100 : 0.0
lowerPct = totalRange > 0 ? (botBody - low) / totalRange * 100 : 0.0

rsi = nz(ta.rsi(close, 3), 50.0)
weight = bodyPct > 60 ? 1.5 : 1.0
signal = (rsi - 50) / 50 * weight * (close > open ? 1 : -1)

var int strongBars = 0
if bodyPct > 60
    strongBars := strongBars + 1

plot(signal, "Sig")
plot(strongBars, "SB")
