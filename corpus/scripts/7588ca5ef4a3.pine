//@version=5
indicator("Comprehensive Regression")
myAvg(a, b) =>
    (a + b) / 2
var float maxVal = 0.0
var int count = 0
s = ta.sma(close, 3)
e = ta.ema(close, 3)
avg = myAvg(s, e)
if avg > maxVal
    maxVal := avg
count := count + 1
arr = array.from(s, e, avg)
arrMax = array.max(arr)
signal = switch
    close > 110 => 3
    close > 105 => 2
    => 1
