//@version=5
indicator("Ultra 015")
type Bin
    string name = ""
    float lower = 0.0
    float upper = 0.0
    int count = 0

method isInRange(Bin this, float val) =>
    val >= this.lower and val < this.upper

method label(Bin this) =>
    this.name + ":" + str.tostring(this.count)

var Bin binLow = Bin.new("low", 0.0, 3.0, 0)
var Bin binMid = Bin.new("mid", 3.0, 6.0, 0)
var Bin binHigh = Bin.new("high", 6.0, 999.0, 0)
var float[] values = array.new_float(0)

atrVal = nz(ta.atr(3), 1.0)
rangeVal = high - low

array.push(values, rangeVal)
if array.size(values) > 5
    array.shift(values)

for [idx, val] in values
    if binLow.isInRange(val)
        binLow.count := binLow.count + 1
    else if binMid.isInRange(val)
        binMid.count := binMid.count + 1
    else
        binHigh.count := binHigh.count + 1

totalCount = binLow.count + binMid.count + binHigh.count
entropy = 0.0
if totalCount > 0
    pLow = binLow.count / totalCount
    pMid = binMid.count / totalCount
    pHigh = binHigh.count / totalCount
    entropy := -(pLow > 0 ? pLow * math.log(pLow + 0.001) : 0.0) - (pMid > 0 ? pMid * math.log(pMid + 0.001) : 0.0) - (pHigh > 0 ? pHigh * math.log(pHigh + 0.001) : 0.0)
plot(entropy)
