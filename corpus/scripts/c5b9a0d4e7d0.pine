
//@version=5
indicator("KNNDist")
calcDist(float x1, float y1, float x2, float y2) =>
    dx = x1 - x2
    dy = y1 - y2
    math.sqrt(dx * dx + dy * dy)

rsi = nz(ta.rsi(close, 3), 50.0)
spread = high - low
refRsi = 50.0
refSpread = 5.0
dist = calcDist(rsi, spread, refRsi, refSpread)
plot(dist, "D")
