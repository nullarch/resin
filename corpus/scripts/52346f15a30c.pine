//@version=5
strategy("Torture 3")
enum Action
    Buy = 1
    Sell = 2
    Hold = 3
type TradeSetup
    float entry = 0.0
    float stopLoss = 0.0
method isValid(TradeSetup this) =>
    this.entry > 0.0 and this.stopLoss > 0.0
var int tradeCount = 0
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float atrVal = nz(ta.atr(3), 1.0)
float sma3 = nz(ta.sma(close, 3), close)
float action = switch
    rsiVal > 60 and close > sma3 => 1.0
    rsiVal < 40 and close < sma3 => 2.0
    => 3.0
setup = TradeSetup.new(close, close - atrVal * 2.0)
bool valid = setup.isValid()
if action == 1.0 and valid
    strategy.entry("Long", strategy.long)
    tradeCount := tradeCount + 1
if action == 2.0
    strategy.close("Long")
