
//@version=5
indicator("Cyc Ph Enum")
enum CPhase
    Accumulation = 0
    Markup = 1
    Distribution = 2
    Markdown = 3

var int barNum = 0
barNum := barNum + 1
phase = switch barNum % 4
    0 => CPhase.Accumulation
    1 => CPhase.Markup
    2 => CPhase.Distribution
    => CPhase.Markdown
plot(int(phase), "Ph")
