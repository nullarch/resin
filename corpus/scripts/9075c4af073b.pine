//@version=5
indicator("ArrayStats")
var prices = array.new<float>(0)
if bar_index < 5
    array.push(prices, close)
var float avgPrice = 0
var float maxPrice = 0
if bar_index == 9 and array.size(prices) > 0
    total = 0.0
    for i = 0 to array.size(prices) - 1
        total := total + array.get(prices, i)
    avgPrice := total / array.size(prices)
    maxPrice := array.max(prices)
