//@version=5
indicator("RSI Dynamic")
var float lastSignal = 0
rsiVal = ta.rsi(close, 5)
smaRsi = ta.sma(close, 3)
if not na(rsiVal)
    upperBand = 70 + nz(ta.stdev(close, 5), 0)
    lowerBand = 30 - nz(ta.stdev(close, 5), 0)
    if rsiVal > upperBand
        lastSignal := 1
    else if rsiVal < lowerBand
        lastSignal := -1
