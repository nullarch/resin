//@version=5
indicator("Crystal System")
var int cubic = 0
var int tetragonal = 0
var int hexagonal = 0
body = math.abs(close - open)
wick = (high - low) - body
ratio = body > 0.1 ? wick / body : 0.0
if ratio < 0.5
    cubic := cubic + 1
else if ratio < 1.5
    tetragonal := tetragonal + 1
else
    hexagonal := hexagonal + 1
