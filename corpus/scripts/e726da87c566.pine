
//@version=5
indicator("Exec Engine")
// Indicators
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)
[macd, sig, hist] = ta.macd(close, 3, 5, 3)

// Multi-signal
signals = array.from(close > sma3 ? 1.0 : -1.0, rsi > 50 ? 1.0 : -1.0, hist > 0 ? 1.0 : -1.0)
composite = array.avg(signals)

// Risk
var float maxDD = 0.0
var float peak = 0.0
if close > peak
    peak := close
dd = peak > 0 ? (peak - close) / peak : 0.0
if dd > maxDD
    maxDD := dd

// Position sizing
riskBudget = 0.02
posSize = atr > 0 ? riskBudget / atr * 1000 : 1.0

// State
var int totalBars = 0
totalBars := totalBars + 1
var float[] compHist = array.new_float(0)
array.push(compHist, composite)
if array.size(compHist) > 8
    array.shift(compHist)

var m = map.new<string, float>()
map.put(m, "signal", composite)
map.put(m, "size", posSize)

plot(composite, "Signal")
plot(posSize, "Size")
plot(maxDD * 100, "DD%")
