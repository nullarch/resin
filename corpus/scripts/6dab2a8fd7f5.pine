//@version=5
strategy("FullFourier20")
enum CycleState
    BULLISH
    BEARISH
    NEUTRAL
type FourierState
    float domFreq = 2.0
    float amplitude = 0.0
    float phase = 0.0
var FourierState fs = FourierState.new()
mags = array.new_float(0)
for f = 1 to 3
    rp = 0.0
    ip = 0.0
    for k = 0 to 4
        angle = 2.0 * math.pi * float(f) * float(k) / 5.0
        rp := rp + (close + float(k)) * math.cos(angle)
        ip := ip - (close + float(k)) * math.sin(angle)
    mag = math.sqrt(rp * rp + ip * ip)
    array.push(mags, mag)
maxMag = nz(array.max(mags), 0.0)
fs.amplitude := maxMag
trend = nz(ta.sma(close, 3), close)
detrended = close - trend
cycState = switch
    detrended > 1.0 => CycleState.BULLISH
    detrended < -1.0 => CycleState.BEARISH
    => CycleState.NEUTRAL
if cycState == CycleState.BULLISH and fs.amplitude > 100.0
    strategy.entry("FL", strategy.long)
if cycState == CycleState.BEARISH and fs.amplitude > 100.0
    strategy.entry("FS", strategy.short)
