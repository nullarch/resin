//@version=5
strategy("AllFeat 018", overlay=true)
findPeak(arr) =>
    peak = 0.0
    for i = 0 to array.size(arr) - 1
        v = array.get(arr, i)
        if v > peak
            peak := v
    peak
var hist = array.new_float(0)
var int signals = 0
array.push(hist, close)
peak = findPeak(hist)
action = switch
    close >= peak and close > 108 => "buy"
    close <= peak * 0.95 => "sell"
    => "wait"
found = false
for i = 0 to array.size(hist) - 1
    if array.get(hist, i) > 109
        found := true
        break
if action == "buy"
    strategy.entry("B", strategy.long)
    signals := signals + 1
