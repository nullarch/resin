
//@version=5
indicator("Cycle 90 Full")

// Percentile
p_near = ta.percentile_nearest_rank(close, 10, 75)
p_lin = ta.percentile_linear_interpolation(close, 10, 25)

// Windowed sum
s = math.sum(close, 5)

// TA precision chain
sma_val = ta.sma(close, 10)
[bb_mid, bb_up, bb_lo] = ta.bb(close, 20, 2.0)
[kc_mid, kc_up, kc_lo] = ta.kc(close, 20, 1.5)

// Squeeze
squeeze = bb_lo > kc_lo and bb_up < kc_up

// Volume indicators (OHLCV inject)
obv_val = ta.obv()
pvt_val = ta.pvt()

// Cumulative
cum_close = ta.cum(close)

// Drawing noop
if bar_index == 5
    label.new(bar_index, close, "Squeeze: " + str.tostring(squeeze))

result = p_near + p_lin + s + sma_val + (squeeze ? 1.0 : 0.0)
plot(result)
