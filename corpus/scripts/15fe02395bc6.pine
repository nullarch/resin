
//@version=5
indicator("TriFilter")
score(float val, float threshold) =>
    val > threshold ? 1.0 : val < -threshold ? -1.0 : 0.0

smaVal = nz(ta.sma(close, 3), close)
emaVal = nz(ta.ema(close, 3), close)
rsi = nz(ta.rsi(close, 3), 50.0)

s1 = score(close - smaVal, 1.0)
s2 = score(close - emaVal, 1.0)
s3 = score(rsi - 50.0, 10.0)
consensus = (s1 + s2 + s3) / 3.0
plot(consensus, "C")
