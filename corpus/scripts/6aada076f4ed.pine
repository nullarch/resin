
//@version=5
indicator("Comp Bool")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
bullish = close > sma3 and sma3 > ema5 and rsi > 50
bearish = close < sma3 and sma3 < ema5 and rsi < 50
neutral = not bullish and not bearish
score = bullish ? 1 : bearish ? -1 : 0
plot(score, "Score")
