
//@version=5
indicator("Score Full")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
atr = ta.atr(3)
[m, s, h] = ta.macd(close, 3, 5, 3)
k = ta.stoch(close, high, low, 5)

var scores = map.new<string, float>()
map.put(scores, "rsi", (rsi - 50) / 50)
map.put(scores, "trend", close > sma3 ? 1.0 : -1.0)
map.put(scores, "macd", h > 0 ? 1.0 : -1.0)
map.put(scores, "stoch", (k - 50) / 50)

composite = 0.0
for [name, val] in scores
    composite := composite + val
composite := composite / 4

var float[] history = array.new_float(0)
array.push(history, composite)
if array.size(history) > 6
    array.shift(history)

var int bars = 0
bars := bars + 1

plot(composite, "Comp")
plot(array.avg(history), "Avg")
