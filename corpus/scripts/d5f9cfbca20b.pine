//@version=5
indicator("Extreme Cluster")
float atrVal = nz(ta.atr(3), 1.0)
float prevC = not na(close[1]) ? close[1] : close
float isExtreme = math.abs(close - prevC) > 1.5 * atrVal ? 1.0 : 0.0
var int cluster = 0
if isExtreme > 0.5
    cluster := cluster + 1
else
    cluster := 0
plot(cluster, "Cluster")
