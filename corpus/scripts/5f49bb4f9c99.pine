//@version=5
indicator("EnumSwitchFor")
enum Dir
    Up = 1
    Down = -1
    Flat = 0
dir = close > open ? Dir.Up : close < open ? Dir.Down : Dir.Flat
total = 0.0
for i = 0 to 2
    total := total + float(i)
result = switch dir
    Dir.Up => total + 10.0
    Dir.Down => total - 10.0
    => total
plot(result, "R")
