//@version=5
indicator("Array Stats")
var arr = array.from(10.0, 20.0, 30.0, 40.0, 50.0)
var float mn = 0.0
mn := array.min(arr)
var float mx = 0.0
mx := array.max(arr)
var float av = 0.0
av := array.avg(arr)
var float med = 0.0
med := array.median(arr)
var float sd = 0.0
sd := array.stdev(arr)
plot(close)
