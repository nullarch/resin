//@version=5
indicator("Dashboard", overlay=true)
var t = table.new(position.top_right, 3, 2)
if barstate.islast
    table.cell(t, 0, 0, "RSI")
    table.cell(t, 0, 1, str.tostring(ta.rsi(close, 14)))
    table.cell(t, 1, 0, "SMA")
    table.cell(t, 1, 1, str.tostring(ta.sma(close, 20)))
    table.cell(t, 2, 0, "ATR")
    table.cell(t, 2, 1, str.tostring(ta.atr(14)))
