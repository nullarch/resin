
//@version=5
indicator("Regime Detector")
// Indicators
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema8 = ta.ema(close, 8)
rsiVal = ta.rsi(close, 3)
atrVal = ta.atr(3)
[macdLine, sigLine, hist] = ta.macd(close, 3, 5, 3)
[bbMid, bbUp, bbLo] = ta.bb(close, 5, 2.0)

// Regime classification
trendScore = (close > sma3 ? 1 : 0) + (sma3 > sma5 ? 1 : 0) + (sma5 > ema8 ? 1 : 0)
momScore = (rsiVal > 50 ? 1 : 0) + (hist > 0 ? 1 : 0)
totalScore = trendScore + momScore

regime = switch
    totalScore >= 4 => "strong_bull"
    totalScore >= 3 => "bull"
    totalScore >= 2 => "neutral"
    totalScore >= 1 => "bear"
    => "strong_bear"

// Tracking
var int bullBars = 0
var int bearBars = 0
var int neutralBars = 0
if totalScore >= 3
    bullBars := bullBars + 1
else if totalScore <= 1
    bearBars := bearBars + 1
else
    neutralBars := neutralBars + 1

// Volatility tracking
bbWidth = bbUp - bbLo
var float avgWidth = 0.0
avgWidth := barstate.isfirst ? bbWidth : avgWidth * 0.9 + bbWidth * 0.1

// Array history
var float[] regimeScores = array.new_float(0)
array.push(regimeScores, float(totalScore))

plot(totalScore, "Score")
plot(bullBars, "Bull")
plot(bearBars, "Bear")
