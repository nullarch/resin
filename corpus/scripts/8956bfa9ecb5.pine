//@version=5
indicator("Quantum-Statistics")
// Quantum: tunneling probability proxy
barrierHeight = nz(ta.atr(3), 1.0)
particleEnergy = close - low
tunnelProb = particleEnergy > 0 and barrierHeight > 0 ? math.exp(-2.0 * barrierHeight / (particleEnergy + 0.01)) : 0.0
// Statistics: ensemble average via array
var ensemble = array.new<float>(0)
array.push(ensemble, tunnelProb)
var float ensembleAvg = 0.0
if array.size(ensemble) > 0
    total = 0.0
    for i = 0 to array.size(ensemble) - 1
        total := total + array.get(ensemble, i)
    ensembleAvg := total / array.size(ensemble)
