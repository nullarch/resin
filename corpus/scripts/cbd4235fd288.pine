
//@version=5
indicator("Wt Map Sum")
var weights = map.new<string, float>()
map.put(weights, "rsi", 0.4)
map.put(weights, "macd", 0.3)
map.put(weights, "trend", 0.3)
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
[m, s, h] = ta.macd(close, 3, 5, 3)
rsiScore = rsi > 50 ? 1.0 : -1.0
macdScore = h > 0 ? 1.0 : -1.0
trendScore = close > sma3 ? 1.0 : -1.0
var scores = map.new<string, float>()
map.put(scores, "rsi", rsiScore)
map.put(scores, "macd", macdScore)
map.put(scores, "trend", trendScore)
weighted = 0.0
for [k, w] in weights
    sc = map.get(scores, k, 0.0)
    weighted := weighted + w * sc
plot(weighted, "Wt")
