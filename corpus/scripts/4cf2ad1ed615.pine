//@version=5
indicator("AllFeat 005")
var buckets = map.new<string, int>()
var prices = array.new_float(0)
map.put(buckets, "lo", 0)
map.put(buckets, "hi", 0)
array.push(prices, close)
bucket = close > 106 ? "hi" : "lo"
prev = nz(map.get(buckets, bucket), 0)
map.put(buckets, bucket, prev + 1)
avg = 0.0
cnt = array.size(prices)
idx = 0
while idx < cnt
    avg := avg + array.get(prices, idx)
    idx := idx + 1
avg := cnt > 0 ? avg / cnt : 0.0
for i = 0 to 2
    avg := avg + 0.0
