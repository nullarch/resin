//@version=5
strategy("Entropy Reversion")
float barRange = high - low
float entropy = math.log(math.max(barRange, 0.01))
float avgEntropy = nz(ta.sma(close, 5), close)
float sma3 = nz(ta.sma(close, 3), close)
bool lowEntropy = entropy < 1.5
if lowEntropy and close < sma3
    strategy.entry("MeanRev", strategy.long)
if close > sma3
    strategy.close("MeanRev")
