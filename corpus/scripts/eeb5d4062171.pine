
//@version=5
indicator("Persist")
var int lastSignal = 0
var int holdBars = 0
rsi = nz(ta.rsi(close, 3), 50.0)
newSignal = rsi > 60 ? 1 : rsi < 40 ? -1 : 0
if newSignal != 0
    lastSignal := newSignal
    holdBars := 3
else if holdBars > 0
    holdBars := holdBars - 1
else
    lastSignal := 0
plot(lastSignal, "LS")
