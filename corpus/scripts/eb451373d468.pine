//@version=5
indicator("MultiUdfArrTernEnum")
enum Signal
    Buy = 1
    Sell = -1
    Hold = 0
scoreMomentum(val) =>
    val > 0 ? 1.0 : val < 0 ? -1.0 : 0.0
scoreVolume(vol) =>
    vol > 1100 ? 1.0 : -1.0
arr = array.new_float(0)
array.push(arr, scoreMomentum(close - open))
array.push(arr, scoreVolume(volume))
total = array.sum(arr)
sig = total > 0 ? Signal.Buy : total < 0 ? Signal.Sell : Signal.Hold
code = switch sig
    Signal.Buy => 1.0
    Signal.Sell => -1.0
    => 0.0
plot(code, "Sig")
