
//@version=5
indicator("M5000")
type TradingState
    float score = 0.0
    int bullBars = 0
    float maxScore = -999.0

var TradingState ts = TradingState.new()
var metrics = map.new<string, float>()
var float[] scoreHistory = array.new_float(0)

sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema3 = ta.ema(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
[macdL, sigL, histL] = ta.macd(close, 3, 5, 3)

trendScore = sma5 > 0 ? (sma3 - sma5) / sma5 * 100 : 0.0
momScore = (rsi - 50) / 50
volRatio = avgATR > 0 ? atr / avgATR : 1.0
macdSignal = histL > 0 ? 1.0 : -1.0

map.put(metrics, "trend", trendScore)
map.put(metrics, "momentum", momScore * 30)
map.put(metrics, "volatility", volRatio * 10)
map.put(metrics, "macd", macdSignal * 5)

composite = 0.0
for [k, v] in metrics
    composite := composite + v
composite := composite / 4

weight = switch
    volRatio > 1.5 => 0.5
    volRatio > 1.0 => 0.8
    => 1.0

adjustedScore = composite * weight

array.push(scoreHistory, adjustedScore)
if array.size(scoreHistory) > 8
    array.shift(scoreHistory)
avgScore = array.size(scoreHistory) > 0 ? array.avg(scoreHistory) : 0.0

ts.score := adjustedScore
ts.maxScore := math.max(ts.maxScore, adjustedScore)
if adjustedScore > 3
    ts.bullBars := ts.bullBars + 1

improving = adjustedScore > avgScore

plot(adjustedScore, "Score")
plot(ts.bullBars, "BB")
plot(improving ? 1 : 0, "Imp")
