
//@version=5
indicator("UDT Perceptron")
type Neuron
    float weight1 = 0.0
    float weight2 = 0.0
    float bias = 0.0
    float output = 0.0
n = Neuron.new()
n.weight1 := 0.4
n.weight2 := -0.6
n.bias := 0.1
inp1 = (close - 100.0) / 10.0
inp2 = (volume - 1000.0) / 500.0
z = n.weight1 * inp1 + n.weight2 * inp2 + n.bias
n.output := math.max(z, 0.0)
plot(n.output, "NOut")
