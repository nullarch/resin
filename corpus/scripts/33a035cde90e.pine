
//@version=5
indicator("FilterSwitch")
smaVal = ta.sma(close, 3)
emaVal = ta.ema(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
mode = rsi > 60 ? 1 : rsi < 40 ? -1 : 0
filtered = switch mode
    1 => nz(emaVal, close)
    -1 => nz(smaVal, close)
    => (nz(emaVal, close) + nz(smaVal, close)) / 2.0
plot(filtered, "F")
