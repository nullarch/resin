
//@version=5
indicator("Momentum System")
// Multi-MA trend
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
hma5 = ta.hma(close, 5)

// Momentum indicators
rsiVal = ta.rsi(close, 3)
[macdLine, sigLine, hist] = ta.macd(close, 3, 5, 3)
chg = ta.change(close, 1)
roc = ta.roc(close, 3)

// Volatility
atrVal = ta.atr(3)
[bbMid, bbUp, bbLo] = ta.bb(close, 5, 2.0)
bbPctB = (close - bbLo) / (bbUp - bbLo)

// Composite score
tScore = (close > sma3 ? 1 : 0) + (close > ema5 ? 1 : 0) + (close > hma5 ? 1 : 0)
mScore = (rsiVal > 50 ? 1 : 0) + (hist > 0 ? 1 : 0) + (roc > 0 ? 1 : 0)
totalScore = tScore + mScore

// State
var int maxScore = 0
var int minScore = 6
var int totalBars = 0
totalBars := totalBars + 1
if totalScore > maxScore
    maxScore := totalScore
if totalScore < minScore
    minScore := totalScore

// Data structures
var float[] scoreArr = array.new_float(0)
array.push(scoreArr, float(totalScore))
var m = map.new<string, float>()
map.put(m, "trend", float(tScore))
map.put(m, "momentum", float(mScore))
map.put(m, "total", float(totalScore))

plot(totalScore, "Score")
plot(maxScore, "Max")
