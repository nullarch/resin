
//@version=5
indicator("RS Hist")
var float[] rsHist = array.new_float(0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rs = sma5 > 0 ? sma3 / sma5 * 100 : 100.0
array.push(rsHist, rs)
if array.size(rsHist) > 10
    array.shift(rsHist)
avgRS = array.size(rsHist) > 0 ? array.avg(rsHist) : 100.0
improving = rs > avgRS
plot(improving ? 1 : 0, "Imp")
