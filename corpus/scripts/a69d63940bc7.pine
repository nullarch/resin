
//@version=5
indicator("Multi Calc")
sumClose = 0.0
sumVol = 0.0
count = 0
for i = 0 to 4
    c = close[i]
    v = volume[i]
    if not na(c) and not na(v)
        sumClose := sumClose + c
        sumVol := sumVol + v
        count := count + 1
avgClose = count > 0 ? sumClose / count : close
avgVol = count > 0 ? sumVol / count : volume
plot(avgClose, "AvgClose")
