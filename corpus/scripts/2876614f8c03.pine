//@version=5
indicator("Genetic-Ecology Model")
// Genetics: allele frequency drift
alleleMomentum = nz(ta.rsi(close, 3), 50.0) / 100.0
// Ecology: population carrying capacity
carryingCapacity = ta.sma(volume, 3)
populationSize = not na(carryingCapacity) ? carryingCapacity * alleleMomentum : 500.0
var float geneticDiversity = 1.0
if populationSize > 0
    geneticDiversity := math.log(populationSize + 1) / 10.0
