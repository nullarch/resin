//@version=5
indicator("Switch Complex")
trend = ta.ema(close, 5) - ta.ema(close, 10)
atrVal = ta.atr(5)
signal = switch
    trend > 2 =>
        strength = nz(atrVal) > 0 ? trend / nz(atrVal) : 0.0
        math.min(strength, 3.0)
    trend > 0 => 1.0
    trend > -2 => -1.0
    =>
        strength = nz(atrVal) > 0 ? math.abs(trend) / nz(atrVal) : 0.0
        -math.min(strength, 3.0)
plot(signal)
