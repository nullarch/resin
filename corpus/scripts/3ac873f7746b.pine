//@version=5
indicator("RSI BB Combo")
rsi5 = ta.rsi(close, 5)
[bbU, bbM, bbL] = ta.bb(close, 5, 2.0)
rsiOB = not na(rsi5) and nz(rsi5) > 70
priceAboveBB = not na(bbU) and close > nz(bbU)
strongSell = rsiOB and priceAboveBB
rsiOS = not na(rsi5) and nz(rsi5) < 30
priceBelowBB = not na(bbL) and close < nz(bbL)
strongBuy = rsiOS and priceBelowBB
