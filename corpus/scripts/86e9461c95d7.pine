//@version=5
strategy("Ultimate All-Domain")
// Physics: gravitational potential energy
mass = volume / 100.0
height = close - low
gravPE = mass * 9.81 * height
// Chemistry: reaction equilibrium constant
temp = (high + low) / 2
keq = math.exp(-5000.0 / (temp + 273.0))
// Biology: logistic growth
var float population = 10.0
growthRate = 0.3
carrying = 1000.0
population := population + growthRate * population * (1.0 - population / carrying)
// Geology: erosion rate
rainfall = volume / 200.0
slopeAngle = nz(ta.atr(3), 1.0)
erosion = rainfall * slopeAngle * 0.05
// Astronomy: luminosity from distance
starDist = close * 10.0
luminosity = starDist > 0 ? 1000.0 / (starDist * starDist) * 1000000.0 : 0.0
// Engineering: system efficiency
inputPower = gravPE + luminosity
outputPower = inputPower * keq
efficiency = inputPower > 0 ? outputPower / inputPower * 100.0 : 0.0
// Combined system score via UDF
systemScore(eff, pop, ero) =>
    effNorm = math.min(eff, 100.0) / 100.0
    popNorm = math.min(pop, carrying) / carrying
    eroNorm = 1.0 - math.min(ero, 10.0) / 10.0
    (effNorm + popNorm + eroNorm) / 3.0
score = systemScore(efficiency, population, erosion)
// Strategy: invest when system is healthy
if score > 0.5
    strategy.entry("Invest", strategy.long)
if score <= 0.3
    strategy.close("Invest")
// Store all metrics in map
var metrics = map.new<string, float>()
map.put(metrics, "gravity", gravPE)
map.put(metrics, "keq", keq)
map.put(metrics, "population", population)
map.put(metrics, "erosion", erosion)
map.put(metrics, "luminosity", luminosity)
map.put(metrics, "efficiency", efficiency)
map.put(metrics, "score", score)
// Track in array
var scores = array.new<float>(0)
array.push(scores, score)
var float avgScore = 0.0
if array.size(scores) > 0
    scoreSum = 0.0
    for i = 0 to array.size(scores) - 1
        scoreSum := scoreSum + array.get(scores, i)
    avgScore := scoreSum / array.size(scores)
