
//@version=5
indicator("Vol Accum")
targetVol = ta.sma(volume, 5) * 3
accumulated = 0.0
barsNeeded = 0
iters = 0
while accumulated < targetVol and iters < 8
    v = volume[iters]
    if not na(v)
        accumulated := accumulated + v
    barsNeeded := barsNeeded + 1
    iters := iters + 1
plot(barsNeeded, "Bars")
