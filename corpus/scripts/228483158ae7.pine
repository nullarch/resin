
//@version=5
indicator("MILESTONE 3000")
// === TA Indicators ===
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
wma5 = ta.wma(close, 5)
rsiVal = ta.rsi(close, 3)
atrVal = ta.atr(3)
[macdLine, sigLine, hist] = ta.macd(close, 3, 5, 3)
[bbMid, bbUp, bbLo] = ta.bb(close, 5, 2.0)

// === Enum ===
enum Regime
    Bull = 2
    Neutral = 0
    Bear = -2

// === Classification ===
trendScore = (close > sma3 ? 1 : 0) + (sma3 > ema5 ? 1 : 0) + (close > wma5 ? 1 : 0)
momScore = (rsiVal > 50 ? 1 : 0) + (hist > 0 ? 1 : 0)
composite = trendScore + momScore

regime = composite >= 4 ? Regime.Bull : composite <= 1 ? Regime.Bear : Regime.Neutral

// === Switch ===
weight = switch regime
    Regime.Bull => 1.5
    Regime.Bear => 0.5
    => 1.0

// === State (var) ===
var int totalBars = 0
var int bullBars = 0
var int bearBars = 0
var float maxComposite = 0.0
var float minComposite = 5.0
totalBars := totalBars + 1
if int(regime) > 0
    bullBars := bullBars + 1
else if int(regime) < 0
    bearBars := bearBars + 1
if float(composite) > maxComposite
    maxComposite := float(composite)
if float(composite) < minComposite
    minComposite := float(composite)

// === Array ===
var float[] compositeHistory = array.new_float(0)
array.push(compositeHistory, float(composite))
if array.size(compositeHistory) > 10
    array.shift(compositeHistory)
avgComposite = array.avg(compositeHistory)
medComposite = array.median(compositeHistory)

// === Map ===
var m = map.new<string, float>()
map.put(m, "composite", float(composite))
map.put(m, "avg", avgComposite)
map.put(m, "bulls", float(bullBars))
map.put(m, "bears", float(bearBars))

// === For loop ===
lookbackMax = 0.0
for i = 0 to 4
    val = close[i]
    if not na(val) and val > lookbackMax
        lookbackMax := val

// === String ===
summary = "C:" + str.tostring(composite) + " R:" + str.tostring(int(regime))

// === Plots ===
plot(composite, "Composite")
plot(avgComposite, "Avg")
plot(bullBars, "Bulls")
plot(bearBars, "Bears")
