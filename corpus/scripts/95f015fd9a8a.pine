//@version=5
indicator("Product Category")
type Pair
    float first = 0.0
    float second = 0.0
method project1(Pair this) =>
    this.first
method project2(Pair this) =>
    this.second
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float smaVal = nz(ta.sma(close, 3), close)
obs = Pair.new(rsiVal, smaVal)
float p1 = obs.project1()
float p2 = obs.project2()
float combined = p1 / 100.0 + p2 / math.max(close, 0.01)
