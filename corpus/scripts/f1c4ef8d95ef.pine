
//@version=5
indicator("Sig Grade E")
enum SigGrade
    AAA = 3
    AA = 2
    A = 1
    B = 0
    C = -1

sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
score = (close > sma3 ? 1 : 0) + (sma3 > sma5 ? 1 : 0) + (rsi > 55 ? 1 : 0) + (volume > ta.sma(volume, 5) ? 1 : 0)
sg = switch score
    4 => SigGrade.AAA
    3 => SigGrade.AA
    2 => SigGrade.A
    1 => SigGrade.B
    => SigGrade.C
plot(int(sg), "SG")
