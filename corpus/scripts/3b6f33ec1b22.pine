
//@version=5
indicator("WhileScan")
var float[] prices = array.new_float(0)
array.push(prices, close)
if array.size(prices) > 5
    array.shift(prices)

idx = 0
eventsFound = 0
while idx < array.size(prices)
    val = array.get(prices, idx)
    if val > 106
        eventsFound := eventsFound + 1
    idx := idx + 1
plot(eventsFound, "EF")
