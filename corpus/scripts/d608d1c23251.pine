
//@version=5
indicator("WhileSearch")
var int[] signals = array.new_int(0)
sig = close > open ? 1 : 0
array.push(signals, sig)
if array.size(signals) > 8
    array.shift(signals)
int idx = 0
int found = -1
while idx < array.size(signals) and found == -1
    val = array.get(signals, idx)
    found := val == 1 ? idx : -1
    idx := idx + 1
plot(found, "Fnd")
