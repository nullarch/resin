//@version=5
indicator("Torture 1")
enum Regime
    Bull = 1
    Bear = 2
    Flat = 3
type Signal
    float score = 0.0
    string label = "none"
method classify(Signal this) =>
    this.score > 1.0 ? "strong" : this.score > 0.0 ? "weak" : "none"
var float cumScore = 0.0
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float smaVal = nz(ta.sma(close, 3), close)
float regime = switch
    close > smaVal and rsiVal > 55 => 1.0
    close < smaVal and rsiVal < 45 => 2.0
    => 3.0
scores = array.new<float>(0)
scores.push(rsiVal / 50.0 - 1.0)
scores.push((close - smaVal) / math.max(math.abs(smaVal), 0.01))
float totalScore = 0.0
for sc in scores
    totalScore := totalScore + sc
sig = Signal.new(totalScore, "test")
string classification = sig.classify()
cumScore := cumScore + totalScore
