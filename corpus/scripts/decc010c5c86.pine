//@version=5
indicator("Mutual Info Proxy")
var float miProxy = 0.0
priceNorm = (close - low) / (high - low > 0.01 ? high - low : 0.01)
volNorm = volume / 2000.0
joint = priceNorm * volNorm
margP = priceNorm > 0.01 ? priceNorm : 0.01
margV = volNorm > 0.01 ? volNorm : 0.01
safeJoint = joint > 0.0001 ? joint : 0.0001
miProxy := safeJoint * math.log(safeJoint / (margP * margV))
