
//@version=5
indicator("Level Str UDF")
levelStr(float price, float level, float atr) =>
    dist = math.abs(price - level)
    atr > 0 ? dist / atr : 0.0

hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
atr = nz(ta.atr(3), 1.0)
resistStr = levelStr(close, hi5, atr)
supportStr = levelStr(close, lo5, atr)
plot(resistStr - supportStr, "LS")
