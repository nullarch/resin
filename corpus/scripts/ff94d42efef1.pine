//@version=5
strategy("Econ-Game Theory")
// Economics: supply-demand equilibrium
supplyProxy = ta.sma(volume, 3)
demandProxy = ta.ema(volume, 3)
// Game theory: best response based on opponent signal
marketSignal = nz(ta.rsi(close, 3), 50.0)
cooperate = marketSignal > 50.0
// Nash equilibrium: enter when cooperating, exit when defecting
if not na(supplyProxy) and not na(demandProxy) and cooperate
    strategy.entry("Cooperate", strategy.long)
if not cooperate
    strategy.close("Cooperate")
