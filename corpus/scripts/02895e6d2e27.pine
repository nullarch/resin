
//@version=5
indicator("Bin Search")
lo = ta.lowest(close, 5)
hi = ta.highest(close, 5)
target = ta.sma(close, 3)
iterations = 0
while hi - lo > 0.001 and iterations < 50
    mid = (lo + hi) / 2.0
    if mid < target
        lo := mid
    else
        hi := mid
    iterations := iterations + 1
plot(lo, "Found")
plot(iterations, "Iters")
