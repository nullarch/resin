
//@version=5
indicator("UDT Copy")
type Config
    float threshold = 1.0
    float multiplier = 2.0
    int period = 5

var Config base = Config.new()
adjusted = Config.copy(base)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
adjusted.threshold := avgATR > 0 ? atr / avgATR : 1.0
adjusted.multiplier := adjusted.threshold > 1.5 ? 1.5 : 2.0
plot(adjusted.multiplier, "Mult")
