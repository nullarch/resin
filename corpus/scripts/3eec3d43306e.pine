
//@version=5
indicator("Cond Full")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
[m, s, h] = ta.macd(close, 3, 5, 3)

// Nested ternary
trendSig = close > sma3 ? (rsi > 55 ? 2.0 : 1.0) : (rsi < 45 ? -2.0 : -1.0)

// If expression
macdSig = if h > 0
    h > h[1] ? 1.5 : 0.5
else
    h < h[1] ? -1.5 : -0.5

// Switch
regime = switch
    trendSig > 1 and macdSig > 1 => "strong_bull"
    trendSig > 0 => "bull"
    trendSig < -1 and macdSig < -1 => "strong_bear"
    => "neutral"

composite = (trendSig + nz(macdSig, 0.0)) / 2

var int bars = 0
bars := bars + 1

plot(composite, "Comp")
