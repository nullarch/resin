//@version=5
indicator("Loop Unrolling Array")
weights = array.new<float>(0)
weights.push(0.5)
weights.push(0.3)
weights.push(0.2)
prices = array.new<float>(0)
prices.push(close)
prices.push(open)
prices.push(high)
float weighted = 0.0
for i = 0 to weights.size() - 1
    weighted := weighted + array.get(weights, i) * array.get(prices, i)
