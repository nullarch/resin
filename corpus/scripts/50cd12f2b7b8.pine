
//@version=5
indicator("UDT Methods")
type Counter
    int value = 0
    int maxVal = 0

method increment(Counter c) =>
    c.value := c.value + 1
    if c.value > c.maxVal
        c.maxVal := c.value

method reset(Counter c) =>
    c.value := 0

var Counter cnt = Counter.new()
cnt.increment()
if close < open
    cnt.reset()
plot(cnt.maxVal, "Max")
