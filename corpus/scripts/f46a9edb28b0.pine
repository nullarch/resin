
//@version=5
indicator("Kelly")
var int wins = 0
var int losses = 0
var float totalWin = 0.0
var float totalLoss = 0.0
gain = close - close[1]
if not na(gain)
    if gain > 0
        wins := wins + 1
        totalWin := totalWin + gain
    else if gain < 0
        losses := losses + 1
        totalLoss := totalLoss + math.abs(gain)
winRate = wins + losses > 0 ? float(wins) / (wins + losses) : 0.5
avgWin = wins > 0 ? totalWin / wins : 1.0
avgLoss = losses > 0 ? totalLoss / losses : 1.0
rrRatio = avgLoss > 0 ? avgWin / avgLoss : 1.0
kelly = winRate - (1 - winRate) / rrRatio
plot(kelly, "K")
