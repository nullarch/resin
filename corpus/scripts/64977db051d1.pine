
//@version=5
indicator("Levels")
var levels = map.new<string, float>()
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
map.put(levels, "resistance", hi5)
map.put(levels, "support", lo5)
map.put(levels, "pivot", (hi5 + lo5 + close) / 3.0)
pivot = map.get(levels, "pivot", close)
abovePivot = close > pivot
plot(pivot, "Pivot")
