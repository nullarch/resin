//@version=5
indicator("CompositeRisk")
clamp01(val) =>
    math.max(0.0, math.min(1.0, val))
c1 = nz(close[1], close)
c2 = nz(close[2], close)
rawDelta = c1 > 0 ? math.abs((close - c1) / c1) : 0.0
rawGamma = math.abs(close - 2.0 * c1 + c2)
rawVega = nz(ta.stdev(close, 5), 1.0)
rawTheta = (high - low) / math.max(close, 1.0)
scores = array.new_float(0)
array.push(scores, clamp01(rawDelta * 50.0))
array.push(scores, clamp01(rawGamma / 5.0))
array.push(scores, clamp01(rawVega / 10.0))
array.push(scores, clamp01(rawTheta))
total = 0.0
for [idx, sc] in scores
    total := total + sc
composite = total / 4.0
plot(composite, "Risk")
