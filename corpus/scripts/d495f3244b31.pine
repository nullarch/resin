
//@version=5
indicator("Vol System")
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
[bbM, bbU, bbL] = ta.bb(close, 5, 2.0)

// Volatility metrics
atrRatio = avgATR > 0 ? atr / avgATR : 1.0
bbWidth = bbM > 0 ? (bbU - bbL) / bbM : 0.0

// Store in map
var m = map.new<string, float>()
map.put(m, "atr_ratio", atrRatio)
map.put(m, "bb_width", bbWidth)

// Track in array
var float[] volHistory = array.new_float(0)
array.push(volHistory, atrRatio)
if array.size(volHistory) > 8
    array.shift(volHistory)
volTrend = array.avg(volHistory)

// Regime classification
regime = atrRatio > 2.0 ? 3 : atrRatio > 1.3 ? 2 : atrRatio > 0.7 ? 1 : 0

var int bars = 0
bars := bars + 1

plot(atrRatio, "ATR_R")
plot(regime, "Regime")
