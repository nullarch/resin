
//@version=5
indicator("Enum Switch")
enum Signal
    StrongBuy = 2
    Buy = 1
    Hold = 0
    Sell = -1
    StrongSell = -2

rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
score = (close > sma3 ? 1 : -1) + (sma3 > sma5 ? 1 : -1) + (rsi > 55 ? 1 : rsi < 45 ? -1 : 0)
sig = switch
    score >= 2 => Signal.StrongBuy
    score == 1 => Signal.Buy
    score <= -2 => Signal.StrongSell
    score == -1 => Signal.Sell
    => Signal.Hold
plot(int(sig), "S")
