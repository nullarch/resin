
//@version=5
indicator("MultiTrig")
var int trigA = 0
var int trigB = 0
var int trigC = 0

rsi = nz(ta.rsi(close, 3), 50.0)
sma5 = ta.sma(close, 5)

if close > open
    trigA := 1
else
    trigA := 0

if rsi > 55
    trigB := 1
else
    trigB := 0

if close > sma5
    trigC := 1
else
    trigC := 0

combined = trigA + trigB + trigC
plot(combined, "CM")
