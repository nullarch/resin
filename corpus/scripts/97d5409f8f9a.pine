//@version=5
indicator("FE04")
var float bestVal = 0.0
scores = map.new<string, float>()
map.put(scores, "alpha", close)
map.put(scores, "beta", open)
map.put(scores, "gamma", high)
keys = map.keys(scores)
mx = 0.0
for [idx, k] in keys
    val = map.get(scores, k)
    v = nz(val, 0.0)
    mx := math.max(mx, v)
bestVal := mx > 100 ? mx : 0.0
