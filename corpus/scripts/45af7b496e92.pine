
//@version=5
indicator("Stress13")
type Particle
    float position = 0.0
    float velocity = 0.0
    string state = "ACTIVE"
evolve(pos, vel) =>
    pos + vel * 0.1
p = Particle.new()
p.position := close
p.velocity := close - open
positions = array.new_float(0)
for step = 1 to 5
    p.position := evolve(p.position, p.velocity)
    p.velocity := p.velocity * 0.95
    array.push(positions, p.position)
iterations = 0
energy = math.abs(p.velocity)
while energy > 0.01 and iterations < 20
    energy := energy * 0.8
    iterations := iterations + 1
p.state := switch
    iterations > 10 => "DECAYED"
    iterations > 5 => "DAMPED"
    => "ACTIVE"
msg = "State:" + p.state + " Steps:" + str.tostring(iterations)
plot(array.sum(positions) + float(str.length(msg)), "S13")
