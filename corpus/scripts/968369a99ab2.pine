//@version=5
indicator("Comprehensive Epidemic")
calcR0(contactRate, recovDays) =>
    contactRate * recovDays
var float suscept = 900.0
var float infect = 80.0
var float recov = 20.0
var float vaccinated = 0.0
float pop = 1000.0
float beta = 0.25
float gamma = 0.1
float dailyVax = volume / 5000.0
vaccinated := math.min(vaccinated + dailyVax, suscept)
suscept := math.max(suscept - dailyVax, 0.0)
float newInf = beta * suscept * infect / pop
float newRec = gamma * infect
suscept := math.max(suscept - newInf, 0.0)
infect := math.max(infect + newInf - newRec, 0.0)
recov := recov + newRec
float r0 = calcR0(beta * pop / (suscept + 1.0), 1.0 / gamma)
float herdThresh = r0 > 1.0 ? (1.0 - 1.0 / r0) * 100.0 : 0.0
float vaxCoverage = vaccinated / pop * 100.0
status = switch
    infect > 100 => "outbreak"
    infect > 50 => "elevated"
    infect > 10 => "moderate"
    => "controlled"
