//@version=5
indicator("SIR Model")
var float susceptible = 990.0
var float infected = 10.0
var float recovered = 0.0
float beta = 0.3
float gamma = 0.1
float population = 1000.0
float newInfected = beta * susceptible * infected / population
float newRecovered = gamma * infected
susceptible := math.max(susceptible - newInfected, 0.0)
infected := math.max(infected + newInfected - newRecovered, 0.0)
recovered := recovered + newRecovered
