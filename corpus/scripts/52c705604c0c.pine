//@version=5
indicator("Comprehensive 119")
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi5 = ta.rsi(close, 5)
atrVal = ta.atr(3)
[upper, mid, lower] = ta.bb(close, 5, 2.0)
[macdLine, signalLine, hist] = ta.macd(close, 12, 26, 9)
highest5 = ta.highest(high, 5)
lowest5 = ta.lowest(low, 5)
var float maxRSI = 0.0
var int barCount = 0
if not na(rsi5) and rsi5 > maxRSI
    maxRSI := rsi5
crossUp = ta.crossover(sma3, ema5)
fib618 = nz(lowest5) + (nz(highest5) - nz(lowest5)) * 0.618
safeDiv = close / nz(sma3, 1.0)
barCount := barCount + 1
