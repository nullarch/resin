//@version=5
indicator("AllFeat 012")
enum Quality
    High
    Medium
    Low
type Assessment
    string label
    float score
rate(v) =>
    switch
        v > 8.0 => "excellent"
        v > 4.0 => "good"
        => "poor"
var assessments = array.new_string(0)
var float cumScore = 0.0
spread = high - low
rating = rate(spread)
array.push(assessments, rating)
scoreVal = 0.0
for i = 0 to array.size(assessments) - 1
    item = array.get(assessments, i)
    scoreVal := scoreVal + (item == "excellent" ? 3.0 : item == "good" ? 2.0 : 1.0)
cumScore := scoreVal
