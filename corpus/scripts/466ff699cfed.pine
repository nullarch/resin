//@version=5
strategy("AllFeat 016", overlay=true)
enum Mode
    Aggressive
    Conservative
type Config
    float threshold
    int mode
var float cumPnl = 0.0
var int barNum = 0
barNum := barNum + 1
threshold = barNum > 5 ? 55.0 : 60.0
rsiVal = nz(ta.rsi(close, 3), 50.0)
sum = 0.0
for i = 0 to 4
    sum := sum + (i + 1) * 1.0
idx = 0
while idx < 2
    sum := sum + 0.0
    idx := idx + 1
if rsiVal > threshold
    strategy.entry("L", strategy.long)
    cumPnl := cumPnl + 1.0
