
//@version=5
indicator("Stat Regime")
enum StatRegime
    LowVol = 0
    Normal = 1
    HighVol = 2
    Extreme = 3

sd = ta.stdev(close, 5)
avgSD = ta.sma(sd, 3)
ratio = avgSD > 0 ? sd / avgSD : 1.0
regime = ratio > 2.0 ? StatRegime.Extreme : ratio > 1.3 ? StatRegime.HighVol : ratio > 0.7 ? StatRegime.Normal : StatRegime.LowVol
plot(int(regime), "Reg")
