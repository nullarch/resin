
//@version=5
indicator("Div Score UDF")
divScore(float price, float pricePrev, float osc, float oscPrev) =>
    priceUp = price > pricePrev
    oscUp = osc > oscPrev
    priceUp and not oscUp ? -1.0 : not priceUp and oscUp ? 1.0 : 0.0

rsi = nz(ta.rsi(close, 3), 50.0)
prevClose = nz(close[1], close)
prevRSI = nz(rsi[1], 50.0)
score = divScore(close, prevClose, rsi, prevRSI)
plot(score, "DS")
