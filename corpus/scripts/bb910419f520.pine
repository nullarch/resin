
//@version=5
indicator("Break UDT")
type BreakState
    int upBreaks = 0
    int dnBreaks = 0
    float lastBreakPrice = 0.0

var BreakState bs = BreakState.new()
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
if close > hi5[1]
    bs.upBreaks := bs.upBreaks + 1
    bs.lastBreakPrice := close
if close < lo5[1]
    bs.dnBreaks := bs.dnBreaks + 1
    bs.lastBreakPrice := close
plot(bs.upBreaks - bs.dnBreaks, "Net")
