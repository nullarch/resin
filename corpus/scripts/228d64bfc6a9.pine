
//@version=5
indicator("Autocorr")
sumProd = 0.0
count = 0
for i = 0 to 4
    c = close[i]
    cLag = close[i + 1]
    if not na(c) and not na(cLag)
        sumProd := sumProd + c * cLag
        count := count + 1
avgProd = count > 0 ? sumProd / count : 0.0
selfProd = close * close
autoCorr = selfProd > 0 ? avgProd / selfProd : 0.0
plot(autoCorr, "AC")
