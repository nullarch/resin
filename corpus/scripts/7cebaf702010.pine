//@version=5
indicator("Geomagnetic Reversal")
var int polarity = 1
var int reversals = 0
momentum = close - open
prevMom = not na(close[1]) ? close[1] - open[1] : 0.0
if momentum > 0 and prevMom < 0
    if polarity == -1
        reversals := reversals + 1
    polarity := 1
if momentum < 0 and prevMom > 0
    if polarity == 1
        reversals := reversals + 1
    polarity := -1
plot(reversals)
