//@version=5
indicator("Comprehensive C78")
var float result = 0.0

custom_avg() =>
    var float running = 0.0
    var int count = 0
    count := count + 1
    running := running + close
    running / count

float avg = custom_avg()
sma3 = ta.sma(close, 3)
float safe = nz(sma3, 0.0)

float bonus = if close > 108
    2.0
else
    0.0

result := avg + safe + bonus
