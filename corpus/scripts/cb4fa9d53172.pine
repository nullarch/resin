
//@version=5
indicator("Mom Grade")
rsi = nz(ta.rsi(close, 3), 50.0)
[m, s, h] = ta.macd(close, 3, 5, 3)
rsiBull = rsi > 50
macdBull = h > 0
grade = switch
    rsiBull and macdBull and rsi > 60 => "A+"
    rsiBull and macdBull => "A"
    rsiBull or macdBull => "B"
    => "C"
topGrade = grade == "A+" or grade == "A"
plot(topGrade ? 1 : 0, "Top")
