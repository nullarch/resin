//@version=5
strategy("Comprehensive Ocean Model")
// Physical oceanography
waveHeight = high - low
currentSpeed = nz(ta.atr(3), 1.0)
surfaceTemp = (high + low) / 2
// Chemistry
co2Absorption = volume / 200.0
phLevel = 8.1 - co2Absorption * 0.001
dissolvedO2 = 14.0 - (surfaceTemp - 95.0) * 0.3
// Biology
phyto = volume / 100.0
zoo = phyto * 0.1
fishBiomass = zoo * 0.1
// Ecosystem health UDF
ecoHealth(ph, oxygen, biomass) =>
    phScore = ph > 7.8 ? 1.0 : 0.5
    o2Score = oxygen > 6.0 ? 1.0 : 0.5
    bioScore = biomass > 0.05 ? 1.0 : 0.5
    (phScore + o2Score + bioScore) / 3.0
health = ecoHealth(phLevel, dissolvedO2, fishBiomass)
// Marine protection strategy
if health < 0.7
    strategy.entry("Protect", strategy.long)
if health >= 0.9
    strategy.close("Protect")
// Store in map
var oceanData = map.new<string, float>()
map.put(oceanData, "wave", waveHeight)
map.put(oceanData, "current", currentSpeed)
map.put(oceanData, "health", health)
map.put(oceanData, "ph", phLevel)
var int dataPoints = 0
dataPoints := map.size(oceanData)
