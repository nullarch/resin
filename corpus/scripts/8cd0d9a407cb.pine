
//@version=5
indicator("Nested CF")
var int state = 0
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
if close > sma3
    if rsi > 60
        state := 2
    else if rsi > 50
        state := 1
    else
        state := 0
else
    if rsi < 40
        state := -2
    else
        state := -1
plot(state, "St")
