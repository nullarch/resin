//@version=5
indicator("Mega 16")
percentRank(float val, float lo, float hi) =>
    hi > lo + 0.01 ? (val - lo) / (hi - lo) * 100.0 : 50.0
var float highWater = 0.0
float sma3 = nz(ta.sma(close, 3), close)
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float atrVal = nz(ta.atr(3), 1.0)
values = array.new<float>(0)
values.push(close)
values.push(sma3)
values.push(close + atrVal)
values.push(close - atrVal)
values.sort()
float lo = values.get(0)
float hi = values.get(values.size() - 1)
float rank = percentRank(close, lo, hi)
int bucket = 0
switch
    rank > 75.0 =>
        bucket := 3
    rank > 50.0 =>
        bucket := 2
    rank > 25.0 =>
        bucket := 1
    =>
        bucket := 0
highWater := math.max(highWater, rank)
float signal = bucket >= 2 ? rsiVal * 0.01 : -rsiVal * 0.01
if math.abs(signal) > 0.3
    float amplified = signal * 1.5
