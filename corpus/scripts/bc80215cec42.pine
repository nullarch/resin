//@version=5
indicator("TransferEntropy")
var float pUp = 0.5
var float pUpGivenVolUp = 0.5
var int totalBars = 0
var int upBars = 0
var int volUpAndPriceUp = 0
var int volUpBars = 0
totalBars := totalBars + 1
priceUp = close > nz(close[1], close) ? 1 : 0
volUp = volume > nz(volume[1], volume) ? 1 : 0
upBars := upBars + priceUp
if volUp == 1
    volUpBars := volUpBars + 1
    volUpAndPriceUp := volUpAndPriceUp + priceUp
pUp := totalBars > 0 ? float(upBars) / float(totalBars) : 0.5
pUpGivenVolUp := volUpBars > 0 ? float(volUpAndPriceUp) / float(volUpBars) : 0.5
teProxy = math.abs(pUpGivenVolUp - pUp)
plot(teProxy, "TE")
