//@version=5
indicator("Betti-1")
float emaVal = nz(ta.ema(close, 3), close)
var float prevDiff = 0.0
float curDiff = close - emaVal
bool signChange = (prevDiff > 0.0 and curDiff < 0.0) or (prevDiff < 0.0 and curDiff > 0.0)
var int loops = 0
if signChange
    loops := loops + 1
prevDiff := curDiff
plot(loops, "Betti1")
