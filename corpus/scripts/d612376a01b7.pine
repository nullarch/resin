//@version=5
indicator("Jump Size Max")
float prevC = not na(close[1]) ? close[1] : close
float moveSize = math.abs(close - prevC)
float atrVal = nz(ta.atr(3), 1.0)
float normMove = atrVal > 0 ? moveSize / atrVal : 0.0
var float maxJump = 0.0
if normMove > maxJump
    maxJump := normMove
plot(maxJump, "MaxJump")
