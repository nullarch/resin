
//@version=5
strategy("Dual Exit", overlay=true)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
rsi = nz(ta.rsi(close, 3), 50.0)
var float entryPx = 0.0
if close > sma3 and rsi > 50
    strategy.entry("Long", strategy.long)
    entryPx := close
profitTarget = entryPx > 0 and close > entryPx + atr * 3
stopLoss = entryPx > 0 and close < entryPx - atr * 2
if profitTarget or stopLoss
    strategy.close("Long")
plot(sma3, "MA")
