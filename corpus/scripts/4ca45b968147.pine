
//@version=5
indicator("Micro Rpt")
avgVol = ta.sma(volume, 5)
spread = high - low
avgSp = ta.sma(spread, 5)
volTag = avgVol > 0 and volume > avgVol * 1.3 ? "HiVol" : "LoVol"
spTag = avgSp > 0 and spread > avgSp * 1.3 ? "WideSp" : "NarSp"
report = volTag + "_" + spTag
goodConditions = report == "HiVol_NarSp"
plot(goodConditions ? 1 : 0, "Good")
