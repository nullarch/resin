
//@version=5
indicator("Dashboard")
var metrics = map.new<string, float>()
prevC = nz(close[1], close)
ret = prevC > 0 ? (close - prevC) / prevC * 100 : 0.0
rsi = nz(ta.rsi(close, 3), 50.0)
atrVal = nz(ta.atr(3), 1.0)
smaVal = nz(ta.sma(close, 5), close)
trend = close > smaVal ? 1.0 : -1.0
map.put(metrics, "ret", ret)
map.put(metrics, "rsi", rsi)
map.put(metrics, "atr", atrVal)
map.put(metrics, "trend", trend)
sz = map.size(metrics)
plot(float(sz), "MS")
