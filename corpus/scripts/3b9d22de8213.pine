
//@version=5
indicator("Dashboard")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
avgVol = ta.sma(volume, 5)

trendDir = sma3 > sma5 ? "BULL" : "BEAR"
momStr = rsi > 60 ? "STRONG" : rsi < 40 ? "WEAK" : "NEUTRAL"
volRegime = avgATR > 0 and atr / avgATR > 1.3 ? "HIGH_VOL" : "LOW_VOL"
volConfirm = avgVol > 0 and volume > avgVol ? "CONFIRMED" : "UNCONFIRMED"

score = (sma3 > sma5 ? 1 : -1) + (rsi > 55 ? 1 : rsi < 45 ? -1 : 0) + (volume > avgVol ? 0.5 : 0)
plot(score, "Score")
