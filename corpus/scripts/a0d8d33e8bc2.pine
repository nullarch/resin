//@version=5
strategy("Ultra 011", overlay=true)
type Signal
    float strength = 0.0
    int direction = 0

method amplify(Signal this, float factor) =>
    this.strength := this.strength * factor
    this

var Signal sig = Signal.new(0.0, 0)
var float[] strengths = array.new_float(0)
var int entries = 0

rsiVal = nz(ta.rsi(close, 5), 50.0)
atrVal = nz(ta.atr(3), 1.0)
prevC = not na(close[1]) ? close[1] : close

sig.strength := math.abs(close - prevC)
sig.direction := close > prevC ? 1 : -1

zone = switch
    rsiVal > 65 => 2
    rsiVal > 50 => 1
    rsiVal > 35 => -1
    => -2

if zone == sig.direction or zone == sig.direction * 2
    sig.amplify(1.5)
else
    sig.amplify(0.5)

array.push(strengths, sig.strength)
if array.size(strengths) > 5
    array.shift(strengths)

avgStr = 0.0
for i = 0 to array.size(strengths) - 1
    avgStr := avgStr + array.get(strengths, i)
avgStr := array.size(strengths) > 0 ? avgStr / array.size(strengths) : 0.0

if sig.direction == 1 and avgStr > atrVal
    strategy.entry("Buy", strategy.long)
    entries := entries + 1
if sig.direction == -1
    strategy.close("Buy")
plot(avgStr)
