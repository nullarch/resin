
//@version=5
indicator("Complex UDF")
analyze(float price, float ma, float rsi, float atr, float vol, float avgVol) =>
    trendScore = ma > 0 ? (price - ma) / ma * 100 : 0.0
    momScore = (rsi - 50) / 50
    volScore = avgVol > 0 ? vol / avgVol : 1.0
    composite = trendScore * 0.4 + momScore * 30 * 0.3 + volScore * 10 * 0.3
    composite

sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgVol = ta.sma(volume, 5)
result = analyze(close, sma5, rsi, atr, volume, avgVol)
plot(result, "R")
