
//@version=5
indicator("Confirm")
var int signalBar = 0
var float signalPrice = 0.0
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
rawSignal = close > sma3 and rsi > 55
if rawSignal and signalBar == 0
    signalBar := 1
    signalPrice := close
if signalBar > 0
    signalBar := signalBar + 1
if signalBar > 3
    signalBar := 0
confirmed = signalBar >= 2 and close > signalPrice
plot(confirmed ? 1 : 0, "Conf")
