//@version=5
indicator("Bell State")
float q0 = close > open ? 1.0 : 0.0
float q1 = high > nz(ta.sma(high, 3), high) ? 1.0 : 0.0
float bellPhi00 = q0 == 0.0 and q1 == 0.0 ? 0.707 : 0.0
float bellPhi11 = q0 == 1.0 and q1 == 1.0 ? 0.707 : 0.0
float bellPhi01 = q0 == 0.0 and q1 == 1.0 ? 0.707 : 0.0
float bellPhi10 = q0 == 1.0 and q1 == 0.0 ? 0.707 : 0.0
float totalProb = bellPhi00 * bellPhi00 + bellPhi11 * bellPhi11 +
    bellPhi01 * bellPhi01 + bellPhi10 * bellPhi10
