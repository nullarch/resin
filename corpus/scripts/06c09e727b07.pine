
//@version=5
strategy("AdaptEntry", overlay=true)
rsi = nz(ta.rsi(close, 3), 50.0)
atrVal = nz(ta.atr(3), 1.0)
smaVal = nz(ta.sma(close, 3), close)
threshold = atrVal * 0.5
if close > smaVal + threshold and rsi < 70
    strategy.entry("Long", strategy.long)
if close < smaVal - threshold and rsi > 30
    strategy.entry("Short", strategy.short)
plot(close, "C")
