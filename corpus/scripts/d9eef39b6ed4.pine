//@version=5
indicator("Comprehensive 62")

// Hoisted function
add(a, b) =>
    a + b

// var persistence
var float cnt = 0.0
cnt := cnt + 1.0

// Multiple var independence
var float sum_close = 0.0
sum_close := sum_close + close

// TA state isolation
sma_a = ta.sma(close, 3)
sma_b = ta.sma(close, 5)

// Series OOB → NaN
float deep = close[50]
var bool oob_nan = na(deep)

// nz fallback
float val = nz(sma_a, close)

// Alert freq (no-op)
alertcondition(close > 108, title="Test", message="High")

// for with variable step
int step = 3
float fsum = 0.0
for i = 0 to 9 by step
    fsum := fsum + i
// 0+3+6+9 = 18

var float result = 0.0
result := cnt + add(1.0, 2.0) + nz(sma_a, 0.0) + fsum + (oob_nan ? 1.0 : 0.0)
plot(close)
