
//@version=5
indicator("Sig Class")
classifySignal(float score) =>
    score > 0.5 ? "strong_buy" : score > 0.1 ? "buy" : score < -0.5 ? "strong_sell" : score < -0.1 ? "sell" : "hold"

rsi = nz(ta.rsi(close, 3), 50.0)
score = (rsi - 50) / 50
cls = classifySignal(score)
isStrong = str.contains(cls, "strong")
plot(isStrong ? 1 : 0, "Strong")
