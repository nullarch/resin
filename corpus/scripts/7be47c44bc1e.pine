
//@version=5
indicator("Map UDF")
normalizeVal(float val, float range_) =>
    range_ > 0 ? val / range_ : 0.0

var data = map.new<string, float>()
atr = ta.atr(3)
map.put(data, "body", math.abs(close - open))
map.put(data, "range", high - low)
map.put(data, "volume_rel", ta.sma(volume, 5) > 0 ? volume / ta.sma(volume, 5) : 1.0)
normBody = normalizeVal(map.get(data, "body", 0.0), map.get(data, "range", 1.0))
plot(normBody, "NB")
