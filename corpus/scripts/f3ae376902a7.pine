
//@version=5
indicator("Div Map")
var dm = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
map.put(dm, "rsi_dir", rsi > 50 ? 1.0 : -1.0)
map.put(dm, "price_dir", close > close[1] ? 1.0 : -1.0)
map.put(dm, "vol_dir", volume > volume[1] ? 1.0 : -1.0)
divCount = 0
priceDir = close > close[1] ? 1.0 : -1.0
for [k, v] in dm
    if k != "price_dir" and v != priceDir
        divCount := divCount + 1
plot(divCount, "DC")
