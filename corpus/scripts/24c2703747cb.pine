
//@version=5
indicator("PctRank")
var float[] window = array.new_float(0)
array.push(window, close)
if array.size(window) > 5
    array.shift(window)
belowCount = 0
for [i, v] in window
    if v <= close
        belowCount := belowCount + 1
sz = array.size(window)
pctRank = sz > 0 ? float(belowCount) / float(sz) * 100 : 50.0
plot(pctRank, "PR")
