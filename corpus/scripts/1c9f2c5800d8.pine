
//@version=5
indicator("CompEvt")
isCompoundEvent(float rsiVal, float priceVsMA, bool volHigh) =>
    score = 0
    score := score + (rsiVal > 55 ? 1 : 0)
    score := score + (priceVsMA > 0 ? 1 : 0)
    score := score + (volHigh ? 1 : 0)
    score >= 2

rsi = nz(ta.rsi(close, 3), 50.0)
sma5 = ta.sma(close, 5)
diff = close - sma5
isEvt = isCompoundEvent(rsi, diff, volume > 1000)
plot(isEvt ? 1 : 0, "CE")
