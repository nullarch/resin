//@version=5
strategy("KalStrat10")
var float fastEst = 100.0
var float slowEst = 100.0
fastEst := fastEst + 0.4 * (close - fastEst)
slowEst := slowEst + 0.1 * (close - slowEst)
if fastEst > slowEst and close > open
    strategy.entry("L", strategy.long)
if fastEst < slowEst and close < open
    strategy.entry("S", strategy.short)
