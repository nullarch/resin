
//@version=5
indicator("Div Track")
var int bullDivs = 0
var int bearDivs = 0
rsi = nz(ta.rsi(close, 3), 50.0)
priceUp = not na(close[3]) and close > close[3]
priceDn = not na(close[3]) and close < close[3]
if priceUp and rsi < 55
    bearDivs := bearDivs + 1
if priceDn and rsi > 45
    bullDivs := bullDivs + 1
plot(bullDivs - bearDivs, "Net")
