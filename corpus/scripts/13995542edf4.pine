//@version=5
indicator("Identity Functor")
values = array.new<float>(0)
values.push(close)
values.push(open)
values.push(high)
mapped = array.new<float>(0)
for val in values
    mapped.push(val)
float diff = 0.0
for i = 0 to values.size() - 1
    diff := diff + math.abs(array.get(values, i) - array.get(mapped, i))
