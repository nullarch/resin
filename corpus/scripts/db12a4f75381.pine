
//@version=5
indicator("Converge")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
target = (sma3 + sma5) / 2
estimate = close
alpha = 0.3
steps = 0
while math.abs(estimate - target) > 0.01 and steps < 30
    estimate := estimate + (target - estimate) * alpha
    steps := steps + 1
plot(steps, "St")
