
//@version=5
indicator("ZScore LB")
sumVal = 0.0
sumSq = 0.0
count = 0
for i = 0 to 4
    val = close[i]
    if not na(val)
        sumVal := sumVal + val
        sumSq := sumSq + val * val
        count := count + 1
mean = count > 0 ? sumVal / count : close
variance = count > 1 ? sumSq / count - mean * mean : 0.001
sd = math.sqrt(math.max(variance, 0.0001))
zscore = (close - mean) / sd
plot(zscore, "Z")
