
//@version=5
indicator("All CF")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
// If
result = 0.0
if close > sma3
    result := 1.0
else
    result := -1.0
// For
total = 0.0
for i = 0 to 3
    c = close[i]
    if not na(c)
        total := total + c
// While
estimate = close
iters = 0
while math.abs(estimate - sma3) > 0.01 and iters < 20
    estimate := (estimate + sma3) / 2
    iters := iters + 1
// Switch
grade = switch
    rsi > 70 => 3
    rsi > 50 => 2
    rsi > 30 => 1
    => 0
// Ternary
final = result > 0 ? grade * 1.0 : -grade * 1.0
plot(final, "Final")
