
//@version=5
indicator("Pat Search")
lookback = 0
found = false
while lookback < 8 and not found
    if not na(high[lookback]) and not na(low[lookback])
        bodySize = math.abs(close[lookback] - open_[lookback])
        fullRange = high[lookback] - low[lookback]
        if fullRange > 0 and bodySize / fullRange < 0.15
            found := true
    lookback := lookback + 1
plot(found ? lookback : 0, "LB")
