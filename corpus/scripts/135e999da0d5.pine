//@version=5
indicator("RewardVar")
var float meanR = 0.0
var float m2 = 0.0
var int nSteps = 0
reward = close > open ? 1.0 : -1.0
nSteps := nSteps + 1
delta = reward - meanR
meanR := meanR + delta / float(nSteps)
delta2 = reward - meanR
m2 := m2 + delta * delta2
variance = nSteps > 1 ? m2 / float(nSteps - 1) : 0.0
plot(variance, "RVar")
