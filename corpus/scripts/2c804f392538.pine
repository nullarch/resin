//@version=5
indicator("Cycle45 All")
// Switch refactored (_emit_switch_case)
var string trend = "flat"
trend := switch
    close > close[1] and close[1] > close[2] => "strong_up"
    close > close[1] => "up"
    close < close[1] and close[1] < close[2] => "strong_down"
    close < close[1] => "down"
    => "flat"

// While with WHILE_LOOP_LIMIT
x = close
var int iters = 0
iters := 0
while x > 1
    x := x / 2
    iters := iters + 1

// Array operations
var arr = array.new_float(0)
array.push(arr, close)
var float arr_avg = 0.0
arr_avg := array.avg(arr)

// Map operations
var m = map.new<string, float>()
m.put("close", close)
m.put("trend_len", iters)

// TA
sma_ = ta.sma(close, 3)
ema_ = ta.ema(close, 5)

// NaN safety
var float safe = 0.0
safe := nz(sma_, 0.0) + nz(ema_, 0.0)

// Input default
period = input.int(14, "Period")

var float result = 0.0
result := safe + arr_avg + period
plot(close)
