//@version=5
indicator("S/R")
pivotHigh = ta.pivothigh(high, 3, 3)
pivotLow = ta.pivotlow(low, 3, 3)
var float resistance = na
var float support = na
if not na(pivotHigh)
    resistance := pivotHigh
if not na(pivotLow)
    support := pivotLow
distToR = not na(resistance) ? math.abs(close - resistance) : 0
plot(distToR)
