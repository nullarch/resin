//@version=5
indicator("Hurst Proxy")
float meanClose = nz(ta.sma(close, 5), close)
float deviation = close - meanClose
var float maxDev = 0.0
var float minDev = 0.0
maxDev := math.max(maxDev, deviation)
minDev := math.min(minDev, deviation)
float rescaledRange = maxDev - minDev
float atrVal = nz(ta.atr(5), 1.0)
float hurstProxy = atrVal > 0.01 ? rescaledRange / atrVal : 0.0
