//@version=5
indicator("AllFeat 017")
enum Regime
    Trending
    MeanReverting
isSignificant(v) =>
    v > 1.0 ? true : false
var data = array.new_float(0)
var regimeCounts = map.new<string, int>()
map.put(regimeCounts, "trending", 0)
map.put(regimeCounts, "reverting", 0)
diff = math.abs(close - open)
array.push(data, diff)
regime = isSignificant(diff) ? "trending" : "reverting"
prev = nz(map.get(regimeCounts, regime), 0)
map.put(regimeCounts, regime, prev + 1)
var float filteredSum = 0.0
total = 0.0
for [key, val] in regimeCounts
    if val < 1
        continue
    total := total + val * 1.0
filteredSum := total
