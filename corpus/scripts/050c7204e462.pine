
//@version=5
strategy("Reg Strat", overlay=true)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
bullRegime = close > sma3 and sma3 > sma5 and rsi > 50
if bullRegime
    strategy.entry("Long", strategy.long)
if close < sma5 or rsi < 40
    strategy.close("Long")
plot(sma3, "MA3")
