
//@version=5
indicator("Deep Nesting")
sma3 = ta.sma(close, 3)
total = 0.0
if close > sma3
    for i = 0 to 3
        val = close[i]
        if na(val)
            continue
        weight = switch i
            0 => 4.0
            1 => 3.0
            2 => 2.0
            => 1.0
        total := total + val * weight
plot(total, "Total")
