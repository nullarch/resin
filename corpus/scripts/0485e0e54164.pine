//@version=5
indicator("Homology Rank")
float eps = 5.0
int v = 4
float d1 = math.abs(close - open)
float d2 = math.abs(high - low)
float d3 = math.abs(close - high)
int e = (d1 < eps ? 1 : 0) + (d2 < eps ? 1 : 0) + (d3 < eps ? 1 : 0)
int f = (d1 < eps and d2 < eps and d3 < eps) ? 1 : 0
int chi = v - e + f
int h0Est = math.max(chi, 1)
plot(h0Est, "H0Rank")
