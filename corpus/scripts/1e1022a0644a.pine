
//@version=5
strategy("Time Exit", overlay=true)
var int barsInTrade = 0
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
if close > sma3 and rsi > 50
    strategy.entry("Long", strategy.long)
    barsInTrade := 0
barsInTrade := barsInTrade + 1
if barsInTrade > 5
    strategy.close("Long")
plot(sma3, "MA")
