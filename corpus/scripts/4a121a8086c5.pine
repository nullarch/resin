
//@version=5
strategy("RS Strat", overlay=true)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rs = sma5 > 0 ? sma3 / sma5 : 1.0
rsi = nz(ta.rsi(close, 3), 50.0)
if rs > 1.0 and rsi > 50
    strategy.entry("Long", strategy.long)
if rs < 0.99 or rsi < 40
    strategy.close("Long")
plot(sma3, "MA")
