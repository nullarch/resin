
//@version=5
strategy("Osc Combo", overlay=true)
rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
sma3 = ta.sma(close, 3)
oscAvg = (rsi + k) / 2
if oscAvg < 35 and close > sma3
    strategy.entry("Long", strategy.long)
if oscAvg > 70 or close < sma3
    strategy.close("Long")
plot(sma3, "MA")
