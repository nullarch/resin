
//@version=5
strategy("ZEntry", overlay=true)
smaVal = nz(ta.sma(close, 5), close)
atrVal = nz(ta.atr(3), 1.0)
zProxy = atrVal > 0.001 ? (close - smaVal) / atrVal : 0.0
if zProxy < -1.5
    strategy.entry("Long", strategy.long)
if zProxy > 1.5
    strategy.entry("Short", strategy.short)
if math.abs(zProxy) < 0.5
    strategy.close_all()
plot(zProxy, "Z")
