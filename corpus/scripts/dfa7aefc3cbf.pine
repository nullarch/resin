
//@version=5
indicator("Mom Map FI")
var mm = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
map.put(mm, "rsi_score", (rsi - 50) / 50)
map.put(mm, "price_score", close > sma3 ? 1.0 : -1.0)
map.put(mm, "vol_score", volume > ta.sma(volume, 5) ? 1.0 : 0.0)
total = 0.0
for [k, v] in mm
    total := total + v
plot(total, "T")
