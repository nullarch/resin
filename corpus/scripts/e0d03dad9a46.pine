//@version=5
strategy("Ultra 019", overlay=true)
type Account
    float equity = 10000.0
    int trades = 0

method drawdown(Account this, float current) =>
    this.equity > 0 ? (this.equity - current) / this.equity * 100.0 : 0.0

calcEdge(float winRate, float avgWin, float avgLoss) =>
    avgLoss > 0 ? winRate * avgWin - (1.0 - winRate) * avgLoss : 0.0

var Account acct = Account.new(10000.0, 0)
var float[] pnl = array.new_float(0)
var map<string, float> metrics = map.new<string, float>()

rsiVal = nz(ta.rsi(close, 5), 50.0)
emaVal = ta.ema(close, 3)
prevC = not na(close[1]) ? close[1] : close
barPnl = close - prevC

array.push(pnl, barPnl)
if array.size(pnl) > 5
    array.shift(pnl)

wins = 0
losses = 0
winSum = 0.0
lossSum = 0.0
for i = 0 to array.size(pnl) - 1
    val = array.get(pnl, i)
    if val > 0
        wins := wins + 1
        winSum := winSum + val
    else
        losses := losses + 1
        lossSum := lossSum + math.abs(val)

total = wins + losses
winRate = total > 0 ? wins / total : 0.5
avgWin = wins > 0 ? winSum / wins : 0.0
avgLoss = losses > 0 ? lossSum / losses : 1.0
edge = calcEdge(winRate, avgWin, avgLoss)

map.put(metrics, "edge", edge)
map.put(metrics, "winrate", winRate)

idx = 0
smoothEdge = edge
while idx < 2
    smoothEdge := smoothEdge * 0.9
    idx := idx + 1

action = switch
    smoothEdge > 0.5 and rsiVal < 65 => "buy"
    smoothEdge < -0.5 or rsiVal > 75 => "sell"
    => "hold"

if action == "buy"
    strategy.entry("Long", strategy.long)
    acct.trades := acct.trades + 1
else if action == "sell"
    strategy.close("Long")

dd = acct.drawdown(acct.equity + smoothEdge)
label = str.tostring(acct.trades) + " trades"
plot(smoothEdge)
