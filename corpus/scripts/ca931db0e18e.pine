
//@version=5
indicator("Cyc State")
var int phase = 0
var int phaseBars = 0
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
phaseBars := phaseBars + 1
if phase == 0 and close > sma3 and rsi > 55
    phase := 1
    phaseBars := 0
else if phase == 1 and (rsi > 70 or phaseBars > 3)
    phase := 2
    phaseBars := 0
else if phase == 2 and close < sma3
    phase := 3
    phaseBars := 0
else if phase == 3 and (rsi < 30 or phaseBars > 3)
    phase := 0
    phaseBars := 0
plot(phase, "Phase")
