
//@version=5
indicator("Kelly")
var int wins = 0
var int total = 0
var float avgWin = 0.0
var float avgLoss = 0.0
ret = close - close[1]
if not na(ret)
    total := total + 1
    if ret > 0
        wins := wins + 1
        avgWin := avgWin + (ret - avgWin) / wins
    else if ret < 0
        losses = total - wins
        avgLoss := avgLoss + (math.abs(ret) - avgLoss) / (losses > 0 ? losses : 1)
winRate = total > 0 ? float(wins) / total : 0.5
kelly = avgLoss > 0 ? winRate - (1 - winRate) / (avgWin / avgLoss) : 0.0
plot(math.max(0.0, math.min(1.0, kelly)), "Kelly")
