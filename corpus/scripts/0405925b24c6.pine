
//@version=5
indicator("Pat Count")
var int bullPatterns = 0
var int bearPatterns = 0
bullBar = close > open_
bearBar = close < open_
prevBear = not na(close[1]) and close[1] < open_[1]
prevBull = not na(close[1]) and close[1] > open_[1]
if bullBar and prevBear
    bullPatterns := bullPatterns + 1
if bearBar and prevBull
    bearPatterns := bearPatterns + 1
plot(bullPatterns - bearPatterns, "Net")
