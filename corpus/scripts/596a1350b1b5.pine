
//@version=5
strategy("Full Sys", overlay=true)
ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
[m, s, h] = ta.macd(close, 3, 5, 3)
atr = ta.atr(3)
k = ta.stoch(close, high, low, 5)
bullVotes = (close > ema3 ? 1 : 0) + (ema3 > sma5 ? 1 : 0) + (rsi > 50 ? 1 : 0) + (h > 0 ? 1 : 0) + (k > 50 ? 1 : 0)
if bullVotes >= 4
    strategy.entry("Long", strategy.long)
if bullVotes <= 1
    strategy.close("Long")
plot(ema3, "EMA")
