
//@version=5
indicator("TransMap")
var transitions = map.new<string, float>()
var int prevState = 0

curState = close > open ? 1 : -1
if prevState != curState and prevState != 0
    key = str.tostring(prevState) + "_to_" + str.tostring(curState)
    existing = map.get(transitions, key, 0.0)
    map.put(transitions, key, existing + 1.0)
prevState := curState

totalTrans = 0.0
for [k, v] in transitions
    totalTrans := totalTrans + v
plot(totalTrans, "TT")
