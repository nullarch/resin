
//@version=5
indicator("All Str")
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
part1 = close > sma3 ? "ABOVE" : "BELOW"
part2 = rsi > 60 ? "STRONG" : rsi < 40 ? "WEAK" : "NEUTRAL"
combined = part1 + "_" + part2
len = str.length(combined)
hasAbove = str.contains(combined, "ABOVE")
plot(hasAbove ? len : -len, "L")
