//@version=5
indicator("Pullback Alignment")
float rsiNorm = nz(ta.rsi(close, 5), 50.0) / 100.0
float sma3 = nz(ta.sma(close, 3), close)
float smaNorm = sma3 / math.max(close, 0.01)
float aligned = (rsiNorm + smaNorm) / 2.0
var float minAligned = 999.0
var float maxAligned = -999.0
minAligned := math.min(aligned, minAligned)
maxAligned := math.max(aligned, maxAligned)
