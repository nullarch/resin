
//@version=5
indicator("Break Data")
var bd = map.new<string, float>()
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
atr = nz(ta.atr(3), 1.0)
map.put(bd, "resistance", hi5)
map.put(bd, "support", lo5)
map.put(bd, "atr", atr)
map.put(bd, "range_pct", hi5 > 0 ? (hi5 - lo5) / hi5 * 100 : 0.0)
rangePct = map.get(bd, "range_pct", 0.0)
plot(rangePct, "RP")
