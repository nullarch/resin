
//@version=5
indicator("UDT Return")
type Range_
    float hi = 0.0
    float lo = 999999.0

method update(Range_ r, float val) =>
    if val > r.hi
        r.hi := val
    if val < r.lo
        r.lo := val

method spread(Range_ r) =>
    r.hi - r.lo

var Range_ rng = Range_.new()
rng.update(close)
sp = rng.spread()
plot(sp, "Spread")
