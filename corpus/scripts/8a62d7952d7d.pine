
//@version=5
indicator("Multi UDF")
trendScore(float price, float ma) =>
    price > ma ? 1.0 : -1.0

momScore(float rsi) =>
    (rsi - 50) / 50

volScore(float atr, float avgATR) =>
    avgATR > 0 ? -(atr / avgATR - 1.0) : 0.0

sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
ts = trendScore(close, sma3)
ms = momScore(rsi)
vs = volScore(atr, avgATR)
total = ts * 0.4 + ms * 0.3 + vs * 0.3
plot(total, "Total")
