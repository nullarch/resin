
//@version=5
indicator("Sig Type")
enum SigType
    Strong = 3
    Moderate = 2
    Weak = 1
    None_ = 0

rsi = nz(ta.rsi(close, 3), 50.0)
diff = math.abs(rsi - 50)
sigType = diff > 25 ? SigType.Strong : diff > 15 ? SigType.Moderate : diff > 5 ? SigType.Weak : SigType.None_
isActionable = sigType == SigType.Strong or sigType == SigType.Moderate
plot(float(sigType), "Type")
