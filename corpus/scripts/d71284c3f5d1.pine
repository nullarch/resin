//@version=5
indicator("Physics-Chemistry")
// Physics: kinetic energy from velocity proxy
velocity = close - open
kineticEnergy = 0.5 * math.abs(velocity) * math.abs(velocity)
// Chemistry: Arrhenius-like reaction rate
tempProxy = (high + low) / 2
activationEnergy = 10.0
reactionRate = kineticEnergy * math.exp(-activationEnergy / (tempProxy + 1))
var float totalReacted = 0.0
totalReacted := totalReacted + reactionRate
