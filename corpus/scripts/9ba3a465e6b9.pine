//@version=5
indicator("Mega 1")
type Signal
    float strength = 0.0
    float direction = 0.0
    int count = 0
calcStrength(float price, float avg) =>
    avg > 0.01 ? (price - avg) / avg * 100.0 : 0.0
var int totalSignals = 0
float sma3 = nz(ta.sma(close, 3), close)
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float str1 = calcStrength(close, sma3)
float dir1 = str1 > 0.0 ? 1.0 : -1.0
sig = Signal.new(str1, dir1, 0)
scores = array.new<float>(0)
for i = 0 to 3
    float score = str1 * math.pow(0.9, i)
    scores.push(score)
float avgScore = 0.0
for val in scores
    avgScore := avgScore + val
avgScore := scores.size() > 0 ? avgScore / scores.size() : 0.0
totalSignals := totalSignals + 1
float finalVal = rsiVal > 50.0 ? avgScore * dir1 : avgScore * -1.0
