//@version=5
indicator("Sidereal Synodic")
pSidereal = (high - low) + 1.0
pEarth = 5.0
invDiff = math.abs(1.0 / pSidereal - 1.0 / pEarth)
pSynodic = invDiff > 0.001 ? 1.0 / invDiff : 999.0
var float avgSynodic = 0.0
var int cnt = 0
cnt := cnt + 1
avgSynodic := avgSynodic + (pSynodic - avgSynodic) / cnt
