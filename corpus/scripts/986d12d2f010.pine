//@version=5
indicator("Real World Comprehensive")
// TA Suite
sma_ = ta.sma(close, 3)
ema_ = ta.ema(close, 3)
rsi_ = ta.rsi(close, 5)
[macdLine, signalLine, hist] = ta.macd(close, 3, 5, 3)
atr_ = ta.atr(5)
[mid, upper, lower] = ta.bb(close, 5, 2.0)
// UDT
type Signal
    string dir = ""
    float strength = 0.0
// UDF
getDir(price, ma) =>
    price > ma ? "bull" : "bear"
getStrength(rsi_val) =>
    math.abs(rsi_val - 50.0) / 50.0
// Logic
dir = getDir(close, sma_)
str_ = getStrength(rsi_)
sig = Signal.new(dir, str_)
// Array
arr = array.from(sma_, ema_, nz(atr_, 0.0))
avg_ta = arr.avg()
// Map
m = map.new<string, float>()
m.put("rsi", rsi_)
m.put("macd", macdLine)
// Switch
action = switch sig.dir
    "bull" => 1.0
    "bear" => -1.0
    => 0.0
// For
lookback_sum = 0.0
for i = 0 to 2
    lookback_sum := lookback_sum + nz(close[i], 0.0)
// Plots
plot(sma_, "SMA")
plot(ema_, "EMA")
