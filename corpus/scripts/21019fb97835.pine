
//@version=5
indicator("MF Full")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)

trendFactor = sma5 > 0 ? (sma3 - sma5) / sma5 * 100 : 0.0
momFactor = (rsi - 50) / 50
volFactor = avgATR > 0 ? atr / avgATR : 1.0
priceFactor = sma3 > 0 ? (close - sma3) / sma3 * 100 : 0.0

composite = trendFactor * 0.3 + momFactor * 30 * 0.3 + priceFactor * 0.2 + volFactor * 10 * 0.2

var int strongBars = 0
if composite > 5
    strongBars := strongBars + 1

plot(composite, "C")
plot(strongBars, "SB")
