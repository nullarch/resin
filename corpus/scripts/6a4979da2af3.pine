
//@version=5
indicator("FilterReg")
var coeffs = map.new<string, float>()
map.put(coeffs, "fast", 0.8)
map.put(coeffs, "medium", 0.5)
map.put(coeffs, "slow", 0.2)
rsi = nz(ta.rsi(close, 3), 50.0)
key = rsi > 60 ? "fast" : rsi < 40 ? "slow" : "medium"
alpha = map.get(coeffs, key, 0.5)
var float output = 0.0
output := output * (1.0 - alpha) + close * alpha
plot(output, "O")
