//@version=5
indicator("Coproduct Either")
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float sma5 = nz(ta.sma(close, 5), close)
bool isBull = rsiVal > 55.0 and close > sma5
bool isBear = rsiVal < 45.0 and close < sma5
string tag = isBull ? "left" : isBear ? "right" : "neither"
float value = isBull ? rsiVal - 50.0 : isBear ? 50.0 - rsiVal : 0.0
var float cumValue = 0.0
cumValue := cumValue + value
