
//@version=5
indicator("Sig Encode")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
[m, s, h] = ta.macd(close, 3, 5, 3)
r = rsi > 50 ? "1" : "0"
t = close > sma3 ? "1" : "0"
mc = h > 0 ? "1" : "0"
code = r + t + mc
allBull = code == "111"
allBear = code == "000"
plot(allBull ? 1 : allBear ? -1 : 0, "Code")
