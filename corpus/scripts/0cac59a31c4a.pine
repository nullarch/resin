//@version=5
indicator("Functor fmap Normalize")
float sma5 = nz(ta.sma(close, 5), close)
prices = array.new<float>(0)
prices.push(close)
prices.push(open)
prices.push(high)
prices.push(low)
normed = array.new<float>(0)
for p in prices
    normed.push(p / math.max(sma5, 0.01))
float avgNorm = 0.0
for n in normed
    avgNorm := avgNorm + n
avgNorm := normed.size() > 0 ? avgNorm / normed.size() : 0.0
