//@version=5
indicator("CycPhase09")
enum Phase
    RISING
    PEAK
    FALLING
    TROUGH
trend = nz(ta.sma(close, 3), close)
cycle = close - trend
var float prevCycle = 0.0
phase = switch
    cycle > 0 and cycle > prevCycle => Phase.RISING
    cycle > 0 and cycle <= prevCycle => Phase.PEAK
    cycle < 0 and cycle < prevCycle => Phase.FALLING
    => Phase.TROUGH
prevCycle := cycle
phaseNum = switch phase
    Phase.RISING => 1.0
    Phase.PEAK => 2.0
    Phase.FALLING => 3.0
    => 4.0
plot(phaseNum, "pn")
