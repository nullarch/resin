
//@version=5
indicator("Zone Finder")
hi = ta.highest(high, 5)
lo = ta.lowest(low, 5)
zones = 5
zoneSize = (hi - lo) / zones
currentZone = 0
level = lo
iters = 0
while level < close and iters < zones
    level := level + zoneSize
    currentZone := currentZone + 1
    iters := iters + 1
plot(currentZone, "Zone")
