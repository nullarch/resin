
//@version=5
indicator("Mom Phase")
rsi = nz(ta.rsi(close, 3), 50.0)
mom = close - close[1]
phase = switch
    rsi > 65 and nz(mom, 0.0) > 0 => "strong_up"
    rsi > 50 and nz(mom, 0.0) > 0 => "weak_up"
    rsi < 35 and nz(mom, 0.0) < 0 => "strong_down"
    rsi < 50 and nz(mom, 0.0) < 0 => "weak_down"
    => "transition"
isStrong = phase == "strong_up" or phase == "strong_down"
plot(isStrong ? 1 : 0, "S")
