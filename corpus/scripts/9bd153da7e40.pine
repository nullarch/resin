
//@version=5
strategy("Stat Strat", overlay=true)
sma5 = ta.sma(close, 5)
stdev5 = ta.stdev(close, 5)
z = stdev5 > 0 ? (close - sma5) / stdev5 : 0.0
rsi = nz(ta.rsi(close, 3), 50.0)
if z < -1.5 and rsi > 35
    strategy.entry("Long", strategy.long)
if z > 1.5 or rsi < 30
    strategy.close("Long")
plot(sma5, "MA")
