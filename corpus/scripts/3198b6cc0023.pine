
//@version=5
indicator("Persist")
type PersistResult
    float value = 0.0
    string regime = "NEUTRAL"
calcPersist(src, len) =>
    smaVal = ta.sma(src, len)
    diff = src - nz(smaVal, src)
    diff
p = calcPersist(close, 5)
result = PersistResult.new()
result.value := p
result.regime := p > 1.0 ? "TRENDING" : p < -1.0 ? "REVERTING" : "NEUTRAL"
numericOut = result.regime == "TRENDING" ? 2.0 : result.regime == "REVERTING" ? 0.0 : 1.0
plot(numericOut + result.value, "P")
