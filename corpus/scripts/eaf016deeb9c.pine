
//@version=5
indicator("EWMA Man")
var float[] data = array.new_float(0)
array.push(data, close)
if array.size(data) > 5
    array.shift(data)
alpha = 0.3
ewma = close
sz = array.size(data)
if sz > 1
    wSum = 0.0
    wTotal = 0.0
    for [idx, val] in data
        w = math.pow(1.0 - alpha, float(sz - 1 - idx))
        wSum := wSum + float(val) * w
        wTotal := wTotal + w
    ewma := wTotal > 0 ? wSum / wTotal : close
plot(ewma, "EWMA")
