
//@version=5
indicator("Cndl Pat")
enum CandlePat
    Doji = 0
    Hammer = 1
    ShootingStar = 2
    Marubozu = 3
    Normal = 4

bodySize = math.abs(close - open_)
fullRange = high - low
ratio = fullRange > 0 ? bodySize / fullRange : 0.0
pat = switch
    ratio < 0.1 => CandlePat.Doji
    ratio > 0.85 => CandlePat.Marubozu
    => CandlePat.Normal
plot(int(pat), "Pat")
