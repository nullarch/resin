
//@version=5
indicator("NormCDF")
normCdfApprox(float x) =>
    t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    d = 0.3989423 * math.exp(-x * x / 2.0)
    p = d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))))
    x > 0 ? 1.0 - p : p

smaVal = nz(ta.sma(close, 5), close)
atrVal = nz(ta.atr(3), 1.0)
z = atrVal > 0.001 ? (close - smaVal) / atrVal : 0.0
prob = normCdfApprox(z)
plot(prob, "P")
