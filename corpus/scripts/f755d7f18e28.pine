
//@version=5
indicator("Pos Mgmt")
rsi = ta.rsi(close, 3)
sma3 = ta.sma(close, 3)
var int pos = 0
action = "hold"
if pos == 0
    if close > sma3 and rsi > 50
        action := "open_long"
        pos := 1
else if pos == 1
    if close < sma3
        action := "close_long"
        pos := 0
    else if rsi > 75
        action := "reduce"
isActive = pos == 1
plot(isActive ? 1 : 0, "Active")
