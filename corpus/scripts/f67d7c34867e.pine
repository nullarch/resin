
//@version=5
indicator("Portfolio Engine")
// Indicators
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)

// Signals
trendSig = close > sma3 ? 1.0 : -1.0
momSig = rsi > 55 ? 1.0 : rsi < 45 ? -1.0 : 0.0

// Portfolio
var float equity = 10000.0
var float maxEquity = 10000.0
var float maxDD = 0.0
chg = ta.change(close, 1)
equity := equity + nz(chg, 0.0) * 10
if equity > maxEquity
    maxEquity := equity
dd = maxEquity > 0 ? (maxEquity - equity) / maxEquity * 100 : 0.0
if dd > maxDD
    maxDD := dd

// History
var float[] eqHist = array.new_float(0)
array.push(eqHist, equity)
if array.size(eqHist) > 8
    array.shift(eqHist)

// State
var state = map.new<string, float>()
map.put(state, "equity", equity)
map.put(state, "dd", dd)
map.put(state, "maxDD", maxDD)

var int bars = 0
bars := bars + 1

plot(equity, "Equity")
plot(maxDD, "MaxDD%")
