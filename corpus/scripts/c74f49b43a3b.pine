//@version=5
indicator("SmallWorld")
nodes = array.new_float(0)
array.push(nodes, close)
array.push(nodes, open)
array.push(nodes, high)
array.push(nodes, low)
thresh = 6.0
e01 = math.abs(array.get(nodes, 0) - array.get(nodes, 1)) < thresh ? 1.0 : 0.0
e02 = math.abs(array.get(nodes, 0) - array.get(nodes, 2)) < thresh ? 1.0 : 0.0
e03 = math.abs(array.get(nodes, 0) - array.get(nodes, 3)) < thresh ? 1.0 : 0.0
e12 = math.abs(array.get(nodes, 1) - array.get(nodes, 2)) < thresh ? 1.0 : 0.0
e13 = math.abs(array.get(nodes, 1) - array.get(nodes, 3)) < thresh ? 1.0 : 0.0
e23 = math.abs(array.get(nodes, 2) - array.get(nodes, 3)) < thresh ? 1.0 : 0.0
totalEdges = e01 + e02 + e03 + e12 + e13 + e23
deg0 = e01 + e02 + e03
tri0 = e01 * e02 * e12 + e01 * e03 * e13 + e02 * e03 * e23
maxTri0 = deg0 >= 2.0 ? deg0 * (deg0 - 1.0) / 2.0 : 1.0
cc0 = maxTri0 > 0.0 ? tri0 / maxTri0 : 0.0
avgPath = 0.0
pairCnt = 0.0
for i = 0 to 3
    for j = i + 1 to 3
        avgPath := avgPath + math.abs(array.get(nodes, i) - array.get(nodes, j))
        pairCnt := pairCnt + 1.0
avgPath := pairCnt > 0.0 ? avgPath / pairCnt : 0.0
swIndex = avgPath > 0.01 ? cc0 / avgPath * 100.0 : 0.0
plot(swIndex, "SWIndex")
