
//@version=5
indicator("Exit Reason")
rsi = ta.rsi(close, 3)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
reason = switch
    rsi > 75 => "overbought"
    rsi < 25 => "oversold"
    close < sma3 - atr * 2 => "stop_loss"
    close > sma3 + atr * 3 => "take_profit"
    => "hold"
shouldExit = reason != "hold"
plot(shouldExit ? 1 : 0, "Exit")
