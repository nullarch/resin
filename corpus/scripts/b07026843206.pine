
//@version=5
indicator("WL Ratio")
var int wins = 0
var int losses = 0
var bool inPos = false
var float entry = 0.0
sma3 = ta.sma(close, 3)
if not inPos and close > sma3
    inPos := true
    entry := close
if inPos and close < sma3
    if close > entry
        wins := wins + 1
    else
        losses := losses + 1
    inPos := false
winRate = (wins + losses) > 0 ? float(wins) / (wins + losses) * 100 : 0.0
plot(winRate, "WR")
