//@version=5
indicator("SIS Model")
var float susc = 950.0
var float infec = 50.0
float beta = 0.25
float gamma = 0.15
float pop = 1000.0
float newInf = beta * susc * infec / pop
float newRec = gamma * infec
susc := math.max(susc - newInf + newRec, 0.0)
infec := math.max(infec + newInf - newRec, 0.0)
