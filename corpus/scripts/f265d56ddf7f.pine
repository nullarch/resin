//@version=5
indicator("Buddy Alloc")
float requestSize = high - low
float blockSize = 1.0
for i = 0 to 9
    if blockSize >= requestSize
        break
    blockSize := blockSize * 2.0
float wastedSpace = blockSize - requestSize
float efficiency = blockSize > 0.01 ? requestSize / blockSize * 100.0 : 0.0
