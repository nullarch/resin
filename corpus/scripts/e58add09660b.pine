
//@version=5
indicator("Regime State")
var int currentRegime = 0
var int regimeChanges = 0
var int regimeBars = 0
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
newRegime = sma3 > sma5 ? 1 : -1
if newRegime != currentRegime
    currentRegime := newRegime
    regimeChanges := regimeChanges + 1
    regimeBars := 0
regimeBars := regimeBars + 1
plot(regimeChanges, "RC")
