
//@version=5
indicator("Ultimate System")
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)
[macd, sig, hist] = ta.macd(close, 3, 5, 3)

// Multi-source signal
tSig = close > sma3 ? 1.0 : -1.0
mSig = rsi > 55 ? 1.0 : rsi < 45 ? -1.0 : 0.0
hSig = hist > 0 ? 1.0 : -1.0
composite = (tSig * 0.4 + mSig * 0.3 + hSig * 0.3)

// Risk
var float equity = 10000.0
var float peakEq = 10000.0
var float maxDD = 0.0
chg = ta.change(close, 1)
equity := equity + nz(chg, 0.0) * 10
if equity > peakEq
    peakEq := equity
dd = peakEq > 0 ? (peakEq - equity) / peakEq : 0.0
if dd > maxDD
    maxDD := dd

// History
var float[] sigHistory = array.new_float(0)
array.push(sigHistory, composite)
if array.size(sigHistory) > 8
    array.shift(sigHistory)
avgSig = array.avg(sigHistory)

// State
var dashboard = map.new<string, float>()
map.put(dashboard, "signal", composite)
map.put(dashboard, "equity", equity)
map.put(dashboard, "maxDD", maxDD * 100)
map.put(dashboard, "avgSig", avgSig)

var int bars = 0
bars := bars + 1

plot(composite, "Signal")
plot(equity, "Equity")
plot(maxDD * 100, "DD%")
