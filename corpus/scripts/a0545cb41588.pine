//@version=5
indicator("Hill Tail Index")
float prevC = not na(close[1]) ? close[1] : close
float retAbs = math.abs(close - prevC)
float maxRet = ta.highest(retAbs, 5)
float logRet = retAbs > 0.001 ? math.log(retAbs) : 0.0
float logMax = maxRet > 0.001 ? math.log(maxRet) : 0.0
float hillEst = logMax > 0.001 ? logRet / logMax : 0.0
plot(hillEst, "Hill")
