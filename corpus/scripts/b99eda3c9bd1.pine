//@version=5
indicator("Mega 10")
getLabel(int level) =>
    level >= 3 ? 3.0 : level >= 2 ? 2.0 : level >= 1 ? 1.0 : 0.0
var float labelSum = 0.0
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float sma3 = nz(ta.sma(close, 3), close)
float atrVal = nz(ta.atr(3), 1.0)
int level = 0
switch
    rsiVal > 70.0 =>
        level := 3
    rsiVal > 55.0 =>
        level := 2
    rsiVal > 40.0 =>
        level := 1
    =>
        level := 0
float lbl = getLabel(level)
buckets = array.new<float>(4, 0.0)
for i = 0 to 3
    float val = buckets.get(i) + (i == level ? 1.0 : 0.0)
    buckets.set(i, val)
labelSum := labelSum + lbl
float entropy = 0.0
for b in buckets
    float p = labelSum > 0.0 ? b / (labelSum + 0.01) : 0.0
    entropy := entropy + (p > 0.0 ? -p * math.log(p + 0.001) : 0.0)
