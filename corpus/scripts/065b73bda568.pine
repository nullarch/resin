//@version=5
indicator("FullShowcase")
calcWeight(idx) =>
    switch
        idx == 0 => 0.5
        idx == 1 => 0.3
        => 0.2
var float weightedSum = 0.0
rsi = nz(ta.rsi(close, 5), 50.0)
smaVal = nz(ta.sma(close, 3), close)
arr = array.new_float(0)
for i = 0 to 2
    w = calcWeight(i)
    array.push(arr, w * rsi)
total = 0.0
idx = 0
sz = array.size(arr)
while idx < sz
    total := total + array.get(arr, idx)
    idx := idx + 1
direction = close > smaVal ? 1.0 : -1.0
score = math.abs(total * direction)
weightedSum := weightedSum + score
plot(weightedSum, "WS")
