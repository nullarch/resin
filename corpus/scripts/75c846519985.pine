
//@version=5
indicator("Regime Tracker")
var string regime = "unknown"
var int regimeAge = 0
var int transitions = 0
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
newRegime = sma3 > sma5 ? "bull" : sma3 < sma5 ? "bear" : "flat"
if newRegime != regime
    transitions := transitions + 1
    regimeAge := 0
else
    regimeAge := regimeAge + 1
regime := newRegime
plot(transitions, "Trans")
plot(regimeAge, "Age")
