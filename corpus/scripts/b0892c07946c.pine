//@version=5
indicator("Ultra 006")

categorize(float val) =>
    switch
        val > 3.0 => "hot"
        val > 1.0 => "warm"
        val > -1.0 => "cool"
        => "cold"

var float[] readings = array.new_float(0)
var int hotCount = 0
var int coldCount = 0

momentum = close - open
array.push(readings, momentum)
if array.size(readings) > 5
    array.shift(readings)

hotCount := 0
coldCount := 0
for [idx, val] in readings
    cat = categorize(val)
    if cat == "hot"
        hotCount := hotCount + 1
    else if cat == "cold"
        coldCount := coldCount + 1

idx2 = 0
decayed = 1.0 * (hotCount - coldCount)
while idx2 < 2
    decayed := decayed * 0.9
    idx2 := idx2 + 1

label = str.tostring(math.round(decayed * 100) / 100)
score = decayed > 0 ? math.sqrt(math.abs(decayed)) : -math.sqrt(math.abs(decayed))
plot(score)
