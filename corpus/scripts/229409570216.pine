
//@version=5
indicator("Risk Params")
var rp = map.new<string, float>()
map.put(rp, "max_risk_pct", 2.0)
map.put(rp, "max_positions", 3.0)
map.put(rp, "stop_mult", 2.0)
atr = nz(ta.atr(3), 1.0)
stopDist = atr * map.get(rp, "stop_mult", 2.0)
maxRisk = close * map.get(rp, "max_risk_pct", 2.0) / 100
posSize = stopDist > 0 ? maxRisk / stopDist : 0
plot(posSize, "PS")
