//@version=5
indicator("Context Switch")
var float savedReg1 = 0.0
var float savedReg2 = 0.0
var int switchCount = 0
bool doSwitch = close > open
if doSwitch
    savedReg1 := close
    savedReg2 := high
    switchCount := switchCount + 1
float overhead = switchCount * 0.5
float throughput = 10.0 - overhead
