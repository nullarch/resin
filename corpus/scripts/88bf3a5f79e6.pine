//@version=5
indicator("Triple MA Ribbon")
maScore(fast, mid, slow) =>
    score = 0.0
    score := fast > mid ? score + 1.0 : score
    score := mid > slow ? score + 1.0 : score
    score := fast > slow ? score + 1.0 : score
    score
float ema2 = nz(ta.ema(close, 2), close)
float ema3 = nz(ta.ema(close, 3), close)
float sma5 = ta.sma(close, 5)
float ribbon = maScore(ema2, ema3, nz(sma5, close))
plot(ribbon, "Ribbon")
