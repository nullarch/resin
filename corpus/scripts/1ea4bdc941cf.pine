
//@version=5
indicator("Trade Sig")
type TradeSignal
    int direction = 0
    float strength = 0.0
    float price = 0.0

var TradeSignal sig = TradeSignal.new()
rsi = nz(ta.rsi(close, 3), 50.0)
sig.direction := rsi > 55 ? 1 : rsi < 45 ? -1 : 0
sig.strength := math.abs(rsi - 50) / 50
sig.price := close
plot(sig.direction, "Dir")
plot(sig.strength, "Str")
