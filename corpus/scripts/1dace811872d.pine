
//@version=5
indicator("Ind UDT")
type CustomInd
    float value = 0.0
    float signal = 0.0
    int direction = 0

var CustomInd ci = CustomInd.new()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
ci.value := (rsi - 50) + (close - sma3) * 10
ci.signal := ta.sma(ci.value, 3)
ci.direction := ci.value > ci.signal ? 1 : -1
plot(ci.direction, "Dir")
