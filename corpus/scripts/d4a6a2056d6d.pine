//@version=5
strategy("Cycle 121 Comprehensive", overlay=true)
type Signal
    string direction = "none"
    float strength = 0.0
    int barIndex = 0
sma_fast = ta.sma(close, 3)
sma_slow = ta.sma(close, 5)
rsi_val = ta.rsi(close, 5)
atr_val = ta.atr(3)
var arr = array.new_float(0)
var m = map.new<string, float>()
var int totalSignals = 0
var float maxStrength = 0.0
sig = Signal.new()
if not na(sma_fast) and not na(sma_slow)
    if sma_fast > sma_slow
        sig.direction := "long"
        sig.strength := nz(sma_fast) - nz(sma_slow)
    else
        sig.direction := "short"
        sig.strength := nz(sma_slow) - nz(sma_fast)
    totalSignals := totalSignals + 1
    if sig.strength > maxStrength
        maxStrength := sig.strength
    array.push(arr, sig.strength)
    map.put(m, "latest", sig.strength)
    map.put(m, "direction", sig.direction == "long" ? 1.0 : -1.0)
if array.size(arr) > 5
    array.shift(arr)
trend = switch sig.direction
    "long" => 1
    "short" => -1
    => 0
if sig.direction == "long" and not na(atr_val)
    strategy.entry("L", strategy.long)
    strategy.exit("TP", "L", profit=100, loss=50)
if sig.direction == "short"
    strategy.close("L")
plot(sma_fast, "Fast")
plot(sma_slow, "Slow")
var int barCount = 0
barCount := barCount + 1
