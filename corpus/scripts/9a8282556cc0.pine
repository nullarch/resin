
//@version=5
indicator("All CF")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
result = 0.0
if close > sma3
    result := 1.0
else
    result := -1.0

total = 0.0
for i = 0 to 3
    if close[i] > sma3[i] and not na(close[i]) and not na(sma3[i])
        total := total + 1

regime = switch
    rsi > 70 => "overbought"
    rsi < 30 => "oversold"
    => "neutral"

estimate = rsi
iters = 0
while math.abs(estimate - 50) > 1 and iters < 20
    estimate := estimate + (50 - estimate) * 0.5
    iters := iters + 1

plot(total, "Tot")
