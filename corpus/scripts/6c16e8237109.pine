
//@version=5
indicator("Osc UDT")
type OscTracker
    float minRSI = 100.0
    float maxRSI = 0.0
    int extremeCount = 0

var OscTracker ot = OscTracker.new()
rsi = nz(ta.rsi(close, 3), 50.0)
ot.minRSI := math.min(ot.minRSI, rsi)
ot.maxRSI := math.max(ot.maxRSI, rsi)
if rsi > 70 or rsi < 30
    ot.extremeCount := ot.extremeCount + 1
plot(ot.extremeCount, "EC")
