//@version=5
indicator("Combo19")
dotProduct(a, b) =>
    sum = 0.0
    for i = 0 to math.min(array.size(a), array.size(b)) - 1
        sum := sum + array.get(a, i) * array.get(b, i)
    sum
var float cumDot = 0.0
features = array.new_float(0)
array.push(features, close - nz(close[1], close))
array.push(features, nz(ta.rsi(close, 5), 50.0) / 100.0)
array.push(features, (high - low) / math.max(close, 0.01))
weights = array.new_float(0)
array.push(weights, 0.5)
array.push(weights, 0.3)
array.push(weights, 0.2)
dp = dotProduct(features, weights)
cumDot := cumDot + dp
normDot = math.abs(cumDot) > 0.01 ? dp / math.abs(cumDot) : 0.0
plot(cumDot, "CumDot")
plot(normDot, "NormDot")
