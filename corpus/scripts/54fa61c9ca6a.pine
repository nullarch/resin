
//@version=5
indicator("Cyc Scan")
upCount = 0
downCount = 0
for i = 0 to 4
    c = close[i]
    c1 = close[i+1]
    if not na(c) and not na(c1)
        if c > c1
            upCount := upCount + 1
        else
            downCount := downCount + 1
cycleSkew = upCount - downCount
plot(cycleSkew, "Skew")
