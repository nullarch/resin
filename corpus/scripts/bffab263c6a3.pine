//@version=5
strategy("DG-19 Curvature Breakout")
var float kappa = 0.0
if not na(close[2])
    dp1 = close - close[1]
    dp0 = close[1] - close[2]
    d2p = dp1 - dp0
    denom = math.pow(1.0 + dp1 * dp1, 1.5)
    kappa := denom > 0.001 ? math.abs(d2p) / denom : 0.0
atrVal = nz(ta.atr(3), 1.0)
if kappa > 0.01 and close > open
    strategy.entry("CurveLong", strategy.long)
if kappa < 0.001
    strategy.close("CurveLong")
