//@version=5
indicator("Comprehensive Lexer")

enum Mode
    Fast = 1
    Slow = 2

/* Block comment: ignored */

// Line comment: ignored

float speed = float(Mode.Fast) // enum to float

float total = 10.0 +
    20.0 +
    30.0

float sci = 1.5e1 // 15.0
float dot = .5

bool check = close > 100 and
    close < 200

var float result = 0.0
result := speed + total + sci + dot + (check ? 1.0 : 0.0)
plot(result, color=#00FF00)
