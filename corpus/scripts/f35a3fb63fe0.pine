//@version=5
indicator("NS-16 Eulerian Density")
bins = array.new_float(4, 0.0)
rangeVal = high - low
if rangeVal > 0
    binIdx = math.floor((close - low) / rangeVal * 3.0)
    binIdx := math.min(binIdx, 3)
    binIdx := math.max(binIdx, 0)
    prev = array.get(bins, int(binIdx))
    array.set(bins, int(binIdx), prev + volume / 1000.0)
density = array.get(bins, 2)
plot(density)
