//@version=5
indicator("test")
fib(int n) =>
    var float[] fibs = array.new_float(0)
    array.clear(fibs)
    array.push(fibs, 0.0)
    array.push(fibs, 1.0)
    i = 2
    while i <= n
        val = array.get(fibs, i-1) + array.get(fibs, i-2)
        array.push(fibs, val)
        i := i + 1
    array.get(fibs, n)
result = fib(10)
plot(result)
