
//@version=5
indicator("Pos State")
var float entry = 0.0
var bool inPos = false
sma3 = ta.sma(close, 3)
if not inPos and close > sma3
    inPos := true
    entry := close
if inPos and close < sma3
    inPos := false
pnlPct = inPos and entry > 0 ? (close - entry) / entry * 100 : 0.0
state = switch
    not inPos => "flat"
    pnlPct > 2 => "winning"
    pnlPct < -2 => "losing"
    => "breakeven"
isWinning = state == "winning"
plot(isWinning ? 1 : 0, "Win")
