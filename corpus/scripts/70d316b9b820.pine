
//@version=5
strategy("Vol Strat", overlay=true)
sma3 = ta.sma(close, 3)
avgVol = ta.sma(volume, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
volConfirm = volume > avgVol
if close > sma3 and rsi > 50 and volConfirm
    strategy.entry("Long", strategy.long)
if close < sma3
    strategy.close("Long")
plot(sma3, "MA")
