
//@version=5
indicator("Adapt Full")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)

volRatio = avgATR > 0 ? atr / avgATR : 1.0
adaptUpper = 70 - (volRatio - 1) * 10
adaptLower = 30 + (volRatio - 1) * 10

var int adaptScore = 0
if rsi > adaptUpper
    adaptScore := adaptScore - 1
else if rsi < adaptLower
    adaptScore := adaptScore + 1
adaptScore := math.max(math.min(adaptScore, 5), -5)

plot(adaptScore, "AS")
plot(volRatio, "VR")
