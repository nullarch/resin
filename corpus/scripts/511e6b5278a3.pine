//@version=5
indicator("Historical analysis")
var int bullCount = 0
var int bearCount = 0
bullCount := 0
bearCount := 0
for i = 0 to 4
    pastClose = close[i]
    pastOpen = open[i]
    if not na(pastClose) and not na(pastOpen)
        if nz(pastClose) > nz(pastOpen)
            bullCount := bullCount + 1
        else
            bearCount := bearCount + 1
ratio = bullCount + bearCount > 0 ? float(bullCount) / float(bullCount + bearCount) : 0.5
