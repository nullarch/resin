
//@version=5
indicator("Math UDF")
volatilityScore(float atr, float avgATR, float sd) =>
    atrRatio = avgATR > 0 ? atr / avgATR : 1.0
    sdNorm = sd > 0 ? math.log(1 + sd) : 0.0
    combined = atrRatio * 0.6 + sdNorm * 0.4
    math.max(0.0, math.min(5.0, combined))

atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
sd = ta.stdev(close, 5)
vs = volatilityScore(atr, avgATR, sd)
plot(vs, "VS")
