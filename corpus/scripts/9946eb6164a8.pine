//@version=5
indicator("Grain Storage Monitor")
var storage = array.new<float>(0)
grainIn = close * 0.1
if array.size(storage) >= 5
    array.shift(storage)
array.push(storage, grainIn)
var float storageLevel = 0.0
if array.size(storage) > 0
    storageLevel := array.get(storage, array.size(storage) - 1)
