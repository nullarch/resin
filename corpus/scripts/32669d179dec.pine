
//@version=5
indicator("Equity Track")
var float equity = 10000.0
var float peakEquity = 10000.0
var float worstDD = 0.0
var int barNum = 0
barNum := barNum + 1
chg = ta.change(close, 1)
equity := equity + nz(chg, 0.0) * 10
if equity > peakEquity
    peakEquity := equity
dd = (peakEquity - equity) / peakEquity * 100
if dd > worstDD
    worstDD := dd
plot(equity, "Equity")
plot(worstDD, "WorstDD")
