
//@version=5
indicator("Bar Scan")
strongBars = 0
for i = 0 to 4
    if not na(close[i]) and not na(open_[i])
        body = math.abs(close[i] - open_[i])
        range_ = high[i] - low[i]
        if range_ > 0 and body / range_ > 0.6
            strongBars := strongBars + 1
plot(strongBars, "SB")
