
//@version=5
indicator("Stress01")
enum Trend
    UP
    DOWN
    FLAT
type Signal
    float strength = 0.0
    string label = ""
var int barCount = 0
barCount := barCount + 1
prices = array.new_float(0)
for i = 0 to 4
    array.push(prices, close + float(i))
sig = Signal.new()
sig.strength := array.sum(prices) / math.max(float(array.size(prices)), 1.0)
trend = switch
    close > open => Trend.UP
    close < open => Trend.DOWN
    => Trend.FLAT
sig.label := trend == Trend.UP ? "BULL" : trend == Trend.DOWN ? "BEAR" : "FLAT"
tags = map.new<string, float>()
map.put(tags, "strength", sig.strength)
map.put(tags, "bars", float(barCount))
total = 0.0
for [k, v] in tags
    total := total + v
plot(total, "S01")
