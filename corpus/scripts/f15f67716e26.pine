
//@version=5
indicator("Osc Map")
var readings = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
cci = ta.cci(close, 5)
map.put(readings, "rsi", (rsi - 50) / 50)
map.put(readings, "stoch", (k - 50) / 50)
map.put(readings, "cci", cci / 200)
maxAbs = 0.0
for [name, val] in readings
    maxAbs := math.max(maxAbs, math.abs(val))
isExtreme = maxAbs > 0.8
plot(maxAbs, "Max")
