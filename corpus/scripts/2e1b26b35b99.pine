
//@version=5
indicator("Osc State E")
enum OscState
    ExtremeOB = 2
    Overbought = 1
    Neutral = 0
    Oversold = -1
    ExtremeOS = -2

rsi = nz(ta.rsi(close, 3), 50.0)
state = switch
    rsi > 80 => OscState.ExtremeOB
    rsi > 70 => OscState.Overbought
    rsi < 20 => OscState.ExtremeOS
    rsi < 30 => OscState.Oversold
    => OscState.Neutral
plot(int(state), "St")
