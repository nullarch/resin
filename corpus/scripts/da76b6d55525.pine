
//@version=5
indicator("Vol Lbl")
avgVol = ta.sma(volume, 5)
ratio = avgVol > 0 ? volume / avgVol : 1.0
volLabel = ratio > 1.5 ? "HIGH" : ratio < 0.5 ? "LOW" : "NORM"
priceDir = close > close[1] ? "UP" : "DN"
label = volLabel + "_" + priceDir
isHighUp = label == "HIGH_UP"
plot(isHighUp ? 1 : 0, "HU")
