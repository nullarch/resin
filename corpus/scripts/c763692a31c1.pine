
//@version=5
indicator("Trend Phase")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
phase = switch
    close > sma3 and sma3 > sma5 and rsi > 60 => "acceleration"
    close > sma3 and sma3 > sma5 => "uptrend"
    close < sma3 and sma3 < sma5 and rsi < 40 => "decline"
    close < sma3 and sma3 < sma5 => "downtrend"
    => "consolidation"
isAccel = phase == "acceleration"
plot(isAccel ? 1 : 0, "Acc")
