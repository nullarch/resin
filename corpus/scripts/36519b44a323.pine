//@version=5
indicator("InstrVar")
var float sumZX = 0.0
var float sumZY = 0.0
var int cnt = 0
cnt := cnt + 1
z = volume - nz(ta.sma(volume, 5), volume)
x = close - nz(close[1], close)
y = high - low
sumZX := sumZX + z * x
sumZY := sumZY + z * y
ivBeta = math.abs(sumZX) > 0.01 ? sumZY / sumZX : 0.0
plot(ivBeta, "IVBeta")
