//@version=5
indicator("Yield Prediction")
var yields = array.new<float>(0)
yieldProxy = ta.ema(close, 5) * volume / 1000
if not na(yieldProxy)
    array.push(yields, yieldProxy)
var float avgYield = 0.0
if array.size(yields) > 0
    total = 0.0
    for i = 0 to array.size(yields) - 1
        total := total + array.get(yields, i)
    avgYield := total / array.size(yields)
