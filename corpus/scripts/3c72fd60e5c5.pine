
//@version=5
indicator("Strat Sel")
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
volRatio = avgATR > 0 ? atr / avgATR : 1.0
bestStrat = switch
    volRatio > 1.5 => "volatility"
    rsi > 65 or rsi < 35 => "mean_reversion"
    => "trend_following"
isTrend = bestStrat == "trend_following"
plot(isTrend ? 1 : 0, "Trend")
