
//@version=5
indicator("EventPrio")
type Event
    int priority = 0
    float payload = 0.0
    bool active = false

var Event highPrio = Event.new(0, 0.0, false)
var Event lowPrio = Event.new(0, 0.0, false)

rsi = nz(ta.rsi(close, 3), 50.0)
if rsi > 70
    highPrio := Event.new(2, rsi, true)
else if rsi > 55
    lowPrio := Event.new(1, rsi, true)
else
    highPrio.active := false
    lowPrio.active := false

activePrio = highPrio.active ? highPrio.priority : lowPrio.active ? lowPrio.priority : 0
plot(activePrio, "AP")
