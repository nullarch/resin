
//@version=5
indicator("Vol Cone")
minVol = 999.0
maxVol = 0.0
for i = 0 to 4
    c = close[i]
    c1 = close[i+1]
    if not na(c) and not na(c1) and c1 > 0
        lr = math.abs(math.log(c / c1))
        minVol := math.min(minVol, lr)
        maxVol := math.max(maxVol, lr)
cone = maxVol - (minVol == 999.0 ? 0.0 : minVol)
plot(cone, "Cone")
