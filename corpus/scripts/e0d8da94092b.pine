
//@version=5
indicator("FullEvtSys")
type EventLog
    int totalEvents = 0
    int suppressed = 0
    float lastPayload = 0.0

var EventLog log = EventLog.new()
var float[] eventQ = array.new_float(0)
var int cooldown = 0
var transitions = map.new<string, float>()

rsi = nz(ta.rsi(close, 3), 50.0)
sma5 = ta.sma(close, 5)

if cooldown > 0
    cooldown := cooldown - 1

isBullEvent = close > sma5 and rsi > 55 and close > open
isBearEvent = close < sma5 and rsi < 45 and close < open

if isBullEvent or isBearEvent
    if cooldown == 0
        log.totalEvents := log.totalEvents + 1
        payload = isBullEvent ? rsi : -rsi
        log.lastPayload := payload
        array.push(eventQ, payload)
        if array.size(eventQ) > 5
            array.shift(eventQ)
        cooldown := 2
        evtType = isBullEvent ? "bull" : "bear"
        cnt = map.get(transitions, evtType, 0.0)
        map.put(transitions, evtType, cnt + 1.0)
    else
        log.suppressed := log.suppressed + 1

qAvg = array.size(eventQ) > 0 ? array.avg(eventQ) : 0.0
output = log.totalEvents > 0 ? qAvg : 0.0
plot(output, "OUT")
