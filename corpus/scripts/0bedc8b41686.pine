
//@version=5
indicator("Wt Sum")
w1 = 0.4
w2 = 0.3
w3 = 0.2
w4 = 0.1
rsi = nz(ta.rsi(close, 3), 50.0) / 100
k = ta.stoch(close, high, low, 5) / 100
trend = close > ta.sma(close, 3) ? 1.0 : 0.0
vol = ta.atr(3) > ta.sma(ta.atr(3), 5) ? 0.0 : 1.0
weighted = rsi * w1 + k * w2 + trend * w3 + vol * w4
plot(weighted, "Wt")
