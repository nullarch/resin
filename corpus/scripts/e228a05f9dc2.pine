//@version=5
indicator("MTF Cross")
var int crossCount = 0
float fast = nz(ta.ema(close, 2), close)
float slow = ta.sma(close, 5)
float prevFast = not na(fast[1]) ? fast[1] : fast
float prevSlow = not na(slow[1]) ? slow[1] : nz(slow, close)
bool crossUp = fast > nz(slow, close) and prevFast <= prevSlow
bool crossDown = fast < nz(slow, close) and prevFast >= prevSlow
if crossUp or crossDown
    crossCount := crossCount + 1
plot(crossCount, "Crosses")
