
//@version=5
indicator("Multi UDF")
trendDir(float price, float ma) => price > ma ? 1.0 : -1.0
momScore(float rsi) => (rsi - 50) / 50
volScore(float vol, float avgVol) => avgVol > 0 ? vol / avgVol : 1.0

sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
avgVol = ta.sma(volume, 5)
td = trendDir(close, sma3)
ms = momScore(rsi)
vs = volScore(volume, avgVol)
composite = td * 0.4 + ms * 0.4 + vs * 0.2
plot(composite, "C")
