
//@version=5
indicator("Mkt Phase")
enum MktPhase
    Accumulation = 0
    Markup = 1
    Distribution = 2
    Markdown = 3

var int phase = 0
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
if phase == 0 and close > sma3 and rsi > 55
    phase := 1
else if phase == 1 and rsi > 70
    phase := 2
else if phase == 2 and close < sma3
    phase := 3
else if phase == 3 and rsi < 30
    phase := 0
plot(phase, "Ph")
