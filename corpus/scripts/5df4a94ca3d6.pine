
//@version=5
indicator("Switch Complex")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsiVal = ta.rsi(close, 3)
signal = switch
    close > sma3 and sma3 > sma5 and rsiVal > 60 => 3
    close > sma3 and rsiVal > 50 => 2
    close > sma5 => 1
    close < sma3 and sma3 < sma5 and rsiVal < 40 => -3
    close < sma3 and rsiVal < 50 => -2
    => 0
plot(signal, "Signal")
