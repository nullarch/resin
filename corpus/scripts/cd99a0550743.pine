
//@version=5
indicator("Div Search")
rsi = nz(ta.rsi(close, 3), 50.0)
lookback = 1
found = false
while lookback < 6 and not found
    if not na(close[lookback])
        pUp = close > close[lookback]
        rDown = rsi < 55
        if pUp and rDown
            found := true
    lookback := lookback + 1
plot(found ? lookback : 0, "LB")
