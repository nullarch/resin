//@version=5
indicator("Milestone 3000")
type Signal
    float value = 0.0
    string name = ""
var float result = 0.0
var signals = array.new_float(0)
// TA
sma_ = ta.sma(close, 3)
ema_ = ta.ema(close, 3)
rsi_ = ta.rsi(close, 5)
atr_ = ta.atr(5)
// UDF
getStrength(src, ma) =>
    if src > ma
        (src - ma) / atr_
    else
        (ma - src) / atr_ * -1.0
strength = getStrength(close, sma_)
// UDT
sig = Signal.new(strength, close > sma_ ? "bull" : "bear")
// Array
signals.push(sig.value)
// Math
total = math.abs(strength) + math.max(rsi_, 0.0)
// Map
m = map.new<string, float>()
m.put("strength", strength)
m.put("rsi", rsi_)
// Switch
action = switch sig.name
    "bull" => 1.0
    "bear" => -1.0
    => 0.0
// For
sum_ = 0.0
for i = 0 to 2
    sum_ := sum_ + close[i]
avg_ = sum_ / 3.0
// Final
result := action * avg_
