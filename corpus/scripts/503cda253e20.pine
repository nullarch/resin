
//@version=5
strategy("Pat Strat", overlay=true)
sma3 = ta.sma(close, 3)
bullBar = close > open
bigBody = math.abs(close - open) > ta.sma(math.abs(close - open), 5) * 1.5
if bullBar and bigBody and close > sma3
    strategy.entry("Long", strategy.long)
if close < sma3
    strategy.close("Long")
plot(sma3, "MA")
