//@version=5
indicator("FE02")
smaVal = ta.sma(close, 3)
rsiVal = nz(ta.rsi(close, 3), 50.0)
zone = switch
    rsiVal > 70 => 3
    rsiVal > 50 => 2
    rsiVal > 30 => 1
    => 0
cnt = 0
n = 0
while n < zone
    cnt := cnt + 1
    n := n + 1
bullish = close > smaVal and cnt > 1
plotVal = bullish ? 1.0 : 0.0
plot(plotVal, title="signal")
