
//@version=5
strategy("Micro Strat", overlay=true)
body = math.abs(close - open_)
barRange = high - low
eff = barRange > 0 ? body / barRange : 0.0
sma3 = ta.sma(close, 3)
strongBull = close > open_ and eff > 0.6 and close > sma3
if strongBull
    strategy.entry("Long", strategy.long)
if close < sma3
    strategy.close("Long")
plot(sma3, "MA")
