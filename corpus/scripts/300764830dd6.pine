
//@version=5
indicator("Candle Type")
body = math.abs(close - open)
totalRange = high - low
bodyPct = totalRange > 0 ? body / totalRange * 100 : 0.0
candleType = switch
    bodyPct < 10 => "doji"
    bodyPct > 70 and close > open => "strong_bull"
    bodyPct > 70 and close < open => "strong_bear"
    close > open => "bull"
    => "bear"
isStrongBull = candleType == "strong_bull"
plot(isStrongBull ? 1 : 0, "SB")
