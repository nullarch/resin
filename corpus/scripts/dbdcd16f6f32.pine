
//@version=5
indicator("FullDecomp")
trend = nz(ta.sma(close, 5), close)
seasonal = bar_index % 3 == 0 ? 0.01 : bar_index % 3 == 1 ? -0.005 : 0.005
residual = close - trend - seasonal
reconstructed = trend + seasonal + residual
var float maxResidual = 0.0
absRes = math.abs(residual)
maxResidual := absRes > maxResidual ? absRes : maxResidual
var int trendBars = 0
trendBars := close > trend ? trendBars + 1 : trendBars
plot(maxResidual + trendBars, "Combo")
