//@version=5
indicator("Cycle 129 Final Sweep", overlay=true)
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi5 = ta.rsi(close, 5)
atr3 = ta.atr(3)
[superT, superD] = ta.supertrend(3.0, 3)
[macdL, sigL, hist] = ta.macd(close, 3, 5, 3)
cmo5 = ta.cmo(close, 5)
sarVal = ta.sar(0.02, 0.02, 0.2)
isRising = ta.rising(close, 3)
cumVol = ta.cum(volume)
var arr = array.new_float(0)
var m = map.new<string, float>()
var int barCount = 0
var float bestScore = 0.0
array.push(arr, close)
if array.size(arr) > 5
    array.shift(arr)
score = 0.0
if not na(sma3) and close > nz(sma3)
    score := score + 1.0
if not na(rsi5) and nz(rsi5) > 50
    score := score + 1.0
if isRising
    score := score + 1.0
if not na(superD) and nz(superD) < 0
    score := score + 1.0
if not na(hist) and nz(hist) > 0
    score := score + 1.0
if score > bestScore
    bestScore := score
zone = switch
    score >= 4 => "very_bullish"
    score >= 3 => "bullish"
    score >= 2 => "neutral"
    => "bearish"
map.put(m, "score", score)
map.put(m, "best", bestScore)
clr = score >= 3 ? color.green : score >= 2 ? color.gray : color.red
plot(sma3, "SMA", color=clr)
plot(ema5, "EMA")
barCount := barCount + 1
