//@version=5
indicator("Heat Capacity")
float chg = not na(close[1]) ? close - close[1] : 0.0
var float sumChg = 0.0
var float sumSqChg = 0.0
var int cnt = 0
cnt := cnt + 1
sumChg := sumChg + chg
sumSqChg := sumSqChg + chg * chg
float meanChg = cnt > 0 ? sumChg / cnt : 0.0
float variance = cnt > 0 ? sumSqChg / cnt - meanChg * meanChg : 0.0
float heatCap = math.abs(variance)
