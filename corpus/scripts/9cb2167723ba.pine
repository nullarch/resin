
//@version=5
indicator("Alloc Reg")
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
volHigh = avgATR > 0 ? atr / avgATR > 1.3 : false
regime = switch
    rsi > 60 and not volHigh => "risk_on"
    rsi > 50 => "moderate"
    volHigh => "defensive"
    => "cautious"
eqWeight = regime == "risk_on" ? 0.8 : regime == "moderate" ? 0.6 : regime == "defensive" ? 0.3 : 0.4
plot(eqWeight, "EW")
