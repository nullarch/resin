
//@version=5
indicator("RegScan")
var int[] regHist = array.new_int(0)
rsi = nz(ta.rsi(close, 3), 50.0)
regime = rsi > 55 ? 1 : 0
array.push(regHist, regime)
if array.size(regHist) > 5
    array.shift(regHist)
int bullCount = 0
for i = 0 to array.size(regHist) - 1
    r = array.get(regHist, i)
    bullCount := r == 1 ? bullCount + 1 : bullCount
dominant = array.size(regHist) > 0 ? bullCount : 0
plot(dominant, "Dom")
