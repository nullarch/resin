//@version=5
indicator("DomCyc07")
var int crossCount = 0
var int barsSinceStart = 0
var float prevDet = 0.0
barsSinceStart := barsSinceStart + 1
trend = nz(ta.ema(close, 5), close)
detrended = close - trend
if (detrended > 0 and prevDet <= 0) or (detrended < 0 and prevDet >= 0)
    crossCount := crossCount + 1
prevDet := detrended
domPeriod = crossCount > 0 ? 2.0 * float(barsSinceStart) / float(crossCount) : 10.0
plot(domPeriod, "dp")
