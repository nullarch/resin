
//@version=5
indicator("Mov Reg")
sumX = 0.0
sumY = 0.0
sumXY = 0.0
sumX2 = 0.0
n = 0.0
for i = 0 to 4
    c = close[i]
    if not na(c)
        x = float(i)
        sumX := sumX + x
        sumY := sumY + c
        sumXY := sumXY + x * c
        sumX2 := sumX2 + x * x
        n := n + 1
denom = n * sumX2 - sumX * sumX
slope = denom > 0 ? (n * sumXY - sumX * sumY) / denom : 0.0
plot(slope, "Slope")
