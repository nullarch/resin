
//@version=5
indicator("Sig Decay")
var float sigStrength = 0.0
rsi = nz(ta.rsi(close, 3), 50.0)
if rsi > 65 or rsi < 35
    sigStrength := rsi > 65 ? 1.0 : -1.0
else
    decay = 0.8
    iters = 0
    while math.abs(sigStrength) > 0.01 and iters < 10
        sigStrength := sigStrength * decay
        iters := iters + 1
plot(sigStrength, "Sig")
