//@version=5
indicator("Period Double")
float chg = close - open
float prevChg = not na(close[1]) ? close[1] - open[1] : chg
bool alternating = (chg > 0 and prevChg < 0) or (chg < 0 and prevChg > 0)
var int altCount = 0
var int totalBars = 0
totalBars := totalBars + 1
if alternating
    altCount := altCount + 1
float altRatio = totalBars > 0 ? altCount / totalBars : 0.0
