
//@version=5
strategy("Complex Cond", overlay=true)
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
atr = ta.atr(3)
bullSetup = close > sma3 and sma3 > ema5 and rsi > 45 and rsi < 75
if bullSetup and close > close[1]
    strategy.entry("Long", strategy.long)
if close < ema5 or rsi > 80
    strategy.close("Long")
plot(sma3, "MA")
