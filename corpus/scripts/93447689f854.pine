//@version=5
indicator("RouletteWheel")
fitArr = array.new_float(0)
for i = 0 to 4
    f = math.abs(math.sin(float(i) + close * 0.05)) * 10.0
    array.push(fitArr, f)
totalFit = array.sum(fitArr)
cumul = array.new_float(0)
runSum = 0.0
sz = array.size(fitArr)
for i = 0 to 4
    runSum := runSum + array.get(fitArr, i)
    prob = totalFit > 0 ? runSum / totalFit : 0.0
    array.push(cumul, prob)
plot(array.get(cumul, 2), "MidProb")
