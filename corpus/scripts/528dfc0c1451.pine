//@version=5
indicator("Glider Detection")
var patternA = array.new_int(0)
var int gliderCount = 0
state = close > open ? 1 : 0
array.push(patternA, state)
sz = array.size(patternA)
if sz >= 4
    p0 = array.get(patternA, sz - 4)
    p1 = array.get(patternA, sz - 3)
    p2 = array.get(patternA, sz - 2)
    p3 = array.get(patternA, sz - 1)
    if p0 == 1 and p1 == 0 and p2 == 1 and p3 == 0
        gliderCount := gliderCount + 1
