
//@version=5
indicator("Complex Switch")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
trendUp = close > sma3
strongMom = rsi > 60 or rsi < 40
highVol = atr > ta.sma(atr, 5) * 1.5
result = switch
    trendUp and strongMom and not highVol => 3
    trendUp and strongMom and highVol => 2
    trendUp and not strongMom => 1
    not trendUp and strongMom => -2
    => 0
plot(result, "R")
