//@version=5
indicator("test")
var float[] levels = array.new_float(0)
if barstate.isfirst
    for i = 1 to 5
        array.push(levels, i * 10.0)
nearest = 0.0
minDist = 99999.0
for i = 0 to array.size(levels) - 1
    level = array.get(levels, i)
    dist = math.abs(close - level)
    if dist < minDist
        minDist := dist
        nearest := level
plot(nearest)
