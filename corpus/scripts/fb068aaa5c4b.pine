
//@version=5
indicator("Map Access")
var m = map.new<string, float>()
key = close > open ? "bull" : "bear"
map.put(m, key, close)
bullPrice = map.contains(m, "bull") ? map.get(m, "bull", 0.0) : 0.0
bearPrice = map.contains(m, "bear") ? map.get(m, "bear", 0.0) : 0.0
plot(bullPrice, "Bull")
plot(bearPrice, "Bear")
