
//@version=5
indicator("Stress04")
classify(val) =>
    switch
        val > 5.0 => "HIGH"
        val > 0.0 => "MID"
        => "LOW"
var float runningTotal = 0.0
diffs = array.new_float(0)
for i = 0 to 3
    diff = close - open + float(i)
    array.push(diffs, diff)
    runningTotal := runningTotal + diff
categories = map.new<string, float>()
for i = 0 to array.size(diffs) - 1
    val = array.get(diffs, i)
    cat = classify(val)
    existing = nz(map.get(categories, cat), 0.0)
    map.put(categories, cat, existing + 1.0)
catTotal = 0.0
for [key, cnt] in categories
    catTotal := catTotal + cnt * float(str.length(key))
plot(catTotal + runningTotal, "S04")
