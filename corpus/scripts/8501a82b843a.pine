
//@version=5
indicator("FC Type")
sma3 = ta.sma(close, 3)
slope = sma3 - sma3[1]
rsi = nz(ta.rsi(close, 3), 50.0)
fcType = switch
    nz(slope, 0.0) > 0 and rsi > 60 => "strong_up"
    nz(slope, 0.0) > 0 => "mild_up"
    nz(slope, 0.0) < 0 and rsi < 40 => "strong_down"
    nz(slope, 0.0) < 0 => "mild_down"
    => "flat"
isUp = str.contains(fcType, "up")
plot(isUp ? 1 : 0, "Up")
