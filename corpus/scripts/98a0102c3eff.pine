//@version=5
indicator("FE13")
var float peakScore = 0.0
isNear(a, b, tol) =>
    math.abs(a - b) < tol
vwmaVal = ta.vwma(close, 3)
peak = ta.highest(high, 5)
sum = 0.0
for i = 0 to 4 by 2
    sum := sum + 1.0
nearPeak = isNear(close, peak, 3.0)
if nearPeak and vwmaVal > 100
    peakScore := peakScore + sum
