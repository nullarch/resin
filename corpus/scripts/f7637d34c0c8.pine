
//@version=5
strategy("Reg Adapt", overlay=true)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
isTrending = close > sma3 and rsi > 50
isLowVol = avgATR > 0 and atr < avgATR * 1.3
entryThresh = isLowVol ? 50 : 60
if close > sma3 and rsi > entryThresh
    strategy.entry("Long", strategy.long)
if close < sma3
    strategy.close("Long")
plot(sma3, "MA")
