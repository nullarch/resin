//@version=5
indicator("UDF pipeline")
normalize(x, lo, hi) =>
    hi != lo ? (x - lo) / (hi - lo) : 0.5
scale(x, newLo, newHi) =>
    newLo + x * (newHi - newLo)
transform(x, lo, hi, newLo, newHi) =>
    n = normalize(x, lo, hi)
    scale(n, newLo, newHi)
h5 = ta.highest(close, 5)
l5 = ta.lowest(close, 5)
scaled = transform(close, nz(l5), nz(h5), 0.0, 100.0)
