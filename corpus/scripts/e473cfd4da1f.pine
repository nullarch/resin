
//@version=5
indicator("Port Full")
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)

var float equity = 10000.0
var bool inPos = false
var float entryPx = 0.0
var int tradeCount = 0

if not inPos and close > sma3 and rsi > 50
    inPos := true
    entryPx := close
    tradeCount := tradeCount + 1
if inPos and (close < sma3 or rsi > 80)
    pnl = close - entryPx
    equity := equity + pnl * 100
    inPos := false

riskPct = atr > 0 ? (atr * 2) / close * 100 : 0.0
posSize = riskPct > 0 ? math.min(equity * 0.02 / (atr * 2), equity * 0.1 / close) : 0.0

var int bars = 0
bars := bars + 1

plot(equity, "Eq")
plot(posSize, "Size")
