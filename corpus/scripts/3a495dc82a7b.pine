
//@version=5
indicator("Portfolio Weights")
var m = map.new<string, float>()
rsiVal = ta.rsi(close, 3)
smaVal = ta.sma(close, 3)
w1 = rsiVal > 50 ? 0.6 : 0.4
w2 = close > smaVal ? 0.7 : 0.3
map.put(m, "momentum", w1)
map.put(m, "trend", w2)
totalW = map.get(m, "momentum", 0.0) + map.get(m, "trend", 0.0)
plot(totalW, "Total Weight")
