//@version=5
indicator("Robotics-PID Control")
// Target position
setpoint = 105.0
// PID gains
kp = 0.5
ki = 0.05
kd = 0.1
// Process variable
position = close
pidError = setpoint - position
var float integral = 0.0
integral := integral + pidError
derivative = not na(close[1]) ? pidError - (setpoint - close[1]) : 0.0
controlSignal = kp * pidError + ki * integral + kd * derivative
var float lastControl = 0.0
lastControl := controlSignal
