//@version=5
indicator("S/R")
var levels = array.from(100.0, 200.0, 300.0)
nearLevel = false
for i = 0 to array.size(levels) - 1
    lvl = array.get(levels, i)
    if math.abs(close - lvl) < 5
        nearLevel := true
        b = box.new(bar_index - 3, lvl + 2, bar_index, lvl - 2)
        box.set_bgcolor(b, color.new(color.blue, 80))
