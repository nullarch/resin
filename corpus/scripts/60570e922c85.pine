
//@version=5
indicator("Price Zone")
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
range_ = hi5 - lo5
pos = range_ > 0 ? (close - lo5) / range_ : 0.5
zone = switch
    pos > 0.8 => "resistance"
    pos > 0.6 => "upper"
    pos < 0.2 => "support"
    pos < 0.4 => "lower"
    => "middle"
isExtreme = zone == "resistance" or zone == "support"
plot(isExtreme ? 1 : 0, "Ext")
