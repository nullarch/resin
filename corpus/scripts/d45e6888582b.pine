
//@version=5
indicator("Eq Curve")
var float[] equity = array.new_float(0)
var float value = 10000.0
ret = close[1] > 0 ? (close - close[1]) / close[1] : 0.0
value := value * (1 + nz(ret, 0.0))
array.push(equity, value)
if array.size(equity) > 10
    array.shift(equity)
maxEq = array.size(equity) > 0 ? array.max(equity) : value
minEq = array.size(equity) > 0 ? array.min(equity) : value
eqRange = maxEq - minEq
plot(eqRange, "ER")
