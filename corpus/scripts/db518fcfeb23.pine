//@version=5
strategy("Mega 11")
type Portfolio
    float equity = 0.0
    float drawdown = 0.0
sharpe(float ret, float risk) =>
    risk > 0.01 ? ret / risk : 0.0
var float peakEquity = 10000.0
var float equity = 10000.0
float sma3 = nz(ta.sma(close, 3), close)
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float atrVal = nz(ta.atr(3), 1.0)
float pnl = close - open
equity := equity + pnl
peakEquity := math.max(peakEquity, equity)
float dd = (peakEquity - equity) / peakEquity * 100.0
portfolio = Portfolio.new(equity, dd)
metrics = map.new<string, float>()
metrics.put("return", pnl)
metrics.put("risk", atrVal)
metrics.put("sharpe", sharpe(pnl, atrVal))
float totalMetric = 0.0
keys = array.from("return", "risk", "sharpe")
for k in keys
    totalMetric := totalMetric + nz(metrics.get(k), 0.0)
if rsiVal > 55.0 and dd < 5.0
    strategy.entry("Mega11Long", strategy.long)
if rsiVal < 40.0 or dd > 10.0
    strategy.close("Mega11Long")
