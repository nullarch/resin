
//@version=5
indicator("Trade Log")
var bool inPos = false
sma3 = ta.sma(close, 3)
action = "HOLD"
if not inPos and close > sma3
    inPos := true
    action := "BUY"
if inPos and close < sma3
    inPos := false
    action := "SELL"
logEntry = action + "_" + str.tostring(math.round(close))
isBuy = str.contains(logEntry, "BUY")
plot(isBuy ? 1 : 0, "Buy")
