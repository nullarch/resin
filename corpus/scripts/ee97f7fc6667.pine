//@version=5
strategy("Ultra 002", overlay=true)

calcWeight(float volatility, float threshold) =>
    volatility > threshold ? math.sqrt(volatility) : volatility * 0.5

var map<string, float> indicators = map.new<string, float>()
var float totalWeight = 0.0

atrVal = nz(ta.atr(3), 1.0)
emaVal = ta.ema(close, 3)
trend = not na(emaVal) ? close - emaVal : 0.0

map.put(indicators, "atr", atrVal)
map.put(indicators, "trend", trend)
map.put(indicators, "momentum", close - open)

composite = 0.0
for [key, val] in indicators
    w = calcWeight(math.abs(val), 2.0)
    composite := composite + val * w

idx = 0
decayed = composite
while idx < 3
    decayed := decayed * 0.85
    idx := idx + 1

totalWeight := totalWeight + math.abs(decayed)

if decayed > 1.0
    strategy.entry("Long", strategy.long)
if decayed < -1.0
    strategy.close("Long")
plot(decayed)
