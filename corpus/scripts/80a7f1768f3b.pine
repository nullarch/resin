
//@version=5
strategy("Dyn Stops", overlay=true)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
rsi = nz(ta.rsi(close, 3), 50.0)
mult = rsi > 60 ? 1.5 : 2.5
stopLevel = close - atr * mult
if close > sma3 and rsi > 45
    strategy.entry("Long", strategy.long)
if close < stopLevel or rsi > 85
    strategy.close("Long")
plot(stopLevel, "Stop")
