//@version=5
indicator("Reversion Speed")
float fast = ta.ema(close, 3)
float slow = ta.ema(close, 5)
float gap = fast - slow
float prevGap = not na(close[1]) ? gap : 0.0
float speed = math.abs(gap) < math.abs(prevGap) ? 1.0 : 0.0
var float revBars = 0.0
revBars := revBars + speed
plot(revBars, "RevSpeed")
