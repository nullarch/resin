//@version=5
indicator("RelEnt09")
relEnt(p, q) =>
    result = 0.0
    if p > 0.001 and q > 0.001
        result := p * math.log(p / q)
    result
var float upRatio = 0.5
var float n = 0.0
n := n + 1.0
if close > open
    upRatio := (upRatio * (n - 1.0) + 1.0) / n
else
    upRatio := (upRatio * (n - 1.0)) / n
re = relEnt(upRatio, 0.5) + relEnt(1.0 - upRatio, 0.5)
plot(re, "re")
