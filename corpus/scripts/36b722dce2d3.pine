//@version=5
indicator("AllFeat 008")
enum Phase
    Accumulation
    Distribution
    Markup
classifyPhase(rsiV) =>
    switch
        rsiV > 60 => "markup"
        rsiV < 40 => "distribution"
        => "accumulation"
var phases = array.new_string(0)
var float momentum = 0.0
rsiVal = nz(ta.rsi(close, 3), 50.0)
phase = classifyPhase(rsiVal)
array.push(phases, phase)
idx = 0
cnt = 0
while idx < array.size(phases)
    if array.get(phases, idx) == "markup"
        cnt := cnt + 1
    idx := idx + 1
momentum := cnt > 0 ? cnt * 1.0 : 0.0
