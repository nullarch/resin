//@version=5
indicator("Neuro-Signal Processing")
// Signal processing: bandpass via EMA difference
slowFilter = ta.ema(close, 5)
fastFilter = ta.ema(close, 3)
filteredSignal = not na(fastFilter) and not na(slowFilter) ? fastFilter - slowFilter : 0.0
// Neuroscience: spike detection with threshold
spikeThreshold = 1.0
var int spikeCount = 0
if math.abs(filteredSignal) > spikeThreshold
    spikeCount := spikeCount + 1
