//@version=5
strategy("AllFeat 020", overlay=true)
enum Stance
    Long
    Short
    Flat
weight(category) =>
    switch category
        "strong" => 3.0
        "moderate" => 2.0
        => 1.0
var scores = array.new_float(0)
var tally = map.new<string, float>()
map.put(tally, "strong", 0.0)
map.put(tally, "moderate", 0.0)
map.put(tally, "weak", 0.0)
var float grandTotal = 0.0
rsiVal = nz(ta.rsi(close, 3), 50.0)
cat = switch
    rsiVal > 60 => "strong"
    rsiVal > 40 => "moderate"
    => "weak"
prev = nz(map.get(tally, cat), 0.0)
map.put(tally, cat, prev + 1.0)
array.push(scores, weight(cat))
wSum = 0.0
for [key, val] in tally
    wSum := wSum + val * weight(key)
idx = 0
while idx < array.size(scores)
    wSum := wSum + array.get(scores, idx) * 0.1
    idx := idx + 1
grandTotal := wSum
stance = grandTotal > 15 ? "long" : grandTotal < 5 ? "short" : "flat"
if stance == "long"
    strategy.entry("L", strategy.long)
if stance == "short"
    strategy.entry("S", strategy.short)
