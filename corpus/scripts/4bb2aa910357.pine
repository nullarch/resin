
//@version=5
indicator("UDF Full")
normalize(float val, float mn, float mx) =>
    rng = mx - mn
    rng > 0 ? (val - mn) / rng : 0.5

scoreIndicator(float val, float threshold) =>
    val > threshold ? 1.0 : val < -threshold ? -1.0 : 0.0

rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)

normRSI = normalize(rsi, 0.0, 100.0) * 2 - 1
trendDist = close - sma3
normTrend = atr > 0 ? trendDist / atr : 0.0

rsiScore = scoreIndicator(normRSI, 0.2)
trendScore = scoreIndicator(normTrend, 0.5)
composite = (rsiScore + trendScore) / 2

var float[] history = array.new_float(0)
array.push(history, composite)
if array.size(history) > 8
    array.shift(history)

var int bars = 0
bars := bars + 1

plot(composite, "Comp")
plot(array.avg(history), "Avg")
