//@version=5
indicator("State Key Isolation")
sma_a = ta.sma(close, 5)
sma_b = ta.sma(close, 5)
ema_c = ta.ema(close, 5)
// All should produce same results despite different state keys
var float diff_ab = 0.0
var float diff_ac = 0.0
diff_ab := nz(sma_a, 0.0) - nz(sma_b, 0.0)
diff_ac := nz(sma_a, 0.0) - nz(ema_c, 0.0)
plot(close)
