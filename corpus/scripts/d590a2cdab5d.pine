//@version=5
indicator("UCB")
var float sumArm1 = 0.0
var float sumArm2 = 0.0
var int countArm1 = 1
var int countArm2 = 1
var int totalPulls = 2
totalPulls := totalPulls + 1
mean1 = sumArm1 / float(countArm1)
mean2 = sumArm2 / float(countArm2)
ucb1 = mean1 + math.sqrt(2.0 * math.log(float(totalPulls)) / float(countArm1))
ucb2 = mean2 + math.sqrt(2.0 * math.log(float(totalPulls)) / float(countArm2))
reward = close > open ? 1.0 : 0.0
if ucb1 >= ucb2
    sumArm1 := sumArm1 + reward
    countArm1 := countArm1 + 1
else
    sumArm2 := sumArm2 + reward
    countArm2 := countArm2 + 1
plot(math.max(ucb1, ucb2), "UCB")
