
//@version=5
indicator("CF Combo")
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)

// Switch expression
regime = switch
    close > sma3 and rsi > 55 => 2
    close > sma3 => 1
    close < sma3 and rsi < 45 => -2
    => -1

// For accumulation
total = 0.0
for i = 0 to 3
    c = close[i]
    if na(c)
        continue
    total := total + c

// If expression
quality = if regime > 0 and total > 0
    1.0
else if regime < 0
    -1.0
else
    0.0

// Ternary
final = quality > 0 ? quality * (rsi / 100) : quality * ((100 - rsi) / 100)

var int bars = 0
bars := bars + 1

plot(final, "Final")
plot(regime, "Regime")
