
//@version=5
indicator("Cyc Data")
var cd = map.new<string, float>()
var int barNum = 0
barNum := barNum + 1
cyclePeriod = 5
cyclePos = barNum % cyclePeriod
map.put(cd, "bar", float(barNum))
map.put(cd, "position", float(cyclePos))
map.put(cd, "progress", float(cyclePos) / cyclePeriod * 100)
plot(map.get(cd, "progress", 0.0), "Prog")
