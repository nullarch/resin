
//@version=5
indicator("Mov Slope")
n = 5.0
sumXY = 0.0
sumX = 0.0
sumY = 0.0
sumX2 = 0.0
for i = 0 to 4
    c = close[i]
    if not na(c)
        x = 4.0 - i
        sumX := sumX + x
        sumY := sumY + c
        sumXY := sumXY + x * c
        sumX2 := sumX2 + x * x
denom = n * sumX2 - sumX * sumX
slope = denom != 0 ? (n * sumXY - sumX * sumY) / denom : 0.0
intercept = (sumY - slope * sumX) / n
plot(slope, "Slope")
