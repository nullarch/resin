
//@version=5
indicator("Regime Conv")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
target = sma3 > sma5 ? 1.0 : -1.0
estimate = 0.0
steps = 0
while math.abs(estimate - target) > 0.05 and steps < 20
    estimate := estimate + (target - estimate) * 0.3
    steps := steps + 1
plot(estimate, "Est")
