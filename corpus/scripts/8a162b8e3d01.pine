
//@version=5
strategy("Combo Strat", overlay=true)
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
[m, s, h] = ta.macd(close, 3, 5, 3)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
trendOK = close > sma3 and sma3 > ema5
momOK = rsi > 45 and h > 0
volOK = avgATR > 0 and atr < avgATR * 1.5
if trendOK and momOK and volOK
    strategy.entry("Long", strategy.long)
if not trendOK or rsi > 80
    strategy.close("Long")
plot(sma3, "MA")
