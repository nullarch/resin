
//@version=5
indicator("Regime Full")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)

trendScore = sma5 > 0 ? (sma3 - sma5) / sma5 * 100 : 0.0
momScore = (rsi - 50) / 50
volRatio = avgATR > 0 ? atr / avgATR : 1.0

regimeScore = trendScore * 0.4 + momScore * 30 * 0.3 + volRatio * 10 * 0.3

var int bullRegime = 0
if regimeScore > 5
    bullRegime := bullRegime + 1

plot(regimeScore, "RS")
plot(bullRegime, "BR")
