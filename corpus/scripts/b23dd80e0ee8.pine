//@version=5
indicator("NestedForBrkCont")
triangular(n) =>
    total = 0.0
    for i = 1 to n
        total := total + float(i)
    total
result = 0.0
for i = 0 to 4
    if i == 0
        continue
    for j = 0 to 3
        if j > i
            break
        result := result + 1.0
bonus = triangular(3)
plot(result + bonus, "R")
