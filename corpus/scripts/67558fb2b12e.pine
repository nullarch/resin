
//@version=5
indicator("Reg Action")
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
volR = avgATR > 0 ? atr / avgATR : 1.0
action = close > sma3 and rsi > 60 and volR < 1.3 ? 2.0 : close > sma3 ? 1.0 : close < sma3 and rsi < 40 ? -2.0 : -1.0
plot(action, "Act")
