
//@version=5
indicator("Level Data")
var ld = map.new<string, float>()
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
map.put(ld, "resistance", hi5)
map.put(ld, "support", lo5)
map.put(ld, "pivot", (high + low + close) / 3)
map.put(ld, "range", hi5 - lo5)
rangeVal = map.get(ld, "range", 0.0)
plot(rangeVal, "R")
