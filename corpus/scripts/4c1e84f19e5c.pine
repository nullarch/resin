//@version=5
indicator("Markov Chain")
var int stayUp = 0
var int stayDown = 0
var int switchState = 0
currUp = close > open
prevUp = not na(close[1]) ? close[1] > open[1] : currUp
if currUp and prevUp
    stayUp := stayUp + 1
else if not currUp and not prevUp
    stayDown := stayDown + 1
else
    switchState := switchState + 1
