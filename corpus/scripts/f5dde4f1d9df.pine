
//@version=5
indicator("Band Pos UDF")
bandPos(float price, float upper, float lower) =>
    rng = upper - lower
    rng > 0 ? (price - lower) / rng * 100 : 50.0

sma5 = ta.sma(close, 5)
atr = nz(ta.atr(3), 1.0)
upper = sma5 + atr * 2
lower = sma5 - atr * 2
pos = bandPos(close, upper, lower)
plot(pos, "BP")
