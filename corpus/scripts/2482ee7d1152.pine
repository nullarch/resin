
//@version=5
indicator("Adapt State")
var float sensitivity = 1.0
var int correctCount = 0
rsi = nz(ta.rsi(close, 3), 50.0)
predicted = rsi > 50
actual = close > close[1]
if predicted == actual
    correctCount := correctCount + 1
    sensitivity := math.max(sensitivity * 0.95, 0.5)
else
    sensitivity := math.min(sensitivity * 1.1, 2.0)
plot(sensitivity, "Sens")
