//@version=5
indicator("KendallTau")
var int cPairs = 0
var int dPairs = 0
var int tiedPairs = 0
dClose = close - nz(close[1], close)
dVol = volume - nz(volume[1], volume)
prod = dClose * dVol
if prod > 0
    cPairs := cPairs + 1
else if prod < 0
    dPairs := dPairs + 1
else
    tiedPairs := tiedPairs + 1
denom = cPairs + dPairs + tiedPairs
tau = denom > 0 ? float(cPairs - dPairs) / float(denom) : 0.0
plot(tau, "Tau")
