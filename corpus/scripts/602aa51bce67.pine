
//@version=5
indicator("Risk Class")
enum RiskClass
    Conservative = 0
    Moderate = 1
    Aggressive = 2
    Speculative = 3

atr = nz(ta.atr(3), 1.0)
riskPct = atr / close * 100
rc = switch
    riskPct > 3.0 => RiskClass.Speculative
    riskPct > 2.0 => RiskClass.Aggressive
    riskPct > 1.0 => RiskClass.Moderate
    => RiskClass.Conservative
plot(int(rc), "RC")
