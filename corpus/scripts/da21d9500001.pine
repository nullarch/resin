
//@version=5
indicator("Roll Beta")
sumXY = 0.0
sumX2 = 0.0
count = 0
for i = 0 to 4
    ac = close[i] - close[i+1]
    bc = close[i] - close[i+1]
    if not na(ac) and not na(bc)
        sumXY := sumXY + ac * bc
        sumX2 := sumX2 + bc * bc
        count := count + 1
beta = sumX2 > 0 ? sumXY / sumX2 : 1.0
plot(beta, "Beta")
