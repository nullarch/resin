//@version=5
strategy("Torture 7")
type Risk
    float atrMul = 2.0
    float maxRisk = 0.05
method stopDist(Risk this, float atrVal) =>
    this.atrMul * atrVal
var int entryBar = 0
risk = Risk.new(2.0, 0.05)
float atrVal = nz(ta.atr(3), 1.0)
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float sma3 = nz(ta.sma(close, 3), close)
float sma5 = nz(ta.sma(close, 5), close)
signals = array.new<float>(0)
for idx = 0 to 2
    float weight = (idx + 1) / 3.0
    float sig = weight * (close - sma3)
    signals.push(sig)
float totalSig = 0.0
for s in signals
    totalSig := totalSig + s
float stopD = risk.stopDist(atrVal)
if totalSig > 0.5 and rsiVal > 45
    if close > sma5
        strategy.entry("L", strategy.long)
        entryBar := entryBar + 1
if totalSig < -0.5
    strategy.close("L")
