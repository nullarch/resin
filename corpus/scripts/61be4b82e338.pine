//@version=5
indicator("Pivot S/R", overlay=true)
leftBars = input.int(5)
rightBars = input.int(5)
ph = ta.pivothigh(leftBars, rightBars)
pl = ta.pivotlow(leftBars, rightBars)
var float resistance = na
var float support = na
if not na(ph)
    resistance := ph
if not na(pl)
    support := pl
plot(resistance, "R", color=color.red, style=plot.style_cross)
plot(support, "S", color=color.green, style=plot.style_cross)
