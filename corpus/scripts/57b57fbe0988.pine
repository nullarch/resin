//@version=5
indicator("Jeffreys Divergence")
var float jeffreys = 0.0
pVal = (close - low) / (high - low > 0.01 ? high - low : 0.01)
qVal = 0.5
safeP = pVal > 0.01 ? pVal : 0.01
safeQ = qVal > 0.01 ? qVal : 0.01
klPQ = safeP * math.log(safeP / safeQ)
klQP = safeQ * math.log(safeQ / safeP)
jeffreys := klPQ + klQP
