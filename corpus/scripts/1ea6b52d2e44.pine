//@version=5
indicator("ATR Trail")
atr3 = ta.atr(3)
var float trailStop = 0.0
var float trailDir = 1.0
if not na(atr3)
    longStop = close - nz(atr3) * 1.5
    shortStop = close + nz(atr3) * 1.5
    if trailDir == 1.0
        trailStop := math.max(trailStop, longStop)
        if close < trailStop
            trailDir := -1.0
            trailStop := shortStop
    else
        trailStop := math.min(trailStop, shortStop)
        if close > trailStop
            trailDir := 1.0
            trailStop := longStop
