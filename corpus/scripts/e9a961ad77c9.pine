//@version=5
indicator("Merkle Tree Root")
leaf1 = open * 31.0
leaf2 = high * 37.0
leaf3 = low * 41.0
leaf4 = close * 43.0
branch1 = leaf1 + leaf2
branch1 := branch1 - math.floor(branch1 / 10000.0) * 10000.0
branch2 = leaf3 + leaf4
branch2 := branch2 - math.floor(branch2 / 10000.0) * 10000.0
root = branch1 + branch2
root := root - math.floor(root / 10000.0) * 10000.0
plot(root)
