
//@version=5
indicator("Comp Score")
compositeScore(float rsiVal, float trendVal, float volVal) =>
    rsiNorm = (rsiVal - 50) / 50
    combo = rsiNorm * 0.4 + trendVal * 0.35 + volVal * 0.25
    math.max(-1.0, math.min(1.0, combo))

rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
trend = close > sma3 ? 1.0 : -1.0
vol = avgATR > 0 ? -(atr / avgATR - 1.0) : 0.0
score = compositeScore(rsi, trend, vol)
plot(score, "Score")
