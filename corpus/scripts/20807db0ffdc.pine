//@version=5
strategy("SmaRsiVarStrat")
var int mode = 0
smaVal = nz(ta.sma(close, 3), close)
rsi = nz(ta.rsi(close, 5), 50.0)
if mode == 0
    if close > smaVal and rsi < 70
        strategy.entry("L", strategy.long)
        mode := 1
else
    if rsi > 75 or close < smaVal
        strategy.close("L")
        mode := 0
plot(float(mode), "M")
