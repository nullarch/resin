
//@version=5
indicator("DecBound")
type Boundary
    float threshold = 50.0
    int direction = 0
    float confidence = 0.0

var Boundary b = Boundary.new()
rsi = nz(ta.rsi(close, 3), 50.0)
b.direction := rsi > b.threshold ? 1 : rsi < b.threshold ? -1 : 0
b.confidence := math.abs(rsi - b.threshold) / 50.0
plot(b.confidence, "C")
