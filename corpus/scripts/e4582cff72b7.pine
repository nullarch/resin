//@version=5
indicator("UDTEnt14")
type EntTracker
    float upCount = 0.0
    float totalCount = 0.0
    float entropy = 0.0
var EntTracker et = EntTracker.new()
et.totalCount := et.totalCount + 1.0
if close > open
    et.upCount := et.upCount + 1.0
pUp = et.totalCount > 0 ? et.upCount / et.totalCount : 0.5
pDn = 1.0 - pUp
et.entropy := 0.0
if pUp > 0.01 and pDn > 0.01
    et.entropy := -(pUp * math.log(pUp) + pDn * math.log(pDn))
plot(et.entropy, "e")
