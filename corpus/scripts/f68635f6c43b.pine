//@version=5
indicator("Comprehensive Block")

// if/elif/else
var float if_val = 0.0
if close > 110
    if_val := 3.0
else if close > 105
    if_val := 2.0
else
    if_val := 1.0

// for
float for_sum = 0.0
for i = 1 to 5
    for_sum := for_sum + float(i)

// while
float w_count = 0.0
float w = 64.0
while w > 1.0
    w := w / 2.0
    w_count := w_count + 1.0

// switch
var float sw_val = 0.0
sw_val := switch
    close > 110 => 10.0
    => 0.0

// for-in
arr = array.new<float>(0)
array.push(arr, 100.0)
array.push(arr, 200.0)
float arr_sum = 0.0
for [idx, v] in arr
    arr_sum := arr_sum + v

var float total = 0.0
total := if_val + for_sum + w_count + sw_val + arr_sum
plot(total)
