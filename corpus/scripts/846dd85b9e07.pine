//@version=5
indicator("PID Windup Clamp")
float setpoint = nz(ta.sma(close, 5), close)
float error = setpoint - close
float kp = 0.6
float ki = 0.15
float kd = 0.04
var float integral = 0.0
var float prevErr = 0.0
integral := integral + error
integral := math.max(-50.0, math.min(50.0, integral))
float deriv = error - prevErr
float output = kp * error + ki * integral + kd * deriv
prevErr := error
float clampedOutput = math.max(-10.0, math.min(10.0, output))
