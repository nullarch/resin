
//@version=5
indicator("Trend UDT")
type TrendTracker
    int bullBars = 0
    int bearBars = 0
    float maxSpread = 0.0

var TrendTracker tt = TrendTracker.new()
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
spread = sma3 - sma5
tt.maxSpread := math.max(tt.maxSpread, math.abs(spread))
if spread > 0
    tt.bullBars := tt.bullBars + 1
else
    tt.bearBars := tt.bearBars + 1
plot(tt.bullBars - tt.bearBars, "Net")
