
//@version=5
indicator("Switch Map")
var actions = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
action = switch
    rsi > 70 => "sell"
    rsi < 30 => "buy"
    rsi > 55 => "hold_long"
    => "wait"
map.put(actions, "current", action == "buy" ? 1.0 : action == "sell" ? -1.0 : 0.0)
map.put(actions, "rsi", rsi)
plot(map.get(actions, "current", 0.0), "Act")
