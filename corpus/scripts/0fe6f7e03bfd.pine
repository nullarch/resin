//@version=5
indicator("CUSUMBreak")
var float cumSum = 0.0
var float meanEst = 0.0
var int cnt = 0
cnt := cnt + 1
meanEst := meanEst + (close - meanEst) / float(cnt)
cumSum := cumSum + (close - meanEst)
threshold = 5.0 * math.sqrt(float(cnt))
breakSignal = math.abs(cumSum) > threshold ? 1.0 : 0.0
plot(cumSum, "CUSUM")
plot(breakSignal, "Break")
