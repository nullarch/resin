
//@version=5
indicator("Cycle 87 Full")

// Arithmetic with all operators
spread = high - low
mid = (high + low) / 2.0
vol_ratio = volume * 100.0 / (volume + 1.0)
bar_mod = bar_index % 3

// Generic types
var array<float> spreads = array.new<float>(0)
array.push(spreads, spread)
if array.size(spreads) > 5
    array.shift(spreads)

// TA
sma_val = ta.sma(close, 5)
rsi_val = ta.rsi(close, 14)

// var persistence
var float max_spread = 0.0
if spread > max_spread
    max_spread := spread

// Alert noop
if rsi_val > 70
    alert("Overbought", alert.freq_once_per_bar)

// Comparison + boolean
bull = close > open and rsi_val > 50
score = bull ? max_spread : mid
plot(score)
