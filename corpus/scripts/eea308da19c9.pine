
//@version=5
indicator("Rank")
var float[] vals = array.new_float(0)
array.clear(vals)
array.push(vals, close)
array.push(vals, nz(ta.sma(close, 3), close))
array.push(vals, nz(ta.ema(close, 3), close))
sorted = array.copy(vals)
array.sort(sorted, order.ascending)
rank = 0
for i = 0 to array.size(sorted) - 1
    if array.get(sorted, i) == close
        rank := i + 1
        break
plot(float(rank), "R")
