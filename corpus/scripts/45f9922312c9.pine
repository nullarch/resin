
//@version=5
indicator("UAM Combo")
type BarStats
    float avg = 0.0
    float spread = 0.0

var BarStats bs = BarStats.new()
var float[] closes = array.new_float(0)
var meta = map.new<string, float>()
array.push(closes, close)
if array.size(closes) > 6
    array.shift(closes)
bs.avg := array.avg(closes)
bs.spread := array.max(closes) - array.min(closes)
map.put(meta, "avg", bs.avg)
map.put(meta, "spread", bs.spread)
plot(map.get(meta, "spread", 0.0), "Sp")
