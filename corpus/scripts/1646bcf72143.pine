
//@version=5
indicator("Count Above")
var float[] history = array.new_float(0)
array.push(history, close)
if array.size(history) > 8
    array.shift(history)
sma3 = ta.sma(close, 3)
aboveCount = 0
for val in history
    if float(val) > sma3
        aboveCount := aboveCount + 1
total = array.size(history)
pctAbove = total > 0 ? float(aboveCount) / float(total) * 100 : 0.0
plot(pctAbove, "PctAbove")
