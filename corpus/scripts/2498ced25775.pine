//@version=5
indicator("Two Step Decay Chain")
var float parent = 10000.0
var float daughter = 0.0
var float stable = 0.0
float lambda1 = 0.2
float lambda2 = 0.1
float parentDecay = lambda1 * parent
float daughterDecay = lambda2 * daughter
parent := math.max(parent - parentDecay, 0.0)
daughter := math.max(daughter + parentDecay - daughterDecay, 0.0)
stable := stable + daughterDecay
