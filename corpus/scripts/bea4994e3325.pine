
//@version=5
indicator("Period Map FI")
var pm = map.new<string, float>()
map.put(pm, "fast_trend", ta.sma(close, 3) > ta.sma(close, 5) ? 1.0 : -1.0)
map.put(pm, "fast_mom", nz(ta.rsi(close, 3), 50.0) > 50 ? 1.0 : -1.0)
map.put(pm, "price_pos", close > ta.sma(close, 5) ? 1.0 : -1.0)
total = 0.0
for [k, v] in pm
    total := total + v
plot(total, "T")
