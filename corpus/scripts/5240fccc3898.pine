
//@version=5
indicator("MA Score")
maScore(float price, float fast, float slow) =>
    aboveFast = price > fast ? 1.0 : -1.0
    fastAboveSlow = fast > slow ? 1.0 : -1.0
    spread = slow > 0 ? (fast - slow) / slow * 100 : 0.0
    aboveFast + fastAboveSlow + spread * 0.1

sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
score = maScore(close, sma3, sma5)
plot(score, "S")
