
//@version=5
indicator("Osc Hist")
var float[] rsiHist = array.new_float(0)
rsi = nz(ta.rsi(close, 3), 50.0)
array.push(rsiHist, rsi)
if array.size(rsiHist) > 8
    array.shift(rsiHist)
rsiAvg = array.avg(rsiHist)
rsiSD = array.stdev(rsiHist)
zRSI = rsiSD > 0 ? (rsi - rsiAvg) / rsiSD : 0.0
plot(zRSI, "ZRSI")
