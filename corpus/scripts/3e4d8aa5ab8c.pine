//@version=5
indicator("Lookback")
var float maxClose = 0.0
var float minClose = 999999.0
maxClose := close
minClose := close
for i = 1 to 5
    pastClose = close[i]
    if not na(pastClose)
        if nz(pastClose) > maxClose
            maxClose := nz(pastClose)
        if nz(pastClose) < minClose
            minClose := nz(pastClose)
lookbackRange = maxClose - minClose
