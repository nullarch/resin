
//@version=5
indicator("Signal Engine")
// Indicators
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
rsi = ta.rsi(close, 3)
atr = ta.atr(3)
[macd, sig, hist] = ta.macd(close, 3, 5, 3)

// Signal generation
trendSig = close > sma3 and sma3 > ema5 ? 1.0 : close < sma3 and sma3 < ema5 ? -1.0 : 0.0
momSig = rsi > 60 ? 1.0 : rsi < 40 ? -1.0 : 0.0
macdSig = hist > 0 ? 1.0 : -1.0

// Composite with weights
composite = trendSig * 0.4 + momSig * 0.3 + macdSig * 0.3

// Tracking
var float[] signals = array.new_float(0)
array.push(signals, composite)
if array.size(signals) > 8
    array.shift(signals)

avgSig = array.avg(signals)
var int bullBars = 0
var int bearBars = 0
if composite > 0
    bullBars := bullBars + 1
else if composite < 0
    bearBars := bearBars + 1

var m = map.new<string, float>()
map.put(m, "signal", composite)
map.put(m, "avg", avgSig)

plot(composite, "Signal")
plot(avgSig, "AvgSignal")
