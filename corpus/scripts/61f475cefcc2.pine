
//@version=5
indicator("Sig Quality")
type SigQuality
    float strength = 0.0
    float consistency = 0.0
    int duration = 0

var SigQuality sq = SigQuality.new()
sig = close > ta.sma(close, 3) ? 1.0 : -1.0
sq.strength := math.abs(close - ta.sma(close, 3))
if sig > 0
    sq.duration := sq.duration + 1
    sq.consistency := math.min(1.0, float(sq.duration) / 5.0)
else
    sq.duration := 0
    sq.consistency := 0.0
plot(sq.consistency, "Cons")
