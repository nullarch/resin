
//@version=5
indicator("Trend Str")
trendStrength(float price, float fastMA, float slowMA) =>
    aligned = (price > fastMA and fastMA > slowMA) or (price < fastMA and fastMA < slowMA)
    spread = fastMA - slowMA
    aligned ? math.abs(spread) : 0.0

ema3 = ta.ema(close, 3)
sma5 = ta.sma(close, 5)
ts = trendStrength(close, ema3, sma5)
plot(ts, "TS")
