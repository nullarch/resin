//@version=5
indicator("Cycle 127 Comprehensive", overlay=true)
sma3 = ta.sma(close, 3)
ema5 = ta.ema(close, 5)
wma5 = ta.wma(close, 5)
rsi5 = ta.rsi(close, 5)
cci5 = ta.cci(close, 5)
atr3 = ta.atr(3)
[diP, diM, adx] = ta.dmi(5, 5)
k = ta.stoch(close, high, low, 5)
chg = ta.change(close)
var prices = array.new_float(0)
var m = map.new<string, float>()
var int barCount = 0
var int bullSignals = 0
array.push(prices, close)
if array.size(prices) > 5
    array.shift(prices)
score = 0
if not na(sma3) and close > nz(sma3)
    score := score + 1
if not na(rsi5) and nz(rsi5) > 50
    score := score + 1
if not na(adx) and nz(adx) > 20
    score := score + 1
if score >= 2
    bullSignals := bullSignals + 1
map.put(m, "score", float(score))
map.put(m, "adx", nz(adx))
clr = score >= 2 ? color.green : color.red
plot(sma3, "SMA", color=clr)
plot(ema5, "EMA")
barCount := barCount + 1
