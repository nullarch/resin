
//@version=5
indicator("ScaleExp")
length = 5
vol = ta.stdev(close, length)
avgVol = ta.sma(nz(vol, 0.0), 5)
ratio = avgVol > 0 ? nz(vol, 0.0) / avgVol : 1.0
label = switch
    ratio > 1.5 => "SUPER"
    ratio > 1.0 => "NORMAL"
    ratio > 0.5 => "SUB"
    => "FLAT"
output = str.length(label)
plot(float(output), "SE")
