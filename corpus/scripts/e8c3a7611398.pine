
//@version=5
indicator("Dist Type")
var float[] rets = array.new_float(0)
ret = close - open
array.push(rets, ret)
if array.size(rets) > 8
    array.shift(rets)
avg = array.avg(rets)
sd = array.stdev(rets)
skewProxy = sd > 0 ? (close - open - avg) / sd : 0.0
distType = switch
    skewProxy > 1.0 => "right_skew"
    skewProxy < -1.0 => "left_skew"
    math.abs(skewProxy) < 0.3 => "symmetric"
    => "moderate"
isSym = distType == "symmetric"
plot(isSym ? 1 : 0, "Sym")
