//@version=5
indicator("Majority Vote")
var int vote = 0
smaVal = nz(ta.sma(close, 3), close)
emaVal = nz(ta.ema(close, 3), close)
rsiVal = nz(ta.rsi(close, 3), 50.0)
cell1 = close > smaVal ? 1 : 0
cell2 = close > emaVal ? 1 : 0
cell3 = rsiVal > 50 ? 1 : 0
total = cell1 + cell2 + cell3
vote := total >= 2 ? 1 : 0
