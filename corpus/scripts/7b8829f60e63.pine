
//@version=5
indicator("Osc Switch")
rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
avgOsc = (rsi + k) / 2
state = switch
    avgOsc > 80 => "extreme_ob"
    avgOsc > 65 => "overbought"
    avgOsc < 20 => "extreme_os"
    avgOsc < 35 => "oversold"
    => "neutral"
isExtreme = str.contains(state, "extreme")
plot(isExtreme ? 1 : 0, "Ext")
