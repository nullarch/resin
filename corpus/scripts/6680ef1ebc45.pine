//@version=5
indicator("Complex UDF TA")
getSignal(src, fastLen, slowLen) =>
    fast = ta.sma(src, fastLen)
    slow = ta.sma(src, slowLen)
    sig = not na(fast) and not na(slow) ? (nz(fast) > nz(slow) ? 1 : -1) : 0
    [sig, fast, slow]
[signal, fastMA, slowMA] = getSignal(close, 3, 5)
plot(fastMA, "Fast")
plot(slowMA, "Slow")
