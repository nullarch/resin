//@version=5
indicator("MapForInIfSwitch")
m = map.new<string, float>()
map.put(m, "bull", close > open ? 1.0 : 0.0)
map.put(m, "bear", close < open ? 1.0 : 0.0)
map.put(m, "flat", close == open ? 1.0 : 0.0)
total = 0.0
for [key, val] in m
    category = switch key
        "bull" => val * 2.0
        "bear" => val * -1.0
        => 0.0
    total := total + category
plot(total, "T")
