
//@version=5
indicator("FractalDash")
type Dashboard
    float hurst = 0.0
    float roughness = 0.0
    float entropy = 0.0
    int bars = 0
dash = Dashboard.new()
length = 5
rangeHL = ta.highest(high, length) - ta.lowest(low, length)
dev = ta.stdev(close, length)
rs = nz(dev, 0.001) > 0 ? nz(rangeHL, 1.0) / nz(dev, 0.001) : 1.0
dash.hurst := math.log(rs) / math.log(float(length))
hlRange = high - low
avgHL = ta.sma(hlRange, length)
dash.roughness := nz(avgHL, 1.0) > 0 ? hlRange / nz(avgHL, 1.0) : 1.0
dash.bars := bar_index + 1
metrics = array.new_float(0)
array.push(metrics, dash.hurst)
array.push(metrics, dash.roughness)
scoreMap = map.new<string, float>()
for i = 0 to array.size(metrics) - 1
    key = "m" + str.tostring(i)
    map.put(scoreMap, key, array.get(metrics, i))
totalScore = 0.0
for [k, v] in scoreMap
    totalScore := totalScore + v
regime = switch
    totalScore > 3.0 => "HIGH_FRACTAL"
    totalScore > 1.5 => "MID_FRACTAL"
    => "LOW_FRACTAL"
regimeNum = regime == "HIGH_FRACTAL" ? 3.0 : regime == "MID_FRACTAL" ? 2.0 : 1.0
plot(regimeNum + totalScore, "FD")
