//@version=5
indicator("Dashboard")
rsi = ta.rsi(close, 5)
[macdLine, signal, hist] = ta.macd(close, 3, 5, 3)
sma20 = ta.sma(close, 5)
atr = ta.atr(5)
bullish = rsi > 50 and macdLine > signal and close > sma20
bearish = rsi < 50 and macdLine < signal and close < sma20
score = bullish ? 1 : bearish ? -1 : 0
plot(score)
