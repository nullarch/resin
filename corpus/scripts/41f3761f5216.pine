
//@version=5
strategy("Adapt Stop", overlay=true)
atr = ta.atr(3)
rsi = nz(ta.rsi(close, 3), 50.0)
mult = rsi > 60 ? 1.5 : 2.5
sma3 = ta.sma(close, 3)
stopLevel = close - atr * mult
if close > sma3
    strategy.entry("Long", strategy.long)
if close < stopLevel
    strategy.close("Long")
plot(stopLevel, "Stop")
