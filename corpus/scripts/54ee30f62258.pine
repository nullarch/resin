//@version=5
indicator("All 4 CF Expr")
var float if_val = 0.0
if_val := if close > 100
    1.0
else
    0.0

var float for_val = 0.0
float facc = 0.0
for_val := for i = 1 to 3
    facc := facc + 1.0
    facc

var float while_val = 0.0
float wv = 8.0
while_val := while wv > 1.0
    wv := wv / 2.0
    wv

var float switch_val = 0.0
switch_val := switch
    close > 100 => 10.0
    => 0.0

var float total = 0.0
total := if_val + for_val + while_val + switch_val
plot(total)
