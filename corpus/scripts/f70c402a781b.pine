//@version=5
indicator("Recurrent Events")
var int eventCount = 0
var float prevClose = 0.0
bool isDrawdown = close < prevClose and prevClose > 0.0
if isDrawdown
    eventCount := eventCount + 1
prevClose := close
float eventRate = bar_index > 0 ? eventCount / bar_index : 0.0
plot(eventRate, "RecurrentRate")
