//@version=5
indicator("Market Regime")
enum Regime
    Trending = 1
    Ranging = 2
    Volatile = 3
atr3 = ta.atr(3)
[diP, diM, adx] = ta.dmi(5, 5)
var regime = Regime.Ranging
if not na(adx) and nz(adx) > 25
    regime := Regime.Trending
else if not na(atr3) and nz(atr3) > close * 0.02
    regime := Regime.Volatile
else
    regime := Regime.Ranging
