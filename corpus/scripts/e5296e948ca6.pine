
//@version=5
indicator("Sig Agg")
var signals = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
map.put(signals, "rsi_sig", rsi > 55 ? 1.0 : rsi < 45 ? -1.0 : 0.0)
map.put(signals, "ma_sig", close > sma3 ? 1.0 : -1.0)
map.put(signals, "mom_sig", close > close[1] ? 1.0 : -1.0)
total = 0.0
for [k, v] in signals
    total := total + v
consensus = total / 3.0
plot(consensus, "Con")
