
//@version=5
indicator("Rec Smooth")
doubleSmooth(float src, int len) =>
    first = ta.ema(src, len)
    ta.ema(first, len)

tripleSmooth(float src, int len) =>
    first = ta.ema(src, len)
    second = ta.ema(first, len)
    ta.ema(second, len)

ds = doubleSmooth(close, 3)
ts = tripleSmooth(close, 3)
diff = ds - ts
plot(diff, "Diff")
