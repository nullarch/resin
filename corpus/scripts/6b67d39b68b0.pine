//@version=5
indicator("Ultra 010")

clamp(float val, float lo, float hi) =>
    val < lo ? lo : val > hi ? hi : val

var float[] window = array.new_float(0)
var float runningMax = 0.0
var float runningMin = 999.0

emaVal = ta.ema(close, 3)
normed = not na(emaVal) and emaVal > 0 ? close / emaVal : 1.0
clamped = clamp(normed, 0.5, 1.5)

array.push(window, clamped)
if array.size(window) > 5
    array.shift(window)

for [idx, val] in window
    if val > runningMax
        runningMax := val
        if val > 1.3
            runningMax := runningMax * 0.99
    if val < runningMin
        runningMin := val

idx2 = 0
spread = runningMax - runningMin
smoothed = spread
while idx2 < 3
    smoothed := smoothed * 0.9
    idx2 := idx2 + 1

plot(math.round(smoothed * 1000) / 1000)
