//@version=5
indicator("Perplexity Proxy")
var float logLossSum = 0.0
var int count = 0
predicted = nz(ta.sma(close, 3), close)
err = math.abs(close - predicted)
normErr = err > 0 ? err / close : 0.001
logLossSum := logLossSum + math.log(normErr > 0.001 ? normErr : 0.001)
count := count + 1
perplexity = count > 0 ? math.exp(-logLossSum / count) : 1.0
