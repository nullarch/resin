//@version=5
indicator("AtrVarWhileTern")
var float cumAtr = 0.0
atrVal = nz(ta.atr(3), 1.0)
cumAtr := cumAtr + atrVal
countdown = 3
bonus = 0.0
while countdown > 0
    bonus := bonus + 0.5
    countdown := countdown - 1
label = cumAtr > 20.0 ? "HIGH" : "LOW"
code = label == "HIGH" ? 1.0 : 0.0
plot(cumAtr + bonus + code, "V")
