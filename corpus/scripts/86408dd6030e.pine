
//@version=5
indicator("Tern Size")
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
volNorm = close > 0 ? atr / close * 100 : 0.0
size = volNorm > 5 ? 0.25 : volNorm > 3 ? 0.5 : volNorm > 1 ? 0.75 : 1.0
momAdj = rsi > 60 ? 1.2 : rsi < 40 ? 0.8 : 1.0
finalSize = math.min(1.0, size * momAdj)
plot(finalSize, "Size")
