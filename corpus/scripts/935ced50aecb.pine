
//@version=5
indicator("AdaptBand")
atrVal = nz(ta.atr(3), 1.0)
smaVal = nz(ta.sma(close, 3), close)
avgAtr = nz(ta.sma(atrVal, 3), 1.0)
multiplier = avgAtr > 0 ? atrVal / avgAtr : 1.0
upper = smaVal + multiplier * atrVal
lower = smaVal - multiplier * atrVal
bandwidth = smaVal > 0 ? (upper - lower) / smaVal * 100 : 0.0
plot(bandwidth, "BW")
