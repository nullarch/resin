
//@version=5
indicator("Switch in For")
bullCount = 0
bearCount = 0
for i = 0 to 4
    c = close[i]
    o = open[i]
    if na(c) or na(o)
        continue
    classification = switch
        c > o => 1
        c < o => -1
        => 0
    if classification > 0
        bullCount := bullCount + 1
    else if classification < 0
        bearCount := bearCount + 1
plot(bullCount, "Bulls")
plot(bearCount, "Bears")
