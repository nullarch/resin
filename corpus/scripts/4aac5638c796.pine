
//@version=5
indicator("SR UDT")
type SRTracker
    float highestR = 0.0
    float lowestS = 99999.0
    int breakouts = 0

var SRTracker sr = SRTracker.new()
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
sr.highestR := math.max(sr.highestR, hi5)
sr.lowestS := math.min(sr.lowestS, lo5)
if close > sr.highestR * 0.99
    sr.breakouts := sr.breakouts + 1
plot(sr.breakouts, "BO")
