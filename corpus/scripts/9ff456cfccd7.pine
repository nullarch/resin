//@version=5
indicator("AllFeat 009")
type Metric
    float value
    string name
computeMetric(v) =>
    v > 0 ? math.sqrt(v) : 0.0
var registry = map.new<string, float>()
map.put(registry, "spread", 0.0)
map.put(registry, "body", 0.0)
spreadVal = high - low
bodyVal = math.abs(close - open)
map.put(registry, "spread", spreadVal)
map.put(registry, "body", bodyVal)
var float sumMetrics = 0.0
total = 0.0
for [key, val] in registry
    total := total + computeMetric(val)
for i = 0 to 2
    total := total + 0.0
sumMetrics := total
