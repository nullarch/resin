
//@version=5
indicator("UDFStr")
formatReport(float price, float change, string dir) =>
    priceStr = str.tostring(price)
    changeStr = str.tostring(change, "#.##")
    "[" + dir + "] " + priceStr + " (" + changeStr + "%)"

pctChange = open > 0 ? (close - open) / open * 100.0 : 0.0
dir = close > open ? "UP" : "DN"
report = formatReport(close, pctChange, dir)
reportLen = str.length(report)
plot(reportLen, "RL")
