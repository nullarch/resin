
//@version=5
indicator("Pat Name")
bodySize = math.abs(close - open_)
fullRange = high - low
ratio = fullRange > 0 ? bodySize / fullRange : 0.0
dir = close > open_ ? "BULL" : "BEAR"
strength = ratio > 0.7 ? "STRONG" : ratio > 0.3 ? "MEDIUM" : "WEAK"
name = dir + "_" + strength
isStrongBull = name == "BULL_STRONG"
plot(isStrongBull ? 1 : 0, "SB")
