
//@version=5
strategy("EventStrat", overlay=true)
var int cooldown = 0

if cooldown > 0
    cooldown := cooldown - 1

rsi = nz(ta.rsi(close, 3), 50.0)
if cooldown == 0 and rsi > 60 and close > open
    strategy.entry("Long", strategy.long)
    cooldown := 3
if rsi < 40
    strategy.close("Long")
plot(rsi, "R")
