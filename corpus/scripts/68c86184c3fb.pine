
//@version=5
indicator("Stat Regime")
stdev5 = ta.stdev(close, 5)
sma5 = ta.sma(close, 5)
cv = sma5 > 0 ? stdev5 / sma5 * 100 : 0.0
regime = switch
    cv > 5 => "high_vol"
    cv > 2 => "normal"
    cv > 0.5 => "low_vol"
    => "flat"
isHighVol = regime == "high_vol"
plot(isHighVol ? 1 : 0, "HV")
