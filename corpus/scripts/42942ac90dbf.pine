
//@version=5
strategy("All Exits", overlay=true)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
var float ep = 0.0
var int hb = 0
if close > sma3 and rsi > 50
    strategy.entry("Long", strategy.long)
    ep := close
    hb := 0
hb := hb + 1
tp = ep > 0 and close > ep + atr * 3
sl = ep > 0 and close < ep - atr * 2
te = hb > 5
re = rsi > 85
if tp or sl or te or re
    strategy.close("Long")
plot(sma3, "MA")
