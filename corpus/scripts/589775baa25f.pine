//@version=5
indicator("Sliding Window")
var float[] window = array.new_float(0)
array.push(window, close)
if array.size(window) > 5
    array.shift(window)
var float windowAvg = 0.0
sz = array.size(window)
if sz > 0
    float wSum = 0.0
    for i = 0 to sz - 1
        wSum := wSum + array.get(window, i)
    windowAvg := wSum / sz
