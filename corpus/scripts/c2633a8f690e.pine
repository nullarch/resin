
//@version=5
indicator("Cycle 89 Full")

// All refactored TA indicators
sma_val = ta.sma(close, 10)
ema_val = ta.ema(close, 10)
rsi_val = ta.rsi(close, 14)
[bb_mid, bb_up, bb_lo] = ta.bb(close, 20, 2.0)
[kc_mid, kc_up, kc_lo] = ta.kc(close, 20, 1.5)
atr_val = ta.atr(14)
dev_val = ta.stdev(close, 20)
med_val = ta.median(close, 10)
obv_val = ta.obv()
pr_val = ta.percentrank(close, 10)

// Squeeze detection
squeeze = bb_lo > kc_lo and bb_up < kc_up

// Combined score
score = rsi_val / 100.0 + (squeeze ? 1.0 : 0.0)
plot(score)
