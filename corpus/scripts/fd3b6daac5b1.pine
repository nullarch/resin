//@version=5
strategy("Multi Cond", overlay=true)
sma5 = ta.sma(close, 5)
rsi5 = ta.rsi(close, 5)
atr3 = ta.atr(3)
longCond = not na(sma5) and not na(rsi5) and close > nz(sma5) and nz(rsi5) < 70
shortCond = not na(sma5) and not na(rsi5) and close < nz(sma5) and nz(rsi5) > 30
if longCond
    strategy.entry("Long", strategy.long)
if shortCond
    strategy.close("Long")
