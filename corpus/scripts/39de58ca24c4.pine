//@version=5
indicator("Isotope Enrichment")
var float[] enrichmentHistory = array.new_float(0)
float naturalU235 = 0.72
float enrichFactor = 1.0 + (close - 100.0) / 200.0
float enriched = naturalU235 * enrichFactor
enriched := math.min(enriched, 95.0)
array.push(enrichmentHistory, enriched)
float maxEnrich = 0.0
for i = 0 to array.size(enrichmentHistory) - 1
    val = array.get(enrichmentHistory, i)
    if val > maxEnrich
        maxEnrich := val
