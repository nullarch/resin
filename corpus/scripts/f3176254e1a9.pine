
//@version=5
indicator("Strat Params")
var sp = map.new<string, float>()
map.put(sp, "fast_period", 3.0)
map.put(sp, "slow_period", 5.0)
map.put(sp, "rsi_ob", 70.0)
map.put(sp, "rsi_os", 30.0)
map.put(sp, "stop_mult", 2.0)
rsiOB = map.get(sp, "rsi_ob", 70.0)
rsiOS = map.get(sp, "rsi_os", 30.0)
rsi = ta.rsi(close, 3)
signal = rsi > rsiOB ? -1 : rsi < rsiOS ? 1 : 0
plot(signal, "Signal")
