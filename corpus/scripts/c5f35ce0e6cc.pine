//@version=5
indicator("EMA Cloud")
ema8 = ta.ema(close, 8)
ema13 = ta.ema(close, 13)
ema21 = ta.ema(close, 21)
bullish = ema8 > ema13 and ema13 > ema21
bearish = ema8 < ema13 and ema13 < ema21
var int trend = 0
if bullish
    trend := 1
else if bearish
    trend := -1
else
    trend := 0
plot(trend)
