
//@version=5
strategy("OBStrat")
type OBState
    float imbalance = 0.0
    float spread = 0.0
    string signal = "NONE"
ob = OBState.new()
buyPressure = close > open ? volume : volume * 0.3
sellPressure = close < open ? volume : volume * 0.3
ob.imbalance := (buyPressure - sellPressure) / (buyPressure + sellPressure + 0.001)
ob.spread := (high - low) / (close + 0.001) * 100.0
avgImb = ta.sma(ob.imbalance, 3)
ob.signal := nz(avgImb, 0.0) > 0.2 ? "BUY" : nz(avgImb, 0.0) < -0.2 ? "SELL" : "HOLD"
signals = array.new_string(0)
array.push(signals, ob.signal)
spreadMap = map.new<string, float>()
map.put(spreadMap, "current", ob.spread)
map.put(spreadMap, "imb", ob.imbalance)
totalInfo = 0.0
for [k, v] in spreadMap
    totalInfo := totalInfo + math.abs(v)
if ob.signal == "BUY"
    strategy.entry("Long", strategy.long)
if ob.signal == "SELL"
    strategy.close("Long")
plot(totalInfo, "OB")
