
//@version=5
indicator("Equity")
var float[] equity = array.new_float(0)
var float balance = 10000.0
ret = nz(close - close[1], 0.0)
sma3 = ta.sma(close, 3)
if close > sma3
    balance := balance + ret
array.push(equity, balance)
if array.size(equity) > 10
    array.shift(equity)
maxEquity = array.size(equity) > 0 ? array.max(equity) : balance
dd = maxEquity > 0 ? (maxEquity - balance) / maxEquity * 100 : 0.0
plot(dd, "DD")
