
//@version=5
indicator("Vol Label")
avgVol = ta.sma(volume, 5)
ratio = avgVol > 0 ? volume / avgVol : 1.0
volLabel = ratio > 2 ? "SURGE" : ratio > 1 ? "ABOVE" : "BELOW"
priceDir = close > open ? "UP" : "DN"
combined = priceDir + "_" + volLabel
isConfirmed = combined == "UP_SURGE" or combined == "UP_ABOVE"
plot(isConfirmed ? 1 : 0, "Conf")
