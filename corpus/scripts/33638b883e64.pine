
//@version=5
indicator("Complex For")
sma3 = ta.sma(close, 3)
totalDist = 0.0
upBars = 0
maxDist = 0.0
for i = 0 to 4
    if not na(close[i])
        dist = close[i] - sma3
        totalDist := totalDist + dist
        maxDist := math.max(maxDist, math.abs(dist))
        if close[i] > sma3
            upBars := upBars + 1
avgDist = totalDist / 5
plot(avgDist, "AD")
