
//@version=5
indicator("Deque")
var float[] deque = array.new_float(0)
if close > open
    array.push(deque, close)
else
    array.unshift(deque, close)
if array.size(deque) > 8
    if close > open
        array.shift(deque)
    else
        array.pop(deque)
sz = array.size(deque)
plot(sz, "Size")
