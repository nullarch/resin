
//@version=5
indicator("LW Avg")
weightedSum = 0.0
totalWeight = 0.0
for i = 0 to 4
    w = 5.0 - i
    val = close[i]
    if not na(val)
        weightedSum := weightedSum + val * w
        totalWeight := totalWeight + w
lwma = totalWeight > 0 ? weightedSum / totalWeight : close
plot(lwma, "LWMA")
