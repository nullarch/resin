
//@version=5
indicator("Double Accum")
sumUp = 0.0
sumDown = 0.0
for i = 0 to 4
    chg = close[i] - close[i + 1]
    if not na(chg)
        if chg > 0
            sumUp := sumUp + chg
        else
            sumDown := sumDown + math.abs(chg)
ratio = sumDown != 0 ? sumUp / sumDown : 1.0
plot(ratio, "UpDown Ratio")
