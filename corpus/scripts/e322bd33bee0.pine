
//@version=5
indicator("Cond Map")
var cm = map.new<string, float>()
rsi = nz(ta.rsi(close, 3), 50.0)
if rsi > 60
    map.put(cm, "state", 1.0)
    map.put(cm, "entry", close)
else if rsi < 40
    map.put(cm, "state", -1.0)
    map.put(cm, "entry", close)
state = map.get(cm, "state", 0.0)
entry = map.get(cm, "entry", close)
pnl = state != 0 ? (close - entry) * state : 0.0
plot(pnl, "PnL")
