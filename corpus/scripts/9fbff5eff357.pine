
//@version=5
indicator("Win Diff")
var float[] win = array.new_float(0)
array.push(win, close)
if array.size(win) > 5
    array.shift(win)
var float[] diffs = array.new_float(0)
array.clear(diffs)
for i = 1 to array.size(win) - 1
    d = array.get(win, i) - array.get(win, i - 1)
    array.push(diffs, d)
avgDiff = array.size(diffs) > 0 ? array.avg(diffs) : 0.0
plot(avgDiff, "AvgDiff")
