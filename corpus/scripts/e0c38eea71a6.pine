//@version=5
indicator("DG-13 Ricci Scalar")
var float ricci = 0.0
if not na(close[2])
    dp1 = close - close[1]
    dp0 = close[1] - close[2]
    d2p = dp1 - dp0
    devVal = nz(ta.stdev(close, 5), 1.0)
    metricSq = 1.0 + devVal * devVal
    ricci := metricSq > 0.01 ? d2p / metricSq : 0.0
plot(ricci)
