
//@version=5
indicator("Stat Map")
var sm = map.new<string, float>()
map.put(sm, "sma", ta.sma(close, 5))
map.put(sm, "high", ta.highest(high, 5))
map.put(sm, "low", ta.lowest(low, 5))
total = 0.0
count = 0
for [k, v] in sm
    total := total + v
    count := count + 1
avg = count > 0 ? total / count : 0.0
plot(avg, "Avg")
