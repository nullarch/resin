
//@version=5
indicator("Full System")
// Trend module
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
trendUp = sma3 > sma5

// Momentum module
rsiVal = ta.rsi(close, 3)
momUp = rsiVal > 50

// Risk module
atrVal = ta.atr(3)
[mid, upper, lower] = ta.bb(close, 5, 2.0)
bbWidth = upper - lower

// Signal combination
signal = (trendUp ? 1 : 0) + (momUp ? 1 : 0)

// State tracking
var int bullSignals = 0
var int bearSignals = 0
var float bestPrice = 0.0
if signal >= 2
    bullSignals := bullSignals + 1
    if close > bestPrice
        bestPrice := close
else if signal == 0
    bearSignals := bearSignals + 1

// Array history
var float[] signals = array.new_float(0)
array.push(signals, float(signal))

plot(signal, "Signal")
plot(bullSignals, "Bulls")
plot(bearSignals, "Bears")
