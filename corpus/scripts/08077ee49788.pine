//@version=5
strategy("Torture 14")
type Entry
    float price = 0.0
    float confidence = 0.0
method shouldAdd(Entry this) =>
    this.confidence > 0.6
var float avgConfidence = 0.0
var int signals = 0
float rsiVal = nz(ta.rsi(close, 5), 50.0)
float atrVal = nz(ta.atr(3), 1.0)
float sma3 = nz(ta.sma(close, 3), close)
confidences = array.new<float>(0)
for idx = 0 to 2
    float lookback = 3 + idx
    float smaLB = nz(ta.sma(close, lookback), close)
    float conf = close > smaLB ? 0.3 + idx * 0.1 : 0.1
    confidences.push(conf)
float totalConf = 0.0
for c in confidences
    totalConf := totalConf + c
float normConf = confidences.size() > 0 ? totalConf / confidences.size() : 0.0
ent = Entry.new(close, normConf)
float direction = switch
    normConf > 0.5 and rsiVal > 50 => 1.0
    normConf < 0.3 and rsiVal < 50 => -1.0
    => 0.0
if direction > 0.0 and ent.shouldAdd()
    strategy.entry("Pyr", strategy.long)
    signals := signals + 1
if direction < 0.0
    strategy.close("Pyr")
avgConfidence := avgConfidence + (normConf - avgConfidence) / math.max(signals, 1)
