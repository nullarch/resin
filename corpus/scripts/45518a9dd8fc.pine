
//@version=5
indicator("Range Brk")
avgRange = ta.sma(high - low, 5)
threshold = avgRange * 2
found = false
barsBack = 0
iters = 0
while not found and iters < 8
    r = high[iters] - low[iters]
    if not na(r) and r > threshold
        found := true
        barsBack := iters
    iters := iters + 1
plot(barsBack, "Back")
