
//@version=5
indicator("3 State")
var int state = 0
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
if state == 0
    if close > sma3 and rsi > 55
        state := 1
    else if close < sma3 and rsi < 45
        state := -1
else if state == 1
    if close < sma3 or rsi < 40
        state := 0
else if state == -1
    if close > sma3 or rsi > 60
        state := 0
plot(state, "State")
