
//@version=5
strategy("Score Strat", overlay=true)
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
[m, s, h] = ta.macd(close, 3, 5, 3)
score = (rsi - 50) / 50 * 0.4 + (close > sma3 ? 1.0 : -1.0) * 0.3 + (h > 0 ? 1.0 : -1.0) * 0.3
if score > 0.3
    strategy.entry("Long", strategy.long)
if score < -0.2
    strategy.close("Long")
plot(sma3, "MA")
