
//@version=5
indicator("Priority Sig")
rsi = ta.rsi(close, 3)
sma3 = ta.sma(close, 3)
atr = ta.atr(3)
signal = 0
priority = ""
if rsi > 80
    signal := -2
    priority := "rsi_extreme"
else if rsi < 20
    signal := 2
    priority := "rsi_extreme"
else if close > sma3 and atr > ta.sma(atr, 5)
    signal := 1
    priority := "trend_vol"
else
    priority := "none"
plot(signal, "Signal")
