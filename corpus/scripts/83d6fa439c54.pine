//@version=5
indicator("Lotka-Volterra Prey")
alpha = 0.1
beta = 0.002
var float prey = 100.0
var float predator = 20.0
dPrey = alpha * prey - beta * prey * predator
prey := math.max(prey + dPrey, 1.0)
dPred = 0.001 * prey * predator - 0.05 * predator
predator := math.max(predator + dPred, 1.0)
plot(prey, "Prey")
