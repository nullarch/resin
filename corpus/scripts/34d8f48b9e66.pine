
//@version=5
indicator("Bar Types")
var int bullBars = 0
var int bearBars = 0
var int dojiBars = 0
body = math.abs(close - open)
rng = high - low
ratio = rng > 0 ? body / rng : 0.0
if ratio < 0.1
    dojiBars := dojiBars + 1
else if close > open
    bullBars := bullBars + 1
else
    bearBars := bearBars + 1
total = bullBars + bearBars + dojiBars
bullPct = total > 0 ? float(bullBars) / float(total) * 100 : 0.0
plot(bullPct, "BullPct")
