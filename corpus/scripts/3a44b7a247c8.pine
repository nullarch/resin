
//@version=5
strategy("Adapt Strat", overlay=true)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
rsiThresh = avgATR > 0 and atr / avgATR > 1.5 ? 60 : 50
if close > sma3 and rsi > rsiThresh
    strategy.entry("Long", strategy.long)
if close < sma3 or rsi < 35
    strategy.close("Long")
plot(sma3, "MA")
