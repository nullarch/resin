
//@version=5
indicator("Sig Hist")
var float[] sigHist = array.new_float(0)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
sig = (close > sma3 ? 1.0 : -1.0) + (rsi - 50) / 50
array.push(sigHist, sig)
if array.size(sigHist) > 8
    array.shift(sigHist)
avgSig = array.size(sigHist) > 0 ? array.avg(sigHist) : 0.0
plot(avgSig, "AS")
