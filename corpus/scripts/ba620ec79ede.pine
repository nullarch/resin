
//@version=5
indicator("Vol Level E")
enum VolLevel
    Extreme = 3
    High = 2
    Normal = 1
    Low = 0

atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
ratio = avgATR > 0 ? atr / avgATR : 1.0
vl = switch
    ratio > 2.0 => VolLevel.Extreme
    ratio > 1.3 => VolLevel.High
    ratio < 0.5 => VolLevel.Low
    => VolLevel.Normal
plot(int(vl), "VL")
