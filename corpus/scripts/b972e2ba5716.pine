//@version=5
strategy("Neural Crossover Strategy")
fastEma = ta.ema(close, 2)
slowEma = ta.ema(close, 5)
bullCross = not na(fastEma) and not na(slowEma) and fastEma > slowEma
bearCross = not na(fastEma) and not na(slowEma) and fastEma < slowEma
if bullCross
    strategy.entry("NeuralLong", strategy.long)
if bearCross
    strategy.close("NeuralLong")
