
//@version=5
indicator("KAMA")
var float kama = 0.0
direction = math.abs(close - close[5])
volatility = 0.0
for i = 0 to 4
    diff = math.abs(close[i] - close[i+1])
    if not na(diff)
        volatility := volatility + diff
er = volatility > 0 ? nz(direction, 0.0) / volatility : 0.0
fastSC = 2.0 / (2 + 1)
slowSC = 2.0 / (30 + 1)
sc = math.pow(er * (fastSC - slowSC) + slowSC, 2)
kama := kama + sc * (close - kama)
plot(kama, "KAMA")
