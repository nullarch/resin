//@version=5
indicator("PID Controller")
float setpoint = 106.0
float err = setpoint - close
var float integral = 0.0
integral := integral + 0.1 * err
float prevErr = not na(close[1]) ? setpoint - close[1] : 0.0
float pTerm = 0.5 * err
float iTerm = integral
float dTerm = 0.2 * (err - prevErr)
float pidOut = pTerm + iTerm + dTerm
