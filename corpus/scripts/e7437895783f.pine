//@version=5
indicator("BinEntropy01")
var int upCount = 0
var int totalBars = 0
totalBars := totalBars + 1
if close > open
    upCount := upCount + 1
pUp = totalBars > 0 ? float(upCount) / float(totalBars) : 0.5
pDown = 1.0 - pUp
entropy = 0.0
if pUp > 0.001 and pDown > 0.001
    entropy := -(pUp * math.log(pUp) + pDown * math.log(pDown))
plot(entropy, "ent")
