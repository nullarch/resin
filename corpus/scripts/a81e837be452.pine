//@version=5
strategy("OS Load Balancer")
float sma3 = nz(ta.sma(close, 3), close)
float atrVal = nz(ta.atr(3), 1.0)
float loadCore1 = close - sma3
float loadCore2 = high - sma3
float imbalance = math.abs(loadCore1 - loadCore2)
float threshold = atrVal * 0.5
if imbalance > threshold and close > sma3
    strategy.entry("Rebalance", strategy.long)
if imbalance < threshold * 0.3
    strategy.close("Rebalance")
