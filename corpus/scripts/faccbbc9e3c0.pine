
//@version=5
indicator("Cndl Type")
bodySize = math.abs(close - open_)
fullRange = high - low
ratio = fullRange > 0 ? bodySize / fullRange : 0.0
upperWick = high - math.max(close, open_)
lowerWick = math.min(close, open_) - low
cType = switch
    ratio < 0.1 => "doji"
    lowerWick > bodySize * 2 and close > open_ => "hammer"
    upperWick > bodySize * 2 and close < open_ => "star"
    ratio > 0.7 and close > open_ => "strong_bull"
    ratio > 0.7 and close < open_ => "strong_bear"
    => "normal"
isStrong = cType == "strong_bull" or cType == "strong_bear"
plot(isStrong ? 1 : 0, "S")
