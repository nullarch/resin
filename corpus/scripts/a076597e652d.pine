//@version=5
indicator("Max Lyapunov")
float ema2 = nz(ta.ema(close, 2), close)
float ema3 = nz(ta.ema(close, 3), close)
float gap = math.abs(ema2 - ema3)
float logGap = math.log(math.max(gap, 0.001))
var float sumLog = 0.0
var int cnt = 0
cnt := cnt + 1
sumLog := sumLog + logGap
float avgLogGap = cnt > 0 ? sumLog / cnt : 0.0
