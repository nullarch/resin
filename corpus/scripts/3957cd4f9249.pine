//@version=5
indicator("Enum UDT")
enum SignalType
    Buy = 1
    Sell = -1
    Hold = 0
type Signal
    float strength = 0.0
getSignal() =>
    rsi = ta.rsi(close, 14)
    sig = Signal.new()
    if rsi > 70
        sig.strength := (rsi - 70) / 30
    else if rsi < 30
        sig.strength := (30 - rsi) / 30
    sig
s = getSignal()
plot(s.strength)
