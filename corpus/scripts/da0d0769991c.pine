//@version=5
indicator("Flock Align")
ema3 = ta.ema(close, 3)
ema5 = ta.ema(close, 5)
prevEma3 = nz(ema3[1])
prevEma5 = nz(ema5[1])
dir3 = ema3 > prevEma3 ? 1.0 : -1.0
dir5 = ema5 > prevEma5 ? 1.0 : -1.0
alignment = (dir3 + dir5) / 2.0
isAligned = math.abs(alignment) > 0.5
plot(isAligned ? alignment : 0)
