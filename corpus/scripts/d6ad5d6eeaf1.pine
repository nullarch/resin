
//@version=5
indicator("Cond UDF")
adaptiveWeight(float rsi, float vol, float trend) =>
    if vol > 1.5
        0.3
    else if trend > 0 and rsi > 50
        0.8
    else if trend < 0 and rsi < 50
        0.8
    else
        0.5

rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
vol = avgATR > 0 ? atr / avgATR : 1.0
trend = close - ta.sma(close, 3)
w = adaptiveWeight(rsi, vol, trend)
plot(w, "W")
