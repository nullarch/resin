
//@version=5
indicator("Break Map")
var bm = map.new<string, float>()
hi5 = ta.highest(high, 5)
lo5 = ta.lowest(low, 5)
map.put(bm, "hi", hi5)
map.put(bm, "lo", lo5)
map.put(bm, "close", close)
nearLevel = 0
atr = nz(ta.atr(3), 1.0)
for [k, v] in bm
    if k != "close" and math.abs(close - v) < atr
        nearLevel := nearLevel + 1
plot(nearLevel, "NL")
