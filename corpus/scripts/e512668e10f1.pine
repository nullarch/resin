//@version=5
indicator("Phase06")
var int barN = 0
barN := barN + 1
period = 5.0
inPhase = math.sin(2.0 * math.pi * float(barN) / period) * (close - 100.0)
quadrature = math.cos(2.0 * math.pi * float(barN) / period) * (close - 100.0)
denom = math.sqrt(inPhase * inPhase + quadrature * quadrature)
normI = denom > 0.001 ? inPhase / denom : 0.0
normQ = denom > 0.001 ? quadrature / denom : 0.0
phaseAngle = math.atan(normQ > 0.0001 ? normI / normQ : 0.0)
plot(phaseAngle, "pa")
