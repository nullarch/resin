
//@version=5
indicator("Corr Matrix")
var cm = map.new<string, float>()
chgClose = ta.change(close, 1)
chgVol = ta.change(volume, 1)
map.put(cm, "close_chg", nz(chgClose, 0.0))
map.put(cm, "vol_chg", nz(chgVol, 0.0))
sameDir = (nz(chgClose, 0.0) > 0 and nz(chgVol, 0.0) > 0) or (nz(chgClose, 0.0) < 0 and nz(chgVol, 0.0) < 0)
plot(sameDir ? 1 : 0, "SameDir")
