
//@version=5
indicator("ATR Breakout")
atrVal = ta.atr(3)
sma5 = ta.sma(close, 5)
upperBand = sma5 + atrVal * 1.5
lowerBand = sma5 - atrVal * 1.5
breakUp = close > upperBand
breakDown = close < lowerBand
var int breakouts = 0
if breakUp or breakDown
    breakouts := breakouts + 1
plot(breakouts, "Breakouts")
