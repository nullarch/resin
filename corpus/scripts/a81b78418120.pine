//@version=5
indicator("Cycle49 All")
// UDT (tests _NEW_SUFFIX, _COPY_SUFFIX)
type Info
    float val = 0.0
    string label_ = ""

var Info info = Info.new(42.0, "test")
var Info dup = Info.copy(info)
dup.val := 99.0

// Generic (tests _GENERIC_OPEN)
var arr = array.new<float>(0)
array.push(arr, close)
var m = map.new<string, float>()
m.put("info", nz(info.val))

// Switch MA dispatch
maType = "SMA"
ma = switch maType
    "EMA" => ta.ema(close, 5)
    "SMA" => ta.sma(close, 5)
    => ta.sma(close, 3)

// str.format
var string msg = ""
msg := str.format("MA={0}", str.tostring(nz(ma)))

// na dual use
float x = na  // non-var: reset to na each bar
var bool was_na = false
was_na := na(x)  // True: x is na before assignment
x := close

// Nested TA
rsi5 = ta.rsi(close, 5)
sma_rsi = ta.sma(rsi5, 3)

// var counter
var int bars = 0
bars := bars + 1

// Result
var float result = 0.0
result := nz(info.val) + nz(dup.val) + array.size(arr) + m.size() + nz(sma_rsi, 50.0) + bars
plot(close)
