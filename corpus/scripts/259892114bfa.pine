
//@version=5
strategy("Multi Cond", overlay=true)
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsiVal = ta.rsi(close, 3)
atrVal = ta.atr(3)
longCond = close > sma3 and sma3 > sma5 and rsiVal > 40
shortCond = close < sma3 and sma3 < sma5 and rsiVal < 60
if longCond
    strategy.entry("Long", strategy.long)
if shortCond
    strategy.entry("Short", strategy.short)
plot(sma3, "Fast")
