//@version=5
indicator("Materials Comprehensive")
var float cumStress = 0.0
var float cumLattice = 0.0
var int solidCount = 0
var float[] grains = array.new_float(0)
var int cnt = 0
cnt := cnt + 1

// Stress
force = volume / 100.0
area = high - low
stress = area > 0 ? force / area : 0.0
cumStress := cumStress + stress

// Lattice energy
q1 = close / 100.0
q2 = nz(close[1], close) / 100.0
dist = math.abs(close - nz(close[1], close))
latticeE = dist > 0.1 ? -(q1 * q2) / dist : 0.0
cumLattice := cumLattice + latticeE

// Phase classification
temp = close - 100.0
pressure = volume / 100.0
if temp < 5 and pressure > 10
    solidCount := solidCount + 1

// Grain tracking
grainSize = high - low
array.push(grains, grainSize)
nGrains = array.size(grains)

avgStress = cnt > 0 ? cumStress / cnt : 0.0
materialScore = avgStress * 10.0 + cumLattice + solidCount * 5.0 + nGrains
