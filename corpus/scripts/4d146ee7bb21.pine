
//@version=5
strategy("Mom Rot", overlay=true)
roc3 = close[3] > 0 ? (close - close[3]) / close[3] * 100 : 0.0
sma3 = ta.sma(close, 3)
strongMom = nz(roc3, 0.0) > 2
if strongMom and close > sma3
    strategy.entry("Long", strategy.long)
if nz(roc3, 0.0) < -1 or close < sma3
    strategy.close("Long")
plot(sma3, "MA")
