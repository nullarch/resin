
//@version=5
indicator("Pctl")
var float[] closes = array.new_float(0)
array.push(closes, close)
if array.size(closes) > 10
    array.shift(closes)
sorted = array.copy(closes)
array.sort(sorted)
sz = array.size(sorted)
p75 = sz > 0 ? array.get(sorted, int(sz * 0.75) < sz ? int(sz * 0.75) : sz - 1) : close
isHigh = close > p75
plot(isHigh ? 1 : 0, "Hi")
