
//@version=5
strategy("Filtered", overlay=true)
sma3 = ta.sma(close, 3)
rsi = nz(ta.rsi(close, 3), 50.0)
avgVol = ta.sma(volume, 5)
bullish = close > sma3 and rsi > 55
volConfirm = volume > avgVol
if bullish and volConfirm
    strategy.entry("Long", strategy.long)
if close < sma3
    strategy.close("Long")
plot(sma3, "MA")
