
//@version=5
indicator("Cyc Peaks")
var float[] peaks = array.new_float(0)
isPeak = not na(high[2]) and high[1] > high[2] and high[1] > high
if isPeak
    array.push(peaks, high[1])
if array.size(peaks) > 6
    array.shift(peaks)
avgPeak = array.size(peaks) > 0 ? array.avg(peaks) : high
plot(avgPeak, "AP")
