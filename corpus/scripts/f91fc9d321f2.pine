
//@version=5
indicator("MTF Full")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
ema3 = ta.ema(close, 3)
rsi3 = nz(ta.rsi(close, 3), 50.0)
rsi5 = nz(ta.rsi(close, 5), 50.0)
atr3 = nz(ta.atr(3), 1.0)
atr5 = nz(ta.atr(5), 1.0)

trendAlign = sma3 > sma5 and close > sma3 ? 1.0 : sma3 < sma5 and close < sma3 ? -1.0 : 0.0
momAlign = rsi3 > rsi5 ? 1.0 : -1.0
volExpand = atr5 > 0 ? atr3 / atr5 : 1.0

composite = trendAlign * 0.4 + momAlign * 0.3 + volExpand * 0.3

var int alignBars = 0
if composite > 0.5
    alignBars := alignBars + 1

plot(composite, "C")
plot(alignBars, "AB")
