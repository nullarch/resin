
//@version=5
indicator("Reg Score")
regimeScore(float price, float ma, float rsi, float vol) =>
    trendPt = price > ma ? 1.0 : -1.0
    momPt = (rsi - 50) / 50
    volPt = vol < 1.5 ? 0.5 : -0.5
    trendPt * 0.4 + momPt * 0.4 + volPt * 0.2

sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = ta.atr(3)
avgATR = ta.sma(atr, 5)
volR = avgATR > 0 ? atr / avgATR : 1.0
score = regimeScore(close, sma5, rsi, volR)
plot(score, "Score")
