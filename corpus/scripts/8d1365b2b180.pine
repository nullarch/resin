
//@version=5
indicator("Running Stats")
arr = array.from(close, open, high, low, volume)
sum = 0.0
mx = -999999.0
mn = 999999.0
for val in arr
    fv = float(val)
    sum := sum + fv
    if fv > mx
        mx := fv
    if fv < mn
        mn := fv
avg = sum / array.size(arr)
plot(avg, "Avg")
plot(mx - mn, "Range")
