
//@version=5
indicator("UDT Method")
type Band
    float upper = 0.0
    float lower = 0.0
    float mid = 0.0

bandWidth(Band b) =>
    b.upper - b.lower

var Band bb = Band.new()
[mid, upper, lower] = ta.bb(close, 5, 2.0)
bb.upper := upper
bb.lower := lower
bb.mid := mid
w = bandWidth(bb)
plot(w, "Width")
