
//@version=5
indicator("Switch Full")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)

score = (close > sma3 ? 1 : 0) + (sma3 > sma5 ? 1 : 0) + (rsi > 55 ? 1 : 0)
regime = switch
    score == 3 and avgATR > 0 and atr / avgATR < 1.3 => "ideal"
    score >= 2 => "good"
    score == 1 => "cautious"
    => "avoid"

weight = switch regime
    "ideal" => 2.0
    "good" => 1.0
    "cautious" => 0.5
    => 0.0

signal = (rsi - 50) / 50 * weight
plot(signal, "Sig")
