
//@version=5
indicator("ZeroCross")
trend = nz(ta.sma(close, 5), close)
detrended = close - trend
var float prevDet = 0.0
var int crossCount = 0
crossed = (detrended > 0 and prevDet <= 0) or (detrended < 0 and prevDet >= 0)
crossCount := crossed ? crossCount + 1 : crossCount
prevDet := detrended
plot(crossCount, "XC")
