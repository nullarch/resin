
//@version=5
indicator("Regime Type")
sma3 = ta.sma(close, 3)
sma5 = ta.sma(close, 5)
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
volHigh = avgATR > 0 and atr > avgATR * 1.3
trending = math.abs(sma3 - sma5) > 0.5
regType = switch
    trending and volHigh => "volatile_trend"
    trending => "quiet_trend"
    volHigh => "volatile_range"
    => "quiet_range"
isVolTrend = regType == "volatile_trend"
plot(isVolTrend ? 1 : 0, "VT")
