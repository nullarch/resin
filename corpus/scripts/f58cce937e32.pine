//@version=5
indicator("comprehensive 113")
type Config
    float multiplier = 2.0
    int length = 5
enum Mode
    Fast = 3
    Slow = 8
calcTA(src, len) =>
    ta.sma(src, len)
var float maxSMA = 0.0
var int barCount = 0
cfg = Config.new(2.0, 5)
mode = Mode.Fast
len = switch mode
    Mode.Fast => 3
    Mode.Slow => 8
    => 5
smaVal = calcTA(close, len)
emaVal = ta.ema(close, len)
atrVal = ta.atr(cfg.length)
tfSec = timeframe.in_seconds("D")
arr = array.from(nz(smaVal, 0.0), nz(emaVal, 0.0))
avgTA = array.avg(arr)
if not na(smaVal) and smaVal > maxSMA
    maxSMA := smaVal
barCount := barCount + 1
