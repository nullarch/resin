//@version=5
indicator("UDF Break")
findLevel(float[] arr, float threshold) =>
    result = -1.0
    for i = 0 to array.size(arr) - 1
        val = array.get(arr, i)
        if val > threshold
            result := val
            break
    result
var float[] prices = array.new_float(0)
array.push(prices, close)
if array.size(prices) > 20
    array.shift(prices)
level = findLevel(prices, 108.0)
plot(level)
