
//@version=5
indicator("Multi Param")
weightedScore(float p1, float w1, float p2, float w2, float p3, float w3) =>
    (p1 * w1 + p2 * w2 + p3 * w3) / (w1 + w2 + w3)

rsi = nz(ta.rsi(close, 3), 50.0)
k = ta.stoch(close, high, low, 5)
sma3 = ta.sma(close, 3)
maScore = close > sma3 ? 70.0 : 30.0
ws = weightedScore(rsi, 0.4, k, 0.3, maScore, 0.3)
plot(ws, "WS")
