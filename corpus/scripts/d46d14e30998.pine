
//@version=5
indicator("Dash State")
var int bullSignals = 0
var int bearSignals = 0
var int totalBars = 0
totalBars := totalBars + 1
rsi = nz(ta.rsi(close, 3), 50.0)
sma3 = ta.sma(close, 3)
if close > sma3 and rsi > 55
    bullSignals := bullSignals + 1
if close < sma3 and rsi < 45
    bearSignals := bearSignals + 1
bullPct = totalBars > 0 ? float(bullSignals) / totalBars * 100 : 0.0
plot(bullPct, "BP")
