
//@version=5
indicator("Vol Lbl")
atr = nz(ta.atr(3), 1.0)
avgATR = ta.sma(nz(ta.atr(3), 1.0), 5)
ratio = avgATR > 0 ? atr / avgATR : 1.0
volLabel = ratio > 1.3 ? "HIGH" : ratio < 0.7 ? "LOW" : "NORM"
trend = close > ta.sma(close, 3) ? "UP" : "DN"
combined = volLabel + "_" + trend
isHighUp = combined == "HIGH_UP"
plot(isHighUp ? 1 : 0, "HU")
