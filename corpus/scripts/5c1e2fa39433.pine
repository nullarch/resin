
//@version=5
indicator("Flow Scan")
buyBars = 0
for i = 0 to 4
    if not na(close[i]) and not na(open[i]) and not na(high[i]) and not na(low[i])
        rng = high[i] - low[i]
        bp = rng > 0 ? (close[i] - low[i]) / rng : 0.5
        if bp > 0.6
            buyBars := buyBars + 1
plot(buyBars, "BB")
