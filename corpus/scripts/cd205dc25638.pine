
//@version=5
indicator("Linked UDT")
type Indicator
    float value = 0.0
    bool bullish = false

var Indicator trend = Indicator.new()
var Indicator momentum = Indicator.new()
sma3 = ta.sma(close, 3)
rsiVal = ta.rsi(close, 3)
trend.value := sma3
trend.bullish := close > sma3
momentum.value := rsiVal
momentum.bullish := rsiVal > 50
combined = trend.bullish and momentum.bullish
plot(combined ? 1 : 0, "Signal")
