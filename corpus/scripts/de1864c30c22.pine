
//@version=5
indicator("Trend Full")
ema3 = ta.ema(close, 3)
ema5 = ta.ema(close, 5)
rsi = nz(ta.rsi(close, 3), 50.0)
atr = nz(ta.atr(3), 1.0)

var int trendDur = 0
var int trendDir = 0
newDir = ema3 > ema5 ? 1 : -1
if newDir == trendDir
    trendDur := trendDur + 1
else
    trendDir := newDir
    trendDur := 1

strength = math.abs(rsi - 50) / 50
momScore = (rsi > 50 ? 1 : -1) * strength

plot(trendDur * trendDir, "TD")
plot(momScore, "MS")
